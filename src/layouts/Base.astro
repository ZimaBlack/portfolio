---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FloatingActions from '../components/FloatingActions.astro';
import { site } from '../data/site';

const { title, description = site.tagline } = Astro.props;
const full = title ? `${title} — ${site.name}` : `${site.name} — ${site.role}`;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{full}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={full} />
    <meta property="og:description" content={description} />
    <script is:inline>document.documentElement.classList.add('js');</script>
    <ClientRouter />
  </head>
  <body>
    <Header />
    <main><slot /></main>
    <Footer />
    <FloatingActions />
    <script>
      import { initMotion, teardown } from '../scripts/motion';
      document.addEventListener('astro:page-load', initMotion);
      document.addEventListener('astro:before-swap', teardown);
    </script>
  </body>
</html>
