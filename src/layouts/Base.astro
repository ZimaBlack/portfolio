---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FloatingActions from '../components/FloatingActions.astro';
import TuringBackground from '../components/TuringBackground.astro';
import { site } from '../data/site';
import { copy, type Lang } from '../lib/i18n';
import { cv } from '../data/cv';

const { title, description, lang = 'es', section = 'home', altHref = '/', esHref, enHref, noindex = false } = Astro.props as {
  title?: string; description?: string; lang?: Lang; section?: string; altHref?: string; esHref?: string; enHref?: string; noindex?: boolean;
};
const c = copy[lang];
const desc = description ?? c.tagline;
const url = new URL(Astro.url.pathname, Astro.site ?? Astro.url).href;
const person = {
  '@context': 'https://schema.org', '@type': 'Person', name: site.name, jobTitle: c.role,
  description: c.tagline, url: new URL(import.meta.env.BASE_URL, Astro.site ?? Astro.url).href,
  address: { '@type': 'PostalAddress', addressLocality: site.location },
  alumniOf: { '@type': 'CollegeOrUniversity', name: 'Universidad de Mendoza' },
  knowsAbout: cv.software.flat().map(([n]) => n),
  sameAs: site.social.map((x) => x.href),
};
const og = new URL(`${import.meta.env.BASE_URL.replace(/\/$/, '')}/og.png`, Astro.site ?? Astro.url).href;
// GitHub Pages no permite cabeceras propias: la política va en una etiqueta meta. Sin servidor ni formularios,
// lo que se restringe es de dónde puede cargar cosas la página (y a dónde puede enviar datos).
const endpoint = import.meta.env.PUBLIC_QUESTION_ENDPOINT ? new URL(import.meta.env.PUBLIC_QUESTION_ENDPOINT).origin : '';
const csp = [
  "default-src 'self'",
  "script-src 'self' 'unsafe-inline' https://challenges.cloudflare.com",
  "style-src 'self' 'unsafe-inline'",
  "img-src 'self' data: blob:",
  "media-src 'self' blob:",
  "font-src 'self' data:",
  `connect-src 'self'${endpoint ? ' ' + endpoint : ''}`,
  "frame-src 'self' https://www.youtube-nocookie.com https://player.vimeo.com https://challenges.cloudflare.com",
  "object-src 'none'",
  "base-uri 'self'",
  "form-action 'self'",
].join('; ');
const full = title ? `${title} — ${site.studio}` : `${site.studio} — ${c.role}`;
---
<!doctype html>
<html lang={c.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/favicon.svg`} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta http-equiv="Content-Security-Policy" content={csp} />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#0b0b0a" />
    <title>{full}</title>
    <meta name="description" content={desc} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta property="og:title" content={full} />
    <meta property="og:description" content={desc} />
    <link rel="canonical" href={url} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={url} />
    <meta property="og:site_name" content={site.studio} />
    <meta property="og:image" content={og} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="ZMA BLK, Director de Arte · Visual Designer · UX/UI" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={og} />
    <meta property="og:locale" content={lang === 'es' ? 'es_AR' : 'en_US'} />
    {esHref && <link rel="alternate" hreflang="es" href={esHref} />}
    {enHref && <link rel="alternate" hreflang="en" href={enHref} />}
    <script type="application/ld+json" set:html={JSON.stringify(person)} />
    <script is:inline>document.documentElement.classList.add('js');</script>
    <ClientRouter />
  </head>
  <body>
    <TuringBackground />
    <Header lang={lang} section={section} altHref={altHref} />
    <main><slot /></main>
    <Footer lang={lang} />
    <FloatingActions lang={lang} />
    <script>
      import { initMotion, teardown } from '../scripts/motion';
      document.addEventListener('astro:page-load', initMotion);
      document.addEventListener('astro:before-swap', teardown);
    </script>
  </body>
</html>
