---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FloatingActions from '../components/FloatingActions.astro';
import { site } from '../data/site';
import { copy, type Lang } from '../lib/i18n';

const { title, description, lang = 'es', section = 'home', altHref = '/', esHref, enHref } = Astro.props as {
  title?: string; description?: string; lang?: Lang; section?: string; altHref?: string; esHref?: string; enHref?: string;
};
const c = copy[lang];
const desc = description ?? c.tagline;
const full = title ? `${title} — ${site.studio}` : `${site.studio} — ${c.role}`;
---
<!doctype html>
<html lang={c.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{full}</title>
    <meta name="description" content={desc} />
    <meta property="og:title" content={full} />
    <meta property="og:description" content={desc} />
    <meta property="og:locale" content={lang === 'es' ? 'es_AR' : 'en_US'} />
    {esHref && <link rel="alternate" hreflang="es" href={esHref} />}
    {enHref && <link rel="alternate" hreflang="en" href={enHref} />}
    <script is:inline>document.documentElement.classList.add('js');</script>
    <ClientRouter />
  </head>
  <body>
    <Header lang={lang} section={section} altHref={altHref} />
    <main><slot /></main>
    <Footer lang={lang} />
    <FloatingActions lang={lang} />
    <script>
      import { initMotion, teardown } from '../scripts/motion';
      document.addEventListener('astro:page-load', initMotion);
      document.addEventListener('astro:before-swap', teardown);
    </script>
  </body>
</html>
