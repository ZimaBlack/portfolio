---
import Icon from './Icon.astro';
import { waLink } from '../data/site';
import { copy, type Lang } from '../lib/i18n';
const { lang } = Astro.props as { lang: Lang };
const c = copy[lang];
---
<div class="fab" transition:persist>
  <a class="fab__btn" href={waLink(lang)} target="_blank" rel="noopener noreferrer" aria-label={c.fab.wa}>
    <Icon name="whatsapp" /><span>{c.fab.label}</span>
  </a>
</div>

<style>
  .fab { position: fixed; right: var(--gutter); bottom: var(--gutter); z-index: 60; }
  .fab__btn { display: inline-flex; align-items: center; height: 3.25rem; padding-inline: 1rem; border-radius: 999px; font-size: .85rem; white-space: nowrap;
    background: var(--fg); color: var(--bg); border: 1px solid var(--fg); transform-origin: right center;
    transition: transform .5s var(--ease), background .4s var(--ease), color .4s var(--ease); }
  .fab__btn :global(.ico) { width: 1.25rem; height: 1.25rem; flex: none; }
  .fab__btn span { max-width: 0; margin-left: 0; opacity: 0; overflow: hidden; transition: max-width .55s var(--ease), margin-left .55s var(--ease), opacity .3s ease; }
  .fab__btn:hover, .fab__btn:focus-visible { transform: scale(1.07); background: transparent; color: var(--fg); }
  .fab__btn:hover span, .fab__btn:focus-visible span { max-width: 7rem; margin-left: .6rem; opacity: 1; transition-delay: 0s, 0s, .12s; }
  @media (hover: none) { .fab__btn span { display: none; } }
  /* Celular: más chico y más bajo, para tapar menos contenido */
  @media (max-width: 760px) { .fab { right: .85rem; bottom: .85rem; } .fab__btn { height: 2.8rem; padding-inline: .8rem; } }
</style>
