---
import Frame from './Frame.astro';
import { loc, paths, copy } from '../lib/i18n';
const { work, lang, index = 0, ratio = '4 / 5' } = Astro.props;
const d = work.data;
const disc = loc(d.discipline, lang);
---
<a class="card" href={paths.work(lang, work.id)} data-cursor={copy[lang].detail.view} data-reveal>
  <div class="card__media">
    <div class="card__zoom"><Frame src={d.cover} alt={d.title} tones={d.tones} ratio={ratio} label={disc} /></div>
  </div>
  <div class="card__meta">
    <span class="muted">{String(index + 1).padStart(2, '0')}</span>
    <h3 class="h3 card__title"><span>{d.title}</span></h3>
    <span class="muted card__tag">{disc}{d.year ? ` · ${d.year}` : ''}</span>
  </div>
</a>

<style>
  .card { display: block; }
  .card__media { overflow: hidden; }
  .card__zoom { transition: transform 1.1s var(--ease), filter .6s; }
  .card:hover .card__zoom { transform: scale(1.06); }
  .card:hover .card__zoom { filter: brightness(1.12); }
  .card__meta { display: grid; grid-template-columns: 2.5rem 1fr auto; gap: .5rem 1rem; align-items: baseline; padding-top: 1rem; font-size: .85rem; border-top: 1px solid transparent; }
  .card__title { transition: transform .7s var(--ease); font-size: 1.15rem; }
  .card:hover .card__title { transform: translateX(.6rem); }
  @media (max-width: 640px) { .card__meta { grid-template-columns: 2rem 1fr; } .card__tag { grid-column: 2; } }
</style>
