---
// Retrato teñido por sectores. Cada sector (pelo, mechones, fondo y campera, logotipos) tiene su máscara (WebP con alfa) y recibe
// uno de los dos colores del widget con una pila de modos de fusión pensada para conservar el realismo:
//   «color» pone el matiz y la saturación y deja la luz de la foto (las sombras y brillos del pelo siguen siendo suyos);
//   «overlay» / «hard-light» / «multiply» ajustan el cuerpo del tono para que el color elegido se lea con su valor real.
import { withBase } from '../lib/i18n';
type Layer = { n?: string; bl?: number; sat?: number; lum?: number; m: string; c: '--c0' | '--c1'; b: [string, number][] };
// Tras la pila base, cada sector suma «multiply» si el color elegido es oscuro y «screen» si es muy claro (sus valores salen del script), para que
// el color no quede limitado por la luz gris de la foto: un acento casi negro oscurece el flequillo y un lila claro lo aclara.
const { photo, bw = '', layers, alt = '', ratio = '872 / 1330', blur = 0.5, tune = false, plain = false, video = '' } = Astro.props as { photo: string; bw?: string; layers: Layer[]; alt?: string; ratio?: string; blur?: number; tune?: boolean; plain?: boolean; video?: string };
const mode0 = layers[0]?.b[0]?.[0] ?? 'color';
const op0 = layers[0]?.b[0]?.[1] ?? 0.9;
const MODES = ['color','soft-light','overlay','hard-light','multiply','screen','normal','hue','saturation','luminosity','color-dodge','color-burn','darken','lighten'];
const STEP = ['Capa 1', 'Capa 2', 'Capa 3'];
---
<div class="tmw">
<figure class:list={['tm', { 'tm--plain': plain }]} data-nozoom style={`--r:${ratio};--blur:${blur}`}>
  <img class="tm__base" src={withBase(photo)} alt={alt} loading="lazy" decoding="async" />
  {layers.map((L, li) => [...L.b, ...(plain ? [] : [['multiply', `calc(var(--m${L.c.slice(-1)}, 0) * ${L.c === '--c1' ? 0.8 : 0.5})`], ['screen', `calc(var(--s${L.c.slice(-1)}, 0) * 0.6)`]])].map(([mode, op], bi) => <i class="tm__l" aria-hidden="true" data-g={bi === 0 ? (L.c === '--c0' ? 0 : 1) : undefined} data-bm={mode} style={`--blur:${L.bl ?? blur};${L.sat != null ? `--sat:${L.sat};` : ''}${L.lum != null ? `--lum:${L.lum};` : ''}--m:url(${withBase(L.m)});--c:var(${L.c});--bm:${mode};--bo:${op}`}></i>))}
  {video
    ? <video class="tm__bw tm__vid" src={withBase(video)} poster={withBase(bw)} muted playsinline preload="auto" aria-hidden="true"></video>
    : bw && <img class="tm__bw" src={withBase(bw)} alt="" loading="lazy" decoding="async" />}
  {video && <i class="tm__static" aria-hidden="true"></i>}
  {bw && <i class="tm__noir" aria-hidden="true"></i>}
</figure>
{tune && (
  <div class="tmc" data-tmc>
    {[['Color principal', 0], ['Color acento', 1]].map(([name, g]) => (
      <div class="tp__ctl" data-g={g}>
        <b>{name}</b>
        <label>Fusión<select data-f="mode">{MODES.map((m) => <option value={m} selected={m === mode0}>{m}</option>)}</select></label>
        <label>Desenfoque <input type="range" min="0" max="3" step="0.05" value={blur} data-f="blur" /></label>
        <label>Opacidad <input type="range" min="0" max="100" step="1" value={Math.round(op0 * 100)} data-f="op" /></label>
        <label>Saturación <input type="range" min="0" max="200" step="1" value={plain ? 100 : 74} data-f="sat" /></label>
        <label>Luminosidad <input type="range" min="40" max="160" step="1" value={plain ? 100 : 90} data-f="lum" /></label>
      </div>
    ))}
  </div>
)}
</div>

<style>
  .tmw { display: grid; gap: 1rem; }
  .tmc { display: grid; grid-template-columns: 1fr 1fr; gap: 1.2rem; }
  .tp__ctl { display: grid; gap: .6rem; font-size: .75rem; color: var(--muted); }
  .tp__ctl b { color: var(--fg); font-weight: 500; letter-spacing: .06em; text-transform: uppercase; font-size: .7rem; }
  .tp__ctl label { display: grid; grid-template-columns: 5.6rem 1fr; align-items: center; gap: .5rem; }
  .tp__ctl select { font: inherit; color: var(--fg); background: color-mix(in srgb, var(--bg) 70%, transparent); border: 1px solid var(--line); border-radius: 999px; padding: .3rem .8rem; }
  .tp__ctl select option { color: #000; }
  .tp__ctl input[type=range] { width: 100%; accent-color: var(--fg); }
  .tm { position: relative; margin: 0; aspect-ratio: var(--r); container-type: inline-size; border-radius: 3.5rem; overflow: hidden; isolation: isolate; }
  .tm img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; display: block; }
  .tm__l { position: absolute; inset: 0; pointer-events: none; background: var(--c); -webkit-mask: var(--m) center / 100% 100% no-repeat; mask: var(--m) center / 100% 100% no-repeat; mix-blend-mode: var(--bm); opacity: var(--bo); filter: blur(calc(var(--blur, 0.5) * 1cqw)) saturate(var(--sat, .74)) brightness(var(--lum, .9)); transition: background-color .8s linear, opacity 1.4s ease; }
  /* El «screen» es el resplandor: más desenfocado que el resto, para que la luz se derrame sobre las hebras */
  /* Método idéntico al de las fotos laterales: solo desenfoque, sin ajuste de saturación ni de brillo */
  .tm--plain { --sat: 1; --lum: 1; }
  .tm__l[data-bm='screen'] { filter: blur(calc(var(--blur, 0.5) * 3.2cqw)) saturate(var(--sat, .74)); }
  /* Modo blanco y negro: noir vintage, con grano, desgaste y viñeteo */
  .tm__bw { filter: grayscale(1) contrast(1.28) brightness(.95); border-radius: 8cqw; opacity: 0; transition: opacity 1.4s ease; }
  .tm__noir { position: absolute; inset: 0; border-radius: 8cqw; pointer-events: none; opacity: 0; transition: opacity 1.4s ease; mix-blend-mode: overlay;
    background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='260' height='260'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='.85' numOctaves='3' stitchTiles='stitch'/><feColorMatrix values='0 0 0 0 .5  0 0 0 0 .5  0 0 0 0 .5  0 0 0 1.4 -.15'/></filter><rect width='100%' height='100%' filter='url(%23n)'/></svg>"),
      linear-gradient(90deg, transparent 18%, rgb(255 255 255 / .5) 18.2%, transparent 18.5%, transparent 71%, rgb(255 255 255 / .35) 71.1%, transparent 71.4%),
      radial-gradient(ellipse 85% 80% at 50% 45%, transparent 45%, rgb(0 0 0 / .85) 100%);
    background-size: 260px 260px, 100% 100%, 100% 100%; animation: tm-flick .9s steps(2) infinite paused; }
  @keyframes tm-flick { 0% { background-position: 0 0, 0 0, 0 0; } 50% { background-position: 60px -40px, 0 0, 0 0; } 100% { background-position: -30px 50px, 0 0, 0 0; } }
  .tm__vid { object-fit: cover; }
  :global(html[data-pw-bw]) .tm__bw { opacity: 1; }
  /* Estática: a los 4 s del video se cubre de ruido; al terminar, un glitch devuelve el retrato a color */
  .tm__static { position: absolute; inset: -4%; border-radius: 8cqw; pointer-events: none; opacity: 0; mix-blend-mode: normal; background-color: #777;
    background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='160' height='160'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='1.1' numOctaves='3' stitchTiles='stitch'/><feColorMatrix type='saturate' values='0'/><feComponentTransfer><feFuncR type='linear' slope='3' intercept='-1'/><feFuncG type='linear' slope='3' intercept='-1'/><feFuncB type='linear' slope='3' intercept='-1'/></feComponentTransfer></filter><rect width='100%' height='100%' filter='url(%23n)'/></svg>"),
      repeating-linear-gradient(0deg, rgb(255 255 255 / .5) 0 2px, rgb(0 0 0 / .5) 2px 4px),
      linear-gradient(180deg, transparent 38%, rgb(255 255 255 / .6) 40%, transparent 44%, transparent 71%, rgb(0 0 0 / .6) 73%, transparent 77%);
    background-size: 160px 160px, 100% 100%, 100% 100%; background-blend-mode: normal; }
  .tm.is-static .tm__static { animation: tm-static .7s steps(7, end) infinite, tm-roll 1.9s linear infinite; }
  @keyframes tm-static { 0% { opacity: .9; background-position: 0 0, 0 0, 0 0; } 25% { opacity: 1; background-position: 37px -23px, 0 3px, 0 0; } 50% { opacity: .85; background-position: -29px 41px, 0 -2px, 0 0; } 75% { opacity: 1; background-position: 52px 17px, 0 4px, 0 0; } 100% { opacity: .92; background-position: -14px -48px, 0 0, 0 0; } }
  @keyframes tm-roll { 0% { filter: contrast(1.3) brightness(1); } 50% { filter: contrast(1.6) brightness(1.2); } 100% { filter: contrast(1.3) brightness(1); } }
  .tm.is-glitch { animation: tm-glitch .6s steps(8, end) 1; }
  :global(html[data-pw-bw]) .tm.is-back .tm__bw, :global(html[data-pw-bw]) .tm.is-back .tm__noir { opacity: 0; }
  :global(html[data-pw-bw]) .tm.is-back .tm__l { opacity: var(--bo); }
  /* Al volver a color, la sección sube por encima del velo gris: el retrato y las fotos recuperan el color mientras el resto del sitio sigue en blanco y negro */
  :global(html[data-pw-back] .cm__blend) { position: relative; z-index: 60; }
  :global(html[data-pw-back] .pw) { z-index: 61; }
  .tm.is-back .tm__static { animation: tm-static-out .6s steps(8, end) forwards; }
  @keyframes tm-static-out { 0% { opacity: .8; } 100% { opacity: 0; } }
  @keyframes tm-glitch { 0% { filter: blur(0); transform: translateX(0); } 20% { filter: blur(4px) hue-rotate(40deg); transform: translateX(-1.5%); } 45% { filter: blur(1px); transform: translateX(1.2%); } 70% { filter: blur(3px) hue-rotate(-30deg); transform: translateX(-.6%); } 100% { filter: blur(0); transform: none; } }
  :global(html[data-pw-bw]) .tm__l { opacity: 0; }
  :global(html[data-pw-bw]) .tm__noir { opacity: .85; animation-play-state: running; }
</style>

<script>
  // Controles simples (los mismos de las fotos laterales): fusión, desenfoque y opacidad de cada color, en vivo
  const initTune = () => document.querySelectorAll<HTMLElement>('[data-tmc]:not([data-on])').forEach((box) => {
    box.setAttribute('data-on', '');
    const fig = box.parentElement!.querySelector<HTMLElement>('.tm')!;
    box.querySelectorAll<HTMLElement>('.tp__ctl').forEach((g) => {
      const ls = () => [...fig.querySelectorAll<HTMLElement>(`.tm__l[data-g="${g.dataset.g}"]`)];
      g.querySelector('[data-f=mode]')!.addEventListener('change', (e) => ls().forEach((l) => { const v = (e.target as HTMLSelectElement).value; l.style.setProperty('--bm', v); l.dataset.bm = v; }));
      g.querySelector('[data-f=blur]')!.addEventListener('input', (e) => ls().forEach((l) => l.style.setProperty('--blur', (e.target as HTMLInputElement).value)));
      g.querySelector('[data-f=sat]')!.addEventListener('input', (e) => ls().forEach((l) => l.style.setProperty('--sat', String(+(e.target as HTMLInputElement).value / 100))));
      g.querySelector('[data-f=lum]')!.addEventListener('input', (e) => ls().forEach((l) => l.style.setProperty('--lum', String(+(e.target as HTMLInputElement).value / 100))));
      g.querySelector('[data-f=op]')!.addEventListener('input', (e) => ls().forEach((l) => l.style.setProperty('--bo', String(+(e.target as HTMLInputElement).value / 100))));
    });
  });
  document.addEventListener('astro:page-load', initTune); initTune();
</script>

<script>
  // Secuencia del video en blanco y negro: arranca con el modo, a los 4 s se cubre de estática y luego vuelve a color con un glitch
  const initVid = () => document.querySelectorAll<HTMLElement>('.tm:not([data-vid])').forEach((fig) => {
    const v = fig.querySelector<HTMLVideoElement>('video.tm__vid'); if (!v) return;
    fig.setAttribute('data-vid', '');
    const root = document.documentElement;
    let timers: number[] = [], raf = 0;
    const glitch = () => { window.dispatchEvent(new Event('pw:buzz')); fig.classList.remove('is-glitch'); void fig.offsetWidth; fig.classList.add('is-glitch'); };
    const at = (ms: number, fn: () => void) => timers.push(window.setTimeout(fn, ms));
    // Rebobinado: el navegador no reproduce hacia atrás, así que se retrocede cuadro a cuadro
    const rewind = (from: number, ms: number) => {
      const t0 = performance.now();
      const step = (now: number) => { const k = Math.min(1, (now - t0) / ms); v.currentTime = from * (1 - k); if (k < 1) raf = requestAnimationFrame(step); };
      raf = requestAnimationFrame(step);
    };
    const reset = () => { timers.forEach(clearTimeout); timers = []; cancelAnimationFrame(raf); fig.classList.remove('is-static', 'is-back', 'is-glitch'); root.removeAttribute('data-pw-back'); v.pause(); };
    const start = () => {
      reset(); v.currentTime = 0; v.play().catch(() => {});             // 0 s: arranca el video junto con el glitch de entrada (lo dispara el widget)
      at(3000, () => { v.pause(); glitch(); rewind(v.currentTime, 3000); }); // 3 s: glitch y el video retrocede
      at(6000, () => { v.pause(); glitch(); fig.classList.add('is-static'); }); // 6 s: glitch y estática
      at(8600, () => { glitch(); fig.classList.add('is-back'); root.setAttribute('data-pw-back', ''); }); // 8,6 s: glitch y vuelve a color
    };
    new MutationObserver(() => (root.hasAttribute('data-pw-bw') ? start() : reset())).observe(root, { attributes: true, attributeFilter: ['data-pw-bw'] });
  });
  document.addEventListener('astro:page-load', initVid); initVid();
</script>

<script>
  // Calcula, para cada color del widget, cuánto «multiply» (colores oscuros) o «screen» (colores muy claros) necesita su sector
  const lum = (c: number[]) => { const f = (v: number) => { v /= 255; return v <= 0.03928 ? v / 12.92 : Math.pow((v + 0.055) / 1.055, 2.4); }; return 0.2126 * f(c[0]) + 0.7152 * f(c[1]) + 0.0722 * f(c[2]); };
  const parse = (s: string) => { const h = /^#([0-9a-f]{6})$/i.exec(s.trim()); if (h) { const n = parseInt(h[1], 16); return [(n >> 16) & 255, (n >> 8) & 255, n & 255]; } const r = /rgba?\(([^)]+)\)/.exec(s); if (r) { const p = r[1].split(/[ ,/]+/).map(Number); return [p[0], p[1], p[2]]; } return null; };
  const init = () => document.querySelectorAll<HTMLElement>('.tm:not([data-lum])').forEach((fig) => {
    fig.setAttribute('data-lum', '');
    const hero = document.querySelector<HTMLElement>('[data-pj-hero]');
    const upd = () => [0, 1].forEach((i) => {
      const c = parse(hero?.style.getPropertyValue(`--pw-${i}`) || '') ?? parse(getComputedStyle(fig).getPropertyValue(`--c${i}`)); if (!c) return;
      const L = lum(c);
      fig.style.setProperty(`--m${i}`, String(Math.max(0, Math.min(1, (0.07 - L) / 0.06))));
      fig.style.setProperty(`--s${i}`, String(Math.max(0, Math.min(1, (L - 0.5) / 0.3))));
    });
    if (hero) new MutationObserver(upd).observe(hero, { attributes: true, attributeFilter: ['style'] });
    upd();
  });
  document.addEventListener('astro:page-load', init); init();
</script>
