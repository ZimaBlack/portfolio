---
// Retrato teñido con máscaras (PNG/WebP con transparencia): cada máscara pinta con un color del widget (--c0 / --c1)
// desenfocado y fusionado con la foto, para que la imagen siga la paleta elegida.
import { withBase } from '../lib/i18n';
const { photo, masks, alt = '', ratio = '872 / 1330', blur = 1.2, opacity = 0.7, mode = 'color' } = Astro.props as { photo: string; masks: string[]; alt?: string; ratio?: string; blur?: number; opacity?: number; mode?: string };
---
<figure class="tm" style={`--r:${ratio};--blur:${blur};--op:${opacity};--mode:${mode}`}>
  <img src={withBase(photo)} alt={alt} loading="lazy" decoding="async" />
  {masks.map((m, i) => <i class="tm__l" aria-hidden="true" style={`--m:url(${withBase(m)});--c:var(--c${i})`}></i>)}
</figure>

<style>
  .tm { position: relative; margin: 0; aspect-ratio: var(--r); container-type: inline-size; isolation: isolate; }
  .tm img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; display: block; }
  .tm__l { position: absolute; inset: 0; pointer-events: none; background: var(--c); -webkit-mask: var(--m) center / 100% 100% no-repeat; mask: var(--m) center / 100% 100% no-repeat; mix-blend-mode: var(--mode); opacity: var(--op); filter: blur(calc(var(--blur) * 1cqw)); transition: background-color .8s linear; }
</style>
