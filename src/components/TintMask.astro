---
// Retrato teñido con «mapa de degradado» (el método de los coloristas de cine): la luz de la propia foto decide qué parte de la rampa de color
// de cada máscara se usa. Las sombras caen a una versión profunda del color, los medios tonos son el color y las luces, una versión clara.
// Así el tinte conserva todo el detalle (mechones, brillos, textura) y no se ve como un filtro plano. Cada máscara (PNG/WebP con alfa)
// recibe un color del widget (--c0 / --c1); el script rehace las rampas cuando los colores cambian, con una transición suave.
import { withBase } from '../lib/i18n';
const { photo, bw = '', masks, alt = '', ratio = '872 / 1330', opacity = 0.96, uid = 'tm', defaults = ['#E03B7A', '#6CE829'] } = Astro.props as { photo: string; bw?: string; masks: string[]; alt?: string; ratio?: string; opacity?: number; uid?: string; defaults?: string[] };
const STEPS = 9;
const hex2 = (h: string) => { const n = parseInt(h.replace('#', ''), 16); return [(n >> 16) & 255, (n >> 8) & 255, n & 255]; };
const mixc = (a: number[], b: number[], t: number) => a.map((v, i) => v + (b[i] - v) * t);
const ramp = (c: number[]) => {
  const dark = c.map((v) => v * 0.16), light = mixc(c, [255, 255, 255], 0.72);
  return Array.from({ length: STEPS }, (_, k) => {
    const t = Math.min(1, Math.max(0, (k / (STEPS - 1) - 0.1) / 0.8)); // estira el contraste de la foto antes de colorear
    return t < 0.5 ? mixc(dark, c, t / 0.5) : mixc(c, light, (t - 0.5) / 0.5);
  });
};
const tables = defaults.map((d) => { const r = ramp(hex2(d)); return [0, 1, 2].map((ch) => r.map((p) => (p[ch] / 255).toFixed(3)).join(' ')); });
---
<figure class="tm" data-tm={uid} style={`--r:${ratio};--op:${opacity}`}>
  <img class="tm__base" src={withBase(photo)} alt={alt} loading="lazy" decoding="async" />
  {masks.map((m, i) => (
    <div class="tm__gm" style={`--m:url(${withBase(m)})`}><img src={withBase(photo)} alt="" aria-hidden="true" loading="lazy" decoding="async" style={`filter:url(#${uid}-f${i})`} /></div>
  ))}
  {bw && <img class="tm__bw" src={withBase(bw)} alt="" loading="lazy" decoding="async" />}
  <svg width="0" height="0" style="position:absolute" aria-hidden="true" focusable="false">
    {masks.map((_, i) => (
      <filter id={`${uid}-f${i}`} color-interpolation-filters="sRGB" x="0" y="0" width="100%" height="100%">
        <feColorMatrix type="matrix" values="0.30 0.59 0.11 0 0  0.30 0.59 0.11 0 0  0.30 0.59 0.11 0 0  0 0 0 1 0" />
        <feComponentTransfer>
          <feFuncR type="table" tableValues={tables[i][0]} />
          <feFuncG type="table" tableValues={tables[i][1]} />
          <feFuncB type="table" tableValues={tables[i][2]} />
        </feComponentTransfer>
      </filter>
    ))}
  </svg>
</figure>

<style>
  .tm { position: relative; margin: 0; aspect-ratio: var(--r); container-type: inline-size; isolation: isolate; }
  .tm img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; display: block; }
  .tm__gm { position: absolute; inset: 0; pointer-events: none; -webkit-mask: var(--m) center / 100% 100% no-repeat; mask: var(--m) center / 100% 100% no-repeat; opacity: var(--op); transition: opacity 1.4s ease; }
  .tm__bw { border-radius: 8cqw; opacity: 0; transition: opacity 1.4s ease; }
  :global(html[data-pw-bw]) .tm__bw { opacity: 1; }
  :global(html[data-pw-bw]) .tm__gm { opacity: 0; }
</style>

<script>
  const STEPS = 9;
  const mixc = (a: number[], b: number[], t: number) => a.map((v, i) => v + (b[i] - v) * t);
  const parse = (s: string): number[] | null => {
    s = s.trim();
    const h = /^#([0-9a-f]{6})$/i.exec(s); if (h) { const n = parseInt(h[1], 16); return [(n >> 16) & 255, (n >> 8) & 255, n & 255]; }
    const r = /rgba?\(([^)]+)\)/.exec(s); if (r) { const p = r[1].split(/[ ,/]+/).map(Number); return [p[0], p[1], p[2]]; }
    return null;
  };
  const rampOf = (c: number[]) => {
    const dark = c.map((v) => v * 0.16), light = mixc(c, [255, 255, 255], 0.72);
    return Array.from({ length: STEPS }, (_, k) => { const t = Math.min(1, Math.max(0, (k / (STEPS - 1) - 0.1) / 0.8)); return t < 0.5 ? mixc(dark, c, t / 0.5) : mixc(c, light, (t - 0.5) / 0.5); });
  };
  const init = () => document.querySelectorAll<HTMLElement>('[data-tm]:not([data-on])').forEach((fig) => {
    fig.setAttribute('data-on', '');
    const uid = fig.dataset.tm!;
    const n = fig.querySelectorAll('.tm__gm').length;
    const cur: number[][] = []; let target: number[][] = []; let raf = 0;
    const apply = () => cur.forEach((c, i) => {
      const f = document.getElementById(`${uid}-f${i}`); if (!f) return;
      const r = rampOf(c);
      ['R', 'G', 'B'].forEach((ch, k) => f.querySelector(`feFunc${ch}`)?.setAttribute('tableValues', r.map((p) => (p[k] / 255).toFixed(3)).join(' ')));
    });
    const hero0 = document.querySelector<HTMLElement>('[data-pj-hero]');
    // Se leen los colores del style inline (--pw-N): el valor calculado de esas variables se anima 0,8 s y llegaría atrasado
    const read = () => Array.from({ length: n }, (_, i) => parse(hero0?.style.getPropertyValue(`--pw-${i}`) || '') ?? parse(getComputedStyle(fig).getPropertyValue(`--c${i}`)));
    const go = () => {
      const t = read(); if (t.some((x) => !x)) return;
      target = t as number[][];
      if (!cur.length) { target.forEach((c) => cur.push([...c])); apply(); return; }
      cancelAnimationFrame(raf);
      const from = cur.map((c) => [...c]), t0 = performance.now();
      const step = (now: number) => {
        const k = Math.min(1, (now - t0) / 700), e = k * (2 - k);
        cur.forEach((c, i) => { c[0] = from[i][0] + (target[i][0] - from[i][0]) * e; c[1] = from[i][1] + (target[i][1] - from[i][1]) * e; c[2] = from[i][2] + (target[i][2] - from[i][2]) * e; });
        apply(); if (k < 1) raf = requestAnimationFrame(step);
      };
      raf = requestAnimationFrame(step);
    };
    // Los colores del widget llegan como variables en la página: se vigilan sus cambios
    const scope = fig.closest<HTMLElement>('[data-pw-scope]') ?? document.documentElement;
    new MutationObserver(go).observe(scope, { attributes: true, attributeFilter: ['style'] });
    const hero = document.querySelector<HTMLElement>('[data-pj-hero]');
    if (hero) new MutationObserver(go).observe(hero, { attributes: true, attributeFilter: ['style'] });
    go();
  });
  document.addEventListener('astro:page-load', init); init();
</script>
