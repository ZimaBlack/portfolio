---
// Fondo del sitio: patrón de Turing a pantalla completa, detrás de todo. En la Home responde al cursor (como el laboratorio; no actúa sobre
// el footer) y se ve a pleno en el hero principal; en el resto del sitio es un patrón asentado al 15 %. El preset se guarda desde /lab/
// en src/data/background.json.
import preset from '../data/background.json';
---
<canvas class="tbg" data-tbg data-preset={JSON.stringify(preset)} aria-hidden="true" transition:persist="turing-bg"></canvas>

<style>
  .tbg { position: fixed; inset: 0; width: 100%; height: 100%; z-index: -1; pointer-events: none; opacity: .15; transition: opacity 1.2s var(--ease); }
  .tbg.is-hero { opacity: 1; }
  /* Pensado para fondo oscuro */
  @media (prefers-color-scheme: light) { :global(:root:not([data-theme='dark'])) .tbg { display: none; } }
</style>

<script>
  import { initTuringBackground, type TuringBackground } from '../scripts/turing-background';

  let bg: TuringBackground | null = null;
  let io: IntersectionObserver | null = null;

  // En cada página: con hero principal (Home), el fondo responde al cursor y está a pleno mientras el hero se ve; sin él, queda asentado al 15 %.
  const wire = () => {
    const canvas = document.querySelector<HTMLCanvasElement>('[data-tbg]');
    if (!canvas) return;
    bg ??= initTuringBackground(canvas, JSON.parse(canvas.dataset.preset || '{}'));
    io?.disconnect();
    canvas.classList.remove('is-hero');
    bg.setGlitch(false);
    const hero = document.querySelector<HTMLElement>('.hero');
    bg.setMode(hero ? 'cursor' : 'ambient');
    if (!hero) return;
    io = new IntersectionObserver(([e]) => { canvas.classList.toggle('is-hero', e.isIntersecting); bg?.setGlitch(e.isIntersecting); }, { threshold: 0.35 }); // el glitch, sólo con el hero a la vista
    io.observe(hero);
  };
  document.addEventListener('astro:page-load', wire);
</script>
