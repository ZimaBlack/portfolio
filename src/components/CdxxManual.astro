---
// Identidad de Conexión CDXX para el portfolio. Texto bilingüe; piezas en /works/cdxx/manual/
import { withBase, type Lang } from '../lib/i18n';

const { lang } = Astro.props as { lang: Lang };
const es = lang === 'es';
const img = (n: string) => withBase(`/works/cdxx/manual/${n}.webp`);
const svg = (n: string) => withBase(`/works/cdxx/manual/${n}.svg`);
const marble = withBase('/works/cdxx/bg-1920.webp');

const t = es ? {
  title: 'Dualidad fusionada: el diseño detrás de una experiencia sensorial',
  introA: 'Conexión CDXX no es solo un producto gourmet, es un portal. La marca nace de la necesidad de transformar la degustación en un viaje que conecte lo tangible del chocolate y los destilados con lo etéreo de la percepción y la conciencia humana.',
  introB: 'La identidad visual se construye sobre una dualidad: la naturaleza y la tecnología. Se inspira en cómo las redes de hongos (hifas micelares) y los procesadores de silicio comparten un mismo propósito: transmitir información y expandir redes.',
  roots: 'Raíces, hifas y circuitos',
  rootsA: 'El símbolo central es un árbol que representa crecimiento orgánico. Sus raíces se transforman en conexiones micelares y se extienden hacia patrones geométricos que evocan circuitos neuronales, simbolizando la expansión del pensamiento.',
  sketch: 'Boceto del isotipo',
  variants: 'Variantes de aplicación',
  reduce: 'Reducciones',
  palette: 'Paleta cromática: profundidad y sofisticación',
  paletteA: 'Los colores son funcionales al concepto.',
  paletteB: 'Moss, Gold y Black Raisin comunican lujo, opulencia y el anclaje a la naturaleza orgánica.',
  paletteC: 'Wine Cream aporta serenidad y equilibra la intensidad gráfica de la marca.',
  type: 'Tipografía',
  typeA: 'La tipografía refleja la dualidad del concepto. Lexend aporta claridad formal, accesibilidad y espacios abiertos. Como contrapeso, Krona One irrumpe con una geometría audaz y futurista, e inyecta dinamismo sin perder elegancia.',
  res: 'Recursos y aplicaciones',
  resA: 'Lo fluido y lo irrepetible: la textura del papel marmolado es el recurso principal porque imita la sedosidad del chocolate derretido. Es orgánico, efímero y, al igual que cada pieza de chocolate artesanal, visualmente irrepetible.',
  studio: 'Fotografías reales de estudio',
  social: 'Redes',
} : {
  title: 'Fused duality: the design behind a sensory experience',
  introA: 'Conexión CDXX is not just a gourmet product, it is a portal. The brand was born from the need to turn tasting into a journey that connects the tangible side of chocolate and spirits with the ethereal side of perception and human consciousness.',
  introB: 'The visual identity is built on a duality: nature and technology. It draws on how fungal networks (mycelial hyphae) and silicon processors share one purpose: transmitting information and expanding networks.',
  roots: 'Roots, hyphae and circuits',
  rootsA: 'The central symbol is a tree that stands for organic growth. Its roots turn into mycelial connections and extend into geometric patterns that evoke neural circuits, symbolizing the expansion of thought.',
  sketch: 'Isotype sketch',
  variants: 'Application variants',
  reduce: 'Reductions',
  palette: 'Color palette: depth and sophistication',
  paletteA: 'The colors serve the concept.',
  paletteB: 'Moss, Gold and Black Raisin convey luxury, opulence and an anchor in organic nature.',
  paletteC: 'Wine Cream brings serenity and balances the brand’s graphic intensity.',
  type: 'Typography',
  typeA: 'The typography reflects the duality of the concept. Lexend brings formal clarity, accessibility and open spaces. As a counterweight, Krona One bursts in with a bold, futuristic geometry and injects dynamism without losing elegance.',
  res: 'Resources and applications',
  resA: 'The fluid and the unrepeatable: the texture of marbled paper is the main resource because it imitates the silkiness of melted chocolate. It is organic, ephemeral and, like every piece of artisanal chocolate, visually unrepeatable.',
  studio: 'Real studio photography',
  social: 'Social',
};

const colors = [
  { n: 'Moss', hex: '#988F5A' }, { n: 'Gold', hex: '#D6B56E' }, { n: 'White Moon', hex: '#ACB4C1' },
  { n: 'Wine Cream', hex: '#142129' }, { n: 'Black Raisin', hex: '#0C1618' },
];
---
<section class="cx" aria-label={es ? 'Identidad' : 'Identity'}>
  <div class="wrap cx__sec" data-reveal>
    <h2 class="h2">{t.title}</h2>
    <div class="cx__cols"><p class="cx__txt">{t.introA}</p><p class="cx__txt">{t.introB}</p></div>
  </div>

  <figure class="wrap cx__full" data-reveal><img src={img('grilla')} alt={t.roots} loading="lazy" decoding="async" /></figure>

  <div class="wrap cx__roots" data-reveal>
    <h2 class="h2">{t.roots}</h2>
    <p class="cx__txt">{t.rootsA}</p>
  </div>

  <div class="wrap cx__label" data-reveal>
    <h2 class="h2">{t.variants}</h2>
    <figure class="cx__rv" data-rv>
      <div class="cx__fig"><img class="cx__svg cx__svg--var" src={svg('variantes')} alt={t.variants} loading="lazy" decoding="async" /><span class="cx__shine" aria-hidden="true" style={`--logo:url(${svg('variantes')})`}></span></div>
    </figure>
  </div>

  <div class="wrap cx__sec" data-reveal>
    <h2 class="h2">{t.palette}</h2>
    <div class="cx__paltxt">
      <div class="cx__side"><p class="cx__txt">{t.paletteA}</p><p class="cx__txt">{t.paletteB}</p><p class="cx__txt">{t.paletteC}</p></div>
      <ul class="cx__pal">{colors.map((c) => <li><strong>{c.n}</strong> <em>{c.hex}</em></li>)}</ul>
    </div>
  </div>
  <figure class="wrap cx__bleed" data-reveal><img src={img('paleta')} alt={t.palette} loading="lazy" decoding="async" /></figure>

  <div class="wrap cx__label" data-reveal>
    <h2 class="h2">{t.reduce}</h2>
    <figure class="cx__rv" data-rv>
      <div class="cx__fig"><img class="cx__svg" src={svg('reducciones')} alt={t.reduce} loading="lazy" decoding="async" /><span class="cx__shine" aria-hidden="true" style={`--logo:url(${svg('reducciones')})`}></span></div>
    </figure>
  </div>

  <figure class="wrap cx__bleed cx__bleed--box" data-reveal><img src={img('recursos')} alt={t.res} loading="lazy" decoding="async" /></figure>

  <div class="wrap cx__sec cx__over" data-reveal>
    <h2 class="h2">{t.res}</h2>
    <p class="cx__txt">{t.resA}</p>
  </div>

  <figure class="wrap cx__trio" data-reveal><img src={img('trio')} alt="Conexión CDXX" loading="lazy" decoding="async" /></figure>

  <figure class="wrap cx__full" data-reveal><img src={img('barra')} alt="Barra Gold" loading="lazy" decoding="async" /></figure>

  <figure class="wrap cx__full" data-reveal>
    <img src={img('estudio')} alt={t.studio} loading="lazy" decoding="async" />
    <figcaption class="muted">{t.studio}</figcaption>
  </figure>

  <div class="wrap cx__end" data-reveal><img src={withBase('/works/cdxx/tree.svg')} alt="" loading="lazy" decoding="async" /></div>
</section>

<style>
  .cx { --gold: #d6b56e; display: grid; gap: clamp(4rem, 8vw, 8rem); padding-block: clamp(3rem, 6vw, 6rem) clamp(5rem, 9vw, 9rem); }
  .cx figure { margin: 0; }
  .cx img { width: 100%; height: auto; display: block; }
  .cx figcaption { font-size: .8rem; padding-top: .75rem; }
  .cx__txt { margin: 0; color: var(--muted); max-width: 46rem; line-height: 1.7; }
  .cx .h2 { margin: 0; }
  /* Sección: filete superior, título y texto, como en la maqueta */
  .cx__sec { display: grid; gap: 1.5rem; padding-top: clamp(1.5rem, 3vw, 2.5rem); border-top: 1px solid var(--line); }
  .cx__cols { display: grid; gap: 1.25rem; max-width: 46rem; }
  .cx__side { display: grid; gap: 1rem; align-content: start; }
  .cx__paltxt { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: clamp(2rem, 6vw, 5rem); align-items: start; }
  .cx__pal { list-style: none; margin: 0; padding: 0; display: grid; gap: .3rem; justify-self: end; text-align: right; font-size: .85rem; }
  .cx__pal em { font-style: normal; color: var(--muted); }
  .cx__roots { display: grid; gap: 1.25rem; max-width: 72rem; }
  .cx__label { display: grid; grid-template-columns: minmax(0, .7fr) minmax(0, 3.2fr); gap: clamp(1.5rem, 4vw, 4rem); align-items: center; }
  /* Contenedor: todo el contenido del proyecto vive en un ancho de lectura centrado; solo las imágenes con el patrón fluido van de borde a borde */
  .cx > .wrap { max-width: 72rem; }
  .cx > figure.wrap:not(.cx__bleed) { margin-inline: auto; }
  .cx__full img { border-radius: 2px; }
  .cx__full figcaption { text-align: center; }
  .cx__bleed { width: 100vw; max-width: none !important; margin-inline: calc(50% - 50vw); padding: 0; }
  .cx__bleed img { border-radius: 0; }
  /* El texto de recursos sube y se monta apenas sobre el borde inferior de la imagen */
  .cx__over { margin-top: calc(-1 * clamp(4rem, 9vw, 9rem)); position: relative; z-index: 2; border-top: 0; text-shadow: 0 2px 24px rgb(0 0 0 / .8); }
  .cx__trio { display: grid; justify-items: center; }
  .cx__trio img { width: 100%; }
  .cx__end { display: grid; place-items: center; }
  .cx__end img { width: clamp(6rem, 12vw, 9rem); }
  .cx__fig { position: relative; }
  /* Escritorio: los sellos de variantes crecen (se recorta el margen vacío del SVG) */
  .cx__label .cx__rv { overflow: hidden; }
  .cx__label .cx__svg--var { width: 150%; max-width: none; margin-inline: -25%; }
  .cx__label .cx__shine { display: none; }
  /* Brillo (el de la marquesina de logos): una banda diagonal que cruza el SVG cuando ya apareció */
  .cx__shine { position: absolute; inset: 0; pointer-events: none; opacity: 0; mix-blend-mode: overlay;
    -webkit-mask: var(--logo) center / 100% 100% no-repeat; mask: var(--logo) center / 100% 100% no-repeat;
    background: linear-gradient(115deg, transparent 38%, rgb(255 255 255 / .95) 50%, transparent 62%) 130% 0 / 260% 100% no-repeat; }
  .cx__rv.is-in .cx__shine { animation: cx-shine 1.8s 2.2s ease-out 1 both; }
  @keyframes cx-shine { 0% { opacity: 0; background-position: 130% 0; } 15% { opacity: .9; } 85% { opacity: .9; } 100% { opacity: 0; background-position: -30% 0; } }
  /* Aparición fluida de los SVG: un velo de máscara que barre de izquierda a derecha, con desenfoque y leve escala */
  @property --rv { syntax: '<number>'; inherits: false; initial-value: 0; }
  .cx__rv .cx__svg { --rv: 0; opacity: 0; filter: blur(8px); transform: scale(.96); transform-origin: 50% 50%;
    -webkit-mask-image: linear-gradient(90deg, #000 calc(var(--rv) * 1% - 30%), transparent calc(var(--rv) * 1%)); mask-image: linear-gradient(90deg, #000 calc(var(--rv) * 1% - 30%), transparent calc(var(--rv) * 1%)); }
  .cx__rv.is-in .cx__svg { opacity: 1; filter: blur(0); transform: none; --rv: 130; transition: --rv 2.6s cubic-bezier(.22, .8, .3, 1), opacity 1.2s ease, filter 1.6s ease, transform 2s var(--ease); }
  @media (prefers-reduced-motion: reduce) { .cx__rv .cx__svg { opacity: 1; filter: none; transform: none; -webkit-mask-image: none; mask-image: none; } .cx__shine { display: none; } }
  @media (max-width: 860px) {
    .cx__cols, .cx__paltxt, .cx__label { grid-template-columns: 1fr; }
    .cx__pal { justify-self: start; text-align: left; }
    /* Móvil: título de variantes centrado y logos más grandes (se recorta el margen lateral del SVG) */
    .cx__label { justify-items: center; text-align: center; }
    .cx__label .cx__rv { width: 100%; overflow: hidden; }
    .cx__label .cx__svg--var { width: 200%; max-width: none; margin-inline: -50%; }
    .cx__label .cx__shine { display: none; }
    /* Móvil: el banner de la caja crece y se desplaza para dejar la caja centrada */
    .cx__bleed--box { overflow: hidden; }
    .cx__bleed--box img { width: 230%; max-width: none; margin-left: -106%; }
  }
</style>

<script>
  // Dispara la aparición de los SVG al entrar en pantalla
  const wire = () => {
    const els = document.querySelectorAll<HTMLElement>('[data-rv]:not([data-rv-ready])');
    if (!els.length) return;
    const io = new IntersectionObserver((entries) => entries.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('is-in'); io.unobserve(e.target); } }), { threshold: 0.35 });
    els.forEach((el) => { el.dataset.rvReady = '1'; io.observe(el); });
  };
  document.addEventListener('astro:page-load', wire);
</script>
