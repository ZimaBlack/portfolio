---
// Identidad de Conexión CDXX para el portfolio. Texto bilingüe; piezas en /works/cdxx/manual/
import { withBase, type Lang } from '../lib/i18n';

const { lang } = Astro.props as { lang: Lang };
const es = lang === 'es';
const img = (n: string) => withBase(`/works/cdxx/manual/${n}.webp`);
const svg = (n: string) => withBase(`/works/cdxx/manual/${n}.svg`);
const marble = withBase('/works/cdxx/bg-1920.webp');

const t = es ? {
  title: 'Dualidad fusionada: el diseño detrás de una experiencia sensorial',
  introA: 'Conexión CDXX no es solo un producto gourmet, es un portal. La marca nace de la necesidad de transformar la degustación en un viaje que conecte lo tangible del chocolate y los destilados con lo etéreo de la percepción y la conciencia humana.',
  introB: 'La identidad visual se construye sobre una dualidad: la naturaleza y la tecnología. Se inspira en cómo las redes de hongos (hifas micelares) y los procesadores de silicio comparten un mismo propósito: transmitir información y expandir redes.',
  roots: 'Raíces, hifas y circuitos',
  rootsA: 'El símbolo central es un árbol que representa crecimiento orgánico. Sus raíces se transforman en conexiones micelares y se extienden hacia patrones geométricos que evocan circuitos neuronales, simbolizando la expansión del pensamiento.',
  sketch: 'Boceto del isotipo',
  variants: 'Variantes',
  reduce: 'Reducciones',
  palette: 'Paleta cromática: profundidad y sofisticación',
  paletteA: 'Los colores son funcionales al concepto.',
  paletteB: 'Moss, Gold y Black Raisin comunican lujo, opulencia y el anclaje a la naturaleza orgánica.',
  paletteC: 'Wine Cream aporta serenidad y equilibra la intensidad gráfica de la marca.',
  type: 'Tipografía',
  typeA: 'La tipografía refleja la dualidad del concepto. Lexend aporta claridad formal, accesibilidad y espacios abiertos. Como contrapeso, Krona One irrumpe con una geometría audaz y futurista, e inyecta dinamismo sin perder elegancia.',
  res: 'Recursos gráficos',
  resA: 'Lo fluido y lo irrepetible: la textura del papel marmolado es el recurso principal porque imita la sedosidad del chocolate derretido. Es orgánico, efímero y, al igual que cada pieza de chocolate artesanal, visualmente irrepetible.',
  studio: 'Fotografías reales de estudio',
  social: 'Redes',
} : {
  title: 'Fused duality: the design behind a sensory experience',
  introA: 'Conexión CDXX is not just a gourmet product, it is a portal. The brand was born from the need to turn tasting into a journey that connects the tangible side of chocolate and spirits with the ethereal side of perception and human consciousness.',
  introB: 'The visual identity is built on a duality: nature and technology. It draws on how fungal networks (mycelial hyphae) and silicon processors share one purpose: transmitting information and expanding networks.',
  roots: 'Roots, hyphae and circuits',
  rootsA: 'The central symbol is a tree that stands for organic growth. Its roots turn into mycelial connections and extend into geometric patterns that evoke neural circuits, symbolizing the expansion of thought.',
  sketch: 'Isotype sketch',
  variants: 'Variants',
  reduce: 'Reductions',
  palette: 'Color palette: depth and sophistication',
  paletteA: 'The colors serve the concept.',
  paletteB: 'Moss, Gold and Black Raisin convey luxury, opulence and an anchor in organic nature.',
  paletteC: 'Wine Cream brings serenity and balances the brand’s graphic intensity.',
  type: 'Typography',
  typeA: 'The typography reflects the duality of the concept. Lexend brings formal clarity, accessibility and open spaces. As a counterweight, Krona One bursts in with a bold, futuristic geometry and injects dynamism without losing elegance.',
  res: 'Graphic resources',
  resA: 'The fluid and the unrepeatable: the texture of marbled paper is the main resource because it imitates the silkiness of melted chocolate. It is organic, ephemeral and, like every piece of artisanal chocolate, visually unrepeatable.',
  studio: 'Real studio photography',
  social: 'Social',
};

const colors = [
  { n: 'Moss', hex: '#988F5A' }, { n: 'Gold', hex: '#D6B56E' }, { n: 'White Moon', hex: '#ACB4C1' },
  { n: 'Wine Cream', hex: '#142129' }, { n: 'Black Raisin', hex: '#0C1618' },
];
---
<section class="cx" aria-label={es ? 'Identidad' : 'Identity'}>
  <div class="wrap cx__intro" data-reveal>
    <h2 class="h2">{t.title}</h2>
    <div class="cx__cols"><p class="cx__txt">{t.introA}</p><p class="cx__txt">{t.introB}</p></div>
  </div>

  <figure class="wrap cx__sketch" data-reveal>
    <img src={img('boceto')} alt={t.sketch} loading="lazy" decoding="async" />
    <figcaption class="muted">{t.sketch}</figcaption>
  </figure>

  <div class="wrap cx__text" data-reveal>
    <h2 class="h2">{t.roots}</h2>
    <p class="cx__txt">{t.rootsA}</p>
  </div>

  <div class="wrap cx__trio" data-reveal>
    <figure class="cx__t cx__t--l"><img src={img('pistacho')} alt="Conexión CDXX" loading="lazy" decoding="async" /></figure>
    <figure class="cx__t cx__t--c"><img src={img('badge')} alt={t.roots} loading="lazy" decoding="async" /></figure>
    <figure class="cx__t cx__t--r"><img src={img('oreo')} alt="Conexión CDXX" loading="lazy" decoding="async" /></figure>
  </div>

  <div class="wrap cx__row" data-reveal>
    <div class="cx__side">
      <h2 class="h2">{t.palette}</h2>
      <p class="cx__txt">{t.paletteA}</p>
      <p class="cx__txt">{t.paletteB}</p>
      <p class="cx__txt">{t.paletteC}</p>
    </div>
    <ul class="cx__pal">
      {colors.map((c) => <li><span class="cx__dot" style={`background:${c.hex}`}></span><span><strong>{c.n}</strong><em>{c.hex}</em></span></li>)}
    </ul>
  </div>

  <figure class="wrap cx__center cx__rv" data-rv>
    <img class="cx__svg cx__svg--var" src={svg('variantes')} alt={t.variants} loading="lazy" decoding="async" />
    <figcaption class="muted">{t.variants}</figcaption>
  </figure>

  <div class="cx__res" data-reveal style={`--m:url(${marble})`}>
    <div class="wrap cx__row cx__row--res">
      <div class="cx__side">
        <h2 class="h2">{t.res}</h2>
        <p class="cx__txt">{t.resA}</p>
      </div>
      <figure class="cx__box"><img src={img('caja')} alt={t.res} loading="lazy" decoding="async" /></figure>
    </div>
  </div>

  <figure class="wrap cx__photo" data-reveal><img src={img('pack')} alt={t.res} loading="lazy" decoding="async" /></figure>

  <figure class="wrap cx__photo" data-reveal>
    <img src={img('fotos')} alt={t.studio} loading="lazy" decoding="async" />
    <figcaption class="muted">{t.studio}</figcaption>
  </figure>

  <figure class="wrap cx__center cx__rv" data-rv>
    <img class="cx__svg cx__svg--red" src={svg('reducciones')} alt={t.reduce} loading="lazy" decoding="async" />
    <figcaption class="muted">{t.reduce}</figcaption>
  </figure>

  <div class="wrap cx__row cx__row--rev cx__row--ig" data-reveal>
    <div class="cx__phone" role="img" aria-label="Instagram">
      <i class="cx__notch"></i>
      <img src={img('ig')} alt="" loading="lazy" decoding="async" />
    </div>
    <div class="cx__side"><h2 class="h2">{t.social}</h2></div>
  </div>
</section>

<style>
  .cx { --gold: #d6b56e; display: grid; gap: clamp(5rem, 11vw, 11rem); padding-block: clamp(3rem, 6vw, 6rem) clamp(5rem, 10vw, 10rem); }
  .cx figure { margin: 0; }
  .cx img { width: 100%; height: auto; display: block; }
  .cx figcaption { font-size: .8rem; padding-top: .75rem; }
  .cx__txt { margin: 0; color: var(--muted); max-width: 36rem; }
  .cx .h2 { margin-bottom: 1.25rem; }
  .cx__intro { display: grid; gap: 1.5rem; max-width: 62rem; }
  .cx__cols { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(2rem, 6vw, 6rem); }
  .cx__row { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: clamp(3rem, 8vw, 9rem); align-items: center; }
  .cx__row--rev { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); }
  .cx__side { display: grid; gap: 1.25rem; align-content: start; }
  .cx__sketch img, .cx__svg, .cx__photo img, .cx__pack img, .cx__box img { border-radius: 2px; }
  .cx__text { display: grid; gap: 1.25rem; max-width: 46rem; }
  .cx__center { display: grid; justify-items: center; text-align: center; }
  .cx__sketch { display: grid; justify-items: center; }
  .cx__sketch img { width: min(100%, 26rem); }
  .cx__svg--var { width: min(100%, 26rem); }
  .cx__svg--red { width: min(100%, 38rem); }
  /* Trío: foto · isotipo · foto, con el isotipo montado entre las dos */
  .cx__trio { display: flex; align-items: center; justify-content: center; }
  .cx__t { flex: 1 1 0; min-width: 0; }
  .cx__t img { width: 100%; aspect-ratio: 4 / 5; object-fit: cover; border-radius: 2px; }
  .cx__t--c { flex: 0 0 38%; margin-inline: -9%; z-index: 2; }
  .cx__t--c img { aspect-ratio: 1; object-fit: contain; border-radius: 50%; }
  /* Aparición fluida de los SVG: un velo de máscara que barre de izquierda a derecha, con desenfoque y leve escala */
  @property --rv { syntax: '<number>'; inherits: false; initial-value: 0; }
  .cx__rv .cx__svg { --rv: 0; opacity: 0; filter: blur(8px); transform: scale(.96); transform-origin: 50% 50%;
    -webkit-mask-image: linear-gradient(90deg, #000 calc(var(--rv) * 1% - 30%), transparent calc(var(--rv) * 1%)); mask-image: linear-gradient(90deg, #000 calc(var(--rv) * 1% - 30%), transparent calc(var(--rv) * 1%)); }
  .cx__rv.is-in .cx__svg { opacity: 1; filter: blur(0); transform: none; --rv: 130; transition: --rv 2.6s cubic-bezier(.22, .8, .3, 1), opacity 1.2s ease, filter 1.6s ease, transform 2s var(--ease); }
  .cx__rv figcaption { opacity: 0; transition: opacity 1s 1.6s ease; }
  .cx__rv.is-in figcaption { opacity: 1; }
  .cx__pal { list-style: none; margin: 0; padding: 0; display: grid; gap: 1.1rem; justify-self: start; }
  .cx__pal li { display: flex; align-items: center; gap: 1.1rem; }
  .cx__pal span:last-child { display: grid; line-height: 1.35; }
  .cx__pal em { font-style: normal; font-size: .82rem; color: var(--muted); }
  .cx__dot { width: 3.2rem; aspect-ratio: 1; border-radius: 50%; flex: none; box-shadow: 0 0 0 1px var(--line); }
  /* Recursos gráficos sobre el marmolado (el fondo fluido) */
  .cx__res { padding-block: clamp(5rem, 10vw, 10rem); background: linear-gradient(90deg, var(--bg) 18%, color-mix(in srgb, var(--bg) 35%, transparent)), var(--m) center / cover; }
  .cx__row--res { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); }
  .cx__box { width: 100%; filter: drop-shadow(0 30px 50px rgb(0 0 0 / .5)); }
  /* Redes: la captura montada en un celular */
  .cx__phone { position: relative; width: min(100%, 15rem); aspect-ratio: 9 / 18.5; justify-self: center; padding: .55rem; border-radius: 2.4rem; background: #0b0b0a; border: 1px solid color-mix(in srgb, var(--fg) 24%, transparent);
    box-shadow: 0 30px 70px rgb(0 0 0 / .55), inset 0 0 0 2px #1d1d1b; overflow: hidden; }
  .cx__phone img { width: 100%; height: 100%; object-fit: cover; object-position: top; border-radius: 1.9rem; }
  .cx__notch { position: absolute; top: 1rem; left: 50%; width: 28%; height: 1.05rem; margin-left: -14%; border-radius: 999px; background: #0b0b0a; z-index: 2; }
  @media (prefers-reduced-motion: reduce) { .cx__rv .cx__svg { opacity: 1; filter: none; transform: none; -webkit-mask-image: none; mask-image: none; } .cx__rv figcaption { opacity: 1; } }
  @media (max-width: 860px) {
    .cx__row, .cx__row--rev, .cx__row--res, .cx__cols { grid-template-columns: 1fr; }
      .cx__row--ig .cx__phone { order: -1; }
  }
</style>

<script>
  // Dispara la aparición de los SVG al entrar en pantalla
  const wire = () => {
    const els = document.querySelectorAll<HTMLElement>('[data-rv]:not([data-rv-ready])');
    if (!els.length) return;
    const io = new IntersectionObserver((entries) => entries.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('is-in'); io.unobserve(e.target); } }), { threshold: 0.35 });
    els.forEach((el) => { el.dataset.rvReady = '1'; io.observe(el); });
  };
  document.addEventListener('astro:page-load', wire);
</script>
