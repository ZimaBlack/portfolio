---
// Resumen del manual normativo de Conexión CDXX para el portfolio, con el estilo del sitio (sin las tipografías ni los fondos del manual).
// Los logos son los SVG del proyecto; las fotos y el arte del isotipo, recortes del manual en /works/cdxx/manual/
import { withBase, type Lang } from '../lib/i18n';

const { lang } = Astro.props as { lang: Lang };
const es = lang === 'es';
const img = (n: string) => withBase(`/works/cdxx/manual/${n}.webp`);
const seal = withBase('/works/cdxx/mark.svg');
const wordmark = withBase('/works/cdxx/logo.svg');
const marble = withBase('/works/cdxx/bg-1920.webp');

const t = es ? {
  kicker: 'Manual de marca',
  lead: 'Conexión CDXX es una propuesta sensorial que transforma la experiencia del chocolate artesanal, acompañada del maridaje con destilados y elixires selectos.',
  brandA: 'La marca conecta lo tangible con lo etéreo: una travesía para curiosos y conocedores, donde cada degustación abre puertas hacia nuevas realidades sensoriales.',
  tags: ['Lujo', 'Naturaleza', 'Percepción', 'Interconexión'],
  concept: 'Concepto visual',
  conceptA: 'La dualidad fusionada: de lo terrenal a lo cósmico, entre hifas micelares y circuitos tecnológicos. Redes subterráneas y estructuras de silicio comparten un mismo principio, la transmisión de información.',
  conceptB: 'Visualmente, texturas orgánicas se entrelazan con patrones geométricos, en un lenguaje que recuerda a la heráldica simplificada, con un gran giro contemporáneo.',
  barra: 'Barra Gold',
  iso: 'Isotipo',
  isoA: 'Un árbol cuyas raíces se entrelazan con hifas micelares simboliza una red de conexiones profundas, y se extiende en formas abstractas que evocan circuitos neuronales: la conexión entre la percepción sensorial y la conciencia.',
  foil: 'Isotipo en hot stamping dorado',
  reduce: 'Reducciones',
  reduceA: 'Al reducir el logotipo cambian la posición y la escala del iso sobre la tipografía para preservar la legibilidad, hasta que en el límite se usa solo el iso.',
  palette: 'Paleta',
  paletteA: 'Moss, Gold y Black Raisin comunican lujo, naturaleza y organicidad; el Wine Cream aporta la suavidad que equilibra la intensidad del resto.',
  res: 'Recurso visual',
  resA: 'La textura fluida del papel marmolado evoca el chocolate derretido y el veteado de los bombones. Cada patrón es irrepetible, como cada pieza artesanal, y encuentra su paralelo en las conexiones micelares.',
  stickers: 'Sellos adhesivos',
} : {
  kicker: 'Brand guidelines',
  lead: 'Conexión CDXX is a sensory proposal that transforms the experience of artisanal chocolate, paired with select spirits and elixirs.',
  brandA: 'The brand connects the tangible with the ethereal: a journey for the curious and the discerning, where every tasting opens doors to new sensory realities.',
  tags: ['Luxury', 'Nature', 'Perception', 'Interconnection'],
  concept: 'Visual concept',
  conceptA: 'Fused duality: from the earthly to the cosmic, between mycelial hyphae and technological circuits. Underground networks and silicon structures share a single principle, the transmission of information.',
  conceptB: 'Visually, organic textures intertwine with geometric patterns, in a language reminiscent of simplified heraldry, with a strong contemporary twist.',
  barra: 'Gold Bar',
  iso: 'Isotype',
  isoA: 'A tree whose roots intertwine with mycelial hyphae symbolizes a network of deep connections, and extends into abstract forms that evoke neural circuits: the connection between sensory perception and consciousness.',
  foil: 'Isotype in gold hot stamping',
  reduce: 'Reductions',
  reduceA: 'When the logotype is reduced, the position and scale of the icon over the lettering change to preserve legibility, until at the limit only the icon is used.',
  palette: 'Palette',
  paletteA: 'Moss, Gold and Black Raisin convey luxury, nature and organic feel; Wine Cream adds the softness that balances the intensity of the rest.',
  res: 'Visual resource',
  resA: 'The fluid texture of marbled paper evokes melted chocolate and the veining of bonbons. Each pattern is unrepeatable, like each artisanal piece, and finds its parallel in mycelial connections.',
  stickers: 'Adhesive seals',
};

const colors = [
  { n: 'Moss', hex: '#988F5A' }, { n: 'Gold', hex: '#D6B56E' }, { n: 'White Moon', hex: '#ACB4C1' },
  { n: 'Wine Cream', hex: '#142129' }, { n: 'Black Raisin', hex: '#0C1618' },
];
const sizes = ['13rem', '8rem', '4.6rem', '2.6rem'];
---
<section class="cx" aria-label={t.kicker}>
  <div class="wrap cx__head" data-reveal>
    <p class="eyebrow">{t.kicker}</p>
    <p class="cx__lead">{t.lead}</p>
    <p class="cx__txt">{t.brandA}</p>
    <ul class="cx__tags">{t.tags.map((x) => <li>{x}</li>)}</ul>
  </div>

  <figure class="wrap cx__photo" data-reveal>
    <img src={img('barra')} alt={t.barra} loading="lazy" decoding="async" />
    <figcaption class="muted">{t.barra}</figcaption>
  </figure>

  <div class="wrap cx__row" data-reveal>
    <div class="cx__side">
      <h2 class="h2">{t.concept}</h2>
      <p class="cx__txt">{t.conceptA}</p>
      <p class="cx__txt">{t.conceptB}</p>
    </div>
    <figure class="cx__art"><img src={img('isotipo')} alt={t.iso} loading="lazy" decoding="async" /></figure>
  </div>

  <div class="wrap cx__row cx__row--rev" data-reveal>
    <figure class="cx__photo cx__photo--foil">
      <img src={img('foil')} alt={t.foil} loading="lazy" decoding="async" />
      <figcaption class="muted">{t.foil}</figcaption>
    </figure>
    <div class="cx__side">
      <h2 class="h2">{t.iso}</h2>
      <p class="cx__txt">{t.isoA}</p>
    </div>
  </div>

  <div class="wrap cx__reduce" data-reveal>
    <h2 class="h2">{t.reduce}</h2>
    <p class="cx__txt">{t.reduceA}</p>
    <div class="cx__seals">
      {sizes.map((s) => <span class="cx__ring" style={`--s:${s}`}><img src={seal} alt="" decoding="async" /></span>)}
    </div>
    <img class="cx__word" src={wordmark} alt="Conexión CDXX" decoding="async" />
  </div>

  <div class="wrap cx__row" data-reveal>
    <div class="cx__side">
      <h2 class="h2">{t.palette}</h2>
      <p class="cx__txt">{t.paletteA}</p>
    </div>
    <ul class="cx__pal">
      {colors.map((c) => <li><span class="cx__dot" style={`background:${c.hex}`}></span><span><strong>{c.n}</strong><em>{c.hex}</em></span></li>)}
    </ul>
  </div>

  <div class="cx__res" data-reveal style={`--m:url(${marble})`}>
    <div class="wrap cx__side">
      <h2 class="h2">{t.res}</h2>
      <p class="cx__txt">{t.resA}</p>
    </div>
  </div>

  <figure class="wrap cx__photo" data-reveal>
    <img src={img('stickers')} alt={t.stickers} loading="lazy" decoding="async" />
    <figcaption class="muted">{t.stickers}</figcaption>
  </figure>
</section>

<style>
  .cx { --gold: #d6b56e; display: grid; gap: clamp(4rem, 9vw, 9rem); padding-block: clamp(3rem, 6vw, 6rem) clamp(4rem, 8vw, 8rem); }
  .cx figure { margin: 0; }
  .cx img { width: 100%; height: auto; display: block; }
  .cx figcaption { font-size: .8rem; padding-top: .75rem; }
  .cx__head { display: grid; gap: 1.5rem; max-width: 62rem; }
  .cx__lead { margin: 0; font-size: clamp(1.25rem, 2.2vw, 2rem); line-height: 1.35; }
  .cx__txt { margin: 0; color: var(--muted); max-width: 40rem; }
  .cx__tags { display: flex; flex-wrap: wrap; gap: .5rem; list-style: none; margin: .5rem 0 0; padding: 0; }
  .cx__tags li { padding: .35rem 1rem; border: 1px solid color-mix(in srgb, var(--gold) 55%, transparent); border-radius: 999px; font-size: .85rem; color: var(--gold); }
  .cx .h2 { margin-bottom: 1rem; }
  .cx__row { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr); gap: clamp(2rem, 6vw, 7rem); align-items: center; }
  .cx__row--rev { grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); }
  .cx__side { display: grid; gap: 1.25rem; align-content: start; }
  .cx__photo img { border-radius: 2px; }
  /* El arte del isotipo trae su propio fondo: se difumina hacia los bordes para fundirse con la página */
  .cx__art img { max-width: 32rem; margin-inline: auto; -webkit-mask-image: radial-gradient(closest-side, #000 62%, transparent); mask-image: radial-gradient(closest-side, #000 62%, transparent); }
  .cx__reduce { display: grid; gap: 1.25rem; justify-items: center; text-align: center; }
  .cx__reduce .cx__txt { max-width: 38rem; }
  .cx__seals { display: flex; align-items: center; justify-content: center; gap: clamp(1rem, 4vw, 3.5rem); flex-wrap: wrap; margin-top: 1rem; }
  .cx__ring { width: calc(var(--s) * 1.25); aspect-ratio: 1; display: grid; place-items: center; border: 1px solid var(--line); border-radius: 50%; }
  .cx__ring img { width: var(--s); }
  .cx__word { width: min(100%, 26rem) !important; margin-top: 1.5rem; }
  .cx__pal { list-style: none; margin: 0; padding: 0; display: grid; gap: 1rem; }
  .cx__pal li { display: flex; align-items: center; gap: 1.1rem; }
  .cx__pal span:last-child { display: grid; line-height: 1.35; }
  .cx__pal em { font-style: normal; font-size: .82rem; color: var(--muted); }
  .cx__dot { width: 3.2rem; aspect-ratio: 1; border-radius: 50%; flex: none; box-shadow: 0 0 0 1px var(--line); }
  /* Recurso visual: el marmolado de la portada asoma tras el texto */
  .cx__res { padding-block: clamp(4rem, 8vw, 8rem); background: linear-gradient(90deg, var(--bg) 30%, color-mix(in srgb, var(--bg) 40%, transparent)), var(--m) center / cover; }
  @media (max-width: 860px) {
    .cx__row, .cx__row--rev { grid-template-columns: 1fr; }
    .cx__art { order: -1; }
  }
</style>
