  .np__endh, .np__endp, .np__btn { opacity: 0; transform: translateY(14px); transition: opacity .9s var(--ease), transform .9s var(--ease); }
  .np__end.is-in .np__endh { opacity: 1; transform: none; transition-delay: .9s; }
  .np__end.is-in .np__endp { opacity: 1; transform: none; transition-delay: 1.1s; }
  .np__end.is-in .np__btn { opacity: 1; transform: none; transition-delay: 1.5s; }
  .np__btn { display: inline-flex; align-items: center; gap: .6rem; margin-top: .6rem; padding: .95rem 1.6rem; border-radius: 999px; color: #14121f; background: linear-gradient(120deg, var(--ac), var(--sky)); font-weight: 500; box-shadow: 0 10px 40px color-mix(in srgb, var(--sky) 35%, transparent); transition: opacity .9s var(--ease), transform .9s var(--ease), box-shadow .4s; }
  .np__btn svg { width: 1.05rem; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; transition: transform .4s var(--ease); }
  .np__btn:hover { box-shadow: 0 14px 50px color-mix(in srgb, var(--sky) 55%, transparent); } .np__btn:hover svg { transform: translate(2px, -2px); }
  /* Animación de aparición: los elementos [data-rv] entran en escalera al verse (clase is-in desde el script) */
  [data-rv] > li { opacity: 0; transform: translateY(18px); transition: opacity .9s var(--ease) calc(var(--i, 0) * .09s), transform .9s var(--ease) calc(var(--i, 0) * .09s); }
  [data-rv].is-in > li { opacity: 1; transform: none; }
  .np__phones.is-in .np__phone { animation: np-float 7s ease-in-out infinite; animation-delay: calc(var(--i, 0) * -1.3s); }
  .np__phones li:nth-child(even) .np__phone { animation-direction: reverse; }
  @keyframes np-float { 50% { transform: translateY(-7px); } }
  @media (prefers-reduced-motion: reduce) {
    [data-rv] > li { opacity: 1; transform: none; transition: none; }
    .np__flow::before { transform: none; transition: none; } .np__pulse { display: none; } .np__phones .np__phone { animation: none !important; }
    .np__iso, .np__endh, .np__endp, .np__btn { opacity: 1; transform: none; filter: none; transition: none; animation: none !important; } .np__iso i { display: none; }
  }
  @media (max-width: 860px) {
    .np__feat { grid-template-columns: 1fr 1fr; }
    .np__phones { grid-template-columns: 1fr 1fr; }
    .np__flow { grid-template-columns: 1fr; gap: 1.5rem; } .np__flow::before, .np__pulse { display: none; }
    .np__data, .np__models { grid-template-columns: 1fr 1fr; }
    .np__bgrid { grid-template-columns: 1fr 1fr; } .np__adapt, .np__pal { grid-template-columns: 1fr; }
  }
  @media (max-width: 520px) { .np__feat, .np__phones, .np__data, .np__models, .np__bgrid { grid-template-columns: 1fr; } }
</style>

<script>
  // Escalera de aparición, y cuentas que suben al mostrarse
  const wire = () => {
    const io = new IntersectionObserver((es) => es.forEach((e) => {
      if (!e.isIntersecting) return;
      const el = e.target as HTMLElement; el.classList.add('is-in'); io.unobserve(el);
      el.querySelectorAll<HTMLElement>('[data-to]').forEach((n) => {
        const to = Number(n.dataset.to); if (!to || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        const t0 = performance.now(); const dur = 1400;
        const tick = (now: number) => { const k = Math.min(1, (now - t0) / dur); n.textContent = String(Math.round(to * (1 - Math.pow(1 - k, 3)))); if (k < 1) requestAnimationFrame(tick); };
        requestAnimationFrame(tick);
      });
    }), { threshold: 0.1, rootMargin: '0px 0px -8% 0px' });
    document.querySelectorAll<HTMLElement>('[data-adapt]:not([data-ready])').forEach((ad) => {
      ad.dataset.ready = '1';
      ad.querySelectorAll<HTMLButtonElement>('.np__combo').forEach((b) => b.addEventListener('click', () => {
        ad.style.setProperty('--pa', b.dataset.a!); ad.style.setProperty('--pb', b.dataset.b!);
        ad.querySelectorAll('.np__combo').forEach((x) => x.classList.toggle('is-on', x === b));
      }));
    });
    document.querySelectorAll<HTMLElement>('[data-rv]:not([data-rv-ready]), .np__nums:not([data-rv-ready]), [data-end]:not([data-rv-ready])').forEach((el) => { el.dataset.rvReady = '1'; io.observe(el); });
  };
  document.addEventListener('astro:page-load', wire);
</script>
