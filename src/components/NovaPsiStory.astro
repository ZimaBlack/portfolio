  .np__mock { display: grid; gap: .9rem; padding: 1.2rem; border-radius: 14px; background: #f6f1ea; box-shadow: 0 24px 50px rgb(0 0 0 / .4); }
  .np__mbar { display: flex; justify-content: space-between; align-items: center; }
