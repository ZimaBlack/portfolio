---
// NovaPsi: qué es, funcionalidades, los tres accesos con capturas explicadas y cómo se conecta.
// Capturas del sistema local en modo de demostración (Tour del Servicio): datos de ejemplo, ninguna persona ni cuenta real.
// Paciente: celular (390 px a 3x). Paneles: 1100 px a 2x, a ancho completo para que el texto se lea.
import '@fontsource/germania-one/latin-400.css';
import { withBase, type Lang } from '../lib/i18n';
import { site } from '../data/site';
const { lang } = Astro.props as { lang: Lang };
const es = lang === 'es';
import boxes from '../data/novapsi-boxes.json';
// Las capturas existen en los dos idiomas (la interfaz del sistema es en español: las de inglés son la misma pantalla con los textos traducidos)
const shot = (n: string) => withBase(`/works/novapsi/shots/${n}${lang === 'en' ? '-en' : ''}.webp`);
// Zona clave de cada captura (la que marca el Tour del sistema), en fracción de la imagen
const hl = (n: string) => { const b = (boxes as Record<string, number[]>)[n]; if (!b) return ''; const x = Math.max(0, b[0]), y = Math.max(0, b[1]); const w = Math.min(1 - x, b[2]), h = Math.min(1 - y, b[3]); return `left:calc(${(x * 100).toFixed(2)}% - var(--gap));top:calc(${(y * 100).toFixed(2)}% - var(--gap));width:calc(${(w * 100).toFixed(2)}% + var(--gap) * 2);height:calc(${(h * 100).toFixed(2)}% + var(--gap) * 2)`; };
const mk = (n: string) => withBase(`/works/novapsi/marca/${n}.svg`);
const brand = (n: string) => withBase(`/works/novapsi/brands/${n}.svg`);

const I: Record<string, string> = {
  calendar: '<rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/><path d="m9 16 2 2 4-4"/>',
  clock: '<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>',
  card: '<rect x="2" y="5" width="20" height="14" rx="2"/><path d="M2 10h20"/>',
  swap: '<path d="M3 12a9 9 0 0 1 15-6.7L21 8"/><path d="M21 3v5h-5"/><path d="M21 12a9 9 0 0 1-15 6.7L3 16"/><path d="M3 21v-5h5"/>',
  bell: '<path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9"/><path d="M10.3 21a1.94 1.94 0 0 0 3.4 0"/>',
  undo: '<path d="M9 14 4 9l5-5"/><path d="M4 9h10a6 6 0 0 1 0 12h-3"/>',
  users: '<circle cx="9" cy="8" r="3.5"/><path d="M2 21a7 7 0 0 1 14 0"/><path d="M16 4.5a3.5 3.5 0 0 1 0 7M22 21a7 7 0 0 0-4-6.3"/>',
  file: '<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6M8 13h8M8 17h5"/>',
  ban: '<circle cx="12" cy="12" r="9"/><path d="m5.6 5.6 12.8 12.8"/>',
  palette: '<circle cx="13.5" cy="6.5" r="1"/><circle cx="17.5" cy="10.5" r="1"/><circle cx="8.5" cy="7.5" r="1"/><circle cx="6.5" cy="12.5" r="1"/><path d="M12 22a10 10 0 1 1 10-10c0 3-2 4-4 4h-2a2 2 0 0 0-1.5 3.3A2 2 0 0 1 12 22z"/>',
  shield: '<path d="M12 3 4 6v6c0 5 3.5 8 8 9 4.5-1 8-4 8-9V6z"/><path d="m9 12 2 2 4-4"/>',
  layers: '<path d="m12 2 10 5-10 5L2 7z"/><path d="m2 12 10 5 10-5M2 17l10 5 10-5"/>',
  phone: '<rect x="7" y="2" width="10" height="20" rx="2"/><path d="M11 18h2"/>',
  user: '<circle cx="12" cy="8" r="4"/><path d="M4 21a8 8 0 0 1 16 0"/>',
  userCheck: '<circle cx="9" cy="8" r="4"/><path d="M2 21a7 7 0 0 1 14 0"/><path d="m16 11 2 2 4-4"/>',
  pulse: '<path d="M22 12h-4l-3 9L9 3l-3 9H2"/>',
  database: '<ellipse cx="12" cy="5" rx="8" ry="3"/><path d="M4 5v14c0 1.7 3.6 3 8 3s8-1.3 8-3V5M4 12c0 1.7 3.6 3 8 3s8-1.3 8-3"/>',
};
const ic = (k: string) => `<svg viewBox="0 0 24 24" aria-hidden="true">${I[k]}</svg>`;

const t = es ? {
  what: 'Qué es',
  whatA: 'Un sistema de turnos para consultorios de salud mental: el paciente reserva y paga una seña, el profesional atiende y el servicio técnico mantiene todo conectado.',
  nums: [[3, 'accesos'], [4, 'modelos'], [125, 'commits'], [11, 'pasos auditados']],
  recep: 'La recepción',
  recepA: 'Lo primero que ve el paciente: elige el tipo de sesión deslizando, y ve duración, valor y seña antes de reservar.',
  feat: 'Qué hace',
  features: [
    ['calendar', 'Reserva en pasos', 'Servicio, fecha, motivo y datos, pensado primero para el celular.'],
    ['clock', 'Disponibilidad real', 'Solo se ofrecen horarios libres, calculados en el servidor.'],
    ['card', 'Seña online', 'Cobro con Mercado Pago, con la comisión incluida en un solo importe.'],
    ['undo', 'Devolución automática', 'La seña vuelve sola si se cancela a tiempo, con respaldo de cada paso.'],
    ['swap', 'Autogestión', 'El paciente cambia o cancela su turno desde un link, dentro del plazo.'],
    ['bell', 'Avisos y recordatorios', 'Confirmaciones y recordatorio 24 h antes, por correo o n8n.'],
    ['userCheck', 'Agenda y asistencia', 'El día del profesional, con turnos atendidos y ausentes.'],
    ['file', 'Fichas y notas', 'Datos de contacto y notas privadas que solo lee el profesional.'],
    ['ban', 'Bloqueo por inasistencia', 'Si falta con seña pagada, no reserva más hasta abonar el saldo.'],
    ['palette', 'Marca propia', 'Dos colores y el sitio entero se adapta, en modo claro y oscuro.'],
    ['pulse', 'Estado de conexiones', 'Se ve en vivo si la base, los cobros y el correo funcionan.'],
    ['shield', 'Legales con versión', 'Cada turno guarda qué versión de los términos aceptó el paciente.'],
  ],
  patient: 'Paciente',
  screens: 'Panel de administración', prev: 'Pantalla anterior', next: 'Pantalla siguiente', goTo: 'Ir a', region: 'Carrusel de pantallas por sección',
  mailH: 'El mail que llega al confirmar',
  mailA: 'Apenas se acredita el pago, el paciente recibe el resumen de su turno y un botón para verlo o cambiarlo. Los textos los edita el profesional desde Notificaciones.',
  mail: { from: 'Lic. Ana Torres', to: 'para Sofía', subject: 'Pago recibido: tu turno está confirmado', biz: 'Lic. Ana Torres · Psicología clínica', title: 'Recibimos tu pago', intro: 'Hola Sofía, tu turno quedó confirmado.', rows: [['Cuándo', 'viernes, 30 de octubre, 09:00 hs'], ['Servicio', 'Primera sesión'], ['Profesional', 'Lic. Ana Torres']], btn: 'Ver o cambiar mi turno', foot: 'Podés cancelar o cambiar tu turno hasta 24 horas antes.' },
  patientA: 'Reserva desde el celular en pocos pasos y gestiona sus turnos desde un link. Datos de ejemplo.',
  ps: [['Servicio', 'Primera sesión, recurrente o evaluación, cada una con duración, valor y seña.'], ['Fecha', 'Solo se ven los días que atiende el profesional.'], ['Horario', 'Todos los horarios que aparecen están libres; elegir uno habilita continuar.'], ['Tu motivo', 'Solo en la primera sesión con ese profesional: pide una breve reseña de por qué consulta, que le llega por mail y queda en la ficha. Quien ya se atendió no ve este paso.'], ['Confirmar', 'Resume el turno y la seña: se paga online y llega un mail y un recordatorio.'], ['Pago', 'La seña se abona en Mercado Pago, sin salir del flujo; al acreditarse, el turno queda confirmado.']],
  pro: 'Profesional',
  proA: 'Su día, sus pacientes y su marca en un panel que se usa igual en el celular.',
  pcap: [['pro-inicio', 'Inicio', 'Lo de hoy, lo que necesita atención (como un paciente bloqueado por saldo pendiente) y accesos rápidos.'], ['pro-agenda', 'Agenda', 'Los puntos del calendario marcan turnos por atender, atendidos y ausentes; cada turno permite marcar asistencia.'], ['pro-servicios', 'Servicios', 'Precio, duración y seña de cada servicio, y qué pasa cuando un paciente con seña no viene.'], ['pro-horarios', 'Horarios', 'La semana de atención, con atajos y franjas partidas, y las reglas de reserva.'], ['pro-reglas', 'El profesional decide cómo se reserva', 'Si apaga “Los pacientes reservan solos”, las visitas las agenda el profesional y el paciente solo gestiona su primera sesión o las que quedan fuera de agenda. También se puede pedir, o no, el motivo en la primera reserva.'], ['pro-pacientes', 'Pacientes', 'Listado con búsqueda y filtros; cada ficha trae contacto y notas privadas.'], ['pro-marca', 'Marca', 'Dos colores a elegir, o una combinación hecha: el sitio y sus efectos se adaptan solos.']],
  tech: 'Servicio técnico',
  techA: 'Ve de un vistazo si cada conexión funciona y lo deja andando sin tocar el código.',
  tcap: 'Conexiones: base de datos, cobros, correo e ingreso con Google, comprobados en vivo.',
  links: 'Cómo se conecta',
  net: { pac: ['Paciente', 'reserva desde el celular'], app: ['NovaPsi', 'registra turno y seña'], mp: ['Mercado Pago', 'cobra la seña'], gm: ['Gmail', 'confirma y recuerda'], pro: ['Profesional', 'atiende'], n8n: ['n8n', 'automatiza los avisos'], wa: ['WhatsApp', 'aviso por chat'], push: ['Notificaciones push', 'avisos en el dispositivo'] }, dev: 'En desarrollo', toastPat: 'Turno confirmado · vie 10:00', toastPro: 'Nuevo turno',
  data: 'Dónde se guardan los datos',
  dataA: [['sqlite', 'SQLite', 'Por defecto: un archivo en el propio servidor, con copias diarias.'], ['airtable', 'Airtable', 'Opcional: como base de datos para quien ya lo usa.']],
  models: 'Cuatro modelos, un código',
  modelsA: [['users', 'Clínica', 'Equipo y administración, una cuenta de cobro.'], ['card', 'Clínica multi-cobro', 'Cada profesional conecta su propio Mercado Pago.'], ['user', 'Profesional', 'Una persona atiende y administra.'], ['database', 'Profesional + Airtable', 'Igual, con Airtable como base.']],
  brand: 'Marca',
  brandA: 'El logotipo está compuesto en Germania One, una tipografía display de trazo gótico, y se acompaña de un isotipo —la Ψ dentro de un cuadrado redondeado— que funciona en claro y en oscuro.',
  bType: 'Tipografía del logotipo', bTypeA: 'Germania One', bTypeMeta: [['Categoría', 'Display'], ['Diseño', 'John Vargas Beltrán'], ['Pesos', 'Uno: Regular 400'], ['En Google Fonts', 'Desde enero de 2012'], ['Licencia', 'Código abierto']], bGlyph: 'Aa Bb Cc Dd Ee Ff Gg Hh Ii Jj 0123456789',
  bLogo: 'Logotipo', bLogoA: 'Versión sobre claro y sobre oscuro.',
  bIso: 'Isotipo', bIsoA: 'También es el ícono de la pestaña y de la app.',
  bPal: 'Paleta', bPalA: 'Tres neutros del sistema: el negro tinta, el gris pálido y una pervinca apagada.',
  bAdapt: 'Se adapta a cada consultorio', bAdaptA: 'El profesional elige dos colores —o una combinación lista— y el sitio completo los usa. Probalo:',
  cta: 'Mirá cómo funciona', ctaA: 'La demostración en línea, con datos de ejemplo.', ctaBtn: 'Abrir la demo',
  want: '¿Necesitás algo como esto?', wantA: 'Un sistema de turnos, una marca o un producto a medida: contame qué tenés en mente.', wantBtn: 'Quiero un producto similar', wantMsg: 'Hola Pablo, vi NovaPsi en tu portfolio y quiero un producto similar.',
} : {
  what: 'What it is',
  whatA: 'An appointment system for mental-health practices: patients book and pay a deposit, the professional sees patients and technical support keeps everything connected.',
  nums: [[3, 'accesses'], [4, 'models'], [125, 'commits'], [11, 'audited steps']],
  recep: 'The welcome screen',
  recepA: 'The first thing patients see: they slide to pick the session type and see duration, price and deposit before booking.',
  feat: 'What it does',
  features: [
    ['calendar', 'Step-by-step booking', 'Service, date, reason and details, designed mobile-first.'],
    ['clock', 'Real availability', 'Only free slots are offered, computed on the server.'],
    ['card', 'Online deposit', 'Paid with Mercado Pago, with the fee included in a single amount.'],
    ['undo', 'Automatic refund', 'The deposit comes back on its own if canceled in time, with a record of each step.'],
    ['swap', 'Self-service', 'Patients change or cancel from a link, within the allowed window.'],
    ['bell', 'Notices and reminders', 'Confirmations and a 24-hour reminder, by email or n8n.'],
    ['userCheck', 'Agenda and attendance', 'The professional’s day, with attended and no-show appointments.'],
    ['file', 'Records and notes', 'Contact details and private notes that only the professional reads.'],
    ['ban', 'No-show blocking', 'If they miss with a paid deposit, no new bookings until the balance is paid.'],
    ['palette', 'Own branding', 'Two colors and the whole site adapts, in light and dark mode.'],
    ['pulse', 'Connection status', 'Shows live whether database, payments and email work.'],
    ['shield', 'Versioned legal terms', 'Each appointment records which version of the terms the patient accepted.'],
  ],
  patient: 'Patient',
  screens: 'Administration panels', prev: 'Previous screen', next: 'Next screen', goTo: 'Go to', region: 'Screens carousel by section',
  mailH: 'The email that arrives on confirmation',
  mailA: 'As soon as the payment is credited, the patient receives a summary of the appointment and a button to view or change it. The professional edits the texts from Notifications.',
  mail: { from: 'Lic. Ana Torres', to: 'to Sofía', subject: 'Payment received: your appointment is confirmed', biz: 'Lic. Ana Torres · Clinical psychology', title: 'We received your payment', intro: 'Hi Sofía, your appointment is confirmed.', rows: [['When', 'Friday, October 30, 09:00'], ['Service', 'First session'], ['Professional', 'Lic. Ana Torres']], btn: 'View or change my appointment', foot: 'You can cancel or change your appointment up to 24 hours before.' },
  patientA: 'Books from the phone in a few steps and manages appointments from a link. Sample data.',
  ps: [['Service', 'First session, recurring or evaluation, each with duration, price and deposit.'], ['Date', 'Only the days the professional works are shown.'], ['Time slot', 'Every slot shown is free; choosing one enables continuing.'], ['Your reason', 'Only on the first session with that professional: it asks for a short note on why they consult, which reaches them by email and stays in the patient file. Returning patients don’t see this step.'], ['Confirm', 'Summarizes the appointment and deposit: paid online, followed by an email and a reminder.'], ['Payment', 'The deposit is paid on Mercado Pago, without leaving the flow; once credited, the appointment is confirmed.']],
  pro: 'Professional',
  proA: 'Their day, patients and brand in one panel that works the same on a phone.',
  pcap: [['pro-inicio', 'Home', 'Today, what needs attention (such as a patient blocked by an outstanding balance) and quick links.'], ['pro-agenda', 'Agenda', 'Calendar dots mark appointments to attend, attended and no-shows; each appointment can be marked.'], ['pro-servicios', 'Services', 'Price, duration and deposit for each service, and what happens when a patient with a deposit doesn’t show.'], ['pro-horarios', 'Hours', 'The weekly schedule, with shortcuts and split shifts, and the booking rules.'], ['pro-reglas', 'The professional decides how booking works', 'If “Patients book on their own” is turned off, the professional schedules the visits and the patient only manages their first session or sessions outside the agenda. The reason on the first booking can also be required or not.'], ['pro-pacientes', 'Patients', 'A list with search and filters; each record holds contact details and private notes.'], ['pro-marca', 'Brand', 'Pick two colors or a ready combination: the site and its effects adapt on their own.']],
  tech: 'Technical support',
  techA: 'Sees at a glance whether each connection works and keeps it running without touching code.',
  tcap: 'Connections: database, payments, email and Google sign-in, checked live.',
  links: 'How it connects',
  net: { pac: ['Patient', 'books from the phone'], app: ['NovaPsi', 'records appointment and deposit'], mp: ['Mercado Pago', 'charges the deposit'], gm: ['Gmail', 'confirms and reminds'], pro: ['Professional', 'sees the patient'], n8n: ['n8n', 'automates the notices'], wa: ['WhatsApp', 'chat notice'], push: ['Push notifications', 'notices on the device'] }, dev: 'In development', toastPat: 'Appointment confirmed · Fri 10:00', toastPro: 'New appointment',
  data: 'Where the data lives',
  dataA: [['sqlite', 'SQLite', 'By default: a file on the server itself, with daily copies.'], ['airtable', 'Airtable', 'Optional: as the database for those who already use it.']],
  models: 'Four models, one codebase',
  modelsA: [['users', 'Clinic', 'Team and administration, one payment account.'], ['card', 'Multi-payment clinic', 'Each professional connects their own Mercado Pago.'], ['user', 'Solo practitioner', 'One person sees patients and administers.'], ['database', 'Solo + Airtable', 'The same, with Airtable as the database.']],
  brand: 'Brand',
  brandA: 'The logotype is set in Germania One, a blackletter-style display typeface, accompanied by an isotype —the Ψ inside a rounded square— that works in light and dark.',
  bType: 'Logotype typeface', bTypeA: 'Germania One', bTypeMeta: [['Category', 'Display'], ['Designer', 'John Vargas Beltrán'], ['Weights', 'One: Regular 400'], ['On Google Fonts', 'Since January 2012'], ['License', 'Open source']], bGlyph: 'Aa Bb Cc Dd Ee Ff Gg Hh Ii Jj 0123456789',
  bLogo: 'Logotype', bLogoA: 'On light and on dark.',
  bIso: 'Isotype', bIsoA: 'Also the tab and app icon.',
  bPal: 'Palette', bPalA: 'Three neutrals of the system: ink black, pale gray and a muted periwinkle.',
  bAdapt: 'Adapts to each practice', bAdaptA: 'The professional picks two colors —or a ready combination— and the whole site uses them. Try it:',
  cta: 'See how it works', ctaA: 'The online demo, with sample data.', ctaBtn: 'Open the demo',
  want: 'Need something like this?', wantA: 'An appointment system, a brand or a custom product: tell me what you have in mind.', wantBtn: 'I want a similar product', wantMsg: 'Hi Pablo, I saw NovaPsi in your portfolio and I want a similar product.',
};
const combos = [['Grafito y celeste', '#334155', '#38bdf8'], ['Violeta y verde agua', '#6d28d9', '#0d9488'], ['Azul y coral', '#2563eb', '#f97316'], ['Verde salvia y arena', '#4d7c5f', '#c8a96a'], ['Índigo y rosa', '#4338ca', '#db2777'], ['Petróleo y durazno', '#0f766e', '#f59e0b']];
const demo = 'https://psi-turnos-app.netlify.app/';
const waHref = `https://wa.me/${site.whatsapp}?text=${encodeURIComponent(t.wantMsg)}`;
type Node = { id: string; r: number; c: number; kind: 'icon' | 'img' | 'logo'; ref: string; color: string; up?: boolean; dev?: boolean };
const nodes: Node[] = [
  { id: 'pac', r: 1, c: 1, kind: 'icon', ref: 'user', color: '#e9e3d6' },
  { id: 'app', r: 1, c: 2, kind: 'img', ref: mk('favicon-light'), color: '#a9aedb' },
  { id: 'mp', r: 1, c: 3, kind: 'logo', ref: brand('mercadopago'), color: '#2fb5f0' },
  { id: 'gm', r: 1, c: 4, kind: 'logo', ref: brand('gmail'), color: '#ea4335' },
  { id: 'n8n', r: 2, c: 4, kind: 'logo', ref: brand('n8n'), color: '#ea4b71', up: true },
  { id: 'wa', r: 3, c: 4, kind: 'logo', ref: brand('whatsapp'), color: '#25d366', up: true, dev: true },
  { id: 'pro', r: 1, c: 5, kind: 'icon', ref: 'userCheck', color: '#e9e3d6' },
  { id: 'push', r: 2, c: 5, kind: 'icon', ref: 'bell', color: '#38bdf8', up: true, dev: true },
];
const phoneShots = ['m2', 'm3', 'm4', 'm4b', 'm5', ''];
// Carrusel: solo las capturas de administración (panel del profesional y servicio técnico), con la sección de cada una
type Slide = { sec: 'pro' | 'tech'; kind: 'wide'; key: string; h: string; p: string };
const slides: Slide[] = [
  ...t.pcap.map(([k, h, p]): Slide => ({ sec: 'pro', kind: 'wide', key: k, h, p })),
  { sec: 'tech', kind: 'wide', key: 'tecnico', h: t.tech, p: t.tcap },
];
const tags = [
  { id: 'pro', n: '02', label: t.pro, desc: t.proA },
  { id: 'tech', n: '03', label: t.tech, desc: t.techA },
].map((g) => ({ ...g, first: slides.findIndex((x) => x.sec === g.id), count: slides.filter((x) => x.sec === g.id).length }));
const brandIcon = (k: string) => k === 'mp' ? brand('mercadopago') : k === 'mail' ? brand('n8n') : '';
---
<section class="np" aria-label={es ? 'Recorrido' : 'Walkthrough'} data-np>
  <div class="wrap np__sec" data-reveal>
    <h2 class="h2">{t.what}</h2>
    <p class="np__txt">{t.whatA}</p>
    <ul class="np__nums">{t.nums.map(([n, l]) => <li><strong data-to={n}>{n}</strong><span>{l}</span></li>)}</ul>
  </div>

  <div class="wrap np__recep" data-reveal>
    <div class="np__rtxt"><span class="np__n">00</span><h2 class="h2">{t.recep}</h2><p class="np__txt">{t.recepA}</p></div>
    <div class="np__stage" data-stage>
      <i class="np__halo" aria-hidden="true"></i><i class="np__halo" aria-hidden="true"></i><i class="np__halo" aria-hidden="true"></i>
      <div class="np__dev">
        <div class="np__scr">
          <div class="np__boot"><i></i><i></i><img src={mk('favicon-light')} alt="" /></div>
          <div class="np__shotimg"><img src={shot('m1')} alt={t.recep} loading="lazy" decoding="async" /><i class="np__hl" style={hl('m1')} aria-hidden="true"></i></div>
        </div>
        <span class="np__notch"></span>
      </div>
      <span class="np__floor"></span>
    </div>
  </div>

  <div class="wrap np__sec" data-reveal>
    <h2 class="h2">{t.feat}</h2>
    <ul class="np__feat" data-rv>
      {t.features.map(([k, h, p], i) => <li style={`--i:${i}`}><span class="np__ico" set:html={ic(k)} /><div><strong>{h}</strong><span>{p}</span></div></li>)}
    </ul>
  </div>

  <!-- 01 Paciente (celular) -->
  <div class="wrap np__sec" data-reveal>
    <div class="np__head"><span class="np__n">01</span><h2 class="h2">{t.patient}</h2></div>
    <p class="np__txt">{t.patientA}</p>
    <ol class="np__phones" data-rv>
      {t.ps.map(([h, p], i) => (
        <li style={`--i:${i}`}>
          {phoneShots[i] ? (
            <div class="np__phone"><div class="np__hlwrap"><img src={shot(phoneShots[i])} alt={h} loading="lazy" decoding="async" /><i class="np__hl" style={hl(phoneShots[i])} aria-hidden="true"></i></div></div>
          ) : (
            <div class="np__phone"><div class="np__mp" role="img" aria-label="Mercado Pago"><i style={`--m:url(${brand('mercadopago')})`}></i></div></div>
          )}
          <div class="np__cap"><b>{i + 1}</b><div><strong>{h}</strong><span>{p}</span></div></div>
        </li>
      ))}
    </ol>
  </div>

  <!-- Mail de confirmación -->
  <div class="wrap np__sec" data-reveal>
    <h2 class="h2">{t.mailH}</h2>
    <p class="np__txt">{t.mailA}</p>
    <div class="np__mailwrap" data-rv>
      <div class="np__mail">
        <div class="np__mailbar"><span class="np__mailav">{t.mail.from.slice(5, 6)}</span><div><b>{t.mail.from}</b><small>{t.mail.to}</small></div></div>
        <div class="np__mailsub">{t.mail.subject}</div>
        <div class="np__mailbody">
          <div class="np__mailcard">
            <i class="np__mailtop"></i>
            <div class="np__mailin">
              <p class="np__mailbiz">{t.mail.biz}</p>
              <h3>{t.mail.title}</h3>
              <p class="np__mailp">{t.mail.intro}</p>
              <dl>{t.mail.rows.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}</dl>
              <span class="np__mailbtn">{t.mail.btn}</span>
            </div>
          </div>
          <p class="np__mailfoot">{t.mail.foot}</p>
        </div>
      </div>
    </div>
  </div>

  <!-- Pantallas: un carrusel con las capturas de los tres accesos y etiquetas navegables por sección -->
  <div class="wrap np__sec np__car" data-reveal data-npcar>
    <h2 class="h2">{t.screens}</h2>
    <div class="np__tags" role="tablist" aria-label={t.region}>
      {tags.map((g, k) => (
        <button type="button" class="np__tag" role="tab" data-tag={g.id} data-first={g.first} data-desc={g.desc} aria-selected={k === 0 ? 'true' : 'false'}><span>{g.n}</span>{g.label}<small>{g.count}</small></button>
      ))}
    </div>
    <p class="np__txt np__cdesc" data-cdesc aria-live="polite">{tags[0].desc}</p>
    <div class="np__cwrap">
      <button type="button" class="np__arrow np__arrow--prev" data-prev aria-label={t.prev}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5l-7 7 7 7" /></svg></button>
      <div class="np__track" data-track tabindex="0" role="region" aria-roledescription="carousel" aria-label={t.region}>
        {slides.map((x, i) => (
          <article class:list={['np__slide', `np__slide--${x.kind}`]} data-sec={x.sec} data-i={i} aria-label={`${i + 1} / ${slides.length}`}>
            <figure class="np__shot"><div class="np__scroll"><div class="np__hlwrap"><img src={shot(x.key)} alt={x.h} loading="lazy" decoding="async" /><i class="np__hl" style={hl(x.key)} aria-hidden="true"></i></div></div><figcaption><strong>{x.h}</strong><span>{x.p}</span></figcaption></figure>
          </article>
        ))}
      </div>
      <button type="button" class="np__arrow np__arrow--next" data-next aria-label={t.next}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5l7 7-7 7" /></svg></button>
    </div>
    <ol class="np__dots" aria-label={t.region}>
      {slides.map((x, i) => <li><button type="button" class="np__dot" data-dot={i} data-sec={x.sec} aria-label={`${t.goTo} ${i + 1}: ${x.h}`} aria-current={i === 0 ? 'true' : undefined}></button></li>)}
    </ol>
  </div>

  <!-- Conexiones -->
  <div class="wrap np__sec" data-reveal>
    <h2 class="h2">{t.links}</h2>
    <ol class="np__net" data-rv>
      {nodes.map((n, i) => (
        <li class:list={['np__nd', `np__nd--${n.id}`, { 'np__nd--up': n.up, 'np__nd--dev': n.dev }]} style={`--i:${i};--g:${n.color};grid-row:${n.r};grid-column:${n.c}`}>
          <span class="np__sq">
            {(n.id === 'pac' || n.id === 'pro') && <i class={`np__ping np__ping--${n.id}`}></i>}
            {n.kind === 'logo' && <span class="np__logo" style={`--m:url(${n.ref});--c:${n.color}`}></span>}
            {n.kind === 'img' && <img src={n.ref} alt="" />}
            {n.kind === 'icon' && <span class="np__ico np__ico--bare" style={`color:${n.color}`} set:html={ic(n.ref)} />}
          </span>
          {n.id === 'pac' && <span class="np__toast np__toast--pat" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9M10.3 21a1.94 1.94 0 0 0 3.4 0"/></svg>{t.toastPat}</span>}
          {n.id === 'pro' && <span class="np__toast np__toast--pro" aria-hidden="true">{t.toastPro}</span>}
          <strong>{t.net[n.id][0]}</strong>
          <span class="np__sub2">{t.net[n.id][1]}</span>
          {n.dev && <em class="np__tag">{t.dev}</em>}
        </li>
      ))}
      <i class="np__pulse" aria-hidden="true"></i>
    </ol>
    <h3 class="np__sub">{t.data}</h3>
    <ul class="np__data" data-rv>
      {t.dataA.map(([k, a, b], i) => <li style={`--i:${i}`}><span class="np__logo np__logo--lg" style={`--m:url(${brand(k)});--c:${k === 'airtable' ? '#fcb400' : '#6fb2e0'}`}></span><div><strong>{a}</strong><span>{b}</span></div></li>)}
    </ul>
  </div>

  <div class="wrap np__sec" data-reveal>
    <h2 class="h2">{t.models}</h2>
    <ul class="np__models" data-rv>{t.modelsA.map(([k, n, d], i) => <li style={`--i:${i}`}><span class="np__ico" set:html={ic(k)} /><strong>{n}</strong><span>{d}</span></li>)}</ul>
  </div>

  <!-- Marca -->
  <div class="wrap np__sec np__brand" data-reveal>
    <h2 class="h2">{t.brand}</h2>
    <p class="np__txt">{t.brandA}</p>
    <div class="np__bgrid" data-rv>
      <figure class="np__tile np__tile--light" style="--i:0"><img src={mk('logo-black')} alt="NovaPsi" loading="lazy" /><figcaption>{t.bLogo} · <span>{t.bLogoA}</span></figcaption></figure>
      <figure class="np__tile np__tile--dark" style="--i:1"><img src={mk('logo-white')} alt="NovaPsi" loading="lazy" /><figcaption>{t.bLogo} · <span>{t.bLogoA}</span></figcaption></figure>
      <figure class="np__tile np__tile--dark np__tile--iso" style="--i:2"><img src={mk('favicon-light')} alt="Isotipo" loading="lazy" /><figcaption>{t.bIso} · <span>{t.bIsoA}</span></figcaption></figure>
      <figure class="np__tile np__tile--light np__tile--iso" style="--i:3"><img src={mk('favicon-dark')} alt="Isotipo" loading="lazy" /><figcaption>{t.bIso} · <span>{t.bIsoA}</span></figcaption></figure>
    </div>
    <div class="np__type">
      <div class="np__spec" aria-hidden="true"><span>NovaPsi</span><small>{t.bGlyph}</small></div>
      <div class="np__tmeta"><h3 class="np__sub">{t.bType}</h3><strong>{t.bTypeA}</strong>
        <dl>{t.bTypeMeta.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}</dl></div>
    </div>
    <div class="np__pal">
      <div><h3 class="np__sub">{t.bPal}</h3><p class="np__txt">{t.bPalA}</p></div>
      <ul><li><i style="background:#0f0f0f"></i>#0F0F0F</li><li><i style="background:#c9c9c9"></i>#C9C9C9</li><li><i style="background:#666b8b"></i>#666B8B</li></ul>
    </div>
    <div class="np__adapt" data-adapt style="--pa:#334155;--pb:#38bdf8">
      <div class="np__adtxt"><h3 class="np__sub">{t.bAdapt}</h3><p class="np__txt">{t.bAdaptA}</p>
        <div class="np__combos">{combos.map(([n, a, b], i) => <button type="button" class:list={['np__combo', { 'is-on': i === 0 }]} data-a={a} data-b={b} aria-label={n} title={n}><i style={`background:${a}`}></i><i style={`background:${b}`}></i></button>)}</div>
      </div>
      <div class="np__mock" aria-hidden="true">
        <div class="np__mbar"><span class="np__mlogo"></span><span class="np__mdot"></span></div>
        <div class="np__mrow"><b></b><b></b><b></b></div>
        <div class="np__mbtn">{es ? 'Reservar turno' : 'Book appointment'}</div>
        <div class="np__mtag">{es ? 'Confirmado' : 'Confirmed'}</div>
      </div>
    </div>
  </div>

  <!-- Cierre: el isotipo y la demo -->
  <div class="wrap np__end" data-end>
    <div class="np__iso" aria-hidden="true"><i></i><i></i><i></i><img src={mk('favicon-light')} alt="" /></div>
    <h2 class="h2 np__endh">{t.cta}</h2>
    <p class="np__txt np__endp">{t.ctaA}</p>
    <a class="np__btn" href={demo} target="_blank" rel="noopener noreferrer">{t.ctaBtn} <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 7h10v10M7 17 17 7"/></svg></a>
  </div>

  <!-- ¿Querés algo así? -->
  <div class="wrap np__want" data-reveal>
    <div class="np__wantbox">
      <div><h2 class="h2">{t.want}</h2><p class="np__txt">{t.wantA}</p></div>
      <a class="np__big" href={waHref} target="_blank" rel="noopener noreferrer"><span>{t.wantBtn}</span><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
    </div>
  </div>
</section>

<style>
  /* Armonía: una paleta de cuatro tonos sacada del isotipo y de la marca del sistema — ciruela-azulado (base), pervinca (acento), cielo (flujo) y crema (texto cálido) */
  .np { --ac: #a9aedb; --sky: #38bdf8; --cream: #f1e9dc; --ink: #14121f; display: grid; grid-template-columns: minmax(0, 1fr); gap: clamp(3.5rem, 7vw, 7rem); padding-block: clamp(3rem, 6vw, 6rem) clamp(5rem, 9vw, 9rem); }
  .np > .wrap { max-width: 72rem; }
  .np figure { margin: 0; }
  .np img { width: 100%; height: auto; display: block; }
  .np .h2 { margin: 0; }
  .np__sec { display: grid; gap: 1.5rem; padding-top: clamp(1.5rem, 3vw, 2.5rem); border-top: 1px solid color-mix(in srgb, var(--ac) 28%, var(--line)); }
  .np__head { display: flex; align-items: baseline; gap: 1rem; }
  .np__n { font-size: .75rem; letter-spacing: .2em; color: var(--sky); }
  .np__txt { margin: 0; color: var(--muted); max-width: 46rem; line-height: 1.7; }
  .np__sub { margin: 1.5rem 0 0; font-size: .8rem; letter-spacing: .16em; text-transform: uppercase; font-weight: 500; color: var(--cream); }
  .np strong { font-weight: 500; }
  .np__nums { list-style: none; margin: .5rem 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: clamp(1.5rem, 5vw, 4rem); }
  .np__nums li { display: grid; gap: .1rem; }
  .np__nums strong { font-size: clamp(2rem, 4vw, 3rem); font-weight: 300; line-height: 1; color: var(--ac); font-variant-numeric: tabular-nums; }
  .np__nums span { font-size: .75rem; letter-spacing: .14em; text-transform: uppercase; color: var(--muted); }
  /* Íconos */
  .np__ico { color: var(--ac); display: inline-grid; place-items: center; width: 2.4rem; aspect-ratio: 1; border-radius: 10px; color: var(--ac); background: color-mix(in srgb, var(--ac) 12%, transparent); border: 1px solid color-mix(in srgb, var(--ac) 30%, transparent); flex: none; }
  .np__ico :global(svg) { width: 55%; height: 55%; fill: none; stroke: currentColor; stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; }
  .np__ico--lg { width: 3.4rem; border-radius: 14px; color: var(--cream); }
  /* Funcionalidades */
  .np__feat { list-style: none; margin: .5rem 0 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1rem; }
  .np__feat li { display: flex; gap: .9rem; padding: 1.1rem; border: 1px solid var(--line); border-radius: 12px; }
  .np__feat div { display: grid; gap: .25rem; align-content: start; }
  .np__feat span:not(.np__ico) { color: var(--muted); font-size: .88rem; line-height: 1.5; }
  /* Carrusel de pantallas con etiquetas por sección */
  .np__tags { display: flex; flex-wrap: wrap; gap: .5rem; }
  .np__tag { all: unset; box-sizing: border-box; cursor: pointer; display: inline-flex; align-items: baseline; gap: .6rem; padding: .6rem 1.15rem; border: 1px solid var(--line); border-radius: 999px; font-size: .88rem; color: var(--muted); transition: color .4s, border-color .4s, background .4s; }
  .np__tag span { font-size: .68rem; letter-spacing: .2em; color: var(--sky); }
  .np__tag small { font-size: .7rem; opacity: .6; }
  .np__tag:hover { color: var(--fg); border-color: var(--ac); }
  .np__tag:focus-visible, .np__arrow:focus-visible, .np__dot:focus-visible, .np__track:focus-visible { outline: 2px solid var(--sky); outline-offset: 3px; }
  .np__tag[aria-selected='true'] { color: var(--ink); background: linear-gradient(120deg, var(--ac), var(--sky)); border-color: transparent; }
  .np__tag[aria-selected='true'] span { color: var(--ink); }
  .np__cdesc { min-height: 3.4em; }
  .np__car { grid-template-columns: minmax(0, 1fr); }
  .np__cwrap { position: relative; min-width: 0; max-width: 100%; }
  .np__track { display: flex; overflow-x: auto; overflow-y: hidden; scroll-snap-type: x mandatory; scrollbar-width: none; align-items: flex-start; transition: height .45s var(--ease); border-radius: 12px; }
  .np__track::-webkit-scrollbar { display: none; }
  .np__slide { flex: 0 0 100%; min-width: 0; scroll-snap-align: start; padding: 1.4rem 1.4rem 2.2rem; box-sizing: border-box; }
  .np__arrow { position: absolute; top: 50%; z-index: 3; width: 3rem; aspect-ratio: 1; margin-top: -1.5rem; display: grid; place-items: center; border: 1px solid var(--line); border-radius: 50%; background: color-mix(in srgb, var(--bg) 70%, transparent); backdrop-filter: blur(8px); color: var(--fg); cursor: pointer; transition: border-color .3s, opacity .3s; }
  .np__arrow:hover { border-color: var(--sky); }
  .np__arrow[disabled] { opacity: .25; cursor: default; }
  .np__arrow svg { width: 1.2rem; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
  .np__arrow--prev { left: -.4rem; } .np__arrow--next { right: -.4rem; }
  .np__dots { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; justify-content: center; gap: .55rem; }
  .np__dot { all: unset; box-sizing: border-box; width: .62rem; height: .62rem; border-radius: 50%; cursor: pointer; background: color-mix(in srgb, var(--fg) 25%, transparent); transition: transform .3s, background .3s; }
  .np__dot[data-sec='tech'] { border-radius: 2px; transform: rotate(45deg); }
  .np__dot[aria-current='true'] { background: var(--sky); transform: scale(1.5); } .np__dot[data-sec='tech'][aria-current='true'] { transform: rotate(45deg) scale(1.5); }
  .np__dot:hover { background: var(--ac); }
  @media (max-width: 760px) { .np__slide { padding-inline: .6rem; } .np__arrow { width: 2.5rem; margin-top: -1.25rem; } .np__arrow--prev { left: 0; } .np__arrow--next { right: 0; } }
  /* Celulares: tres por fila, a un tamaño donde el texto de la captura se lee */
  .np__phones { list-style: none; margin: .75rem 0 0; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: clamp(2rem, 4vw, 3rem) clamp(1rem, 3vw, 2.5rem); justify-items: center; }
  .np__phones li:last-child:nth-child(odd) { grid-column: 1 / -1; }
  .np__phones li { display: grid; gap: 1rem; width: min(100%, 23rem); align-content: start; }
  .np__phone { padding: .45rem; border-radius: 2rem; background: #0b0b0a; box-shadow: 0 0 0 1px color-mix(in srgb, var(--ac) 35%, transparent), 0 30px 60px rgb(0 0 0 / .5); }
  .np__phone img { border-radius: 1.6rem; }
  .np__cap { display: flex; gap: .7rem; }
  .np__cap b { display: grid; place-items: center; width: 1.5rem; aspect-ratio: 1; border-radius: 50%; background: color-mix(in srgb, var(--sky) 18%, transparent); color: var(--sky); font-size: .75rem; font-weight: 500; flex: none; }
  .np__cap div { display: grid; gap: .2rem; }
  .np__cap span { color: var(--muted); font-size: .85rem; line-height: 1.5; }
  /* Resaltado muy sutil de la zona clave de cada captura: un marco de luz que respira, sin tapar nada */
  .np__hlwrap { position: relative; }
  /* El marco se separa de la zona marcada: --gap es la distancia entre la zona y la línea de luz */
  .np__hl { --gap: .9rem; position: absolute; border-radius: 18px; pointer-events: none; opacity: 0; z-index: 2; }
  .np__phone .np__hl { --gap: .6rem; border-radius: 10px; }
  .np__phone .np__hlwrap.is-in .np__hl { animation: np-hlp 6s 1s ease-in-out infinite; }
  @keyframes np-hlp { 0%, 100% { opacity: 0; box-shadow: 0 0 0 0 transparent; } 14%, 50% { opacity: 1; box-shadow: 0 0 0 2px rgb(56 189 248 / .9), 0 0 34px 4px rgb(56 189 248 / .38), inset 0 0 26px rgb(56 189 248 / .14); } 72% { opacity: 0; box-shadow: 0 0 0 0 transparent; } }
  .np__mp { aspect-ratio: 780 / 1688; border-radius: 1.6rem; background: #009ee3; display: grid; place-items: center; }
  .np__mp i { width: 46%; aspect-ratio: 1; background: #fff; -webkit-mask: var(--m) center / contain no-repeat; mask: var(--m) center / contain no-repeat; }
  .np__mailwrap { margin-top: 1.5rem; display: grid; justify-items: center; }
  .np__mail { width: min(100%, 36rem); border-radius: 14px; background: #fff; color: #0f172a; box-shadow: 0 30px 70px rgb(0 0 0 / .5), 0 0 0 1px color-mix(in srgb, var(--ac) 22%, transparent); overflow: hidden; font-family: -apple-system, 'Segoe UI', Roboto, Arial, sans-serif; }
  .np__mailbar { display: flex; align-items: center; gap: .7rem; padding: .9rem 1.1rem; border-bottom: 1px solid #e2e8f0; }
  .np__mailav { display: grid; place-items: center; width: 2.2rem; aspect-ratio: 1; border-radius: 50%; background: #334155; color: #fff; font-weight: 600; font-size: .9rem; }
  .np__mailbar div { display: grid; line-height: 1.3; } .np__mailbar b { font-size: .9rem; } .np__mailbar small { color: #64748b; font-size: .78rem; }
  .np__mailsub { padding: .8rem 1.1rem 0; font-size: 1.05rem; font-weight: 600; }
  .np__mailbody { margin: .8rem; padding: 1rem .6rem 1rem; background: #f1f5f9; border-radius: 10px; }
  .np__mailcard { background: #fff; border: 1px solid #e2e8f0; border-radius: 14px; overflow: hidden; max-width: 30rem; margin: 0 auto; }
  .np__mailtop { display: block; height: 4px; background: #334155; }
  .np__mailin { padding: 1.5rem 1.5rem 1.6rem; }
  .np__mailbiz { margin: 0 0 .25rem; font-size: .8rem; color: #64748b; }
  .np__mailin h3 { margin: 0 0 .7rem; font-size: 1.35rem; line-height: 1.3; }
  .np__mailp { margin: 0 0 1.2rem; font-size: .95rem; color: #334155; }
  .np__mailin dl { margin: 0 0 1.2rem; border-block: 1px solid #e2e8f0; padding: .3rem 0; }
  .np__mailin dl div { display: flex; gap: 1rem; padding: .35rem 0; font-size: .88rem; }
  .np__mailin dt { width: 6.5rem; flex: none; color: #64748b; } .np__mailin dd { margin: 0; }
  .np__mailbtn { display: inline-block; background: #334155; color: #fff; font-weight: 600; font-size: .92rem; padding: .75rem 1.3rem; border-radius: 10px; }
  .np__mailfoot { margin: 1rem .5rem 0; text-align: center; font-size: .75rem; color: #94a3b8; }
  .np__stage .np__hl { --gap: .45rem; border-radius: 14px; }
  .np__stage .np__hl { z-index: 3; }
  .np__hlwrap.is-in .np__hl { animation: np-hl 8s 1.4s ease-in-out infinite; }
  .np__stage.is-in .np__hl { animation: np-hl 8s 6.4s ease-in-out infinite; }
  .np__shotimg { overflow: hidden; }
  @keyframes np-hl { 0%, 100% { opacity: 0; box-shadow: 0 0 0 0 transparent; } 18%, 42% { opacity: 1; box-shadow: 0 0 0 1px rgb(56 189 248 / .5), 0 0 24px 1px rgb(56 189 248 / .18), inset 0 0 20px rgb(56 189 248 / .06); } 64% { opacity: 0; box-shadow: 0 0 0 0 transparent; } }
  @media (prefers-reduced-motion: reduce) { .np__hl { display: none; } }
  /* Paneles: uno por fila a ancho completo, con la explicación debajo */
  .np__wide { display: grid; gap: clamp(2.5rem, 5vw, 4rem); }
  /* En el celular los paneles se deslizan en horizontal, a un tamaño donde el texto se lee */
  .np__wide { grid-template-columns: minmax(0, 1fr); } .np__shot { min-width: 0; }
  .np__scroll { border-radius: 8px; max-width: 100%; }
  @media (max-width: 720px) { .np__scroll { overflow-x: auto; scroll-snap-type: x proximity; -webkit-overflow-scrolling: touch; padding-bottom: .4rem; } .np__scroll .np__hlwrap { min-width: 46rem; } }
  .np__shot img { border-radius: 8px; box-shadow: 0 30px 70px rgb(0 0 0 / .45), 0 0 0 1px color-mix(in srgb, var(--ac) 22%, transparent); }
  .np figcaption { display: grid; gap: .25rem; padding-top: .9rem; max-width: 46rem; }
  .np figcaption span { color: var(--muted); font-size: .9rem; line-height: 1.55; }
  /* Red de conexiones */
  .np__net { --sq: 5.2rem; position: relative; list-style: none; margin: 4.8rem 0 0; padding: 0; display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); row-gap: 2.8rem; }
  .np__net::before { content: ''; position: absolute; left: 10%; right: 10%; top: calc(var(--sq) / 2); height: 1px; background: linear-gradient(90deg, #a9aedb, #38bdf8); transform-origin: left; transform: scaleX(0); transition: transform 1.8s var(--ease) .2s; }
  .np__net.is-in::before { transform: scaleX(1); }
  .np__nd { position: relative; display: grid; justify-items: center; align-content: start; gap: .35rem; text-align: center; padding: 0 .4rem; }
  .np__nd strong { font-size: .95rem; }
  .np__sub2 { font-size: .78rem; color: var(--muted); line-height: 1.4; }
  .np__tag { margin-top: .15rem; font-style: normal; font-size: .64rem; letter-spacing: .12em; text-transform: uppercase; padding: .15rem .55rem; border: 1px dashed color-mix(in srgb, var(--g) 70%, transparent); border-radius: 999px; color: var(--g); }
  .np__nd--up::before { content: ''; position: absolute; left: 50%; top: -2.8rem; height: 2.8rem; width: 1px; background: linear-gradient(to bottom, color-mix(in srgb, var(--g) 15%, transparent), var(--g)); }
  .np__nd--dev .np__sq { border-style: dashed; }
  /* El cuadrado negro: el ícono o logo va dentro, y una luz de su color se enciende por detrás */
  .np__sq { position: relative; isolation: isolate; display: grid; place-items: center; width: var(--sq); aspect-ratio: 1; border-radius: 1.3rem; background: #09090c; border: 1px solid color-mix(in srgb, var(--g) 38%, #2a2833); margin-bottom: .55rem; z-index: 1; }
