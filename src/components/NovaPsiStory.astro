      }));
    });
    document.querySelectorAll<HTMLElement>('[data-rv]:not([data-rv-ready]), .np__nums:not([data-rv-ready]), [data-end]:not([data-rv-ready]), [data-stage]:not([data-rv-ready]), .np__hlwrap:not([data-rv-ready])').forEach((el) => { el.dataset.rvReady = '1'; io.observe(el); });
  };
  document.addEventListener('astro:page-load', wire);
</script>

<script>
  // Carrusel de pantallas: etiquetas por sección, flechas, puntos y teclado. La altura sigue a la pantalla activa.
  const initCar = () => {
    document.querySelectorAll<HTMLElement>('[data-npcar]:not([data-ready])').forEach((car) => {
      car.dataset.ready = '1';
      const track = car.querySelector<HTMLElement>('[data-track]')!;
      const slides = [...track.querySelectorAll<HTMLElement>('.np__slide')];
      const tags = [...car.querySelectorAll<HTMLButtonElement>('[data-tag]')];
      const dots = [...car.querySelectorAll<HTMLButtonElement>('[data-dot]')];
      const prev = car.querySelector<HTMLButtonElement>('[data-prev]')!, next = car.querySelector<HTMLButtonElement>('[data-next]')!;
      const desc = car.querySelector<HTMLElement>('[data-cdesc]')!;
      let cur = -1;
      const fit = () => { track.style.height = `${slides[cur]?.offsetHeight ?? 0}px`; };
      const show = (i: number) => {
        if (i === cur) return; cur = i;
        const sec = slides[i].dataset.sec;
        tags.forEach((t) => { const on = t.dataset.tag === sec; t.setAttribute('aria-selected', String(on)); if (on) desc.textContent = t.dataset.desc ?? ''; });
        dots.forEach((d, k) => { if (k === i) d.setAttribute('aria-current', 'true'); else d.removeAttribute('aria-current'); });
        prev.disabled = i === 0; next.disabled = i === slides.length - 1;
        fit();
      };
      // Al navegar por código se ignora el scroll intermedio (si no, las etiquetas parpadean por cada pantalla que se cruza)
      let lock = 0;
      const go = (i: number) => { const k = Math.max(0, Math.min(slides.length - 1, i)); lock = performance.now() + 900; track.scrollTo({ left: k * track.clientWidth, behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' }); show(k); };
      let raf = 0;
      const sync = () => show(Math.round(track.scrollLeft / track.clientWidth));
      track.addEventListener('scroll', () => { if (performance.now() < lock) return; cancelAnimationFrame(raf); raf = requestAnimationFrame(sync); }, { passive: true });
      tags.forEach((t) => t.addEventListener('click', () => go(Number(t.dataset.first))));
      dots.forEach((d, k) => d.addEventListener('click', () => go(k)));
      prev.addEventListener('click', () => go(cur - 1)); next.addEventListener('click', () => go(cur + 1));
      track.addEventListener('keydown', (e) => { if (e.key === 'ArrowRight') { e.preventDefault(); go(cur + 1); } else if (e.key === 'ArrowLeft') { e.preventDefault(); go(cur - 1); } });
      // Las capturas cargan despacio: la altura se reajusta cuando cambia el tamaño de la pantalla activa
      const ro = new ResizeObserver(() => fit()); slides.forEach((sl) => ro.observe(sl));
      addEventListener('resize', () => track.scrollTo({ left: cur * track.clientWidth }));
      show(0);
    });
  };
  document.addEventListener('astro:page-load', initCar);
  initCar();
</script>
