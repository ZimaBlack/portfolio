  .np__end.is-in .np__iso i:nth-child(2) { animation-delay: 2.4s; } .np__end.is-in .np__iso i:nth-child(3) { animation-delay: 3.6s; }
  @keyframes np-ring { 0% { transform: scale(1); opacity: .55; } 100% { transform: scale(2.1); opacity: 0; } }
