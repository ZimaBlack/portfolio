  .aw-ty__f { list-style: none; margin: 0; padding: 0 0 0 clamp(1.4rem, 5vw, 5rem); display: grid; gap: clamp(.8rem, 1.7vw, 1.6rem); }
  .aw-ty__f li { display: flex; align-items: center; gap: clamp(1rem, 3vw, 3rem); font-size: var(--lb); font-weight: 800; letter-spacing: .5em; text-transform: uppercase; color: #5f5f5f; transition: color .3s, translate .3s; }
  .aw-ty__f li:hover { color: var(--ink); translate: .4rem 0; }
  .aw-ty__f svg { width: .8em; fill: currentColor; flex: none; }
  .aw-ty__r h3 { margin: .9rem 0 clamp(1.4rem, 3vw, 2.4rem); font-size: clamp(1.4rem, 2.2vw, 2.2rem); font-weight: 800; letter-spacing: -.01em; }
  .aw-ty__r p { margin: 0 0 clamp(1rem, 2vw, 1.6rem); font-size: clamp(.9rem, 1.15vw, 1.15rem); line-height: 2.1; font-weight: 400; }
  .aw-an--s { width: clamp(2.4rem, 3.2vw, 3.2rem); }
  .aw-ty__m { display: flex; align-items: center; gap: .9rem; margin-top: clamp(1.8rem, 4vw, 3.4rem) !important; font-size: var(--lb) !important; letter-spacing: .4em; text-transform: uppercase; color: #2b2a2a; line-height: 1 !important; }
  .aw-ty__m svg { width: 1.5em; fill: currentColor; }

  /* 05 Flyer: logo SVG; el selector cambia el degradado completo de «WRAP» */
  .aw-fly { min-height: clamp(24rem, 52vw, 44rem); display: grid; place-items: center; padding-block: var(--pad); }
  .aw-fly .aw-bg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .aw-fly__in { display: grid; justify-items: center; gap: clamp(1.4rem, 3vw, 2.6rem); z-index: 1; }
  .aw-lg { width: min(100%, 52rem); height: auto; overflow: visible; }
  .aw-lg__m { fill: url(#aw-fg); } .aw-lg__a { fill: var(--ink); }
  .aw-sel { display: flex; gap: .7rem; padding: .55rem .8rem; border-radius: 99px; background: rgb(22 21 21 / .55); -webkit-backdrop-filter: blur(10px); backdrop-filter: blur(10px); border: 1px solid rgb(255 255 255 / .08); }
  .aw-sw { width: clamp(1.4rem, 2.2vw, 1.9rem); aspect-ratio: 1; border-radius: 50%; border: 2px solid transparent; background: linear-gradient(135deg, var(--a), var(--b)); cursor: pointer; padding: 0; transition: transform .25s, border-color .25s; }
  .aw-sw:hover { transform: scale(1.12); } .aw-sw[aria-pressed='true'] { border-color: #fff; transform: scale(1.12); } .aw-sw:focus-visible { outline: 2px solid #fff; outline-offset: 3px; }

  /* 06 Pieza: bloque de degradado, logo que sale del corte y aro giratorio */
  @property --aw-bd { syntax: '<angle>'; inherits: false; initial-value: 0deg; }
  @keyframes aw-bd { to { --aw-bd: 360deg; } }
  @property --aw-p { syntax: '<number>'; inherits: false; initial-value: 1; }
  @property --aw-a { syntax: '<color>'; inherits: true; initial-value: #e0206f; }
  @property --aw-b { syntax: '<color>'; inherits: true; initial-value: #562c8a; }
  @property --aw-ga { syntax: '<angle>'; inherits: true; initial-value: 168deg; }
  .aw-cc { --aw-a: #e0206f; --aw-b: #562c8a; --aw-ga: 168deg; container-type: inline-size; position: relative; width: min(100%, 67.6rem); margin-inline: auto; aspect-ratio: 1082 / 601; transition: --aw-a 1.6s ease, --aw-b 1.6s ease, --aw-ga 1.6s ease; }
  .aw-cc__p { position: absolute; inset: 0; background: #1b1b1b; border-radius: 4px; overflow: hidden; }
  .aw-cc__g { position: absolute; inset: 0; background: linear-gradient(var(--aw-ga), var(--aw-a), var(--aw-b)); }
  .aw-cc__l { position: absolute; --aw-p: 1; clip-path: polygon(calc(var(--t) * (1 - var(--aw-p))) 0, calc(var(--t) + (100% - var(--t)) * var(--aw-p)) 0, calc(var(--b) + (100% - var(--b)) * var(--aw-p)) 100%, calc(var(--b) * (1 - var(--aw-p))) 100%); }
  .aw-cc__l svg { display: block; width: 100%; height: auto; fill: var(--ink); }
  .aw-cc__s { position: absolute; margin: 0; font-size: 1.27cqw; letter-spacing: .4em; font-weight: 700; color: var(--ink); white-space: nowrap; }
  .aw-cc.is-armed .aw-cc__g { transform: translateX(-105%); }
  .aw-cc.is-armed .aw-cc__l { --aw-p: 0; } .aw-cc.is-armed .aw-cc__s { opacity: 0; }
  .aw-cc.is-in .aw-cc__g { transform: none; transition: transform 1.2s cubic-bezier(.2, .7, .2, 1); }
  .aw-cc.is-in .aw-cc__l { --aw-p: 1; transition: --aw-p 1.2s cubic-bezier(.3, .6, .2, 1) 1.1s; }
  .aw-cc.is-in .aw-cc__s { opacity: 1; transition: opacity .8s ease 2s; }
  .aw-cc.is-reset .aw-cc__g, .aw-cc.is-reset .aw-cc__l, .aw-cc.is-reset .aw-cc__s { transition: none !important; }
  .aw-don { position: absolute; left: -9.15%; top: 35.9%; width: 18.2%; aspect-ratio: 1; padding: 0; border: 0; border-radius: 50%; cursor: grab; touch-action: none; z-index: 2; background: radial-gradient(circle, #161515 0 59%, transparent 60%), conic-gradient(from 20deg, #2a2a2a, #1f1f1f 25%, #3d3d3d 55%, #5b5b5b 70%, #2d2d2d 85%, #2a2a2a); box-shadow: 0 .6rem 2rem rgb(0 0 0 / .45); transition: rotate .8s cubic-bezier(.3, .8, .3, 1); }
  .aw-don.is-drag { cursor: grabbing; transition: none; }
  .aw-don i { position: absolute; left: 50%; top: 4%; width: 6%; height: 12%; translate: -50% 0; border-radius: 99px; background: rgb(255 255 255 / .55); }
  .aw-don:focus-visible { outline: 2px solid #fff; outline-offset: 4px; }

  /* 07 Aplicaciones: tarjeta y teléfono; las cintas cruzan toda la página, fuera de cualquier contenedor */
  .aw-mk { position: relative; aspect-ratio: 1708 / 617; }
  .aw-mk__c { position: absolute; left: 0; top: 7.6%; width: 42.4%; height: 85.7%; z-index: 2; border-radius: var(--r); overflow: hidden; border: 3px solid transparent; background: linear-gradient(#000, #000) padding-box, conic-gradient(from var(--aw-bd), #ffe600, #b9e43a, #16a977, #1668d4, #7a2fd0, #d12a52, #ff6a00, #ffe600) border-box; animation: aw-bd 14s linear infinite; box-shadow: 0 .6rem 2.4rem rgb(0 0 0 / .5); container-type: inline-size; }
  .aw-mk__h { position: absolute; left: 4.2%; top: 4.4%; margin: 0; font-size: 21.5cqw; line-height: .93; letter-spacing: -.045em; font-weight: 800; color: var(--ink); }
  .aw-mk__u { position: absolute; left: 4.4%; bottom: 6%; margin: 0; font-size: 3.7cqw; font-weight: 700; letter-spacing: -.01em; color: var(--ink); }
  .aw-mk__p { position: absolute; right: 0; top: 0; width: 81.5%; height: 100%; overflow: hidden; border-radius: 4px; }
  .aw-mk__p img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .aw-rbs { position: absolute; inset: 0; pointer-events: none; z-index: 4; --rc: #ac48ff; }
  .aw-rb { position: absolute; left: -10vw; width: 120vw; height: clamp(2.4rem, 4.6vw, 4.8rem); display: flex; align-items: center; overflow: hidden; box-shadow: 0 .5rem 1.6rem rgb(0 0 0 / .4); }
  .aw-rb::before, .aw-rb::after { content: ''; position: absolute; left: 0; right: 0; height: .22rem; background: repeating-linear-gradient(90deg, rgb(255 255 255 / .55) 0 .55rem, transparent .55rem 1rem); }
  .aw-rb::before { top: .3rem; } .aw-rb::after { bottom: .3rem; }
  .aw-rb--k { top: 79%; transform: rotate(-2.5deg); background: #161515; color: var(--ink); }
  .aw-rb--c { top: 86%; transform: rotate(2deg); background: var(--rc); color: #161515; transition: background 1.1s ease; }
  .aw-rb--c::before, .aw-rb--c::after { background: repeating-linear-gradient(90deg, rgb(22 21 21 / .55) 0 .55rem, transparent .55rem 1rem); }
  .aw-rb__t { display: flex; align-items: center; gap: 1.6rem; white-space: nowrap; font-size: clamp(.62rem, .95vw, .9rem); letter-spacing: .14em; text-transform: uppercase; padding-left: 1.6rem; animation: aw-marq 38s linear infinite; }
  .aw-rb__t--r { animation-direction: reverse; animation-duration: 44s; }
  .aw-rb__t b { font-weight: 800; } .aw-rb__t span { font-weight: 500; } .aw-rb__t i { font-style: normal; font-size: .7em; opacity: .8; }
  @keyframes aw-marq { to { transform: translateX(-33.333%); } }

  /* 08 Inspiraciones */
  .aw-in--m { width: min(100% - 2 * var(--gut), 62rem); }
  .aw-ins img { display: block; width: 100%; height: auto; border-radius: 6px; }

  /* 09 Sitio web: carrusel de landings, en negro con borde multicolor */
  .aw-wc { display: flex; flex-wrap: wrap; gap: 1rem 1.5rem; align-items: center; justify-content: space-between; margin-bottom: clamp(1.2rem, 2.4vw, 2rem); }
  .aw-tabs { display: flex; gap: .45rem; flex-wrap: wrap; }
  .aw-tabs button, .aw-dev button { font: 500 clamp(.72rem, .95vw, .85rem)/1 'Onest Variable', 'Onest', system-ui, sans-serif; letter-spacing: .04em; color: var(--cap); background: transparent; border: 1px solid rgb(255 255 255 / .14); border-radius: 99px; padding: .6rem 1rem; cursor: pointer; transition: color .25s, border-color .25s, background .25s; }
  .aw-tabs button:hover, .aw-dev button:hover { color: var(--ink); border-color: rgb(255 255 255 / .35); }
  .aw-tabs button[aria-pressed='true'], .aw-dev button[aria-pressed='true'] { color: #161515; background: var(--ink); border-color: var(--ink); }
  .aw-dev { display: flex; gap: .45rem; }
  .aw-tabs button:focus-visible, .aw-dev button:focus-visible, .aw-nav:focus-visible { outline: 2px solid #fff; outline-offset: 3px; }
  .aw-stage { position: relative; display: grid; justify-items: center; }
  .aw-fr { width: 100%; max-width: 68rem; border-radius: var(--r); border: 3px solid transparent; background: linear-gradient(#000, #000) padding-box, conic-gradient(from var(--aw-bd), #ffe600, #b9e43a, #16a977, #1668d4, #7a2fd0, #d12a52, #ff6a00, #ffe600) border-box; animation: aw-bd 14s linear infinite; overflow: hidden; box-shadow: 0 1.4rem 4rem rgb(0 0 0 / .55); }
  .aw-fr__bar { display: flex; align-items: center; gap: .4rem; padding: .7rem .9rem; background: #000; border-bottom: 1px solid rgb(255 255 255 / .1); }
  .aw-fr__bar i { width: .6rem; height: .6rem; border-radius: 50%; background: rgb(255 255 255 / .18); }
  .aw-fr__bar a { margin-left: .7rem; font-size: .75rem; color: var(--cap); letter-spacing: .03em; text-decoration: none; transition: color .25s; } .aw-fr__bar a:hover { color: var(--ink); text-decoration: underline; text-underline-offset: .2em; }
  .aw-fr__v { height: clamp(22rem, 46vw, 36rem); overflow-y: auto; overscroll-behavior: contain; scrollbar-width: thin; background: #000; }
  .aw-fr__v[hidden] { display: none; }
  .aw-fr__v img { display: block; width: 100%; height: auto; }
  .aw-stage[data-stage='celular'] .aw-fr { max-width: clamp(15rem, 24vw, 21rem); border-radius: 2.2rem; border-width: 4px; }
  .aw-stage[data-stage='celular'] .aw-fr__bar { justify-content: center; padding: .5rem; }
  .aw-stage[data-stage='celular'] .aw-fr__bar i, .aw-stage[data-stage='celular'] .aw-fr__bar a { display: none; }
  .aw-stage[data-stage='celular'] .aw-fr__bar::after { content: ''; width: 28%; height: .35rem; border-radius: 99px; background: rgb(255 255 255 / .18); }
  .aw-stage[data-stage='celular'] .aw-fr__v { height: clamp(26rem, 46vw, 36rem); }
  .aw-nav { position: absolute; top: 50%; translate: 0 -50%; z-index: 2; width: clamp(2.4rem, 3.4vw, 3.2rem); aspect-ratio: 1; border-radius: 50%; border: 1px solid rgb(255 255 255 / .18); background: rgb(22 21 21 / .7); -webkit-backdrop-filter: blur(8px); backdrop-filter: blur(8px); color: var(--ink); font: 400 1.6rem/1 'Onest Variable', system-ui, sans-serif; cursor: pointer; transition: background .25s; }
  .aw-nav:hover { background: rgb(255 255 255 / .16); } .aw-nav--p { left: 0; } .aw-nav--n { right: 0; }
  .aw-cap { margin: 1.2rem 0 0; text-align: center; font-size: .8rem; color: var(--cap); letter-spacing: .04em; }
  .aw-cap a { color: var(--ink); text-decoration: underline; text-underline-offset: .2em; }

  /* 10 Videos y cierre: un aro chico en la esquina inferior derecha con el isologo */
  .aw-vf, .aw-vc figure { margin: 0; }
  .aw-vf video, .aw-vc video { display: block; width: 100%; aspect-ratio: 16 / 9; background: #000; border-radius: var(--r); object-fit: cover; }
  .aw-vf figcaption, .aw-vc figcaption { margin-top: .8rem; font-size: clamp(.78rem, 1vw, .9rem); line-height: 1.2; color: var(--cap); letter-spacing: .02em; }
  .aw-vf figcaption span, .aw-vc figcaption span { opacity: .7; }
  .aw-vf { max-width: 56rem; margin-inline: auto; margin-bottom: clamp(1.4rem, 3vw, 2.4rem); }
  .aw-vc { max-width: 56rem; margin-inline: auto; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(.8rem, 1.6vw, 1.4rem); }
  .aw-vc video { border-radius: 10px; }

  @media (prefers-reduced-motion: reduce) { .aw-film i, .aw-rb__t, .aw-fr { animation: none; } .aw-cc.is-armed .aw-cc__g { transform: none; } .aw-cc.is-armed .aw-cc__l { --aw-p: 1; } .aw-cc.is-armed .aw-cc__s { opacity: 1; } }

  @media (max-width: 860px) {
    .aw-ri { grid-template-columns: minmax(0, 1fr); }
    .aw-ty__g { grid-template-columns: minmax(0, 1fr); }
    .aw-ty__k { padding-left: 0; } .aw-ty__f { padding-left: 0; } .aw-ty__lg { margin-inline: auto; } .aw-ty__k { text-align: center; }
    .aw-cl { width: auto; justify-items: center; text-align: center; }
    .aw-cl li { padding-left: 0; letter-spacing: .32em; }
    .aw-lb { letter-spacing: .32em; } .aw-r { text-align: center; }
    .aw-don { left: -3%; width: 22%; }
    .aw-mk { aspect-ratio: auto; display: grid; gap: 1rem; }
    .aw-mk__c { position: relative; left: auto; top: auto; width: 100%; height: auto; aspect-ratio: 724 / 529; }
    .aw-mk__p { position: relative; right: auto; width: 100%; height: auto; aspect-ratio: 1393 / 617; }
    .aw-rb--k { top: 74%; } .aw-rb--c { top: 82%; }
    .aw-wc { justify-content: center; } .aw-tabs { justify-content: center; }
    .aw-nav { top: auto; bottom: -3.4rem; translate: 0; } .aw-nav--p { left: calc(50% - 3.4rem); } .aw-nav--n { right: calc(50% - 3.4rem); }
    .aw-cap { margin-top: 4.6rem; }
    .aw-vc { grid-template-columns: minmax(0, 1fr); }
  }
</style>

<script>
  // Interacciones: selector de color del flyer, aro giratorio de la pieza, cintas de color y carrusel del sitio.
  const init = () => document.querySelectorAll<HTMLElement>('[data-aw]:not([data-bound])').forEach((root) => {
    root.dataset.bound = '1';
    const calm = matchMedia('(prefers-reduced-motion: reduce)').matches;

    // Flyer: el selector cambia los dos colores del degradado de «WRAP»
    const fly = root.querySelector<HTMLElement>('[data-aw-fly]');
    fly?.querySelectorAll<HTMLButtonElement>('.aw-sw').forEach((b) => b.addEventListener('click', () => {
      fly.style.setProperty('--g1', b.dataset.a!); fly.style.setProperty('--g2', b.dataset.b!);
      fly.querySelectorAll('.aw-sw').forEach((o) => o.setAttribute('aria-pressed', String(o === b)));
    }));

    // Pieza: el bloque de degradado entra, el logo sale del corte; el aro gira y elige el modelo (cambio suave).
    // Con cada giro completo, la animación de entrada vuelve a correr.
    const cc = root.querySelector<HTMLElement>('[data-aw-cc]');
    if (cc) {
      const models = ['#e0206f|#562c8a', '#ffa21d|#f2431f', '#1d6bf0|#199198', '#1aab70|#dff051', '#ac48ff|#3a1d6e', '#ffed00|#e01f1a'];
      const n = models.length, step = 360 / n;
      const play = () => {
        cc.classList.remove('is-in'); cc.classList.add('is-reset', 'is-armed');
        void cc.offsetWidth;
        cc.classList.remove('is-reset');
        requestAnimationFrame(() => requestAnimationFrame(() => cc.classList.add('is-in')));
      };
      if (!calm) {
        cc.classList.add('is-armed');
        new IntersectionObserver((es, io) => es.forEach((e) => { if (e.isIntersecting) { requestAnimationFrame(() => cc.classList.add('is-in')); io.disconnect(); } }), { threshold: 0.4 }).observe(cc);
      }
      const don = cc.querySelector<HTMLButtonElement>('[data-aw-don]')!;
      let rot = 0, turns = 0;
      const apply = (r: number) => {
        rot = r; don.style.rotate = `${r}deg`;
        const idx = ((Math.round(r / step) % n) + n) % n;
        const [a, b] = models[idx].split('|');
        cc.style.setProperty('--aw-a', a); cc.style.setProperty('--aw-b', b); cc.style.setProperty('--aw-ga', `${168 + r / 3}deg`);
        const t = Math.trunc(r / 360);
        if (t !== turns) { turns = t; if (!calm) play(); }
      };
      don.addEventListener('click', () => { if (!don.dataset.moved) apply(rot + step); don.dataset.moved = ''; });
      don.addEventListener('keydown', (e) => { if (e.key === 'ArrowRight' || e.key === 'ArrowUp') { e.preventDefault(); apply(rot + step); } if (e.key === 'ArrowLeft' || e.key === 'ArrowDown') { e.preventDefault(); apply(rot - step); } });
      const ang = (e: PointerEvent) => { const r = don.getBoundingClientRect(); return (Math.atan2(e.clientY - (r.top + r.height / 2), e.clientX - (r.left + r.width / 2)) * 180) / Math.PI; };
      let a0 = 0, r0 = 0, down = false;
      don.addEventListener('pointerdown', (e) => { down = true; a0 = ang(e); r0 = rot; don.setPointerCapture(e.pointerId); don.classList.add('is-drag'); don.dataset.moved = ''; });
      don.addEventListener('pointermove', (e) => { if (!down) return; let d = ang(e) - a0; while (d > 180) d -= 360; while (d < -180) d += 360; if (Math.abs(d) > 3) don.dataset.moved = '1'; a0 = ang(e); r0 += d; apply(r0); });
      const up = () => { if (!down) return; down = false; don.classList.remove('is-drag'); if (don.dataset.moved) apply(Math.round(rot / step) * step); };
      don.addEventListener('pointerup', up); don.addEventListener('pointercancel', up);
    }

    // Paleta de brillo: se revela al entrar en pantalla
    const br = root.querySelector<HTMLElement>('[data-aw-br]');
    if (br && !calm) {
      br.classList.add('is-armed');
      new IntersectionObserver((es, io) => es.forEach((e) => { if (e.isIntersecting) { requestAnimationFrame(() => br.classList.add('is-in')); io.disconnect(); } }), { threshold: 0.4 }).observe(br);
    }

    // Cintas: la de color cambia sola cada 5 s
    const tape = root.querySelector<HTMLElement>('[data-aw-tape]');
    if (tape) {
      const cols = ['#e01f1a', '#ff6128', '#fda208', '#ffed00', '#1aab70', '#1b8f9c', '#015aff', '#ac48ff', '#ff1b71'];
      let last = '';
      const rnd = () => { let c = last; while (c === last) c = cols[Math.floor(Math.random() * cols.length)]; last = c; tape.style.setProperty('--rc', c); };
      rnd();
      if (!calm) setInterval(() => { if (tape.isConnected) rnd(); }, 5000);
    }

    // Carrusel del sitio: páginas y formato (escritorio / celular)
    const web = root.querySelector<HTMLElement>('[data-aw-web]');
    if (web) {
      const tabs = [...web.querySelectorAll<HTMLButtonElement>('[data-page]')];
      const devs = [...web.querySelectorAll<HTMLButtonElement>('button[data-dev]')];
      const stage = web.querySelector<HTMLElement>('.aw-stage')!;
      const urls = ['', 'services', 'promotional-videos', 'social-media-videos', 'youtube-videos', 'faqs', 'contact-us'];
      let page = 0, dev = 'escritorio';
      const show = () => {
        web.querySelectorAll<HTMLElement>('[data-slide]').forEach((s) => { s.hidden = s.dataset.slide !== `${page}-${dev}`; });
        tabs.forEach((b, i) => b.setAttribute('aria-pressed', String(i === page)));
        devs.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.dev === dev)));
        stage.dataset.stage = dev;
        const u = web.querySelector('[data-url]'); if (u) u.textContent = `afterwrapstudio.com${urls[page] ? '/' + urls[page] : ''}`;
        const c = web.querySelector('[data-count]'); if (c) c.textContent = `${String(page + 1).padStart(2, '0')} / ${String(tabs.length).padStart(2, '0')}`;
        const cur = web.querySelector<HTMLElement>(`[data-slide="${page}-${dev}"]`); if (cur) cur.scrollTop = 0;
      };
      tabs.forEach((b, i) => b.addEventListener('click', () => { page = i; show(); }));
      devs.forEach((b) => b.addEventListener('click', () => { dev = b.dataset.dev!; show(); }));
      web.querySelectorAll<HTMLButtonElement>('[data-nav]').forEach((b) => b.addEventListener('click', () => { page = (page + Number(b.dataset.nav) + tabs.length) % tabs.length; show(); }));
    }
  });
  document.addEventListener('astro:page-load', init);
</script>
