---
// Imagen del proyecto Wanderlust, o PLACEHOLDER (fondo oscuro morado con halo) si todavía no hay archivo.
import '@fontsource-variable/montserrat';
import { withBase, type Lang } from '../../lib/i18n';
const { src, alt, cap, ratio = '16 / 10', fit = 'cover', surface, zoom = false, why, lang, eager = false } = Astro.props as {
  src?: string; alt: string; cap?: string; ratio?: string; fit?: 'cover' | 'contain'; surface?: 'dark' | 'light' | 'brand'; zoom?: boolean; why?: string; lang: Lang; eager?: boolean;
};
const url = src ? withBase(src) : undefined;
---
<figure class="fig">
  <div class:list={['fig__box', surface && `is-${surface}`, fit === 'contain' && 'is-contain', !url && 'is-ph']} style={`aspect-ratio:${ratio}`}>
    {url
      ? (zoom
        ? <a class="zoom" href={url} target="_blank" rel="noopener" aria-label={`${alt} (${lang === 'es' ? 'abrir a tamaño completo' : 'open full size'})`}><img src={url} alt="" loading="lazy" decoding="async" /></a>
        : <img src={url} alt={alt} loading={eager ? 'eager' : 'lazy'} decoding="async" />)
      : <div class="ph" role="img" aria-label={`Placeholder: ${alt}`}>
          <span class="ph__tag">Placeholder</span>
          <strong>{cap ?? alt}</strong>
          {why && <span class="ph__why">{why}</span>}
        </div>}
  </div>
  {cap && <figcaption>{cap}</figcaption>}
</figure>
<style>
  .fig { margin: 0; display: grid; gap: .6rem; }
  .fig__box { position: relative; overflow: hidden; border-radius: 4px; background: #14141a; }
  .fig__box img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .fig__box.is-contain img { object-fit: contain; padding: 3%; }
  .fig__box.is-light { background: #f4f3f1; } .fig__box.is-dark { background: #1c1c26; } .fig__box.is-brand { background: #282931; }
  .zoom { position: absolute; inset: 0; cursor: zoom-in; }
  figcaption { font-size: .8rem; color: var(--muted); }
  .ph { position: absolute; inset: 0; display: grid; align-content: center; justify-items: center; gap: .5rem; padding: 1.25rem; text-align: center; color: #fff; font-family: 'Montserrat Variable', 'Montserrat', system-ui, sans-serif;
        background: radial-gradient(70% 80% at 72% 8%, rgb(168 85 247 / .5), transparent 65%), radial-gradient(60% 70% at 12% 105%, rgb(124 205 225 / .28), transparent 70%), #1a1030; }
  .ph::after { content: ''; position: absolute; inset: .6rem; border: 1px dashed rgb(255 255 255 / .28); border-radius: 3px; pointer-events: none; }
  .ph__tag { font-size: .62rem; font-weight: 700; letter-spacing: .2em; text-transform: uppercase; padding: .15rem .6rem; border: 1px solid #ff7a3d; color: #ff9a68; border-radius: 999px; }
  .ph strong { font-size: clamp(.85rem, 1.3vw, 1.05rem); font-weight: 700; line-height: 1.25; max-width: 28ch; }
  .ph__why { font-size: .72rem; line-height: 1.45; color: rgb(255 255 255 / .75); max-width: 36ch; }
</style>
