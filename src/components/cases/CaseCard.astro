---
import { loc, paths, withBase, type Lang } from '../../lib/i18n';
import { type Case } from '../../data/cases';
import CaseArt from './CaseArt.astro';
import ShotFig from './ShotFig.astro';
const { c, lang, ratio = '4 / 3', index } = Astro.props as { c: Case; lang: Lang; ratio?: string; index?: number };
---
<a class="cc" href={paths.caseOf(lang, c.slug)} data-reveal>
  <div class="cc__media" style={`aspect-ratio:${ratio}`}>
    <div class="cc__zoom">
      {c.art ? <CaseArt kind={c.art} /> : <div class="cc__img"><ShotFig shot={{ ...(c.cardCover ?? c.cover), ratio: undefined }} lang={lang} bare={true} /></div>}
    </div>
  </div>
  <div class="cc__meta">
    <span class="muted">{c.num}</span>
    <h3 class="cc__t">{loc(c.title, lang)}</h3>
    <span class="muted cc__p">{loc(c.pillar, lang)} · {c.year}</span>
  </div>
</a>
<style>
  .cc { display: block; }
  .cc__media { position: relative; overflow: hidden; border-radius: 4px; background: #12151c; }
  .cc__zoom { position: absolute; inset: 0; transition: transform 1.1s var(--ease), filter .6s; }
  .cc:hover .cc__zoom { transform: scale(1.05); filter: brightness(1.1); }
  .cc__img { position: absolute; inset: 0; }
  .cc__img :global(.shot), .cc__img :global(.shot__box) { height: 100%; aspect-ratio: auto !important; }
  .cc__meta { display: grid; grid-template-columns: 2.2rem 1fr auto; gap: .35rem 1rem; align-items: baseline; padding-top: 1rem; font-size: .85rem; }
  .cc__t { font-size: 1.1rem; font-weight: 400; line-height: 1.25; margin: 0; letter-spacing: -.01em; transition: transform .7s var(--ease); }
  .cc:hover .cc__t { transform: translateX(.5rem); }
  @media (max-width: 640px) { .cc__meta { grid-template-columns: 2rem 1fr; } .cc__p { grid-column: 2; } }
</style>
