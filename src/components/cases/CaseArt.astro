---
// Composiciones en código para las tarjetas de casos que no tienen una imagen fuerte propia.
import '@fontsource-variable/montserrat';
const { kind } = Astro.props as { kind: 'tokens' | 'states' };
---
<div class:list={['art', `art--${kind}`]} aria-hidden="true">
  {kind === 'tokens' && (
    <>
      <div class="sw"><i style="background:#1b1f2a"></i><i style="background:#1f5fbf"></i><i style="background:#c2410c"></i><i style="background:#8fc8e8"></i><i style="background:#f6f5f3"></i></div>
      <div class="aa">Aa</div>
      <div class="bt"><b style="background:#1f5fbf">Primary</b><b style="background:#c2410c">Accent</b><b class="gh">Ghost</b></div>
    </>
  )}
  {kind === 'states' && (
    <>
      <div class="roles"><b style="background:#3b4fd8">CL</b><b style="background:#ef6a4a">ED</b><b style="background:#f5ad4a">PM</b><b style="background:#6a1f6a">QA</b></div>
      <div class="chips">
        <u style="color:#fff;border-color:#fff">Draft</u><u style="color:#ffb53d;border-color:#ffb53d">Pending</u><u style="color:#5fb4f0;border-color:#5fb4f0">In process</u><u style="color:#ff6b6b;border-color:#ff6b6b">Revision</u><u style="color:#8aa0ff;border-color:#8aa0ff">Approved</u>
      </div>
    </>
  )}
</div>
<style>
  .art { position: absolute; inset: 0; display: grid; place-content: center; gap: 1.4rem; justify-items: center; padding: 8%; color: #fff; font-family: 'Montserrat Variable', 'Montserrat', system-ui, sans-serif;
         background: radial-gradient(70% 80% at 75% 8%, rgb(143 200 232 / .35), transparent 65%), radial-gradient(60% 70% at 10% 105%, rgb(194 65 12 / .4), transparent 70%), #12151c; }
  .sw { display: flex; gap: .5rem; }
  .sw i { width: clamp(1.6rem, 5vw, 3rem); aspect-ratio: 1; border-radius: 50%; border: 2px solid rgb(255 255 255 / .35); }
  .aa { font-size: clamp(3rem, 9vw, 6rem); font-weight: 800; letter-spacing: -.04em; line-height: 1; }
  .bt { display: flex; flex-wrap: wrap; gap: .5rem; justify-content: center; }
  .bt b { padding: .55rem 1.1rem; border-radius: 999px; font-size: clamp(.7rem, 1.4vw, .9rem); font-weight: 700; }
  .bt .gh { background: transparent; border: 2px solid #fff; }
  .roles { display: flex; gap: .4rem; }
  .roles b { padding: .3rem .55rem; border-radius: 6px; font-size: .75rem; font-weight: 800; }
  .chips { display: grid; gap: .55rem; justify-items: center; }
  .chips u { text-decoration: none; padding: .3rem .9rem; border: 2px solid; border-radius: 8px; font-size: clamp(.65rem, 1.3vw, .8rem); font-weight: 800; letter-spacing: .08em; text-transform: uppercase; }
</style>
