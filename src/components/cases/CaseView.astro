---
import { Code } from 'astro:components';
import Base from '../../layouts/Base.astro';
import Pend from './Pend.astro';
import ShotFig from './ShotFig.astro';
import CaseArt from './CaseArt.astro';
import tokensRaw from '../../../demo-src/design-system/_tokens.scss?raw';
import mixinsRaw from '../../../demo-src/design-system/_mixins.scss?raw';
import buttonsRaw from '../../../demo-src/design-system/_buttons.scss?raw';
import statesRaw from '../../../demo-src/design-system/_states.scss?raw';
import { cases, showPending, type Case, type Snippet, type T } from '../../data/cases';
import { loc, paths, withBase, type Lang } from '../../lib/i18n';
import { u, rich } from '../../lib/casesUi';

const { c, lang } = Astro.props as { c: Case; lang: Lang };
const ui = u(lang);
const alt = lang === 'es' ? 'en' : 'es';
const idx = cases.findIndex((x) => x.slug === c.slug);
const next = cases[(idx + 1) % cases.length];

const raws = { tokens: tokensRaw, mixins: mixinsRaw, buttons: buttonsRaw, states: statesRaw };
// Fragmento del archivo real del demo, entre dos marcas (así el código mostrado es el que corre en la demo)
const excerpt = (raw: string, from?: string, to?: string) => {
  const lines = raw.split('\n');
  const a = from ? Math.max(0, lines.findIndex((x) => x.includes(from))) : 0;
  const b = to ? lines.findIndex((x, i) => i > a && x.includes(to)) : -1;
  return lines.slice(a, b > a ? b : undefined).join('\n').trimEnd();
};
const codeOf = (s: Snippet) => (s.raw ? excerpt(raws[s.raw], s.from, s.to) : (s.code ?? ''));
const tall = c.process.length > 0 && c.process.every((p) => p.ratio === '2 / 3');
const nPending = (t: T) => (t.pending ? 1 : 0);
const sec = ui.sections;
---
<Base lang={lang} section="cases" title={loc(c.title, lang)} description={loc(c.line, lang)}
  altHref={paths.caseOf(alt, c.slug)} esHref={paths.caseOf('es', c.slug)} enHref={paths.caseOf('en', c.slug)}>

  <header class="wrap ch">
    <a class="ch__back muted" href={paths.cases(lang)}>{ui.back}</a>
    <p class="eyebrow" data-hero>{c.num} · {loc(c.pillar, lang)}</p>
    <h1 class="ch__title" data-hero-title>{loc(c.title, lang)}</h1>
    <p class="ch__line">{loc(c.line, lang)}</p>
    <dl class="ch__meta">
      <div><dt>{ui.year}</dt><dd>{c.year}</dd></div>
      <div><dt>{ui.role}</dt><dd>{loc(c.role, lang)}</dd></div>
      <div><dt>{ui.pillar}</dt><dd>{loc(c.pillar, lang)}</dd></div>
    </dl>
    {c.scope === 'estructura' && <p class="ch__note"><b>{ui.structure}</b> — {ui.structureNote}</p>}
  </header>

  <div class="wrap cover" data-reveal>
    {c.art
      ? <div class="cover__art"><CaseArt kind={c.art} /></div>
      : <ShotFig shot={{ ...c.cover, ratio: '21 / 9' }} lang={lang} eager={true} bare={true} />}
  </div>

  <div class="wrap body">
    <!-- 1 · Contexto -->
    <section class="blk" id="contexto" data-reveal>
      <h2 class="blk__h"><span>01</span>{sec.context}</h2>
      <div class="blk__c"><p class="lead">{loc(c.context, lang)}{c.context.pending && <Pend lang={lang} />}</p></div>
    </section>

    <!-- 2 · Problema -->
    <section class="blk" id="problema" data-reveal>
      <h2 class="blk__h"><span>02</span>{sec.problem}</h2>
      <div class="blk__c"><p class="lead">{loc(c.problem, lang)}{c.problem.pending && <Pend lang={lang} />}</p></div>
    </section>

    <!-- 3 · Decisión clave y por qué -->
    <section class="blk" id="decision" data-reveal>
      <h2 class="blk__h"><span>03</span>{sec.decision}</h2>
      <div class="blk__c">
        <ol class="dec">
          {c.decisions.map((d, i) => (
            <li>
              <h3>{loc(d.title, lang)}</h3>
              <p><b class="why">{ui.why}.</b> <span set:html={rich(loc(d.why, lang))} />{d.why.pending && <Pend lang={lang} />}</p>
            </li>
          ))}
        </ol>
        {c.swatches && (
          <ul class="swatches" aria-label="Paleta">
            {c.swatches.map((s) => (
              <li><i style={`background:${s.hex}`}></i><b>{s.hex}</b><span>{s.name}</span><em>{loc(s.use, lang)}</em></li>
            ))}
          </ul>
        )}
        {c.chain && (
          <div class="chain" aria-label={ui.chain}>
            {c.chain.map((s, i) => <><span class="chain__i">{loc(s, lang)}</span>{i < c.chain!.length - 1 && <span class="chain__a" aria-hidden="true">→</span>}</>)}
          </div>
        )}
      </div>
    </section>

    <!-- 4 · Proceso -->
    {c.process.length > 0 && (
      <section class="blk blk--wide" id="proceso" data-reveal>
        <h2 class="blk__h"><span>04</span>{sec.process}</h2>
        <div class:list={['grid', tall ? 'grid--3' : 'grid--2']}>
          {c.process.map((p) => <ShotFig shot={p} lang={lang} />)}
        </div>
      </section>
    )}

    <!-- 5 · Resultado visual -->
    {(c.result.length > 0 || c.demos) && (
      <section class="blk blk--wide" id="resultado" data-reveal>
        <h2 class="blk__h"><span>05</span>{sec.result}</h2>
        {c.result.length > 0 && <div class="grid grid--2">{c.result.map((p) => <ShotFig shot={p} lang={lang} />)}</div>}
        {c.demos && c.demos.map((d) => (
          <figure class="demo">
            <div class="demo__bar"><span class="demo__dot"></span><span class="demo__dot"></span><span class="demo__dot"></span><b>{ui.live}</b><a href={withBase(d.src)} target="_blank" rel="noopener">{ui.openDemo} ↗</a></div>
            <iframe src={withBase(d.src)} title={loc(d.title, lang)} loading="lazy" style={`aspect-ratio:${d.ratio ?? '16 / 10'}`}></iframe>
            <figcaption>{loc(d.title, lang)}</figcaption>
          </figure>
        ))}
      </section>
    )}

    <!-- 6 · Implementación -->
    <section class="blk blk--wide" id="implementacion" data-reveal>
      <h2 class="blk__h"><span>06</span>{sec.impl}</h2>
      <div class="blk__c blk__c--wide">
        <p class="lead">{loc(c.impl.text, lang)}{c.impl.text.pending && <Pend lang={lang} />}</p>
        {c.impl.snippets.map((s) => (
          <figure class="code">
            <figcaption><code>{s.file}</code><span>{loc(s.note, lang)}</span></figcaption>
            <Code code={codeOf(s)} lang={s.lang as any} theme="github-dark" wrap={false} />
          </figure>
        ))}
      </div>
    </section>

    <!-- 7 · Impacto -->
    <section class="blk" id="impacto" data-reveal>
      <h2 class="blk__h"><span>07</span>{sec.impact}</h2>
      <div class="blk__c">
        <p class="lead">{loc(c.impact.text, lang)}{c.impact.text.pending && <Pend lang={lang} />}</p>
        <ul class="metrics" aria-label={ui.metrics}>
          {c.impact.metrics.map((m) => (
            <li><span>{loc(m.label, lang)}</span>{m.value ? <b>{m.value}</b> : <Pend lang={lang} />}</li>
          ))}
        </ul>
      </div>
    </section>
  </div>

  <nav class="wrap nx" aria-label={ui.next}>
    <a href={paths.caseOf(lang, next.slug)}>
      <span class="muted">{ui.next} · {next.num}</span>
      <strong>{loc(next.title, lang)}</strong>
    </a>
  </nav>
</Base>

<style>
  .ch { padding-top: clamp(8rem, 14vw, 12rem); display: grid; gap: 1.1rem; }
  .ch__back { font-size: .85rem; justify-self: start; }
  .ch__title { font-size: clamp(1.9rem, 5.2vw, 4.4rem); line-height: 1.04; letter-spacing: -.03em; font-weight: 600; margin: 0; max-width: 18ch; }
  .ch__line { font-size: clamp(1rem, 1.5vw, 1.25rem); color: var(--muted); max-width: 52ch; margin: 0; line-height: 1.5; }
  .ch__meta { display: flex; flex-wrap: wrap; gap: 1rem 3rem; margin: 1.2rem 0 0; padding-top: 1.2rem; border-top: 1px solid var(--line); }
  .ch__meta dt { font-size: .7rem; letter-spacing: .14em; text-transform: uppercase; color: var(--muted); }
  .ch__meta dd { margin: .2rem 0 0; font-size: .95rem; }
  .ch__note { margin: .6rem 0 0; padding: .8rem 1rem; border: 1px dashed #e84d00; border-radius: 4px; font-size: .85rem; color: var(--muted); max-width: 70ch; }
  .ch__note b { color: #ff7a3d; }
  .cover { padding-top: clamp(2rem, 4vw, 4rem); }
  .cover__art { aspect-ratio: 21 / 9; position: relative; overflow: hidden; border-radius: 4px; }

  .body { display: grid; gap: clamp(4rem, 9vw, 9rem); padding-block: clamp(4rem, 9vw, 9rem); }
  .blk { display: grid; gap: 2rem 3rem; grid-template-columns: minmax(10rem, 1fr) 4fr; align-items: start; }
  .blk--wide { grid-template-columns: 1fr; }
  .blk__h { display: flex; gap: 1rem; align-items: baseline; margin: 0; font-size: .78rem; letter-spacing: .18em; text-transform: uppercase; font-weight: 700; }
  .blk__h span { color: var(--muted); font-weight: 400; }
  @media (min-width: 900px) { .blk:not(.blk--wide) .blk__h { position: sticky; top: 6rem; } }
  .blk__c { display: grid; gap: 2rem; max-width: 62rem; }
  .blk__c--wide { max-width: none; }
  .lead { font-size: clamp(1.1rem, 1.8vw, 1.5rem); line-height: 1.5; margin: 0; max-width: 56ch; }
  @media (max-width: 899px) { .blk { grid-template-columns: 1fr; } }

  .dec { list-style: none; counter-reset: d; margin: 0; padding: 0; display: grid; gap: 2rem; }
  .dec li { counter-increment: d; display: grid; gap: .6rem; padding-top: 1.2rem; border-top: 1px solid var(--line); }
  .dec h3 { margin: 0; font-size: 1.15rem; font-weight: 600; }
  .dec h3::before { content: counter(d, decimal-leading-zero) ' '; color: var(--muted); font-weight: 400; margin-right: .6rem; }
  .dec p { margin: 0; color: color-mix(in srgb, var(--fg) 82%, var(--bg)); max-width: 62ch; line-height: 1.6; }
  .why { color: var(--fg); }
  .dec :global(code), .lead :global(code) { font-family: ui-monospace, 'SF Mono', Menlo, monospace; font-size: .88em; background: rgb(127 127 127 / .18); padding: .08em .35em; border-radius: 3px; }

  .swatches { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(9.5rem, 1fr)); gap: .8rem; }
  .swatches li { display: grid; gap: .15rem; font-size: .8rem; }
  .swatches i { display: block; height: 4.4rem; border-radius: 4px; border: 1px solid var(--line); margin-bottom: .4rem; }
  .swatches b { font-size: .9rem; letter-spacing: .02em; }
  .swatches em { font-style: normal; color: var(--muted); }
  .chain { display: flex; flex-wrap: wrap; align-items: center; gap: .5rem .8rem; }
  .chain__i { padding: .5rem 1rem; border: 1px solid var(--fg); border-radius: 999px; font-size: .85rem; }
  .chain__a { color: var(--muted); }

  .grid { display: grid; gap: 1.5rem; }
  .grid--2 { grid-template-columns: repeat(2, 1fr); }
  .grid--3 { grid-template-columns: repeat(3, 1fr); }
  @media (max-width: 760px) { .grid--2, .grid--3 { grid-template-columns: 1fr; } }

  .demo { margin: 2rem 0 0; display: grid; border: 1px solid var(--line); border-radius: 8px; overflow: hidden; }
  .demo__bar { display: flex; align-items: center; gap: .4rem; padding: .6rem .9rem; border-bottom: 1px solid var(--line); font-size: .8rem; }
  .demo__bar b { margin-left: .6rem; letter-spacing: .12em; text-transform: uppercase; font-size: .68rem; }
  .demo__bar a { margin-left: auto; color: var(--muted); }
  .demo__bar a:hover { color: var(--fg); }
  .demo__dot { width: .6rem; height: .6rem; border-radius: 50%; background: var(--line); }
  .demo iframe { width: 100%; border: 0; background: #fff; display: block; }
  .demo figcaption { padding: .7rem .9rem; font-size: .8rem; color: var(--muted); border-top: 1px solid var(--line); }

  .code { margin: 0; display: grid; gap: 0; border: 1px solid var(--line); border-radius: 8px; overflow: hidden; }
  .code figcaption { display: flex; flex-wrap: wrap; gap: .4rem 1.2rem; align-items: baseline; padding: .7rem 1rem; background: rgb(127 127 127 / .12); font-size: .8rem; color: var(--muted); }
  .code figcaption code { color: var(--fg); font-family: ui-monospace, 'SF Mono', Menlo, monospace; }
  .code :global(pre) { margin: 0 !important; padding: 1.1rem 1.2rem !important; font-size: .78rem; line-height: 1.6; overflow-x: auto; border-radius: 0; }

  .metrics { list-style: none; margin: 0; padding: 0; display: grid; gap: 0; }
  .metrics li { display: flex; justify-content: space-between; align-items: center; gap: 1rem; padding: 1rem 0; border-top: 1px solid var(--line); }
  .metrics li:last-child { border-bottom: 1px solid var(--line); }
  .metrics b { font-size: 1.6rem; font-weight: 600; }

  .nx { padding-block: 0 clamp(5rem, 10vw, 9rem); }
  .nx a { display: grid; gap: .4rem; padding-top: 2rem; border-top: 1px solid var(--line); }
  .nx strong { font-size: clamp(1.3rem, 3vw, 2.4rem); font-weight: 500; letter-spacing: -.02em; transition: transform .7s var(--ease); }
  .nx a:hover strong { transform: translateX(.6rem); }
</style>
