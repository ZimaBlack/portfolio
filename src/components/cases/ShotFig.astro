---
// Imagen del caso, o PLACEHOLDER con fondo oscuro morado y halo de luz.
import '@fontsource-variable/montserrat';
import { withBase, loc, type Lang } from '../../lib/i18n';
import { showPending, type Shot } from '../../data/cases';
import { u } from '../../lib/casesUi';
const { shot, lang, eager = false, bare = false } = Astro.props as { shot: Shot; lang: Lang; eager?: boolean; bare?: boolean };
const src = shot.src ? withBase(shot.src) : undefined;
const ratio = shot.ratio ?? '16 / 10';
---
<figure class:list={['shot', { 'shot--bare': bare }]}>
  <div class:list={['shot__box', shot.surface && `is-${shot.surface}`, shot.fit === 'contain' && 'is-contain', !src && 'is-ph']} style={`aspect-ratio:${ratio}`}>
    {src
      ? (shot.zoom
          ? <a class="zoom" href={src} target="_blank" rel="noopener" aria-label={`${loc(shot.alt, lang)} (${lang === 'es' ? 'abrir a tamaño completo' : 'open full size'})`}><img src={src} alt="" loading="lazy" decoding="async" /></a>
          : <img src={src} alt={loc(shot.alt, lang)} loading={eager ? 'eager' : 'lazy'} decoding="async" />)
      : <div class="ph" role="img" aria-label={`${u(lang).placeholder}: ${loc(shot.alt, lang)}`}>
          <span class="ph__tag">{u(lang).placeholder}</span>
          <strong class="ph__t">{loc(shot.cap, lang)}</strong>
          {showPending && shot.ph && <span class="ph__why">{loc(shot.ph, lang)}</span>}
        </div>}
  </div>
  {!bare && <figcaption>{loc(shot.cap, lang)}</figcaption>}
</figure>

<style>
  .shot { margin: 0; display: grid; gap: .6rem; }
  .shot__box { position: relative; overflow: hidden; border-radius: 4px; background: #14141a; }
  .shot__box img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .shot__box.is-contain img { object-fit: contain; padding: 3%; }
  .zoom { position: absolute; inset: 0; cursor: zoom-in; }
  .shot__box.is-light { background: #f4f3f1; }
  .shot__box.is-dark { background: #1c1c26; }
  .shot__box.is-brand { background: #282931; }
  figcaption { font-size: .8rem; color: var(--muted); }
  /* Placeholder: fondo oscuro morado con halo de luz, Montserrat y la paleta funcional */
  .ph { position: absolute; inset: 0; display: grid; align-content: center; justify-items: center; gap: .5rem; padding: 1.25rem; text-align: center; color: #fff; font-family: 'Montserrat Variable', 'Montserrat', system-ui, sans-serif;
        background: radial-gradient(70% 80% at 72% 8%, rgb(168 85 247 / .5), transparent 65%), radial-gradient(60% 70% at 12% 105%, rgb(124 205 225 / .28), transparent 70%), #1a1030; }
  .ph::after { content: ''; position: absolute; inset: .6rem; border: 1px dashed rgb(255 255 255 / .28); border-radius: 3px; pointer-events: none; }
  .ph__tag { font-size: .62rem; font-weight: 700; letter-spacing: .2em; text-transform: uppercase; padding: .15rem .6rem; border: 1px solid #ff7a3d; color: #ff9a68; border-radius: 999px; }
  .ph__t { font-size: clamp(.85rem, 1.3vw, 1.05rem); font-weight: 700; line-height: 1.25; max-width: 28ch; }
  .ph__why { font-size: .72rem; line-height: 1.45; color: rgb(255 255 255 / .75); max-width: 36ch; }
</style>
