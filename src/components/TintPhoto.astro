---
// Foto teñida: un SVG de formas (mismas proporciones que la foto) se superpone en la posición exacta,
// con desenfoque y mezcla «soft light», y toma los colores del widget (--c0 / --c1, por defecto la paleta de la marca).
// Las dos formas del SVG se identifican por su relleno: la 1.ª (magenta) lleva --c0 y la 2.ª (verde), --c1.
import { readFileSync } from 'node:fs';
import { join } from 'node:path';
import { withBase } from '../lib/i18n';

const { photo, shapes, alt = '', ratio = '1792 / 2400', blur = 1.1, strength = 1, picker = false, mode = 'color', opacity = 0.67 } = Astro.props as { photo: string; shapes: string; alt?: string; ratio?: string; blur?: number; strength?: number; picker?: boolean; mode?: string; opacity?: number };
const modes = ['soft-light', 'overlay', 'hard-light', 'color', 'hue', 'saturation', 'luminosity', 'multiply', 'screen', 'color-dodge', 'color-burn', 'darken', 'lighten', 'difference', 'normal'];
// Los dos colores de relleno del SVG (en orden de aparición) se reemplazan por --c0 y --c1, sea cual sea su valor
const raw = readFileSync(join(process.cwd(), 'public', shapes), 'utf8');
const fills = [...new Set([...raw.matchAll(/fill:\s*(rgb\([^)]*\)|#[0-9a-fA-F]{3,8})/g)].map((m) => m[1]))];
let svg = raw
  .replace(/<\?xml[^>]*>|<!DOCTYPE[^>]*>/g, '')
  .replace(/<svg\b([^>]*)>/i, (_m, a) => `<svg${a.replace(/\s(width|height)="[^"]*"/g, '')} preserveAspectRatio="xMidYMid slice" aria-hidden="true">`);
fills.slice(0, 2).forEach((f, i) => { svg = svg.split(`fill:${f}`).join(`fill:var(--c${i})`); });
---
<div class="tpw" data-tp style={`--blur:${blur};--op:${opacity};--mode:${mode}`}>
  <figure class="tp" style={`--r:${ratio}`}>
    <img src={withBase(photo)} alt={alt} loading="lazy" decoding="async" />
    <div class="tp__tint" set:html={svg} />
    {strength > 1 && <div class="tp__tint tp__tint--2" set:html={svg} />}
  </figure>
  {picker && (
    <div class="tp__ctl">
      <label>Fusión
        <select data-tp-mode>{modes.map((m) => <option value={m} selected={m === mode}>{m}</option>)}</select>
      </label>
      <label>Desenfoque <output data-tp-blur-out>{blur}</output>
        <input type="range" min="0" max="5" step="0.1" value={blur} data-tp-blur />
      </label>
      <label>Opacidad <output data-tp-op-out>100</output>
        <input type="range" min="0" max="100" step="1" value={Math.round(opacity * 100)} data-tp-op />
      </label>
    </div>
  )}
</div>

<style>
  .tp { position: relative; margin: 0; aspect-ratio: var(--r); overflow: hidden; container-type: inline-size; border-radius: 3px; background: #000; isolation: isolate; }
  .tp img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; display: block; }
  .tpw { display: grid; gap: .75rem; }
  .tp__ctl { display: grid; gap: .6rem; font-size: .75rem; color: var(--muted); }
  .tp__ctl label { display: grid; grid-template-columns: 6.5rem 1fr; align-items: center; gap: .5rem; }
  .tp__ctl output { display: none; }
  .tp__ctl select { font: inherit; color: var(--fg); background: color-mix(in srgb, var(--bg) 70%, transparent); border: 1px solid var(--line); border-radius: 999px; padding: .3rem .8rem; }
  .tp__ctl input[type=range] { width: 100%; accent-color: var(--fg); }
  .tp__tint { position: absolute; inset: 0; pointer-events: none; mix-blend-mode: var(--mode, color); filter: blur(calc(var(--blur) * 1cqw)); opacity: var(--op, 1); transform: scale(1.04); }
  .tp__tint :global(svg) { width: 100%; height: 100%; display: block; }
  .tp__tint :global(path) { transition: fill .8s linear; }
</style>

<script>
  // Selector de prueba: modo de fusión, desenfoque y opacidad de la capa de color (delegado, sirve tras cada navegación)
  const bind = () => {
    document.querySelectorAll<HTMLElement>('[data-tp]:not([data-tp-ready])').forEach((w) => {
      w.dataset.tpReady = '1';
      const layers = () => Array.from(w.querySelectorAll<HTMLElement>('.tp__tint'));
      w.querySelector<HTMLSelectElement>('[data-tp-mode]')?.addEventListener('change', (e) => layers().forEach((l) => (l.style.mixBlendMode = (e.target as HTMLSelectElement).value)));
      w.querySelector<HTMLInputElement>('[data-tp-blur]')?.addEventListener('input', (e) => w.style.setProperty('--blur', (e.target as HTMLInputElement).value));
      w.querySelector<HTMLInputElement>('[data-tp-op]')?.addEventListener('input', (e) => w.style.setProperty('--op', String(Number((e.target as HTMLInputElement).value) / 100)));
    });
  };
  document.addEventListener('astro:page-load', bind);
</script>
