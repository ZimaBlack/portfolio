---
// Foto teñida: un SVG de formas (mismas proporciones que la foto) se superpone en la posición exacta,
// con desenfoque y mezcla «soft light», y toma los colores del widget (--c0 / --c1, por defecto la paleta de la marca).
// Las dos formas del SVG se identifican por su relleno: la 1.ª (magenta) lleva --c0 y la 2.ª (verde), --c1.
import { readFileSync } from 'node:fs';
import { join } from 'node:path';
import { withBase } from '../lib/i18n';

const { photo, shapes, alt = '', ratio = '1792 / 2400', blur = 1.1, strength = 1 } = Astro.props as { photo: string; shapes: string; alt?: string; ratio?: string; blur?: number; strength?: number };
const svg = readFileSync(join(process.cwd(), 'public', shapes), 'utf8')
  .replace(/<\?xml[^>]*>|<!DOCTYPE[^>]*>/g, '')
  .replace(/<svg\b([^>]*)>/i, (_m, a) => `<svg${a.replace(/\s(width|height)="[^"]*"/g, '')} preserveAspectRatio="xMidYMid slice" aria-hidden="true">`)
  .replace(/fill:\s*rgb\(\s*223\s*,\s*0\s*,\s*255\s*\)/g, 'fill:var(--c0)')
  .replace(/fill:\s*rgb\(\s*132\s*,\s*216\s*,\s*142\s*\)/g, 'fill:var(--c1)');
---
<figure class="tp" style={`--r:${ratio};--blur:${blur};--k:${strength}`}>
  <img src={withBase(photo)} alt={alt} loading="lazy" decoding="async" />
  <div class="tp__tint" set:html={svg} />
  {strength > 1 && <div class="tp__tint tp__tint--2" set:html={svg} />}
</figure>

<style>
  .tp { position: relative; margin: 0; aspect-ratio: var(--r); overflow: hidden; container-type: inline-size; border-radius: 3px; background: #000; isolation: isolate; }
  .tp img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; display: block; }
  .tp__tint { position: absolute; inset: 0; pointer-events: none; mix-blend-mode: soft-light; filter: blur(calc(var(--blur) * 1cqw)); transform: scale(1.04); }
  .tp__tint :global(svg) { width: 100%; height: 100%; display: block; }
  .tp__tint :global(path) { transition: fill .8s linear; }
</style>
