---
import { site } from '../data/site';
import Icon from './Icon.astro';
import { copy, paths, type Lang } from '../lib/i18n';

const { lang, section, altHref } = Astro.props as { lang: Lang; section: string; altHref: string };
const c = copy[lang];
const navHref = { home: paths.home(lang), works: paths.works(lang), contact: paths.contact(lang) } as Record<string, string>;
---
<header class="header" data-header>
  <div class="wrap header__in">
    <a href={paths.home(lang)} class="brand" aria-label={`${site.studio} — ${c.nav[0].label}`}>
      <span class="brand__name">{site.studio}</span>
    </a>
    <nav aria-label="Principal" class="nav">
      {c.nav.map((i) => <a href={navHref[i.key]} class="link" aria-current={i.key === section ? 'page' : undefined}>{i.label}</a>)}
    </nav>
    <ul class="social" aria-label="Redes">
      <li><a class="lang" href={altHref} hreflang={lang === 'es' ? 'en' : 'es'} lang={lang === 'es' ? 'en' : 'es'}>{c.switchTo}</a></li>
      {site.social.map((s) => <li><a class="soc" href={s.href} target="_blank" rel="noopener noreferrer" aria-label={s.label} title={s.label}><Icon name={s.icon} /></a></li>)}
    </ul>
  </div>
</header>

<style>
  .header { position: fixed; inset: 0 0 auto 0; z-index: 50; transition: transform .7s var(--ease), background .5s var(--ease); }
  .header.is-hidden { transform: translateY(-100%); }
  .header.is-solid { background: color-mix(in srgb, var(--bg) 78%, transparent); backdrop-filter: blur(14px); }
  .header__in { display: flex; align-items: center; justify-content: space-between; gap: 1.5rem; height: 4.5rem; font-size: .85rem; }
  .brand { display: flex; align-items: center; gap: .75rem; }
  .brand__name { font-size: 1.15rem; font-weight: 500; letter-spacing: .04em; text-transform: uppercase; }
  .nav { display: flex; gap: clamp(1rem, 3vw, 2.5rem); }
  .nav a { color: var(--muted); transition: color .4s; }
  .nav a:hover, .nav a[aria-current='page'] { color: var(--fg); }
  .social { display: flex; gap: .4rem; list-style: none; margin: 0; padding: 0; }
  .social { align-items: center; }
  .lang { font-size: .8rem; letter-spacing: .08em; text-transform: uppercase; color: var(--muted); padding-right: .6rem; margin-right: .2rem; border-right: 1px solid var(--line); transition: color .4s; }
  .lang:hover { color: var(--fg); }
  .soc { display: grid; place-items: center; width: 2.25rem; height: 2.25rem; border-radius: 50%; color: var(--muted); transition: color .4s var(--ease), background .4s var(--ease); }
  .soc :global(.ico) { width: 1.15rem; height: 1.15rem; }
  .soc:hover { color: var(--bg); background: var(--fg); }
  @media (max-width: 640px) { .soc { display: none; } .lang { border: 0; padding: 0; margin: 0; } .brand__name { font-size: 1rem; } }
</style>
