---
// Trama del manual de Omega Shields (piezas vectoriales del proyecto): vitrales Art Déco / Art Nouveau en violeta casi negro,
// con una celda central encendida en oro (tonos del concepto: #0F0D18 fondo, #232131 trazos, #E0C58E oro, brillo verde-plata en los bordes).
import { readFileSync } from 'node:fs';
import { join } from 'node:path';
const { uid = 'op', par = 'xMidYMid slice', variant = 'b', logo = true, animate = true, label = 'Omega Shields' } = Astro.props as { uid?: string; par?: string; variant?: 'a' | 'b'; logo?: boolean; animate?: boolean; label?: string };
const root = join(process.cwd(), 'public/works/omega-shields/brand');
let raw = readFileSync(join(root, `pattern-${variant}.svg`), 'utf8');
const inner = raw.replace(/<svg[^>]*>/, '').replace('</svg>', '').replace(/<defs>[\s\S]*?<\/defs>/, '');
const vb = /viewBox="([^"]+)"/.exec(raw)![1];
const dim = [...inner.matchAll(/<path d="([^"]+)" fill="#232131"\/>/g)].map((m) => m[1]);
const lit = [...inner.matchAll(/<path d="([^"]+)" fill="url\(#paint\d+_linear[^"]*\)"\/>/g)].map((m) => m[1]);
const lg = readFileSync(join(root, 'logo-glow.svg'), 'utf8');
const lgBody = lg.replace(/<svg[^>]*>/, '').replace('</svg>', '').replace(/<circle[^>]*\/>/g, '').replace(/id="([^"]+)"/g, `id="${uid}-$1"`).replace(/url\(#([^)]+)\)/g, `url(#${uid}-$1)`);
const [, , VW, VH] = vb.split(' ').map(Number);
const cx = 330, cy = 352; // centro de la celda encendida
---
<svg class={`omp ${animate ? 'omp--a' : ''}`} viewBox={vb} preserveAspectRatio={par} role="img" aria-label={label} focusable="false">
  <defs>
    <linearGradient id={`${uid}-g`} x1="230" y1="220" x2="435" y2="484" gradientUnits="userSpaceOnUse"><stop offset="0" stop-color="#7a6334" /><stop offset=".25" stop-color="#d9c083" /><stop offset=".42" stop-color="#8f7842" /><stop offset=".6" stop-color="#f3e4b0" /><stop offset=".8" stop-color="#9c8450" /><stop offset="1" stop-color="#cdb678" /></linearGradient>
    <radialGradient id={`${uid}-r`} cx="330" cy="352" r="150" gradientUnits="userSpaceOnUse"><stop offset="0" stop-color="#e9d49a" stop-opacity=".55" /><stop offset=".5" stop-color="#8e7748" stop-opacity=".18" /><stop offset="1" stop-color="#8e7748" stop-opacity="0" /></radialGradient>
  <radialGradient id={`${uid}-dg`} cx="332" cy="352" r="270" gradientUnits="userSpaceOnUse"><stop offset="0" stop-color="#e2c985" stop-opacity=".95" /><stop offset=".5" stop-color="#a98c4e" stop-opacity=".6" /><stop offset="1" stop-color="#7a6334" stop-opacity="0" /></radialGradient>
  </defs>
  <g class="omp__bgw">
  <g class="omp__dim">{dim.map((d, i) => <path d={d} fill="#1d2542" style={`--i:${i}`} />)}</g>
  <g class="omp__dimgold">{dim.map((d) => <path d={d} fill={`url(#${uid}-dg)`} />)}</g>
  <g class="omp__solid">{lit.slice(0, Math.ceil(lit.length / 2)).map((d, i) => <path d={d} fill="#1d2542" style={`--i:${i}`} />)}</g>
  <g class="omp__lit">{lit.slice(0, Math.ceil(lit.length / 2)).map((d, i) => <path d={d} fill={`url(#${uid}-g)`} style={`--i:${i}`} />)}</g>
  </g>
  {logo && <g class="omp__logo" transform={`translate(${332.5 - 30.5 * 1.05} ${352 - 37 * 1.05}) scale(1.05)`} set:html={lgBody} />}
</svg>

<style is:global>
  .omp { display: block; width: 100%; height: 100%; }
  /* Secuencia rápida: 1) las piezas se colocan en cascada, en azul oscuro · 2) el corte central se enciende en dorado · 3) el logo se arma desde los bordes de la carta */
  .omp--a .omp__dim path, .omp--a .omp__solid path { opacity: 0; animation: omp-pop .45s calc(.05s + var(--i) * .035s) cubic-bezier(.2, .9, .3, 1) forwards; }
  .omp--a .omp__lit path { opacity: 0; animation: omp-lit 1.1s calc(1.5s + var(--i) * .09s) ease-in-out forwards; }
  .omp--a .omp__logo path { opacity: 0; transform-box: fill-box; animation: omp-asm 1s calc(2.9s + var(--j) * .05s) cubic-bezier(.2, .9, .3, 1) forwards; }
  .omp__logo { filter: brightness(1.55) saturate(1.1) contrast(1.1); }
  .omp__dimgold { opacity: 0; }
  .omp--a .omp__dimgold { animation: omp-goldin 1.6s 1.9s ease forwards; }
  @keyframes omp-goldin { to { opacity: .7; } }
  .omp--a .omp__bgw { animation: omp-dimbg 1.4s 3.4s ease forwards; }
  @keyframes omp-dimbg { to { opacity: .55; } }
  @keyframes omp-pop { from { opacity: 0; transform: translateY(18px); } to { opacity: .4; transform: none; } }
  @keyframes omp-lit { 0% { opacity: 0; filter: brightness(.45); } 50% { opacity: .85; filter: brightness(.8); } 100% { opacity: 1; filter: brightness(1.15); } }
  @keyframes omp-asm { from { opacity: 0; transform: translate(var(--fx), var(--fy)); } to { opacity: 1; transform: none; } }
  @media (prefers-reduced-motion: reduce) { .omp--a * { animation: none !important; opacity: 1 !important; } }
</style>

<script>
  // El logo se arma desde los bordes de la carta: cada pieza parte hacia afuera, según su posición respecto del centro
  const initO = () => document.querySelectorAll<SVGGElement>('.omp__logo:not([data-on])').forEach((g) => {
    g.setAttribute('data-on', '');
    const ps = [...g.querySelectorAll<SVGPathElement>('path')];
    ps.forEach((p, j) => {
      const b = p.getBBox(); const dx = b.x + b.width / 2 - 30.5, dy = b.y + b.height / 2 - 37, m = Math.hypot(dx, dy) || 1;
      p.style.setProperty('--fx', `${(dx / m) * 60}px`); p.style.setProperty('--fy', `${(dy / m) * 60}px`); p.style.setProperty('--j', String(j));
    });
  });
  document.addEventListener('astro:page-load', initO); initO();
</script>
