---
// Widget de color de un proyecto: dos manejadores verticales (barras de arco iris), pegados al borde derecho junto al scroll.
// Cada manejador cambia uno de los dos colores del logotipo (`reactiveColors`); no se muestran los colores, sólo los manejadores.
// Los dos colores tiñen también el fondo de la portada, con luces asimétricas.
import type { Lang } from '../lib/i18n';
const { colors, lang } = Astro.props as { colors: string[]; lang: Lang };
const t = {
  es: { main: 'Color principal', second: 'Color secundario', random: 'Paleta al azar', toggle: 'Mostrar u ocultar los selectores de color', region: 'Selectores de color' },
  en: { main: 'Main color', second: 'Secondary color', random: 'Random palette', toggle: 'Show or hide the color pickers', region: 'Color pickers' },
}[lang];
---
<aside class="pw" data-pw data-start={colors[0]} data-start2={colors[1] ?? colors[0]} aria-label={t.region}>
  <button type="button" class="pw__tab" data-pw-toggle aria-expanded="true" aria-label={t.toggle}>
    <i data-pw-dot="0"></i><i data-pw-dot="1"></i>
  </button>
  <div class="pw__panel">
   <div class="pw__rails">
    <div class="pw__rail" data-pw-rail="0" role="slider" tabindex="0" aria-orientation="vertical" aria-label={t.main} aria-valuemin="0" aria-valuemax="360"><div class="pw__knob"></div></div>
    <div class="pw__rail" data-pw-rail="1" role="slider" tabindex="0" aria-orientation="vertical" aria-label={t.second} aria-valuemin="0" aria-valuemax="360"><div class="pw__knob"></div></div>
   <div class="pw__lq" aria-hidden="true"><i data-pw-lq="0"></i><i data-pw-lq="1"></i></div>
   </div>
   <button type="button" class="pw__random" data-pw-random aria-label={t.random} title={t.random}>
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M16 3h5v5"/><path d="M4 20 21 3"/><path d="M21 16v5h-5"/><path d="m15 15 6 6"/><path d="M4 4l5 5"/></svg>
   </button>
  </div>
</aside>

<style is:global>
  /* Modo blanco y negro: un velo que quita el color a todo el sitio (el widget queda por encima) */
  .pw__bwv { position: fixed; inset: 0; z-index: 54; pointer-events: none; opacity: 0; -webkit-backdrop-filter: grayscale(1) contrast(1.06); backdrop-filter: grayscale(1) contrast(1.06); transition: opacity 1.4s ease; }
  html[data-pw-bw] .pw__bwv { opacity: 1; }
  /* Ruido sutil que acompaña todo el modo blanco y negro: grano de película que se mueve y titila apenas */
  .pw__bwv::before { content: ''; position: absolute; inset: -10%; opacity: 0; transition: opacity 1.6s ease; mix-blend-mode: overlay; pointer-events: none;
    background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='240' height='240'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='.9' numOctaves='2' stitchTiles='stitch'/><feColorMatrix values='0 0 0 0 .5  0 0 0 0 .5  0 0 0 0 .5  0 0 0 1.5 -.2'/></filter><rect width='100%' height='100%' filter='url(%23n)'/></svg>"); background-size: 240px 240px; }
  html[data-pw-bw] .pw__bwv::before { opacity: .16; animation: pw-grain .7s steps(5) infinite; }
  @keyframes pw-grain { 0% { transform: translate(0, 0); } 20% { transform: translate(-3%, 2%); } 40% { transform: translate(2%, -3%); } 60% { transform: translate(-2%, -1%); } 80% { transform: translate(3%, 3%); } 100% { transform: translate(0, 0); } }
  @media (prefers-reduced-motion: reduce) { html[data-pw-bw] .pw__bwv::before { animation: none; } }
  /* Zumbido: al pasar a blanco y negro, un desenfoque que vibra y unas barras de interferencia, solo por un instante */
  .pw__bwv::after { content: ''; position: absolute; inset: 0; opacity: 0; mix-blend-mode: overlay;
    background: repeating-linear-gradient(0deg, rgb(255 255 255 / .55) 0 2px, transparent 2px 6px), linear-gradient(90deg, transparent 20%, rgb(255 255 255 / .35) 50%, transparent 80%); }
  html[data-pw-bw] .pw__bwv.is-buzz { animation: pw-buzz .85s steps(14, end) 1 both; }
  html[data-pw-bw] .pw__bwv.is-buzz::after { animation: pw-buzz-l .85s steps(14, end) 1 both; }
  @keyframes pw-buzz {
    0% { -webkit-backdrop-filter: grayscale(0) blur(0); backdrop-filter: grayscale(0) blur(0); }
    12% { -webkit-backdrop-filter: grayscale(.6) blur(4px); backdrop-filter: grayscale(.6) blur(4px); }
    24% { -webkit-backdrop-filter: grayscale(1) blur(1px); backdrop-filter: grayscale(1) blur(1px); }
    38% { -webkit-backdrop-filter: grayscale(1) blur(5px); backdrop-filter: grayscale(1) blur(5px); }
    52% { -webkit-backdrop-filter: grayscale(1) blur(2px); backdrop-filter: grayscale(1) blur(2px); }
    70% { -webkit-backdrop-filter: grayscale(1) blur(3px); backdrop-filter: grayscale(1) blur(3px); }
    100% { -webkit-backdrop-filter: grayscale(1) contrast(1.06) blur(0); backdrop-filter: grayscale(1) contrast(1.06) blur(0); }
  }
  @keyframes pw-buzz-l { 0% { opacity: 0; transform: translateX(-2%); } 15% { opacity: .5; transform: translateX(1.5%); } 30% { opacity: .15; } 45% { opacity: .45; transform: translateX(-1%); } 70% { opacity: .12; } 100% { opacity: 0; transform: none; } }
  @media (prefers-reduced-motion: reduce) { html[data-pw-bw] .pw__bwv.is-buzz, html[data-pw-bw] .pw__bwv.is-buzz::after { animation: none; } }
  /* El widget también pierde el color mientras dura el modo blanco y negro */
  .pw { --gs: 0; } html[data-pw-bw] .pw :is(.pw__random, .pw__tab) { filter: grayscale(1) contrast(1.05); }
  html[data-pw-bw] .pw__rail { background: linear-gradient(to bottom, #b9b9b9, #7a7a7a 55%, #444) !important; }
</style>
<style>
  /* Vertical, centrado en la altura de la pantalla y pegado al borde derecho */
  .pw { position: fixed; right: 1rem; transition: opacity .5s ease, transform .9s var(--ease); top: 50%; transform: translate(var(--pw-dx, 0px), calc(-50% + var(--pw-dy, 0px))); z-index: 55; display: flex; align-items: center; gap: .5rem; }
  .pw__panel { order: 2; display: flex; flex-direction: column; align-items: center; gap: .7rem; padding: .9rem 1rem; border: 1px solid var(--line); border-radius: 14px; box-shadow: 0 18px 50px rgb(0 0 0 / .4);
    background: color-mix(in srgb, var(--bg) 82%, transparent); -webkit-backdrop-filter: blur(14px); backdrop-filter: blur(14px);
    transition: transform .6s var(--ease), opacity .4s ease; }
  .pw.is-closed .pw__panel { transform: translateX(calc(100% + 1.2rem)); opacity: 0; pointer-events: none; position: absolute; right: 0; }

  /* Temporizador: un líquido de los colores que van a volver sube por las barras durante el minuto en blanco y negro */
  .pw__rails { position: relative; }
  .pw__lq { position: absolute; inset: 0; display: none; gap: 1rem; pointer-events: none; z-index: 3; }
  .pw.is-timing .pw__lq { display: flex; }
  .pw__lq i { position: relative; width: 2.1rem; align-self: flex-end; height: 0; border-radius: 8px; background: var(--q); box-shadow: inset 0 0 12px rgb(255 255 255 / .22); animation: pw-fill 15s linear forwards; }
  .pw__lq i:first-child { --q: var(--lq0); } .pw__lq i:last-child { --q: var(--lq1); }
  .pw__lq i::before { content: ''; position: absolute; left: 0; right: 0; top: -.45rem; height: .9rem; background: var(--q); -webkit-mask: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='34' height='14' viewBox='0 0 34 14'><path d='M0 8 Q8.5 0 17 8 T34 8 V14 H0Z' fill='black'/></svg>") 0 0 / 34px 14px repeat-x; mask: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='34' height='14' viewBox='0 0 34 14'><path d='M0 8 Q8.5 0 17 8 T34 8 V14 H0Z' fill='black'/></svg>") 0 0 / 34px 14px repeat-x; animation: pw-wave 2.4s linear infinite; }
  .pw__lq i:last-child::before { animation-duration: 3.1s; animation-direction: reverse; }
  @keyframes pw-fill { to { height: 100%; } }
  @keyframes pw-wave { to { -webkit-mask-position: 34px 0; mask-position: 34px 0; } }
  .pw__rails { display: flex; align-items: stretch; gap: 1rem; height: min(52vh, 25rem); }
  .pw__random { all: unset; box-sizing: border-box; cursor: pointer; width: 100%; height: 2.4rem; flex: none; border-radius: 8px; border: 1px solid var(--line); display: grid; place-items: center; color: var(--fg); transition: background .35s var(--ease), color .35s var(--ease), transform .5s var(--ease); }
  .pw__random:hover, .pw__random:focus-visible { background: var(--fg); color: var(--bg); transform: rotate(180deg); }
  .pw__random:focus-visible { outline: 1px solid var(--fg); outline-offset: 3px; }
  .pw__random:disabled { opacity: .4; cursor: default; pointer-events: none; }
  .pw__random svg { width: 1rem; height: 1rem; fill: none; stroke: currentColor; stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; }
  .pw__knob.is-slide { transition: top .7s var(--ease), transform .3s var(--ease); }
  /* Cada barra: el arco iris, con una perilla que toma el color que aplica */
  .pw__rail { position: relative; width: 2.1rem; border-radius: 8px; cursor: grab; touch-action: none;
    background: linear-gradient(to bottom, #e8452a, #f1e63a 17%, #6df13a 33%, #3af1f1 50%, #1a1aff 67%, #c43af1 83%, #e8452a); } /* respaldo: el script la redibuja con los colores reales */
  .pw__rail:focus-visible { outline: 1px solid var(--fg); outline-offset: 4px; }
  .pw__rail.is-drag { cursor: grabbing; }
  .pw__knob { z-index: 5; position: absolute; left: 50%; top: 0; width: 2.9rem; height: 1.5rem; margin: -.75rem 0 0 -1.45rem; border-radius: 6px; background: var(--k, #f5282c);
    border: 2px solid #fff; box-shadow: 0 2px 8px rgb(0 0 0 / .45); transition: transform .3s var(--ease); }
  .pw__rail:hover .pw__knob, .pw__rail.is-drag .pw__knob { transform: scale(1.12); }

  /* La pestaña que queda al plegar */
  .pw__tab { all: unset; box-sizing: border-box; cursor: pointer; order: 1; display: grid; gap: 3px; padding: .45rem; border: 1px solid var(--line); border-radius: 8px; background: color-mix(in srgb, var(--bg) 82%, transparent); }
  .pw__tab:focus-visible { outline: 1px solid var(--fg); outline-offset: 3px; }
  .pw__tab i { width: 1.1rem; height: .7rem; border-radius: 3px; }
  /* En el pie de la web el widget se oculta */
  .pw.is-away { opacity: 0; pointer-events: none; transform: translate(calc(var(--pw-dx, 0px) + 1.5rem), calc(-50% + var(--pw-dy, 0px))); }
  .pw.is-docked { transition: opacity .5s ease, transform .35s ease-out; }
  @media (max-width: 760px) { .pw { right: .5rem; } .pw__rails { height: min(40vh, 18rem); gap: .6rem; } .pw__rail, .pw__lq i { width: 1.7rem; } .pw__lq { gap: .6rem; } .pw__knob { width: 2.4rem; margin-left: -1.2rem; } }
  @media (prefers-reduced-motion: reduce) { .pw__panel, .pw__knob { transition: none; } .pw__lq i::before { animation: none; } }
</style>

<script>
  type LCH = [number, number, number]; // L 0-1, C ~0-0.37, h 0-360 (OKLCH: el brillo percibido es parejo entre matices, así que los colores armonizan)
  const clamp = (v: number, a: number, b: number) => Math.min(b, Math.max(a, v));
  const rand = (a: number, b: number) => a + Math.random() * (b - a);
  const norm = (h: number) => ((h % 360) + 360) % 360;

  const lin = (v: number) => (v <= 0.04045 ? v / 12.92 : Math.pow((v + 0.055) / 1.055, 2.4));
  const gamma = (v: number) => (v <= 0.0031308 ? 12.92 * v : 1.055 * Math.pow(v, 1 / 2.4) - 0.055);
  const hexToLch = (hex: string): LCH => {
    const n = parseInt(hex.replace('#', ''), 16);
    const r = lin(((n >> 16) & 255) / 255), g = lin(((n >> 8) & 255) / 255), b = lin((n & 255) / 255);
    const l = Math.cbrt(0.4122214708 * r + 0.5363325363 * g + 0.0514459929 * b);
    const m = Math.cbrt(0.2119034982 * r + 0.6806995451 * g + 0.1073969566 * b);
    const s = Math.cbrt(0.0883024619 * r + 0.2817188376 * g + 0.6299787005 * b);
    const L = 0.2104542553 * l + 0.793617785 * m - 0.0040720468 * s;
    const A = 1.9779984951 * l - 2.428592205 * m + 0.4505937099 * s;
    const B = 0.0259040371 * l + 0.7827717662 * m - 0.808675766 * s;
    return [L, Math.hypot(A, B), norm((Math.atan2(B, A) * 180) / Math.PI)];
  };
  const rgbOf = ([L, C, h]: LCH) => {
    const a = C * Math.cos((h * Math.PI) / 180), b = C * Math.sin((h * Math.PI) / 180);
    const l = (L + 0.3963377774 * a + 0.2158037573 * b) ** 3;
    const m = (L - 0.1055613458 * a - 0.0638541728 * b) ** 3;
    const s = (L - 0.0894841775 * a - 1.291485548 * b) ** 3;
    return [4.0767416621 * l - 3.3077115913 * m + 0.2309699292 * s, -1.2684380046 * l + 2.6097574011 * m - 0.3413193965 * s, -0.0041960863 * l - 0.7034186147 * m + 1.707614701 * s];
  };
  /** OKLCH → #RRGGBB; si el color se sale del gamut, baja el croma hasta que entre. */
  const toHex = ([L, C, h]: LCH) => {
    let c = C, rgb = rgbOf([L, c, h]);
    for (let k = 0; k < 40 && rgb.some((v) => v < -0.001 || v > 1.001); k++) { c *= 0.94; rgb = rgbOf([L, c, h]); }
    return '#' + rgb.map((v) => Math.round(clamp(gamma(clamp(v, 0, 1)), 0, 1) * 255).toString(16).padStart(2, '0')).join('').toUpperCase();
  };

  document.addEventListener('astro:before-swap', () => document.documentElement.removeAttribute('data-pw-bw'));
  const init = () => {
    if (!document.querySelector('.pw__bwv')) { const v = document.createElement('div'); v.className = 'pw__bwv'; v.setAttribute('aria-hidden', 'true'); document.body.appendChild(v); }
    document.querySelectorAll<HTMLElement>('[data-pw]:not([data-ready])').forEach((pw) => {
      pw.dataset.ready = '1';
      const foot = document.querySelector('#contacto, footer');
      if (foot) new IntersectionObserver((es) => es.forEach((e) => pw.classList.toggle('is-away', e.isIntersecting)), { threshold: 0.05 }).observe(foot);
      const rails = Array.from(pw.querySelectorAll<HTMLElement>('[data-pw-rail]'));
      const dots = Array.from(pw.querySelectorAll<HTMLElement>('[data-pw-dot]'));
      const toggle = pw.querySelector<HTMLButtonElement>('[data-pw-toggle]')!;
      const hero = document.querySelector<HTMLElement>('[data-pj-hero]');

      // Cada manejador parte del color de la marca; su brillo y croma se mantienen al recorrer la barra,
      // así todos los matices pesan parecido. El 2.º (la sombra) conserva su propio brillo, más oscuro.
      const base = [hexToLch(pw.dataset.start || '#F5282C'), hexToLch(pw.dataset.start2 || '#840002')];
      // Vibrantes y luminosos: croma alto y brillo alto (el 2.º, algo más oscuro para seguir haciendo de sombra)
      const L0 = [0.73, 0.58];
      const C0 = [0.27, 0.25];
      const hue = base.map((b) => b[2]);
      let touched = false;
      let fixed: string[] | null = null; // colores exactos elegidos desde una paleta de prueba (se sueltan al mover las barras)
      rails.forEach((rail, i) => {
        rail.style.background = `linear-gradient(to bottom, ${Array.from({ length: 25 }, (_, k) => toHex([L0[i], C0[i], (k / 24) * 360])).join(', ')})`;
      });

      // Dónde caen las dos luces del fondo: siempre asimétricas, y otras en cada gesto
      let ax = 20, ay = 30, bx = 78, by = 74;
      const reroll = () => {
        const left = Math.random() < 0.5;
        // Los focos de color quedan cerca del centro (asimétricos, pero juntos): ax/bx a los lados del 50 %, ay/by apenas arriba y abajo
        ax = left ? rand(30, 43) : rand(57, 70); ay = rand(34, 50);
        bx = left ? rand(57, 70) : rand(30, 43); by = rand(50, 66);
      };
      reroll();

      // Estado del botón "al azar": a la 3.ª vez todo pasa a blanco y negro, las luces se desvanecen y vuelve con otra paleta
      let bw = false, busy = false, presses = 0, intensity = 1;
      const GRAYS = ['#000000', '#CFCFCF']; // principal: negro; mechón: gris pálido
      const render = () => {
        const hex = bw ? GRAYS : fixed ?? hue.map((h, i) => toHex([L0[i], C0[i], h]));
        rails.forEach((rail, i) => {
          rail.querySelector<HTMLElement>('.pw__knob')!.style.setProperty('--k', hex[i]);
          rail.querySelector<HTMLElement>('.pw__knob')!.style.top = `${(hue[i] / 360) * 100}%`;
          rail.setAttribute('aria-valuenow', String(Math.round(hue[i])));
          dots[i].style.background = hex[i];
        });
        // Los colores reactivos del logotipo (1.º y 2.º) y las dos luces del fondo
        if (touched && hero) {
          const scope = hero.closest<HTMLElement>('[data-pw-scope]'); // toda la página del proyecto hereda los colores
          const set = (k: string, v: string) => { hero.style.setProperty(k, v); scope?.style.setProperty(k, v); };
          set('--pw-0', hex[0]);
          set('--pw-1', hex[1]);
          set('--ga', bw ? '#D8D8D8' : fixed ? fixed[0] : toHex([0.58, C0[0] * 0.9, hue[0]]));
          set('--gb', bw ? '#8A8A8A' : fixed ? fixed[1] : toHex([0.54, C0[1] * 0.9, hue[1]]));
          set('--gi', String(intensity));
          set('--ax', `${ax.toFixed(1)}%`); set('--ay', `${ay.toFixed(1)}%`);
          set('--bx', `${bx.toFixed(1)}%`); set('--by', `${by.toFixed(1)}%`);
        }
      };

      rails.forEach((rail, i) => {
        const setFromY = (clientY: number) => {
          if (busy) return;
          const r = rail.getBoundingClientRect();
          hue[i] = clamp((clientY - r.top) / r.height, 0, 1) * 360;
          fixed = null; touched = true;
          render();
        };
        let id = -1;
        rail.addEventListener('pointerdown', (e) => { if (busy) return; rail.querySelector('.pw__knob')!.classList.remove('is-slide'); id = e.pointerId; rail.setPointerCapture(id); rail.classList.add('is-drag'); reroll(); setFromY(e.clientY); });
        rail.addEventListener('pointermove', (e) => { if (e.pointerId === id) setFromY(e.clientY); });
        const end = (e: PointerEvent) => { if (e.pointerId === id) { id = -1; rail.classList.remove('is-drag'); } };
        rail.addEventListener('pointerup', end);
        rail.addEventListener('pointercancel', end);
        rail.addEventListener('keydown', (e) => {
          const step = e.shiftKey ? 20 : 5;
          if (e.key === 'ArrowDown' || e.key === 'ArrowRight') hue[i] = clamp(hue[i] + step, 0, 360);
          else if (e.key === 'ArrowUp' || e.key === 'ArrowLeft') hue[i] = clamp(hue[i] - step, 0, 360);
          else return;
          e.preventDefault(); fixed = null; touched = true; render();
        });
      });

      // Paleta al azar: dos matices con relación armónica (análogo, complementario o triádico) y todo se desliza hacia ellos
      const pickHues = (): [number, number] => {
        const base = rand(0, 360);
        const rel = [() => rand(24, 38) * (Math.random() < 0.5 ? -1 : 1), () => 180 + rand(-12, 12), () => 120 * (Math.random() < 0.5 ? -1 : 1) + rand(-10, 10)][Math.floor(Math.random() * 3)]();
        return [base, ((base + rel) % 360 + 360) % 360];
      };
      const randomize = (pre?: [number, number]) => {
        const [a, b] = pre ?? pickHues();
        hue[0] = a; hue[1] = b; fixed = null;
        reroll();
        rails.forEach((r) => r.querySelector('.pw__knob')!.classList.add('is-slide'));
        touched = true; render();
      };
      // Paletas de prueba (desde la página): fijan los dos matices sin pasar por el contador del azar
      window.addEventListener('pw:set', (e) => {
        const cols = (e as CustomEvent<{ colors: string[] }>).detail.colors;
        if (busy) return;
        fixed = cols.map((c) => c.toUpperCase());
        hue[0] = hexToLch(cols[0])[2]; hue[1] = hexToLch(cols[1])[2]; reroll();
        rails.forEach((r) => r.querySelector('.pw__knob')!.classList.add('is-slide'));
        touched = true; render();
      });
      // En la sección con hueco (data-pw-slot) el widget viaja hasta allí e invita a jugar
      const slot = document.querySelector<HTMLElement>('[data-pw-slot]');
      const dock = () => {
        const off = () => { pw.style.removeProperty('--pw-dx'); pw.style.removeProperty('--pw-dy'); pw.classList.remove('is-docked'); };
        if (!slot || matchMedia('(max-width: 860px)').matches) return off();
        const r = slot.getBoundingClientRect(), vh = innerHeight;
        if (!(r.top < vh * 0.85 && r.bottom > vh * 0.15)) return off();
        // Posición de reposo (sin desplazamiento): pegado al borde derecho de la ventana, centrado en vertical
        const w = pw.offsetWidth, h = pw.offsetHeight, vw = document.documentElement.clientWidth;
        const restX = vw - 16 - w / 2, restY = vh / 2;
        const dx = r.right - 10 - w / 2 - restX;
        const lim = Math.max(0, vh / 2 - h / 2 - 12);
        const dy = Math.max(-lim, Math.min(lim, r.top + r.height / 2 - restY));
        pw.classList.add('is-docked');
        pw.style.setProperty('--pw-dx', `${Math.round(dx)}px`); pw.style.setProperty('--pw-dy', `${Math.round(dy)}px`);
      };
      if (slot) { addEventListener('scroll', dock, { passive: true }); addEventListener('resize', dock); dock(); }
      const wait = (ms: number) => new Promise<void>((res) => setTimeout(res, ms));
      const randomBtn = pw.querySelector<HTMLButtonElement>('[data-pw-random]')!;
      randomBtn.addEventListener('click', async () => {
        if (busy) return;
        presses++;
        if (presses < 3) { randomize(); return; }
        // 3.ª vez: el sitio pierde el color durante 1 minuto (blanco y negro, con el retrato alternativo) y vuelve con otra paleta
        busy = true; randomBtn.disabled = true; presses = 0;
        // Los colores que vuelven se eligen ya: un líquido de esos colores llena las barras durante el minuto, como temporizador
        const next = pickHues();
        pw.style.setProperty('--lq0', toHex([L0[0], C0[0], next[0]])); pw.style.setProperty('--lq1', toHex([L0[1], C0[1], next[1]]));
        pw.classList.add('is-timing');
        bw = true; touched = true; render();
        document.documentElement.setAttribute('data-pw-bw', '');
        const veil = document.querySelector('.pw__bwv'); veil?.classList.remove('is-buzz'); void (veil as HTMLElement | null)?.offsetWidth; veil?.classList.add('is-buzz');
        await wait(15000);
        veil?.classList.remove('is-buzz');
        document.documentElement.removeAttribute('data-pw-bw');
        await wait(900);
        bw = false; randomize(next);
        pw.classList.remove('is-timing');
        intensity = 1; render();
        await wait(1200);
        busy = false; randomBtn.disabled = false;
      });

      const setOpen = (open: boolean) => { pw.classList.toggle('is-closed', !open); toggle.setAttribute('aria-expanded', String(open)); };
      setOpen(!matchMedia('(max-width: 760px)').matches);
      toggle.addEventListener('click', () => setOpen(pw.classList.contains('is-closed')));
      render();
    });
  };
  document.addEventListener('astro:page-load', init);
</script>
