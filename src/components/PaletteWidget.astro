---
// Widget de color de un proyecto: una barra vertical con el arco iris, pegada al borde derecho (junto al scroll).
// Se arrastra para elegir un color; al lado, la paleta de dos colores: el elegido y otro que se calcula solo
// (análogo o complementario, con una variación al azar). Los dos tiñen también el fondo de la portada.
import type { Lang } from '../lib/i18n';
const { colors, lang } = Astro.props as { colors: string[]; lang: Lang };
const t = {
  es: { hue: 'Color', pick: 'Elegido', auto: 'Automático', copied: 'Copiado', shuffle: 'Otra variación', toggle: 'Mostrar u ocultar el selector de color', region: 'Selector de paleta' },
  en: { hue: 'Color', pick: 'Picked', auto: 'Automatic', copied: 'Copied', shuffle: 'Another variation', toggle: 'Show or hide the color picker', region: 'Palette picker' },
}[lang];
---
<aside class="pw" data-pw data-start={colors[0]} data-labels={JSON.stringify(t)} aria-label={t.region}>
  <button type="button" class="pw__tab" data-pw-toggle aria-expanded="true" aria-label={t.toggle}>
    <i data-pw-dot-a></i><i data-pw-dot-b></i>
  </button>
  <div class="pw__panel">
    <div class="pw__pair">
      <button type="button" class="pw__sw" data-pw-a aria-label={t.pick}><span>{t.pick}</span><b data-hex></b></button>
      <button type="button" class="pw__sw" data-pw-b aria-label={t.auto}><span>{t.auto}</span><b data-hex></b></button>
    </div>
    <div class="pw__rail" data-pw-rail role="slider" tabindex="0" aria-orientation="vertical" aria-label={t.hue} aria-valuemin="0" aria-valuemax="360">
      <div class="pw__knob" data-pw-knob></div>
    </div>
  </div>
</aside>

<style>
  /* Vertical, centrado en la altura de la pantalla y pegado al borde derecho */
  .pw { position: fixed; right: .6rem; top: 50%; transform: translateY(-50%); z-index: 55; display: flex; align-items: center; gap: .5rem; }
  .pw__panel { display: flex; align-items: stretch; gap: .6rem; height: min(46vh, 22rem); padding: .6rem; border: 1px solid var(--line); border-radius: 999px 999px 999px 999px / 1.6rem;
    background: color-mix(in srgb, var(--bg) 82%, transparent); -webkit-backdrop-filter: blur(14px); backdrop-filter: blur(14px);
    transition: transform .6s var(--ease), opacity .4s ease; }
  .pw.is-closed .pw__panel { transform: translateX(calc(100% + 1.2rem)); opacity: 0; position: absolute; right: 0; pointer-events: none; }

  /* La paleta: el color elegido y el automático, uno sobre otro */
  .pw__pair { display: grid; grid-template-rows: 1fr 1fr; gap: .45rem; width: 4.9rem; }
  .pw__sw { all: unset; box-sizing: border-box; cursor: pointer; display: grid; align-content: end; gap: .1rem; padding: .5rem .55rem; border-radius: .8rem; border: 1px solid var(--line);
    font-size: .6rem; letter-spacing: .1em; text-transform: uppercase; transition: background-color .25s linear, transform .45s var(--ease); }
  .pw__sw b { font-weight: 500; font-size: .7rem; letter-spacing: .03em; }
  .pw__sw:hover, .pw__sw:focus-visible { transform: translateX(-2px); }
  .pw__sw:focus-visible { outline: 1px solid var(--fg); outline-offset: 2px; }

  /* La barra: el arco iris, con una perilla que toma el color elegido */
  .pw__rail { position: relative; width: 1.15rem; border-radius: 999px; cursor: grab; touch-action: none;
    background: linear-gradient(to bottom, #e8452a, #f1e63a 17%, #6df13a 33%, #3af1f1 50%, #1a1aff 67%, #c43af1 83%, #e8452a); } /* respaldo: el script la redibuja con los colores reales del selector */
  .pw__rail:focus-visible { outline: 1px solid var(--fg); outline-offset: 4px; }
  .pw__rail.is-drag { cursor: grabbing; }
  .pw__knob { position: absolute; left: 50%; top: 0; width: 1.7rem; height: 1.7rem; margin: -.85rem 0 0 -.85rem; border-radius: 50%; background: var(--k, #f5282c);
    border: 2px solid #fff; box-shadow: 0 2px 8px rgb(0 0 0 / .45); transition: transform .3s var(--ease); }
  .pw__rail:hover .pw__knob, .pw__rail.is-drag .pw__knob { transform: scale(1.12); }

  /* La pestaña que queda al plegar: los dos colores */
  .pw__tab { all: unset; box-sizing: border-box; cursor: pointer; order: 1; display: grid; gap: 2px; padding: .3rem; border: 1px solid var(--line); border-radius: 999px; background: color-mix(in srgb, var(--bg) 82%, transparent); }
  .pw__tab:focus-visible { outline: 1px solid var(--fg); outline-offset: 3px; }
  .pw__tab i { width: .8rem; height: .8rem; border-radius: 50%; }
  .pw__panel { order: 2; }
  @media (max-width: 760px) { .pw { right: .35rem; } .pw__pair { width: 3.9rem; } .pw__sw { padding: .4rem; } .pw__sw span { display: none; } .pw__panel { height: min(40vh, 18rem); } }
  @media (prefers-reduced-motion: reduce) { .pw__panel, .pw__sw, .pw__knob { transition: none; } }
</style>

<script>
  type LCH = [number, number, number]; // L 0-1, C ~0-0.37, h 0-360 (OKLCH: el brillo percibido es parejo entre matices, así que los colores armonizan)
  const clamp = (v: number, a: number, b: number) => Math.min(b, Math.max(a, v));
  const rand = (a: number, b: number) => a + Math.random() * (b - a);
  const norm = (h: number) => ((h % 360) + 360) % 360;

  const lin = (v: number) => (v <= 0.04045 ? v / 12.92 : Math.pow((v + 0.055) / 1.055, 2.4));
  const gamma = (v: number) => (v <= 0.0031308 ? 12.92 * v : 1.055 * Math.pow(v, 1 / 2.4) - 0.055);
  const hexToLch = (hex: string): LCH => {
    const n = parseInt(hex.replace('#', ''), 16);
    const r = lin(((n >> 16) & 255) / 255), g = lin(((n >> 8) & 255) / 255), b = lin((n & 255) / 255);
    const l = Math.cbrt(0.4122214708 * r + 0.5363325363 * g + 0.0514459929 * b);
    const m = Math.cbrt(0.2119034982 * r + 0.6806995451 * g + 0.1073969566 * b);
    const s = Math.cbrt(0.0883024619 * r + 0.2817188376 * g + 0.6299787005 * b);
    const L = 0.2104542553 * l + 0.793617785 * m - 0.0040720468 * s;
    const A = 1.9779984951 * l - 2.428592205 * m + 0.4505937099 * s;
    const B = 0.0259040371 * l + 0.7827717662 * m - 0.808675766 * s;
    return [L, Math.hypot(A, B), norm((Math.atan2(B, A) * 180) / Math.PI)];
  };
  const rgbOf = ([L, C, h]: LCH) => {
    const a = C * Math.cos((h * Math.PI) / 180), b = C * Math.sin((h * Math.PI) / 180);
    const l = (L + 0.3963377774 * a + 0.2158037573 * b) ** 3;
    const m = (L - 0.1055613458 * a - 0.0638541728 * b) ** 3;
    const s = (L - 0.0894841775 * a - 1.291485548 * b) ** 3;
    return [4.0767416621 * l - 3.3077115913 * m + 0.2309699292 * s, -1.2684380046 * l + 2.6097574011 * m - 0.3413193965 * s, -0.0041960863 * l - 0.7034186147 * m + 1.707614701 * s];
  };
  /** OKLCH → #RRGGBB; si el color se sale del gamut, baja el croma hasta que entre. */
  const toHex = ([L, C, h]: LCH) => {
    let c = C, rgb = rgbOf([L, c, h]);
    for (let k = 0; k < 40 && rgb.some((v) => v < -0.001 || v > 1.001); k++) { c *= 0.94; rgb = rgbOf([L, c, h]); }
    return '#' + rgb.map((v) => Math.round(clamp(gamma(clamp(v, 0, 1)), 0, 1) * 255).toString(16).padStart(2, '0')).join('').toUpperCase();
  };
  const ink = (hex: string) => (hexToLch(hex)[0] > 0.68 ? '#0b0b0a' : '#ecebe6');

  const init = () => {
    document.querySelectorAll<HTMLElement>('[data-pw]:not([data-ready])').forEach((pw) => {
      pw.dataset.ready = '1';
      const L: Record<string, string> = JSON.parse(pw.dataset.labels || '{}');
      const rail = pw.querySelector<HTMLElement>('[data-pw-rail]')!;
      const knob = pw.querySelector<HTMLElement>('[data-pw-knob]')!;
      const swA = pw.querySelector<HTMLElement>('[data-pw-a]')!;
      const swB = pw.querySelector<HTMLElement>('[data-pw-b]')!;
      const dotA = pw.querySelector<HTMLElement>('[data-pw-dot-a]')!;
      const dotB = pw.querySelector<HTMLElement>('[data-pw-dot-b]')!;
      const toggle = pw.querySelector<HTMLButtonElement>('[data-pw-toggle]')!;
      const hero = document.querySelector<HTMLElement>('[data-pj-hero]');

      // Color inicial: el de la marca. Su brillo y croma se mantienen mientras se arrastra el matiz, así todos los matices pesan parecido.
      const start = hexToLch(pw.dataset.start || '#F5282C');
      const L0 = clamp(start[0], 0.58, 0.7), C0 = clamp(start[1], 0.13, 0.22);
      let hue = start[2];
      let touched = false;
      // La barra se dibuja con los mismos colores (mismo brillo y croma) que el selector entrega
      rail.style.background = `linear-gradient(to bottom, ${Array.from({ length: 25 }, (_, i) => toHex([L0, C0, (i / 24) * 360])).join(', ')})`;

      // Segundo color: análogo (±25–36°) o complementario (180° ± 8°). Brillo y croma se mantienen cerca del primero: así armonizan.
      // Cada variación sortea también dónde caen las dos luces del fondo (siempre asimétricas).
      let complementary = true, sign = 1, jitter = 0.5, dL = 0, ax = 20, ay = 30, bx = 78, by = 74;
      const reroll = () => {
        complementary = Math.random() < 0.5; sign = Math.random() < 0.5 ? -1 : 1; jitter = Math.random(); dL = rand(-0.05, 0.05);
        const left = Math.random() < 0.5; // de qué lado cae la luz del color elegido
        ax = left ? rand(6, 30) : rand(70, 94); ay = rand(14, 40);
        bx = clamp((left ? rand(66, 92) : rand(8, 34)), 4, 96); by = rand(60, 90);
      };
      reroll();

      const render = () => {
        const a: LCH = [L0, C0, hue];
        const shift = complementary ? 180 + (jitter - 0.5) * 16 : sign * (25 + jitter * 11);
        const b: LCH = [clamp(L0 + dL, 0.5, 0.74), C0 * (complementary ? 0.88 : 0.95), norm(hue + shift)];
        const hexA = toHex(a), hexB = toHex(b);
        knob.style.setProperty('--k', hexA);
        knob.style.top = `${(hue / 360) * 100}%`;
        rail.setAttribute('aria-valuenow', String(Math.round(hue)));
        [[swA, hexA], [swB, hexB]].forEach(([el, hex]) => {
          const sw = el as HTMLElement;
          sw.style.backgroundColor = hex as string; sw.style.color = ink(hex as string);
          sw.querySelector<HTMLElement>('[data-hex]')!.textContent = hex as string;
          sw.dataset.hex = hex as string;
        });
        dotA.style.background = hexA; dotB.style.background = hexB;
        // Una vez que se usa, la portada del proyecto toma los dos colores: dos luces grandes en posiciones asimétricas
        if (touched && hero) {
          const set = (k: string, v: string) => hero.style.setProperty(k, v);
          set('--ga', toHex([0.46, C0 * 0.95, hue]));
          set('--gb', toHex([0.4, b[1] * 0.95, b[2]]));
          set('--ax', `${ax.toFixed(1)}%`); set('--ay', `${ay.toFixed(1)}%`);
          set('--bx', `${bx.toFixed(1)}%`); set('--by', `${by.toFixed(1)}%`);
          // Los colores del logotipo que son "reactivos": el 1.º sigue al elegido; el 2.º, al automático (más oscuro, como una sombra)
          set('--pw-0', hexA);
          set('--pw-1', toHex([b[0] - 0.17, b[1] * 0.9, b[2]]));
        }
      };

      const setFromY = (clientY: number) => {
        const r = rail.getBoundingClientRect();
        hue = clamp((clientY - r.top) / r.height, 0, 1) * 360;
        touched = true;
        render();
      };
      let id = -1;
      rail.addEventListener('pointerdown', (e) => { id = e.pointerId; rail.setPointerCapture(id); rail.classList.add('is-drag'); reroll(); setFromY(e.clientY); });
      rail.addEventListener('pointermove', (e) => { if (e.pointerId === id) setFromY(e.clientY); });
      const end = (e: PointerEvent) => { if (e.pointerId === id) { id = -1; rail.classList.remove('is-drag'); } };
      rail.addEventListener('pointerup', end);
      rail.addEventListener('pointercancel', end);
      rail.addEventListener('keydown', (e) => {
        const step = e.shiftKey ? 20 : 5;
        if (e.key === 'ArrowDown' || e.key === 'ArrowRight') hue = clamp(hue + step, 0, 360);
        else if (e.key === 'ArrowUp' || e.key === 'ArrowLeft') hue = clamp(hue - step, 0, 360);
        else return;
        e.preventDefault(); touched = true; render();
      });

      // Clic en un color: lo copia. En el automático, además, sortea otra variación.
      let timer = 0;
      const copy = async (sw: HTMLElement, again: boolean) => {
        const hex = sw.dataset.hex!;
        try { await navigator.clipboard.writeText(hex); } catch { /* sin portapapeles */ }
        const b = sw.querySelector<HTMLElement>('[data-hex]')!;
        b.textContent = L.copied;
        clearTimeout(timer);
        timer = window.setTimeout(() => { if (again) { reroll(); touched = true; } render(); }, 700);
      };
      swA.addEventListener('click', () => copy(swA, false));
      swB.addEventListener('click', () => copy(swB, true));
      swB.title = L.shuffle;

      const setOpen = (open: boolean) => { pw.classList.toggle('is-closed', !open); toggle.setAttribute('aria-expanded', String(open)); };
      setOpen(!matchMedia('(max-width: 760px)').matches);
      toggle.addEventListener('click', () => setOpen(pw.classList.contains('is-closed')));
      render();
    });
  };
  document.addEventListener('astro:page-load', init);
</script>
