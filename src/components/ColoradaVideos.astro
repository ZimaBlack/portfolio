---
// «Videos de prueba con IA»: tres clips verticales generados con IA, tratados como un solo sistema.
// Todo lo de encima está hecho con código y usa SOLO los dos tonos de la marca (--c0 y --c1):
//  · entrada: el logo aparece con un disco de color;
//  · subtítulos: lo que dice el audio (transcripción con tiempos por palabra), palabra por palabra, con una línea de código que se escribe;
//  · elementos superpuestos: marcas de rostro, paleta, etiqueta y stickers;
//  · cierre: el mismo líquido del hero de Colorada con el logo en composición.
// Mientras suena uno, los otros se detienen y pierden el color.
import { readFileSync } from 'node:fs';
import { join } from 'node:path';
import { Code } from 'astro:components';
import { withBase, type Lang } from '../lib/i18n';

const { lang } = Astro.props as { lang: Lang };
const es = lang === 'es';
const t = (a: string, b: string) => (es ? a : b);
const V = '/works/colorada/videos';

const character = readFileSync(join(process.cwd(), 'public/works/colorada/logo.svg'), 'utf8')
  .replace(/fill="#E03B7A"/gi, 'style="fill:var(--c0)"')
  .replace(/fill="#6CE829"/gi, 'style="fill:var(--c1)"')
  .replace(/<svg\b([^>]*)>/i, (_m, a) => `<svg${a.replace(/\s(width|height)="[^"]*"/g, '')} role="img" aria-label="Colorada">`);

type Word = { w: string; a: number; b: number; code: string };
type Layer = { kind: 'brackets' | 'chips' | 'tag' | 'sticker'; a: number; b: number; text?: string };
type Clip = { n: string; title: string; note: string; src: string; poster: string; words: Word[]; layers: Layer[] };

// Palabras y tiempos: transcripción del audio de cada clip (Whisper, con revisión de tiempos por palabra)
const clips: Clip[] = [
  {
    n: '01', title: t('Noche neón', 'Neon night'), note: t('Dice: «Fluo, neón, oscuro, colorada».', 'It says: “Fluo, neón, oscuro, colorada”.'),
    src: `${V}/prueba-01.mp4`, poster: `${V}/prueba-01.webp`,
    words: [
      { w: 'Fluo,', a: 0.0, b: 1.32, code: 'glow(hair, "#6CE829")' },
      { w: 'neón,', a: 1.42, b: 2.62, code: 'light = "neon"' },
      { w: 'oscuro,', a: 3.46, b: 4.8, code: 'scene.mood = "dark"' },
      { w: 'colorada.', a: 5.76, b: 6.92, code: 'brand = "colorada"' },
    ],
    layers: [
      { kind: 'brackets', a: 0.5, b: 7.6 },
      { kind: 'chips', a: 1.5, b: 7.6 },
      { kind: 'sticker', a: 5.76, b: 7.6, text: 'Let’s blend!' },
    ],
  },
  {
    n: '02', title: t('Kawaii y caos', 'Kawaii and chaos'), note: t('Dice: «Fluo, neón, oscuro, kawaii, caos, colorada».', 'It says: “Fluo, neón, oscuro, kawaii, caos, colorada”.'),
    src: `${V}/prueba-02.mp4`, poster: `${V}/prueba-02.webp`,
    words: [
      { w: 'Fluo,', a: 0.0, b: 1.0, code: 'glow(hair, "#6CE829")' },
      { w: 'neón,', a: 1.04, b: 1.96, code: 'light = "neon"' },
      { w: 'oscuro,', a: 2.48, b: 2.96, code: 'scene.mood = "dark"' },
      { w: 'kawaii,', a: 3.54, b: 4.7, code: 'style.add("kawaii")' },
      { w: 'caos,', a: 4.94, b: 5.52, code: 'chaos.on()' },
      { w: 'colorada.', a: 5.92, b: 7.04, code: 'brand = "colorada"' },
    ],
    layers: [
      { kind: 'chips', a: 1.0, b: 7.6 },
      { kind: 'sticker', a: 3.54, b: 4.9, text: 'Kawaii' },
      { kind: 'sticker', a: 4.94, b: 5.9, text: t('¡Caos!', 'Chaos!') },
      { kind: 'brackets', a: 5.9, b: 7.6 },
    ],
  },
  {
    n: '03', title: t('Spray en mano', 'Spray in hand'), note: t('Sin voz en el audio: no lleva subtítulos.', 'No voice in the audio: no subtitles.'),
    src: `${V}/prueba-03.mp4`, poster: `${V}/prueba-03.webp`,
    words: [],
    layers: [
      { kind: 'tag', a: 1.0, b: 6.4, text: t('Spray de color', 'Colour spray') },
      { kind: 'chips', a: 2.0, b: 7.6 },
      { kind: 'brackets', a: 3.0, b: 7.6 },
    ],
  },
];

const OUT_AT = 8.0; // el cierre es el mismo en los tres: el líquido del hero con el logo
const IN_TO = 1.5;
const timelineCode = (c: Clip) => `// ${c.title}: la línea de tiempo que se monta sobre el video
const timeline = ${JSON.stringify({
  intro: { logo: 'colorada', to: IN_TO },
  words: c.words.map(({ w, a, b, code }) => ({ w, a, b, code })),
  layers: c.layers.map(({ kind, a, b, text }) => ({ kind, a, b, ...(text ? { text } : {}) })),
  outro: { effect: 'hero-liquid', logo: 'colorada', at: OUT_AT },
}, null, 2)};`;

const L = {
  title: t('Videos de prueba con IA', 'AI test videos'),
  lead: t('Tres clips verticales generados con IA, tratados como un solo sistema. Sobre cada uno monté con código la entrada del logo, los subtítulos de lo que dice el audio con una línea de código que se escribe, elementos superpuestos y el mismo cierre: el líquido del hero con el logo. Al reproducir uno, los otros se detienen y pierden el color.', 'Three vertical AI-generated clips, treated as a single system. Over each one I built, in code, the logo entrance, subtitles of what the audio says with a typed line of code, overlaid elements and the same closing: the hero’s liquid with the logo. When one plays, the others stop and lose their colour.'),
  layers: t('Con capas', 'With layers'), raw: t('Original', 'Original'),
  play: t('Reproducir', 'Play'), pause: t('Pausar', 'Pause'), mute: t('Silenciar', 'Mute'), unmute: t('Activar sonido', 'Unmute'),
  code: t('Ver el código de las capas', 'View the layers’ code'),
  tag: t('Generados con IA (Gemini); las personas que aparecen no existen. Tocá un video para escucharlo.', 'AI-generated (Gemini); the people shown do not exist. Tap a video to hear it.'),
  region: t('Videos de prueba', 'Test videos'),
};
---
<section class="wrap cmv" id="videos-ia" data-reveal aria-label={L.region}>
  <header class="cmv__head">
    <h2 class="h2">{L.title}</h2>
    <p class="cmv__lead">{L.lead}</p>
    <div class="cmv__tools">
      <div class="cmv__seg" role="group" aria-label={L.title}>
        <button type="button" data-cmv-mode="layers" aria-pressed="true">{L.layers}</button>
        <button type="button" data-cmv-mode="raw" aria-pressed="false">{L.raw}</button>
      </div>
      <p class="cmv__tag">{L.tag}</p>
    </div>
  </header>

  <div class="cmv__row">
    {clips.map((c) => (
      <article class="vp" data-vp data-play={L.play} data-pause={L.pause} data-mute={L.mute} data-unmute={L.unmute} data-out={OUT_AT}>
        <div class="vp__screen">
          <video src={withBase(c.src)} poster={withBase(c.poster)} playsinline preload="metadata" aria-label={`${L.title} ${c.n}: ${c.title}`}></video>

          <div class="ly ly--prog" aria-hidden="true"><i></i></div>

          {c.layers.map((l) => (
            <div class={`ly ly--${l.kind}`} data-a={l.a} data-b={l.b} aria-hidden="true">
              {l.kind === 'brackets' && (<><i></i><i></i><i></i><i></i><span>face.lock</span></>)}
              {l.kind === 'chips' && (<><b><i style="background:var(--c0)"></i>#E03B7A</b><b><i style="background:var(--c1)"></i>#6CE829</b></>)}
              {l.kind === 'tag' && (<><i></i><span>{l.text}</span><em>colorada</em></>)}
              {l.kind === 'sticker' && <span>{l.text}</span>}
            </div>
          ))}

          {c.words.length > 0 && (
            <div class="cues">
              <p class="sub" lang="es" data-a="0" data-b={c.words[c.words.length - 1].b + 0.7}>
                {c.words.map((w) => <span class="w" data-a={w.a} data-b={w.b} data-code={w.code}>{w.w} </span>)}
              </p>
              <code class="cue__code" data-code-out></code>
            </div>
          )}

          <!-- Entrada: el logo con un disco de color (dos tonos) -->
          <div class="ly ly--in" data-a="0" data-b={IN_TO} aria-hidden="true">
            <i class="in__disc"></i><i class="in__ring"></i><div class="in__logo" set:html={character} />
          </div>

          <!-- Cierre: el líquido del hero (los dos tonos de la marca) con el logo en composición -->
          <div class="ly ly--out is-leaving" data-a={OUT_AT} data-b="99" data-pj-out data-liquid-on style="--ax:36%;--ay:42%;--bx:64%;--by:58%;" aria-hidden="true">
            <canvas class="out__liq" data-pj-liquid></canvas>
            <div class="out__logo" set:html={character} />
          </div>

          <button type="button" class="vp__snd" data-vp-snd aria-pressed="false" aria-label={L.mute}>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 9v6h4l5 4V5L8 9z" /><path class="on" d="M16 8.5a5 5 0 0 1 0 7M18.5 6a8.5 8.5 0 0 1 0 12" /><path class="off" d="M16 9l5 6M21 9l-5 6" /></svg>
          </button>
          <button type="button" class="vp__btn" data-vp-btn aria-label={L.play}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5v14l11-7z" /></svg></button>
        </div>
        <h3 class="vp__t"><span>{c.n}</span>{c.title}</h3>
        <p class="vp__n">{c.note}</p>
        <details class="vp__code">
          <summary>{L.code}</summary>
          <Code code={timelineCode(c)} lang="ts" theme="github-dark" wrap={false} />
        </details>
      </article>
    ))}
  </div>
</section>

<script>
  import { initLiquid } from '../scripts/liquid';

  const esc = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;');
  const hl = (s: string) => esc(s)
    .replace(/("[^"]*")/g, '<i class="s">$1</i>')
    .replace(/(#[0-9a-fA-F]{6})/g, '<i class="h" style="--h:$1">$1</i>');

  // Un solo clip suena a la vez: los demás se detienen y pierden el color hasta que el activo se pausa o termina.
  let active: HTMLElement | null = null;
  const vps = () => [...document.querySelectorAll<HTMLElement>('[data-vp]')];
  const undim = () => vps().forEach((x) => x.classList.remove('is-dim'));

  const initVideos = () => {
    const hero = document.querySelector<HTMLElement>('[data-pj-hero]');

    document.querySelectorAll<HTMLElement>('[data-vp]:not([data-on])').forEach((vp) => {
      vp.setAttribute('data-on', '');
      const v = vp.querySelector('video')!;
      const btn = vp.querySelector<HTMLButtonElement>('[data-vp-btn]')!;
      const snd = vp.querySelector<HTMLButtonElement>('[data-vp-snd]')!;
      const out = vp.querySelector<HTMLElement>('[data-pj-out]')!;
      const outAt = +(vp.dataset.out ?? 8);
      const layers = [...vp.querySelectorAll<HTMLElement>('.ly[data-a], .sub[data-a]')].map((el) => ({ el, a: +el.dataset.a!, b: +el.dataset.b!, on: false }));
      const words = [...vp.querySelectorAll<HTMLElement>('.w')].map((el) => ({ el, a: +el.dataset.a!, b: +el.dataset.b!, code: el.dataset.code ?? '' }));
      const codeOut = vp.querySelector<HTMLElement>('[data-code-out]');
      const prog = vp.querySelector<HTMLElement>('.ly--prog i')!;
      let raf = 0, lastCode = '';

      // El líquido del hero, con los colores del widget de la página
      initLiquid(out);
      const mirror = () => { if (!hero) return; ['--ga', '--gb', '--ax', '--ay', '--bx', '--by'].forEach((k) => { const val = hero.style.getPropertyValue(k); if (val) out.style.setProperty(k, val); }); };
      if (hero) { mirror(); new MutationObserver(mirror).observe(hero, { attributes: true, attributeFilter: ['style'] }); }

      const tick = () => {
        const t = v.currentTime, d = v.duration || 10;
        prog.style.transform = `scaleX(${Math.min(1, t / d)})`;
        for (const l of layers) {
          const on = t >= l.a && t < l.b;
          if (on !== l.on) { l.on = on; l.el.classList.toggle('is-on', on); if (l.el === out) out.classList.toggle('is-leaving', !on); }
        }
        // Subtítulos palabra por palabra + la línea de código de la palabra que suena
        let idx = -1;
        if (t > 0.05) words.forEach((w, i) => { if (t >= w.a) idx = i; }); // en reposo (t = 0) ninguna palabra está resaltada
        words.forEach((w, i) => {
          w.el.classList.toggle('is-now', i === idx && t <= w.b + 0.15);
          w.el.classList.toggle('is-done', i < idx || (i === idx && t > w.b + 0.15));
        });
        if (codeOut) {
          if (idx < 0) { if (lastCode) { codeOut.innerHTML = ''; lastCode = ''; } }
          else {
            const w = words[idx], n = Math.min(w.code.length, Math.ceil(((t - w.a) / 0.6) * w.code.length));
            const html = hl(w.code.slice(0, n)) + (n < w.code.length ? '<u></u>' : '');
            if (html !== lastCode) { lastCode = html; codeOut.innerHTML = html; }
          }
        }
        raf = v.paused ? 0 : requestAnimationFrame(tick);
      };
      const sync = () => {
        vp.classList.toggle('is-paused', v.paused);
        btn.setAttribute('aria-label', (v.paused ? vp.dataset.play : vp.dataset.pause) ?? '');
        if (!v.paused && !raf) raf = requestAnimationFrame(tick);
        if (v.paused) tick();
      };
      v.addEventListener('play', sync);
      v.addEventListener('seeked', tick);
      v.addEventListener('pause', () => { if (active === vp && !v.ended) { active = null; undim(); } sync(); });
      v.addEventListener('ended', () => { if (active === vp) { active = null; undim(); } sync(); });

      const play = () => {
        if (v.ended || v.currentTime >= (v.duration || 10) - 0.05) v.currentTime = 0;
        active = vp;
        vps().forEach((o) => { if (o !== vp) { o.querySelector('video')!.pause(); o.classList.add('is-dim'); } });
        vp.classList.remove('is-dim');
        v.muted = snd.getAttribute('aria-pressed') === 'true';
        v.play().catch(() => { v.muted = true; v.play().catch(() => {}); });
      };
      const toggle = () => { if (v.paused) play(); else v.pause(); };
      btn.addEventListener('click', (e) => { e.stopPropagation(); toggle(); });
      snd.addEventListener('click', (e) => {
        e.stopPropagation();
        const muted = snd.getAttribute('aria-pressed') !== 'true';
        snd.setAttribute('aria-pressed', String(muted)); v.muted = muted;
        snd.setAttribute('aria-label', (muted ? vp.dataset.unmute : vp.dataset.mute) ?? '');
      });
      vp.querySelector('.vp__screen')!.addEventListener('click', toggle);

      // Si el clip sale de pantalla, se detiene
      if ('IntersectionObserver' in window) new IntersectionObserver(([e]) => { if (!e.isIntersecting && !v.paused) v.pause(); }, { threshold: 0.15 }).observe(vp);
      sync();
    });

    // Con capas / Original
    const root = document.getElementById('videos-ia');
    root?.querySelectorAll<HTMLButtonElement>('[data-cmv-mode]:not([data-on])').forEach((b) => {
      b.setAttribute('data-on', '');
      b.addEventListener('click', () => {
        root.classList.toggle('is-raw', b.dataset.cmvMode === 'raw');
        root.querySelectorAll('[data-cmv-mode]').forEach((o) => o.setAttribute('aria-pressed', String(o === b)));
      });
    });
  };
  document.addEventListener('astro:page-load', initVideos);
  initVideos();
</script>

<style>
  .cmv { display: grid; gap: clamp(1.8rem, 3.5vw, 3rem); }
  .cmv__head { display: grid; gap: 1rem; max-width: 52rem; }
  .cmv__lead { margin: 0; color: var(--muted); line-height: 1.6; font-size: clamp(1rem, 1.3vw, 1.15rem); }
  .cmv__tools { display: flex; flex-wrap: wrap; align-items: center; gap: .8rem 1.4rem; }
  .cmv__seg { display: inline-flex; border: 1px solid var(--line); border-radius: 999px; padding: .2rem; }
  .cmv__seg button { background: none; border: 0; color: var(--muted); font: inherit; font-size: .8rem; padding: .35rem .95rem; border-radius: 999px; cursor: pointer; transition: background .3s, color .3s; }
  .cmv__seg button[aria-pressed='true'] { background: var(--fg); color: var(--bg); }
  .cmv__tag { margin: 0; font-size: .75rem; color: var(--muted); }

  .cmv__row { display: grid; grid-template-columns: repeat(3, 1fr); gap: clamp(1.5rem, 3vw, 3rem); align-items: start; }
  @media (max-width: 900px) {
    .cmv__row { grid-template-columns: none; grid-auto-flow: column; grid-auto-columns: min(78%, 20rem); overflow-x: auto; scroll-snap-type: x mandatory; padding-bottom: 1rem; margin-inline: calc(var(--gutter) * -1); padding-inline: var(--gutter); }
    .vp { scroll-snap-align: center; }
  }

  .vp { display: grid; gap: .6rem; max-width: 20rem; width: 100%; margin-inline: auto; min-width: 0; }
  .vp__screen { position: relative; aspect-ratio: 9 / 16; border-radius: 2rem; overflow: hidden; background: #000; container-type: inline-size; box-shadow: 0 0 0 .45rem #15151a, 0 0 0 calc(.45rem + 1px) rgb(255 255 255 / .16), 0 1.6rem 3rem rgb(0 0 0 / .45); cursor: pointer; isolation: isolate; transition: filter .7s var(--ease); }
  .vp__screen video { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  /* Mientras suena otro clip: sin color y quieto */
  .vp.is-dim .vp__screen { filter: grayscale(1) brightness(.78); }
  .vp__t { display: flex; gap: .7rem; align-items: baseline; margin: .9rem 0 0; font-size: 1.05rem; font-weight: 600; }
  .vp__t span { color: var(--muted); font-weight: 400; font-size: .8rem; }
  .vp__n { margin: 0; color: var(--muted); font-size: .85rem; line-height: 1.5; }
  .vp__btn { position: absolute; left: 50%; top: 50%; width: 15cqw; aspect-ratio: 1; transform: translate(-50%, -50%); display: grid; place-items: center; border: 0; border-radius: 50%; background: rgb(0 0 0 / .5); color: #fff; backdrop-filter: blur(6px); cursor: pointer; z-index: 9; opacity: 0; transition: opacity .3s; }
  .vp__btn svg { width: 45%; fill: currentColor; }
  .vp.is-paused .vp__btn, .vp__screen:hover .vp__btn, .vp__btn:focus-visible { opacity: 1; }
  .vp__btn:focus-visible, .vp__snd:focus-visible { outline: 2px solid #fff; outline-offset: 3px; }
  .vp__snd { position: absolute; right: 4cqw; top: 7cqw; width: 9cqw; aspect-ratio: 1; display: grid; place-items: center; border: 0; border-radius: 50%; background: rgb(0 0 0 / .5); color: #fff; cursor: pointer; z-index: 9; backdrop-filter: blur(6px); }
  .vp__snd svg { width: 58%; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
  .vp__snd path:first-child { fill: currentColor; }
  .vp__snd .off { display: none; } .vp__snd[aria-pressed='true'] .on { display: none; } .vp__snd[aria-pressed='true'] .off { display: block; }

  /* Capas: todo lo que se monta sobre el video (solo los dos tonos de la marca) */
  .ly { position: absolute; inset: 0; pointer-events: none; z-index: 2; }
  .is-raw .ly, .is-raw .cues { display: none; }
  .ly--prog { top: 2.4cqw; bottom: auto; left: 4cqw; right: 4cqw; height: .9cqw; border-radius: 1cqw; background: rgb(255 255 255 / .28); overflow: hidden; z-index: 6; }
  .ly--prog i { display: block; height: 100%; background: var(--c1); transform-origin: left; transform: scaleX(0); }
  .ly:not(.ly--prog):not(.ly--in):not(.ly--out) { opacity: 0; transition: opacity .35s var(--ease); }
  .ly.is-on { opacity: 1; }

  /* Subtítulos: lo que dice el audio, palabra por palabra, y la línea de código de la palabra */
  .cues { position: absolute; left: 5cqw; right: 5cqw; bottom: 9cqw; z-index: 8; display: grid; gap: 1.6cqw; justify-items: start; }
  .sub { margin: 0; font-weight: 800; font-size: 6.4cqw; line-height: 1.2; color: #fff; text-shadow: 0 .4cqw 1.6cqw rgb(0 0 0 / .85); opacity: 0; transition: opacity .3s; }
  .sub.is-on { opacity: 1; }
  .w { opacity: .5; padding: 0 .6cqw; margin: 0 -.6cqw; border-radius: 1.2cqw; transition: opacity .2s, background .2s; }
  .w.is-done { opacity: 1; }
  .w.is-now { opacity: 1; background: var(--c0); box-decoration-break: clone; -webkit-box-decoration-break: clone; }
  .cue__code { font-family: ui-monospace, 'SF Mono', Menlo, monospace; font-size: 3.6cqw; line-height: 1.4; color: #e9e9ef; background: rgb(8 8 14 / .78); border: 1px solid var(--c1); border-radius: 1.4cqw; padding: 1.1cqw 2.2cqw; min-height: 1.4em; min-width: 14cqw; max-width: 100%; overflow: hidden; white-space: nowrap; backdrop-filter: blur(4px); }
  .cue__code:empty, .cues:has(.sub:not(.is-on)) .cue__code { visibility: hidden; }
  .cue__code :global(.s) { color: color-mix(in srgb, var(--c0) 55%, #fff); font-style: normal; }
  .cue__code :global(.h) { color: var(--h); font-style: normal; }
  .cue__code :global(u) { display: inline-block; width: .55ch; height: 1.05em; vertical-align: text-bottom; background: var(--c1); text-decoration: none; margin-left: .15ch; animation: blink .7s steps(2) infinite; }
  @keyframes blink { 50% { opacity: 0; } }

  /* Elementos superpuestos */
  .ly--brackets { inset: 16% 19% auto 19%; height: 40%; }
  .ly--brackets i { position: absolute; width: 11cqw; height: 11cqw; border: 0 solid var(--c1); filter: drop-shadow(0 0 1cqw rgb(0 0 0 / .6)); }
  .ly--brackets i:nth-child(1) { top: 0; left: 0; border-width: .8cqw 0 0 .8cqw; } .ly--brackets i:nth-child(2) { top: 0; right: 0; border-width: .8cqw .8cqw 0 0; }
  .ly--brackets i:nth-child(3) { bottom: 0; left: 0; border-width: 0 0 .8cqw .8cqw; } .ly--brackets i:nth-child(4) { bottom: 0; right: 0; border-width: 0 .8cqw .8cqw 0; }
  .ly--brackets span { position: absolute; left: 0; top: -6cqw; font: 700 3cqw ui-monospace, Menlo, monospace; letter-spacing: .08em; color: #fff; background: var(--c0); padding: .5cqw 1.6cqw; border-radius: 1cqw; }
  .ly--brackets.is-on { animation: lock .7s var(--ease) both; }
