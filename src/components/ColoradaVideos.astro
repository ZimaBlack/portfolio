---
// «Videos de prueba con IA»: tres muestras verticales generadas con IA, tratadas como un solo sistema.
// Encima, todo hecho con código y con solo dos tonos (--c0 y --c1):
//  · entrada y cierre: la misma tarjeta (el líquido del hero con el logo), con la misma activación;
//  · subtítulos: lo que dice el audio, palabra por palabra;
//  · superpuestos: marcas de rostro, paleta, etiqueta y stickers.
// El clip 3 no tiene voz: es un loop del cambio de color del pelo, con el logotipo (sin el isotipo) que toma esos colores.
// Mientras suena uno, los otros quedan deshabilitados: sin color, quietos y con un botón de pausa semitraslúcido.
import { readFileSync } from 'node:fs';
import { join } from 'node:path';
import { withBase, type Lang } from '../lib/i18n';

const { lang } = Astro.props as { lang: Lang };
const es = lang === 'es';
const t = (a: string, b: string) => (es ? a : b);
const V = '/works/colorada/videos';

const inline = (file: string, label: string) => readFileSync(join(process.cwd(), 'public/works/colorada', file), 'utf8')
  .replace(/fill="#E03B7A"/gi, 'style="fill:var(--c0)"')
  .replace(/fill="#6CE829"/gi, 'style="fill:var(--c1)"')
  .replace(/<svg\b([^>]*)>/i, (_m, a) => `<svg${a.replace(/\s(width|height)="[^"]*"/g, '')} role="img" aria-label="${label}">`);
const character = inline('logo.svg', 'Colorada');   // logo completo (isotipo + logotipo)
const wordmark = inline('mark.svg', 'Colorada');    // variante sin el isotipo encima

type Word = { w: string; a: number; b: number };
type Layer = { kind: 'brackets' | 'chips' | 'tag' | 'sticker'; a: number; b: number; text?: string };
type Stop = { at: number; c0: string; c1: string };
type Clip = { n: string; title: string; src: string; poster: string; words: Word[]; layers: Layer[]; loop?: boolean; stops: Stop[] };

// Paleta madre fija para las tarjetas de marca (entrada, cierre y placeholder): rosa #E03B7A y verde #6CE829
const MOTHER = '--ga:#E03B7A;--gb:#6CE829;--ax:36%;--ay:42%;--bx:64%;--by:58%;';
const IN_TO = 1.25;  // 2 pulsos del beat (96 BPM): la tarjeta de entrada se va
const OUT_AT = 7.5;  // inicio del 4.º compás del beat: llega la tarjeta de cierre

const clips: Clip[] = [
  {
    n: '01', title: t('Noche neón', 'Neon night'), src: `${V}/prueba-01.mp4`, poster: `${V}/prueba-01.webp`,
    words: [{ w: 'Fluo,', a: 0.0, b: 1.32 }, { w: 'neón,', a: 1.42, b: 2.62 }, { w: 'oscuro,', a: 3.46, b: 4.8 }, { w: 'colorada.', a: 5.76, b: 6.92 }],
    layers: [{ kind: 'brackets', a: 1.5, b: 7.5 }, { kind: 'chips', a: 1.6, b: 7.5 }, { kind: 'sticker', a: 5.76, b: 7.5, text: 'Let’s blend!' }],
    // Colores que se ven en el pelo en cada momento: los superpuestos los siguen
    stops: [
      { at: 0.0, c0: '#E8407C', c1: '#8CDF2E' }, { at: 1.5, c0: '#D43FA0', c1: '#9AE05A' }, { at: 2.0, c0: '#B547D8', c1: '#4EE8A4' },
      { at: 3.0, c0: '#A24FE0', c1: '#52E39C' }, { at: 3.5, c0: '#8A4A9A', c1: '#7BB46A' }, { at: 4.0, c0: '#7A4A68', c1: '#8A9A78' },
      { at: 4.5, c0: '#9A3E72', c1: '#6E9A4E' }, { at: 5.0, c0: '#C23E86', c1: '#7CD04A' }, { at: 5.5, c0: '#E8407C', c1: '#8CDF2E' },
    ],
  },
  {
    n: '02', title: t('Kawaii y caos', 'Kawaii and chaos'), src: `${V}/prueba-02.mp4`, poster: `${V}/prueba-02.webp`,
    words: [{ w: 'Fluo,', a: 0.0, b: 1.0 }, { w: 'neón,', a: 1.04, b: 1.96 }, { w: 'oscuro,', a: 2.48, b: 2.96 }, { w: 'kawaii,', a: 3.54, b: 4.7 }, { w: 'caos,', a: 4.94, b: 5.52 }, { w: 'colorada.', a: 5.92, b: 7.04 }],
    layers: [{ kind: 'chips', a: 1.5, b: 7.5 }, { kind: 'sticker', a: 3.54, b: 4.9, text: 'Kawaii' }, { kind: 'sticker', a: 4.94, b: 5.9, text: t('¡Caos!', 'Chaos!') }, { kind: 'brackets', a: 5.9, b: 7.5 }],
    stops: [
      { at: 0.0, c0: '#E5336E', c1: '#8FE02A' }, { at: 0.5, c0: '#EE5A8A', c1: '#C9D84A' }, { at: 1.0, c0: '#E5336E', c1: '#8FE02A' },
      { at: 1.5, c0: '#E83E8C', c1: '#43E39A' }, { at: 2.0, c0: '#D4264F', c1: '#6A6A78' }, { at: 3.0, c0: '#C9A6E4', c1: '#A8D8C8' },
      { at: 4.0, c0: '#F0409A', c1: '#A6E84A' }, { at: 4.5, c0: '#E5336E', c1: '#8FE02A' }, { at: 5.0, c0: '#E8408C', c1: '#46E8A0' }, { at: 5.5, c0: '#E5336E', c1: '#8FE02A' },
    ],
  },
  {
    // Sin voz: loop del cambio de color. Los dos tonos del logo siguen el pelo que se ve en cada momento.
    n: '03', title: t('Cambio de color', 'Colour change'), src: `${V}/prueba-03.mp4`, poster: `${V}/prueba-03.webp`, loop: true,
    words: [],
    layers: [],
    stops: [
      { at: 0.0, c0: '#C9CBD4', c1: '#3C3C44' }, // plata
      { at: 0.5, c0: '#CDB79A', c1: '#4A4038' }, // arena
      { at: 1.0, c0: '#C98A55', c1: '#6B3F2A' }, // caramelo
      { at: 1.5, c0: '#C0444E', c1: '#5E1F29' }, // rojo
      { at: 2.0, c0: '#E0508C', c1: '#8A2B52' }, // rosa
      { at: 2.5, c0: '#9A55D8', c1: '#46307F' }, // violeta
      { at: 3.0, c0: '#6A93EA', c1: '#35529F' }, // azul
      { at: 3.5, c0: '#52C6E4', c1: '#2F85AE' }, // celeste
      { at: 4.0, c0: '#3FCFA6', c1: '#1F7F6B' }, // turquesa
      { at: 4.5, c0: '#74E0A8', c1: '#2F9A6E' }, // menta
      { at: 5.1, c0: '#A9CDB6', c1: '#4E6A5C' }, // verde apagado
      { at: 5.5, c0: '#C9CBD4', c1: '#3C3C44' }, // vuelve a la plata
    ],
  },
];

const L = {
  title: t('Videos de prueba con IA', 'AI test videos'),
  lead: t('Tres muestras generadas con IA. Las capas de encima están hechas con código.', 'Three AI-generated samples. The layers on top are built in code.'),
  layers: t('Con capas', 'With layers'), raw: t('Original', 'Original'),
  play: t('Reproducir', 'Play'), pause: t('Pausar', 'Pause'), mute: t('Silenciar', 'Mute'), unmute: t('Activar sonido', 'Unmute'),
  tag: t('Generados con IA (Gemini); las personas que aparecen no existen.', 'AI-generated (Gemini); the people shown do not exist.'),
  region: t('Videos de prueba', 'Test videos'),
};
---
<section class="wrap cmv" id="videos-ia" data-reveal aria-label={L.region}>
  <header class="cmv__head">
    <h2 class="h2">{L.title}</h2>
    <p class="cmv__lead">{L.lead}</p>
    <div class="cmv__tools">
      <div class="cmv__seg" role="group" aria-label={L.title}>
        <button type="button" data-cmv-mode="layers" aria-pressed="true">{L.layers}</button>
        <button type="button" data-cmv-mode="raw" aria-pressed="false">{L.raw}</button>
      </div>
      <p class="cmv__tag">{L.tag}</p>
    </div>
  </header>

  <div class="cmv__row">
    {clips.map((c) => (
      <article class="vp" data-vp data-loop={c.loop ? '1' : undefined} data-stops={JSON.stringify(c.stops)} data-play={L.play} data-pause={L.pause} data-mute={L.mute} data-unmute={L.unmute}>
        <div class="vp__screen">
          <video src={withBase(c.src)} poster={withBase(c.poster)} playsinline preload="metadata" loop={c.loop} aria-label={`${L.title} ${c.n}: ${c.title}`}></video>

          <div class="ly ly--prog" aria-hidden="true"><i></i></div>

          {c.layers.map((l) => (
            <div class={`ly ly--${l.kind}`} data-a={l.a} data-b={l.b} aria-hidden="true">
              {l.kind === 'brackets' && (<><i></i><i></i><i></i><i></i></>)}
              {l.kind === 'chips' && (<><b style="background:var(--c0)"></b><b style="background:var(--c1)"></b></>)}
              {l.kind === 'tag' && <span>{l.text}</span>}
              {l.kind === 'sticker' && <span>{l.text}</span>}
            </div>
          ))}

          {c.words.length > 0 && (
            <p class="sub" lang="es" data-a="0" data-b={c.words[c.words.length - 1].b + 0.4}>
              {c.words.map((w) => <span class="w" data-a={w.a} data-b={w.b}>{w.w} </span>)}
            </p>
          )}

          {/* Clip 3: logotipo sin isotipo con los colores del pelo. Clips 1 y 2: la misma tarjeta (líquido del hero + logo) de entrada y de cierre */}
          {c.loop ? (
            <div class="ly ly--logo" data-a="0.15" data-b="5.8" aria-hidden="true"><div class="logo3" set:html={wordmark} /></div>
            <div class="ly ly--card ly--out is-leaving" data-a="999" data-b="999" data-hold data-pj-out data-liquid-on style={MOTHER} aria-hidden="true">
              <canvas class="card__liq" data-pj-liquid></canvas><div class="card__logo" set:html={character} />
            </div>
          ) : (
            <>
              <div class="ly ly--card ly--in is-leaving" data-a="0" data-b={IN_TO} data-pj-out data-liquid-on style={MOTHER} aria-hidden="true">
                <canvas class="card__liq" data-pj-liquid></canvas><div class="card__logo" set:html={character} />
              </div>
              <div class="ly ly--card ly--out is-leaving" data-a={OUT_AT} data-b="99" data-hold data-pj-out data-liquid-on style={MOTHER} aria-hidden="true">
                <canvas class="card__liq" data-pj-liquid></canvas><div class="card__logo" set:html={character} />
              </div>
            </>
          )}

          {(
            <button type="button" class="vp__snd" data-vp-snd aria-pressed="false" aria-label={L.mute}>
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 9v6h4l5 4V5L8 9z" /><path class="on" d="M16 8.5a5 5 0 0 1 0 7M18.5 6a8.5 8.5 0 0 1 0 12" /><path class="off" d="M16 9l5 6M21 9l-5 6" /></svg>
            </button>
          )}
          <button type="button" class="vp__btn" data-vp-btn aria-label={L.play}>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path class="i-play" d="M8 5v14l11-7z" /><path class="i-pause" d="M7 5h3.6v14H7zM13.4 5H17v14h-3.6z" /></svg>
          </button>
          <!-- Clip deshabilitado mientras suena otro: botón de pausa semitraslúcido -->
          <span class="vp__lock" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M7 5h3.6v14H7zM13.4 5H17v14h-3.6z" /></svg></span>
        </div>
      </article>
    ))}
  </div>
</section>

<script>
  import { initLiquid } from '../scripts/liquid';

  // Un solo clip suena a la vez: los demás quedan deshabilitados (sin color y quietos) hasta que el activo se pausa.
  let active: HTMLElement | null = null;
  const vps = () => [...document.querySelectorAll<HTMLElement>('[data-vp]')];
  const setDim = (el: HTMLElement, on: boolean) => { el.classList.toggle('is-dim', on); if (on) el.setAttribute('aria-disabled', 'true'); else el.removeAttribute('aria-disabled'); };
  const undim = () => vps().forEach((x) => setDim(x, false));
  // Luminancia relativa: decide si el texto sobre el color va oscuro o claro
  const lum = (hex: string) => { const n = parseInt(hex.slice(1), 16); const c = [(n >> 16) & 255, (n >> 8) & 255, n & 255].map((v) => { v /= 255; return v <= 0.03928 ? v / 12.92 : ((v + 0.055) / 1.055) ** 2.4; }); return 0.2126 * c[0] + 0.7152 * c[1] + 0.0722 * c[2]; };

  const initVideos = () => {
    document.querySelectorAll<HTMLElement>('[data-vp]:not([data-on])').forEach((vp) => {
      vp.setAttribute('data-on', '');
      const v = vp.querySelector('video')!;
      const btn = vp.querySelector<HTMLButtonElement>('[data-vp-btn]')!;
      const snd = vp.querySelector<HTMLButtonElement>('[data-vp-snd]');
      const cards = [...vp.querySelectorAll<HTMLElement>('[data-pj-out]')];
      const layers = [...vp.querySelectorAll<HTMLElement>('.ly[data-a], .sub[data-a]')].map((el) => ({ el, a: +el.dataset.a!, b: +el.dataset.b!, on: false }));
      const words = [...vp.querySelectorAll<HTMLElement>('.w')].map((el) => ({ el, a: +el.dataset.a!, b: +el.dataset.b! }));
      const stops: { at: number; c0: string; c1: string }[] = vp.dataset.stops ? JSON.parse(vp.dataset.stops) : [];
      const prog = vp.querySelector<HTMLElement>('.ly--prog i')!;
      let raf = 0, stopAt = -1;

      // El líquido del hero, siempre con la paleta madre (no sigue al widget)
      cards.forEach(initLiquid);

      const tick = () => {
        const t = v.currentTime, d = v.duration || 10;
        prog.style.transform = `scaleX(${Math.min(1, t / d)})`;
        for (const l of layers) {
          // La tarjeta de marca (data-hold) también es el placeholder: se ve siempre que el video está frenado
          const on = (t >= l.a && t < l.b) || (v.paused && l.el.hasAttribute('data-hold'));
          if (on !== l.on) { l.on = on; l.el.classList.toggle('is-on', on); if (l.el.hasAttribute('data-pj-out')) l.el.classList.toggle('is-leaving', !on); }
        }
        // Subtítulos: la palabra que suena se resalta
        let idx = -1;
        if (t > 0.05) words.forEach((w, i) => { if (t >= w.a) idx = i; }); // en reposo (t = 0) ninguna palabra está resaltada
        words.forEach((w, i) => {
          w.el.classList.toggle('is-now', i === idx && t <= w.b + 0.15);
          w.el.classList.toggle('is-done', i < idx || (i === idx && t > w.b + 0.15));
        });
        // Clip 3: el logotipo toma los colores del pelo que se ve
        if (stops.length) {
          let k = 0; stops.forEach((s, i) => { if (t >= s.at) k = i; });
          if (k !== stopAt) { stopAt = k; vp.style.setProperty('--v0', stops[k].c0); vp.style.setProperty('--v1', stops[k].c1); vp.style.setProperty('--on0', lum(stops[k].c0) > 0.4 ? '#14080f' : '#fff'); }
        }
        raf = v.paused ? 0 : requestAnimationFrame(tick);
      };
      const sync = () => {
        vp.classList.toggle('is-paused', v.paused);
        btn.setAttribute('aria-label', (v.paused ? vp.dataset.play : vp.dataset.pause) ?? '');
        if (!v.paused && !raf) raf = requestAnimationFrame(tick);
        if (v.paused) tick();
      };
      v.addEventListener('play', sync);
      v.addEventListener('seeked', tick);
      v.addEventListener('pause', () => { if (active === vp && !v.ended) { active = null; undim(); } sync(); });
      v.addEventListener('ended', () => { if (active === vp) { active = null; undim(); } sync(); });

      const play = () => {
        if (vp.classList.contains('is-dim')) return; // deshabilitado mientras suena otro
        if (v.ended || (!v.loop && v.currentTime >= (v.duration || 10) - 0.05)) v.currentTime = 0;
        active = vp;
        vps().forEach((o) => { if (o !== vp) { o.querySelector('video')!.pause(); setDim(o, true); } });
        v.muted = snd?.getAttribute('aria-pressed') === 'true';
        v.play().catch(() => { v.muted = true; v.play().catch(() => {}); });
      };
      const toggle = () => { if (vp.classList.contains('is-dim')) return; if (v.paused) play(); else v.pause(); };
      btn.addEventListener('click', (e) => { e.stopPropagation(); toggle(); });
      snd?.addEventListener('click', (e) => {
        e.stopPropagation();
        const muted = snd.getAttribute('aria-pressed') !== 'true';
        snd.setAttribute('aria-pressed', String(muted)); v.muted = muted;
        snd.setAttribute('aria-label', (muted ? vp.dataset.unmute : vp.dataset.mute) ?? '');
      });
      vp.querySelector('.vp__screen')!.addEventListener('click', toggle);

      // Si el clip sale de pantalla, se detiene
      if ('IntersectionObserver' in window) new IntersectionObserver(([e]) => { if (!e.isIntersecting && !v.paused) v.pause(); }, { threshold: 0.15 }).observe(vp);
      sync();
    });

    // Con los videos a la vista, el widget de color se contrae solo
    const area = document.getElementById('videos-ia');
    if (area && 'IntersectionObserver' in window && !area.dataset.fold) {
      area.dataset.fold = '1';
      new IntersectionObserver(([e]) => window.dispatchEvent(new CustomEvent('pw:fold', { detail: { fold: e.isIntersecting } })), { threshold: 0.08 }).observe(area);
    }

    // Con capas / Original
    const root = document.getElementById('videos-ia');
    root?.querySelectorAll<HTMLButtonElement>('[data-cmv-mode]:not([data-on])').forEach((b) => {
      b.setAttribute('data-on', '');
      b.addEventListener('click', () => {
        root.classList.toggle('is-raw', b.dataset.cmvMode === 'raw');
        root.querySelectorAll('[data-cmv-mode]').forEach((o) => o.setAttribute('aria-pressed', String(o === b)));
      });
    });
  };
  document.addEventListener('astro:page-load', initVideos);
  initVideos();
</script>

<style>
  /* Colores del clip 3: registrados para que cambien con transición */
  @property --v0 { syntax: '<color>'; inherits: true; initial-value: #c9cbd4; }
  @property --v1 { syntax: '<color>'; inherits: true; initial-value: #3c3c44; }

  .cmv { display: grid; gap: clamp(1.8rem, 3.5vw, 3rem); }
  .cmv__head { display: grid; gap: 1rem; max-width: 40rem; justify-items: center; text-align: center; margin-inline: auto; }
  .cmv__lead { margin: 0; color: var(--muted); line-height: 1.6; font-size: clamp(1rem, 1.3vw, 1.15rem); }
  .cmv__tools { display: grid; justify-items: center; gap: .8rem; }
  .cmv__seg { display: inline-flex; border: 1px solid var(--line); border-radius: 999px; padding: .2rem; }
  .cmv__seg button { background: none; border: 0; color: var(--muted); font: inherit; font-size: .8rem; padding: .35rem .95rem; border-radius: 999px; cursor: pointer; transition: background .3s, color .3s; }
  .cmv__seg button[aria-pressed='true'] { background: var(--fg); color: var(--bg); }
  .cmv__tag { margin: 0; font-size: .75rem; color: var(--muted); }

  .cmv__row { display: grid; grid-template-columns: repeat(3, minmax(0, 18rem)); gap: clamp(1.5rem, 3vw, 3rem); align-items: start; justify-content: center; }
  /* Celular y tablet: una sola columna, los tres clips uno debajo del otro y centrados */
  @media (max-width: 900px) {
    .cmv__row { grid-template-columns: minmax(0, 20rem); gap: clamp(2rem, 8vw, 3rem); }
    .vp { max-width: 20rem; }
  }

  .vp { max-width: 18rem; width: 100%; margin-inline: auto; min-width: 0; }
  .vp { --c0: var(--v0); --c1: var(--v1); transition: --v0 .5s linear, --v1 .5s linear; }
  .vp__screen { position: relative; aspect-ratio: 9 / 16; border-radius: 2rem; overflow: hidden; background: #000; container-type: inline-size; box-shadow: 0 0 0 .45rem #15151a, 0 0 0 calc(.45rem + 1px) rgb(255 255 255 / .16), 0 1.6rem 3rem rgb(0 0 0 / .45); cursor: pointer; isolation: isolate; transition: filter .7s var(--ease); }
  .vp__screen video { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }

  /* Deshabilitado mientras suena otro clip: saturación 0, quieto y con el botón de pausa semitraslúcido */
  .vp.is-dim .vp__screen { filter: grayscale(1); cursor: default; pointer-events: none; }
  .vp__lock { position: absolute; left: 50%; top: 50%; width: 17cqw; aspect-ratio: 1; transform: translate(-50%, -50%); display: grid; place-items: center; border-radius: 50%; background: rgb(0 0 0 / .38); color: rgb(255 255 255 / .8); backdrop-filter: blur(6px); z-index: 10; opacity: 0; transition: opacity .5s; pointer-events: none; }
  .vp__lock svg { width: 48%; fill: currentColor; }
  .vp.is-dim .vp__lock { opacity: 1; }
  .vp.is-dim .vp__btn, .vp.is-dim .vp__snd { display: none; }

  .vp__btn { position: absolute; left: 50%; top: 50%; width: 15cqw; aspect-ratio: 1; transform: translate(-50%, -50%); display: grid; place-items: center; border: 0; border-radius: 50%; background: rgb(0 0 0 / .5); color: #fff; backdrop-filter: blur(6px); cursor: pointer; z-index: 9; opacity: 0; transition: opacity .3s; }
  .vp__btn svg { width: 45%; fill: currentColor; }
  .vp__btn .i-pause { display: block; } .vp__btn .i-play { display: none; }
  .vp.is-paused .vp__btn .i-pause { display: none; } .vp.is-paused .vp__btn .i-play { display: block; }
  .vp.is-paused .vp__btn, .vp__screen:hover .vp__btn, .vp__btn:focus-visible { opacity: 1; }
  /* Celular (sin hover): al reproducir, el botón no se queda fijo sobre la imagen; pasa a una esquina abajo a la derecha */
  @media (hover: none), (max-width: 760px) {
    .vp:not(.is-paused) .vp__btn { left: auto; top: auto; right: 4cqw; bottom: 4cqw; transform: none; width: 12.5cqw; opacity: .88; }
  }
  .vp__btn:focus-visible, .vp__snd:focus-visible { outline: 2px solid #fff; outline-offset: 3px; }
  .vp__snd { position: absolute; right: 4cqw; top: 7cqw; width: 9cqw; aspect-ratio: 1; display: grid; place-items: center; border: 0; border-radius: 50%; background: rgb(0 0 0 / .5); color: #fff; cursor: pointer; z-index: 9; backdrop-filter: blur(6px); }
  .vp__snd svg { width: 58%; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
  .vp__snd path:first-child { fill: currentColor; }
  .vp__snd .off { display: none; } .vp__snd[aria-pressed='true'] .on { display: none; } .vp__snd[aria-pressed='true'] .off { display: block; }

  /* Capas: todo lo que se monta sobre el video (solo los dos tonos) */
  .ly { position: absolute; inset: 0; pointer-events: none; z-index: 2; }
  .is-raw .ly, .is-raw .sub { display: none; }
