    background-position: 0 0, 100% 0, 0 100%, 100% 100%; background-size: var(--cs) auto; background-repeat: no-repeat; }
  .omf:has(figcaption)::after { bottom: 2.7rem; }
  .omf figcaption { position: relative; }
  /* Carrusel de los desplegables */
  .omc { position: relative; }
  .omc__track { display: flex; overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; background: #fff; }
  .omc__s--z { padding: 0; aspect-ratio: auto; }
  .omc__z { width: 100%; aspect-ratio: 2000 / 1180; background-size: 235% auto; background-position: 33% 38%; background-repeat: no-repeat; }
  .omc__track::-webkit-scrollbar { display: none; }
  .omc__s { flex: 0 0 100%; scroll-snap-align: start; display: grid; place-items: center; padding: clamp(1.6rem, 4vw, 3.4rem); aspect-ratio: 2000 / 1180; }
  .omc__s img { width: 100%; height: 100%; object-fit: contain; }
  .omc__b { position: absolute; top: 50%; translate: 0 -50%; z-index: 2; width: 2.8rem; height: 2.8rem; border-radius: 50%; border: 1px solid #2c4560; background: #fff; color: #2c4560; cursor: pointer; font-size: 1.1rem; transition: background .3s, color .3s; }
  .omc__b:hover { background: #2c4560; color: #fff; }
  .omc__b--prev { left: .8rem; } .omc__b--next { right: .8rem; }
  .omc__dots { position: absolute; left: 0; right: 0; bottom: 1.2rem; display: flex; justify-content: center; gap: .55rem; z-index: 2; }
  .omc__d { width: .55rem; height: .55rem; padding: 0; border-radius: 50%; border: 1px solid #2c4560; background: transparent; cursor: pointer; }
  .omc__d.is-on { background: #2c4560; }
  /* Fichas internas: ancho completo, mostrando el 60 % del alto (centrado 20/20) */
  .om__full { margin: 0; width: 100%; }
  .om__full img { width: 100%; height: auto; display: block; }
  .om__deco { max-width: 72rem; }
  .om__prods { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--gutter); }
  .om__prods img { width: 100%; aspect-ratio: 3 / 4; object-fit: cover; }
  /* Caja destacada: abre el modal de variantes de corte */
  .om__prods { grid-template-columns: 1fr 1.7fr 1fr; align-items: center; }
  .om__open { z-index: 2; }
  .om__open .om__openb { all: unset; display: block; position: relative; cursor: pointer; overflow: hidden; width: 100%; }
  .om__open img { aspect-ratio: 3 / 4.1 !important; transition: transform 1.2s var(--ease), filter .6s; filter: drop-shadow(0 0 28px rgb(212 174 100 / .22)); }
  .om__open .om__openb:hover img, .om__open .om__openb:focus-visible img { transform: scale(1.05); filter: brightness(1.12) drop-shadow(0 0 34px rgb(212 174 100 / .45)); }
  .om__hint { position: absolute; left: 0; right: 0; bottom: 0; display: flex; justify-content: center; align-items: center; gap: .6rem; padding: 1.1rem 1rem; font-size: .8rem; letter-spacing: .18em; text-transform: uppercase; color: #e3d0a6; background: linear-gradient(0deg, rgb(13 11 20 / .92), transparent); transform: translateY(100%); transition: transform .6s var(--ease); }
  .om__hint b { font-weight: 300; font-size: 1.2rem; line-height: 1; }
  .om__openb:hover .om__hint, .om__openb:focus-visible .om__hint { transform: none; }
  @media (hover: none) { .om__hint { transform: none; } }
  @media (max-width: 760px) { .om__prods { grid-template-columns: 1fr; } }
  /* Modal de variantes */
  .omm { border: 0; padding: 0; width: min(76rem, 94vw); max-height: 92vh; background: #fff; color: #07070d; overflow: hidden; }
  .omm::backdrop { background: rgb(5 4 9 / .88); backdrop-filter: blur(6px); }
  .omm__t { margin: 0; padding: 1rem 1.4rem; font-size: .75rem; letter-spacing: .2em; text-transform: uppercase; color: #2c4560; border-bottom: 1px solid #dfe5ec; }
  .omm__x { all: unset; position: absolute; top: .5rem; right: .8rem; z-index: 3; cursor: pointer; font-size: 1.8rem; line-height: 1; padding: .2rem .6rem; color: #2c4560; }
  .omm .omc__s { aspect-ratio: 2000 / 1100; }

  @media (max-width: 760px) { .om__prods { grid-template-columns: 1fr; } }
  .om__cards { display: grid; gap: var(--gutter); }
  .om__card img { width: 100%; aspect-ratio: 2000 / 800; object-fit: cover; object-position: 50% 50%; }
  /* Variantes como cartas: grandes, inclinadas y superpuestas; borde recto, sin contorno, con fondo en degradado y resplandor */
  .om__row--iso { grid-template-columns: minmax(0, .8fr) minmax(0, 1.5fr); }
  .omv { position: relative; display: flex; justify-content: center; align-items: center; padding: 2rem 0 3rem; isolation: isolate; }
  .omv::before { content: ''; position: absolute; inset: 0 8% 0; z-index: -1; background: radial-gradient(ellipse 55% 50% at 50% 50%, rgb(70 120 200 / .34), rgb(40 70 140 / .16) 55%, transparent 75%); filter: blur(22px); }
  .omv__c { all: unset; box-sizing: border-box; position: relative; display: block; flex: 0 0 56%; aspect-ratio: 2 / 3; overflow: hidden; cursor: pointer; border-radius: clamp(12px, 1.6vw, 20px); background: linear-gradient(160deg, #1b2644, #0c1320 70%); transition: transform .8s var(--ease), box-shadow .8s, filter .8s; filter: brightness(.7) saturate(.8); z-index: 1; }
  .omv__c:first-child { transform: rotate(-7deg) translateX(14%); }
  .omv__c:last-child { transform: rotate(6deg) translateX(-14%) translateY(2%); margin-left: -4%; }
  .omv__c:focus-visible { outline: 2px solid #5b84a8; outline-offset: 6px; }
  .omv__c.is-active { z-index: 3; filter: none; box-shadow: 0 0 60px rgb(70 120 200 / .45), 0 34px 60px rgb(0 0 0 / .55); }
  .omv__c::after { content: ''; position: absolute; inset: 0; z-index: 2; pointer-events: none; border-radius: inherit; border: 2px solid #35446b; transition: border-color .8s; }
  .omv__c.is-active::after { border-color: #17305a; }
  .omv__c:first-child.is-active { transform: rotate(-4deg) translateX(10%) scale(1.04); }
  .omv__c:last-child.is-active { transform: rotate(3deg) translateX(-10%) scale(1.04); }
  .omv__flat { position: absolute; inset: 0; display: grid; place-items: center; background: radial-gradient(ellipse at 50% 42%, rgb(91 132 168 / .22), transparent 62%), linear-gradient(160deg, #1b2644, #0c1320 70%); }
  .omv__flat i { position: absolute; left: 28%; width: 44%; top: var(--ty, 34%); aspect-ratio: var(--ar, 64 / 69); background: #35446b; -webkit-mask: var(--m) center / contain no-repeat; mask: var(--m) center / contain no-repeat; }
  .omv__flat b { position: absolute; bottom: 11%; font: 500 clamp(.6rem, 1.1vw, .8rem) var(--sans); letter-spacing: .5em; padding-left: .5em; color: #41507a; }
  .omv__live { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: 0; transition: opacity .8s; }
  .omv__c.is-active .omv__live { opacity: 1; }
  @media (max-width: 860px) { .om__row--iso { grid-template-columns: 1fr; } }
  /* Encuadre de las secciones: un ornamento a cada lado, pegado al borde y con su proporción (160 × 546); encastran al entrar */
  .om__row, .om__res, .om__apps, .om__deco, .om__prods { position: relative; padding-block: clamp(2.6rem, 6vw, 4.4rem); padding-inline: clamp(1.2rem, 3vw, 2.5rem); }
  .om__row::before, .om__row::after, .om__res::before, .om__res::after, .om__apps::before, .om__apps::after, .om__deco::before, .om__deco::after, .om__prods::before, .om__prods::after {
    content: ''; position: absolute; top: 50%; height: min(100%, 24rem); aspect-ratio: 160 / 546; width: auto; pointer-events: none; z-index: 0; opacity: 0; translate: 0 -50%;
    background: no-repeat center / 100% 100%; transition: opacity 1.2s ease, transform 1.4s var(--ease); }
  .om__row::before, .om__res::before, .om__apps::before, .om__deco::before, .om__prods::before { left: calc(50% - 50vw + 60px); background-image: var(--sr); transform: translateX(-60%); }
  .om__row::after, .om__res::after, .om__apps::after, .om__deco::after, .om__prods::after { right: calc(50% - 50vw + 60px); background-image: var(--sl); transform: translateX(60%); }
  .is-in.om__row::before, .is-in.om__res::before, .is-in.om__apps::before, .is-in.om__deco::before, .is-in.om__prods::before,
  .is-in.om__row::after, .is-in.om__res::after, .is-in.om__apps::after, .is-in.om__deco::after, .is-in.om__prods::after { opacity: .14; transform: none; }
  @media (max-width: 1280px) { .om__row::before, .om__row::after, .om__res::before, .om__res::after, .om__apps::before, .om__apps::after, .om__deco::before, .om__deco::after, .om__prods::before, .om__prods::after { display: none; } }
  .om__row > *, .om__res > *, .om__apps > *, .om__deco > *, .om__prods > * { position: relative; z-index: 1; }
  .om__scene { display: grid; justify-items: center; }
  .om__sceneb { width: min(100%, 30rem); aspect-ratio: 636 / 886; overflow: hidden; border-radius: 4px; box-shadow: 0 30px 80px rgb(0 0 0 / .5); }
  .om__fade img { -webkit-mask-image: radial-gradient(closest-side at 50% 50%, #000 60%, transparent); mask-image: radial-gradient(closest-side at 50% 50%, #000 60%, transparent); }
  .om__fade--wide { max-width: 64rem; }
  .om__cap { display: grid; grid-template-columns: 1fr 1fr; text-align: center; letter-spacing: .24em; text-transform: uppercase; font-size: .7rem !important; color: var(--muted); }
  .om__name { display: grid; place-items: center; }
  /* El nombre toma el oro del manual (Solemn Gold) en vez del relleno original del SVG */
  .om__name span { width: min(100%, 26rem); aspect-ratio: 476 / 153; background: var(--gold); -webkit-mask: var(--n) center / contain no-repeat; mask: var(--n) center / contain no-repeat; }
  /* Paleta en rombos de la marca, con un glow leve */
  .om__rh { list-style: none; margin: 0; padding: 0; display: flex; justify-content: center; gap: clamp(1.4rem, 4vw, 3.4rem); }
  .om__rh li { display: grid; justify-items: center; gap: .3rem; text-align: center; opacity: 0; transform: translateY(14px); transition: opacity 1s calc(var(--i) * .18s) ease, transform 1.2s calc(var(--i) * .18s) var(--ease); }
  .om__rh.is-in li { opacity: 1; transform: none; }
  .om__rh i { display: block; width: clamp(5.6rem, 11vw, 8.6rem); aspect-ratio: 5 / 7; background: var(--c); clip-path: polygon(50% 0, 100% 50%, 50% 100%, 0 50%); margin-bottom: .6rem; }
