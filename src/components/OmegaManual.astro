---
// Resumen del manual de identidad de Omega Shields para el portfolio, con el estilo del sitio (sin tipografías ni fondos del manual).
// Los recortes del manual están en /works/omega-shields/manual/
import { withBase, type Lang } from '../lib/i18n';

const { lang } = Astro.props as { lang: Lang };
const es = lang === 'es';
const img = (n: string) => withBase(`/works/omega-shields/manual/${n}.webp`);
const name = withBase('/works/omega-shields/name.svg');

const t = es ? {
  kicker: 'Manual de marca',
  lead: 'Omega Shields es una marca del universo TCG, especializada en accesorios para proteger y conservar mazos, cartas y colecciones.',
  brandA: 'Su identidad habla un lenguaje fantástico y refinado: la estética Art Déco y la noción de protector de lujo, entre el medieval fantástico y la orfebrería mística. Un sello que protege y distingue.',
  tags: ['Art Déco', 'Medieval fantástico', 'Orfebrería mística', 'Sci-Fi'],
  iso: 'Isologotipo',
  isoA: 'Un emblema-escudo donde la letra Ω se divide para abrazar un núcleo central: lo protegido, lo esencial, el TCG. En su interior, el espacio negativo abre una figura que combina fuerza y accesibilidad.',
  isoB: 'Curva y filo, contención y estructura: esa dualidad es la esencia formal de la marca. Existe en dos versiones, Essentials y Forged.',
  ess: 'Essentials', forged: 'Forged',
  logo: 'Logotipo',
  logoA: 'Una tipografía display de inspiración tecnológica, con terminaciones geométricas suaves y proporciones levemente aplanadas. Hace de contrapunto a lo orgánico del isotipo: lo fantástico frente a lo industrial, lo místico frente a lo tecnológico.',
  weave: 'Tramas',
  weaveA: 'La marca se asocia a un campo protector lineal: una protección energética o mágica dibujada con tramas ornamentales Art Déco que sugieren circuitos, runas y flujos de energía organizada. Se aplican como insignias, sellos, cofres, fundas o blasones, siempre con el espacio negativo y la línea como recursos.',
  palette: 'Azure Deep & Solemn Gold',
  paletteA: 'Contención y resplandor, protección y valor. El Azure Deep expresa profundidad y calma segura, la mente del estratega; el Solemn Gold, la recompensa y la nobleza del guardián. El emblema es monocromático, así que puede absorber los matices del universo donde se inserta, incluso un neón.',
  deep: 'Azure Deep', gold: 'Solemn Gold',
  neon: 'El emblema, en versión neón',
  pattern: 'Patrón',
  patternA: 'Una textura gráfica que repite el escudo, para superficies y fondos.',
  pack: 'Packaging: el puzzle invertido',
  packA: 'El recurso visual es un sistema modular de tramas lineales dobles. Cada diseño se piensa como un «puzzle invertido»: marco e ilustración hacen un uso inteligente del espacio negativo, y las secciones —como cartas— forman, al unirse, el Escudo Omega que envuelve el producto.',
  packB: 'El brillo metálico se reparte según la aplicación, total o parcial, y conserva un aura de misterio y exclusividad.',
  reflect: 'Reflejo metálico con aplicación total',
  apps: 'Aplicaciones',
  appsA: 'La marca en las fichas de producto del DeckBOX.',
} : {
  kicker: 'Brand guidelines',
  lead: 'Omega Shields is a brand from the TCG universe, specialized in accessories to protect and preserve decks, cards and collections.',
  brandA: 'Its identity speaks a fantastical, refined language: Art Deco aesthetics and the notion of a luxury protector, between fantasy medieval and mystic goldsmithing. A seal that protects and distinguishes.',
  tags: ['Art Deco', 'Fantasy medieval', 'Mystic goldsmithing', 'Sci-Fi'],
  iso: 'Isologotype',
  isoA: 'A shield emblem where the letter Ω splits to embrace a central core: the protected, the essential, the TCG. Inside, negative space opens a figure that combines strength and approachability.',
  isoB: 'Curve and edge, containment and structure: that duality is the formal essence of the brand. It comes in two versions, Essentials and Forged.',
  ess: 'Essentials', forged: 'Forged',
  logo: 'Logotype',
  logoA: 'A tech-inspired display typeface, with soft geometric terminals and slightly flattened proportions. It counterpoints the organic isotype: the fantastical against the industrial, the mystic against the technological.',
  weave: 'Weaves',
  weaveA: 'The brand is tied to a linear protective field: an energetic or magical protection drawn with Art Deco ornamental weaves that suggest circuits, runes and flows of organized energy. They are applied as insignia, seals, chests, sleeves or blazons, always with negative space and line as resources.',
  palette: 'Azure Deep & Solemn Gold',
  paletteA: 'Containment and radiance, protection and value. Azure Deep expresses depth and calm assurance, the strategist’s mind; Solemn Gold, the reward and the nobility of the guardian. The emblem is monochrome, so it can absorb the hues of the universe it sits in, even a neon one.',
  deep: 'Azure Deep', gold: 'Solemn Gold',
  neon: 'The emblem, in neon',
  pattern: 'Pattern',
  patternA: 'A graphic texture that repeats the shield, for surfaces and backgrounds.',
  pack: 'Packaging: the inverted puzzle',
  packA: 'The visual resource is a modular system of double linear weaves. Each design is conceived as an “inverted puzzle”: frame and illustration make clever use of negative space, and the sections —like cards— form, when joined, the Omega Shield that wraps the product.',
  packB: 'The metallic shine is distributed according to the application, total or partial, and keeps an aura of mystery and exclusivity.',
  reflect: 'Metallic reflection, full application',
  apps: 'Applications',
  appsA: 'The brand on the DeckBOX product sheets.',
};
---
<section class="om" aria-label={t.kicker}>
  <div class="wrap om__head" data-reveal>
    <p class="eyebrow">{t.kicker}</p>
    <p class="om__lead">{t.lead}</p>
    <p class="om__txt">{t.brandA}</p>
    <ul class="om__tags">{t.tags.map((x) => <li>{x}</li>)}</ul>
  </div>

  <div class="wrap om__row" data-reveal>
    <div class="om__side">
      <h2 class="h2">{t.iso}</h2>
      <p class="om__txt">{t.isoA}</p>
      <p class="om__txt">{t.isoB}</p>
    </div>
    <figure class="om__fade"><img src={img('emblemas')} alt={`${t.ess} · ${t.forged}`} loading="lazy" decoding="async" /><figcaption class="om__cap"><span>{t.ess}</span><span>{t.forged}</span></figcaption></figure>
  </div>

  <div class="wrap om__row om__row--rev" data-reveal>
    <figure class="om__name" role="img" aria-label="Omega Shields"><span style={`--n:url(${name})`}></span></figure>
    <div class="om__side">
      <h2 class="h2">{t.logo}</h2>
      <p class="om__txt">{t.logoA}</p>
    </div>
  </div>

  <div class="wrap om__row" data-reveal>
    <div class="om__side">
      <h2 class="h2">{t.weave}</h2>
      <p class="om__txt">{t.weaveA}</p>
    </div>
    <figure class="om__fade"><img src={img('trama')} alt={t.weave} loading="lazy" decoding="async" /></figure>
  </div>

  <div class="wrap om__row om__row--rev" data-reveal>
    <figure class="om__photo om__photo--tall"><img src={img('neon')} alt={t.neon} loading="lazy" decoding="async" /><figcaption class="muted">{t.neon}</figcaption></figure>
    <div class="om__side">
      <h2 class="h2">{t.palette}</h2>
      <p class="om__txt">{t.paletteA}</p>
      <ul class="om__pal">
        <li><span class="om__dot" style="background:#020718"></span><span><strong>{t.deep}</strong><em>#020718</em></span></li>
        <li><span class="om__dot" style="background:#E3D0A6"></span><span><strong>{t.gold}</strong><em>#E3D0A6</em></span></li>
      </ul>
    </div>
  </div>

  <figure class="om__bleed" data-reveal><img src={img('patron')} alt={t.pattern} loading="lazy" decoding="async" /></figure>

  <div class="wrap om__row" data-reveal>
    <div class="om__side">
      <h2 class="h2">{t.pattern}</h2>
      <p class="om__txt">{t.patternA}</p>
    </div>
    <figure class="om__photo"><img src={img('textura')} alt={t.pattern} loading="lazy" decoding="async" /></figure>
  </div>

  <figure class="om__bleed" data-reveal><img src={img('empaque')} alt={t.pack} loading="lazy" decoding="async" /></figure>

  <div class="wrap om__row om__row--rev" data-reveal>
    <figure class="om__photo"><img src={img('caja')} alt={t.pack} loading="lazy" decoding="async" /></figure>
    <div class="om__side">
      <h2 class="h2">{t.pack}</h2>
      <p class="om__txt">{t.packA}</p>
      <p class="om__txt">{t.packB}</p>
    </div>
  </div>

  <figure class="wrap om__fade om__fade--wide" data-reveal>
    <img src={img('reflejo')} alt={t.reflect} loading="lazy" decoding="async" />
    <figcaption class="muted">{t.reflect}</figcaption>
  </figure>

  <div class="wrap om__apps" data-reveal>
    <div class="om__side"><h2 class="h2">{t.apps}</h2><p class="om__txt">{t.appsA}</p></div>
    <div class="om__pair">
      <figure class="om__photo"><img src={img('deck1')} alt="DeckBOX" loading="lazy" decoding="async" /></figure>
      <figure class="om__photo"><img src={img('deck2')} alt="DeckBOX" loading="lazy" decoding="async" /></figure>
    </div>
  </div>
</section>

<style>
  .om { --gold: #e3d0a6; display: grid; gap: clamp(4rem, 9vw, 9rem); padding-block: clamp(3rem, 6vw, 6rem) clamp(4rem, 8vw, 8rem); }
  .om figure { margin: 0; }
  .om img { width: 100%; height: auto; display: block; }
  .om figcaption { font-size: .8rem; padding-top: .75rem; }
  .om__head { display: grid; gap: 1.5rem; max-width: 62rem; }
  .om__lead { margin: 0; font-size: clamp(1.25rem, 2.2vw, 2rem); line-height: 1.35; }
  .om__txt { margin: 0; color: var(--muted); max-width: 40rem; }
  .om__tags { display: flex; flex-wrap: wrap; gap: .5rem; list-style: none; margin: .5rem 0 0; padding: 0; }
  .om__tags li { padding: .35rem 1rem; border: 1px solid color-mix(in srgb, var(--gold) 50%, transparent); border-radius: 999px; font-size: .85rem; color: var(--gold); }
  .om .h2 { margin-bottom: 1rem; }
  .om__row { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr); gap: clamp(2rem, 6vw, 7rem); align-items: center; }
  .om__row--rev { grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); }
  .om__side { display: grid; gap: 1.25rem; align-content: start; }
  .om__photo img { border-radius: 2px; }
  .om__photo--tall { max-width: 24rem; justify-self: center; }
  .om__bleed img { width: 100%; }
  /* Recortes con fondo azul del manual: se difuminan hacia los bordes para fundirse con la página */
  .om__fade img { -webkit-mask-image: radial-gradient(closest-side at 50% 50%, #000 60%, transparent); mask-image: radial-gradient(closest-side at 50% 50%, #000 60%, transparent); }
  .om__fade--wide { max-width: 64rem; }
  .om__cap { display: grid; grid-template-columns: 1fr 1fr; text-align: center; letter-spacing: .24em; text-transform: uppercase; font-size: .7rem !important; color: var(--muted); }
  .om__name { display: grid; place-items: center; }
  /* El nombre toma el oro del manual (Solemn Gold) en vez del relleno original del SVG */
  .om__name span { width: min(100%, 26rem); aspect-ratio: 476 / 153; background: var(--gold); -webkit-mask: var(--n) center / contain no-repeat; mask: var(--n) center / contain no-repeat; }
  .om__pal { list-style: none; margin: .5rem 0 0; padding: 0; display: grid; gap: 1rem; }
  .om__pal li { display: flex; align-items: center; gap: 1.1rem; }
  .om__pal span:last-child { display: grid; line-height: 1.35; }
  .om__pal em { font-style: normal; font-size: .82rem; color: var(--muted); }
  .om__dot { width: 3.2rem; aspect-ratio: 1; border-radius: 50%; flex: none; box-shadow: 0 0 0 1px var(--line); }
  .om__apps { display: grid; gap: 2rem; }
  .om__pair { display: grid; grid-template-columns: 1fr 1fr; gap: var(--gutter); }
  @media (max-width: 860px) {
    .om__row, .om__row--rev, .om__pair { grid-template-columns: 1fr; }
    .om__row--rev .om__photo, .om__row--rev .om__name { order: -1; }
  }
</style>
