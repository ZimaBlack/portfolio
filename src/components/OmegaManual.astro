---
// Resumen del manual de identidad de Omega Shields para el portfolio, con el estilo del sitio (sin tipografías ni fondos del manual).
// Los recortes del manual están en /works/omega-shields/manual/
import { withBase, type Lang } from '../lib/i18n';
import OmegaArt from './OmegaArt.astro';
import OmegaPattern from './OmegaPattern.astro';

const { lang } = Astro.props as { lang: Lang };
const es = lang === 'es';
const img = (n: string) => withBase(`/works/omega-shields/manual/${n}.webp`);
const name = withBase('/works/omega-shields/name.svg');
const g = (n: string) => withBase(`/works/omega-shields/gallery/${n}.webp`);
const videoUrl = 'https://www.facebook.com/mtgpirulo/videos/entro-omega-shields-a-pirulouna-l%C3%ADnea-de-accesorios-que-hace-que-proteger-tus-ca/1750145923105637/';

const t = es ? {
  lead: 'Accesorios TCG para proteger mazos, cartas y colecciones.',
  brandA: 'Art Déco, medieval fantástico y orfebrería mística: un sello que protege y distingue.',
  tags: ['Art Déco', 'Medieval fantástico', 'Orfebrería mística', 'Sci-Fi'],
  iso: 'Isologotipo',
  isoA: 'La Ω se divide para abrazar lo protegido. En el espacio negativo se abre una figura de fuerza y cercanía.',
  isoB: 'Dos versiones: Essentials y Forged.',
  ess: 'Essentials', forged: 'Forged',
  logo: 'Logotipo',
  logoA: 'Tipografía display tecnológica, de terminaciones suaves: contrapunto a lo orgánico del isotipo.',
  weave: 'Tramas',
  weaveA: 'Tramas Art Déco que sugieren circuitos, runas y energía: un campo protector lineal para insignias, sellos y cofres.',
  palette: 'Azure Deep, Navy Ink & Solemn Gold',
  paletteA: 'Azure Deep, Navy Ink y Solemn Gold: contención y resplandor. El emblema es monocromático y absorbe los matices de cada universo.',
  deep: 'Azure Deep', gold: 'Solemn Gold', navy: 'Navy Ink', navy: 'Navy Ink',
  neon: 'El emblema, en versión neón',
  pattern: 'Patrón',
  patternA: 'Textura gráfica que repite el escudo.',
  pack: 'Packaging: el puzzle invertido',
  packA: 'Un sistema modular de tramas dobles: cada pieza es una «carta» que, al unirse, forma el Escudo Omega.',
  packB: 'El brillo metálico varía según la aplicación, total o parcial.',
  reflect: 'Reflejo metálico con aplicación total',
  res: 'Recursos gráficos',
  resA: 'El arte que acompaña a la marca: un concepto ilustrado, el desarrollo de los detalles gráficos y los desplegables del packaging.',
  concept: 'Concepto del arte',
  details: 'Detalles gráficos: textura granulada y marcos mutables',
  dielines: 'Desplegables de la caja',
  variants: 'Ver variantes de corte',
  dielinesA: 'Tres variantes del troquel, con las ventanas que dejan ver el color de las fundas.',
  scene: 'El producto en escena',
  video: 'Video de lanzamiento',
  videoA: 'Omega Shields llega a Pirulo: una línea de accesorios que hace que proteger tus cartas sea parte del juego.',
  videoCta: 'Ver el video',
  apps: 'Aplicaciones',
  appsA: 'Fichas de producto del DeckBOX.',
} : {
  lead: 'TCG accessories to protect decks, cards and collections.',
  brandA: 'Art Deco, fantasy medieval and mystic goldsmithing: a seal that protects and distinguishes.',
  tags: ['Art Deco', 'Fantasy medieval', 'Mystic goldsmithing', 'Sci-Fi'],
  iso: 'Isologotype',
  isoA: 'The Ω splits to embrace what it protects. Negative space opens a figure of strength and closeness.',
  isoB: 'Two versions: Essentials and Forged.',
  ess: 'Essentials', forged: 'Forged',
  logo: 'Logotype',
  logoA: 'A tech display typeface with soft terminals: a counterpoint to the organic isotype.',
  weave: 'Weaves',
  weaveA: 'Art Deco weaves that suggest circuits, runes and energy: a linear protective field for insignia, seals and chests.',
  palette: 'Azure Deep, Navy Ink & Solemn Gold',
  paletteA: 'Azure Deep, Navy Ink and Solemn Gold: containment and radiance. The emblem is monochrome and absorbs the hues of each universe.',
  deep: 'Azure Deep', gold: 'Solemn Gold', navy: 'Navy Ink', navy: 'Navy Ink',
  neon: 'The emblem, in neon',
  pattern: 'Pattern',
  patternA: 'A graphic texture that repeats the shield.',
  pack: 'Packaging: the inverted puzzle',
  packA: 'A modular system of double weaves: each piece is a “card” that, joined, forms the Omega Shield.',
  packB: 'The metallic shine varies with the application, full or partial.',
  reflect: 'Metallic reflection, full application',
  res: 'Graphic resources',
  resA: 'The art that accompanies the brand: an illustrated concept, the development of the graphic details and the packaging dielines.',
  concept: 'Art concept',
  details: 'Graphic details: subtle grain texture and mutable frames',
  dielines: 'Box dielines',
  variants: 'See die-cut variants',
  dielinesA: 'Three die-cut variants, with windows that show the color of the sleeves.',
  scene: 'The product in scene',
  video: 'Launch video',
  videoA: 'Omega Shields arrives at Pirulo: a line of accessories that makes protecting your cards part of the game.',
  videoCta: 'Watch the video',
  apps: 'Applications',
  appsA: 'DeckBOX product sheets.',
};
---
<section class="om" aria-label={es ? 'Identidad' : 'Identity'} style={`--sl:url(${withBase('/works/omega-shields/ornaments/side-l.svg')});--sr:url(${withBase('/works/omega-shields/ornaments/side-r.svg')})`}>
  <div class="wrap om__head" data-reveal>
    <ul class="om__tags">{t.tags.map((x) => <li>{x}</li>)}</ul>
  </div>

  <div class="wrap om__row om__row--iso" data-reveal>
    <div class="om__side">
      <h2 class="h2">{t.iso}</h2>
      <p class="om__txt">{t.isoA}</p>
      <p class="om__txt">{t.isoB}</p>
    </div>
    <div class="omv" data-omv role="group" aria-label={`${t.ess} · ${t.forged}`}>
      {[['ess', 'variant-essentials', 'shield-essentials', t.ess, 979, 1459], ['forged', 'variant-forged', 'shield-forged', t.forged, 961, 1479]].map(([k, img, sh, label, w, h], i) => (
        <button type="button" class:list={['omv__c', { 'is-active': i === 0 }]} data-omv-c aria-pressed={i === 0 ? 'true' : 'false'}>
          <span class="omv__flat" aria-hidden="true"><i style={`--m:url(${withBase(`/works/omega-shields/brand/${sh}.svg`)});--ar:${k === 'ess' ? '64 / 69' : '64 / 86'};--ty:${k === 'ess' ? '34.5%' : '33.5%'}`}></i><b>{String(label).toUpperCase()}</b></span>
          <img class="omv__live" src={g(String(img))} alt={String(label)} width={Number(w)} height={Number(h)} loading="lazy" decoding="async" />
        </button>
      ))}
    </div>
  </div>

  <div class="wrap om__row om__row--rev" data-reveal>
    <figure class="om__name" role="img" aria-label="Omega Shields"><span style={`--n:url(${name})`}></span></figure>
    <div class="om__side">
      <h2 class="h2">{t.logo}</h2>
      <p class="om__txt">{t.logoA}</p>
    </div>
  </div>

  <div class="wrap om__side om__deco" data-reveal>
    <h2 class="h2">{t.weave}</h2>
    <p class="om__txt">{t.weaveA}</p>
  </div>
  <figure class="om__full" data-reveal><img src={g('detalles')} alt={t.details} width="1920" height="1080" loading="lazy" decoding="async" /></figure>

  <div class="wrap om__row" data-reveal>
    <div class="om__side">
      <h2 class="h2">{t.palette}</h2>
      <p class="om__txt">{t.paletteA}</p>
</div>
    <ul class="om__rh" data-omi>
      {[['#07070d', t.deep], ['#1F2A47', t.navy], ['#D4AE64', t.gold]].map(([c, n], i) => (
        <li style={`--c:${c};--i:${i}`}><i aria-hidden="true"></i><strong>{n}</strong><em>{c}</em></li>
      ))}
    </ul>
  </div>

  <div class="wrap om__res" data-reveal>
    <div class="om__side"><h2 class="h2">{t.res}</h2><p class="om__txt">{t.resA}</p></div>
    <div class="omb" role="img" aria-label={t.res} style={`--b:url(${withBase('/works/omega-shields/ornaments/band.svg')})`}><i></i><i class="omb__s"></i></div>
    <figure class="omx" data-omi>
      <i class="omx__m" aria-hidden="true"></i>
      <img class="omx__e omx__e--a" src={withBase('/works/omega-shields/ornaments/emblem-forged.svg')} alt="Forged" width="290" height="402" loading="lazy" decoding="async" />
      <img class="omx__e omx__e--b" src={withBase('/works/omega-shields/ornaments/emblem-essentials.svg')} alt="Essentials" width="273" height="306" loading="lazy" decoding="async" />
    </figure>
  </div>

  <figure class="om__bleed" data-reveal><img src={g('scene')} alt={t.scene} width="2000" height="840" loading="lazy" decoding="async" /></figure>

  <div class="wrap om__side om__deco" data-reveal>
    <h2 class="h2">{t.video}</h2>
    <p class="om__txt">{t.videoA}</p>
    <a class="om__btn" href={videoUrl} target="_blank" rel="noopener noreferrer">{t.videoCta} <span aria-hidden="true">↗</span></a>
  </div>
  <figure class="om__full" data-reveal><img src={g('line')} alt="Omega Shields" width="2000" height="990" loading="lazy" decoding="async" /></figure>
  <div class="wrap om__prods" data-reveal>
    <figure class="om__photo omf"><img src={g('bag-magnetic')} alt="Magnetic case" width="1493" height="2000" loading="lazy" decoding="async" /></figure>
    <figure class="om__photo omf om__open"><button type="button" class="om__openb" data-om-open aria-haspopup="dialog"><img src={g('box-front')} alt={t.pack} width="1493" height="2000" loading="lazy" decoding="async" /><span class="om__hint">{t.variants} <b aria-hidden="true">+</b></span></button></figure>
    <figure class="om__photo omf"><img src={g('bag-sleeves')} alt="Sleeves" width="1601" height="2000" loading="lazy" decoding="async" /></figure>
  </div>

  <div class="wrap om__apps" data-reveal>
    <div class="om__side"><h2 class="h2">{t.apps}</h2><p class="om__txt">{t.appsA}</p></div>
    <div class="om__cards">
      <figure class="om__photo om__card"><img src={g('card-essentials')} alt="Essentials card sleeves" width="2000" height="1333" loading="lazy" decoding="async" /></figure>
      <figure class="om__photo om__card"><img src={g('card-magnetic')} alt="Magnetic card holder" width="2000" height="1333" loading="lazy" decoding="async" /></figure>
    </div>
  </div>
</section>
<script is:inline>document.documentElement.setAttribute('data-om','')</script>

<dialog class="omm" data-om-dialog aria-label={t.dielines}>
  <button type="button" class="omm__x" data-om-close aria-label={es ? 'Cerrar' : 'Close'}>×</button>
  <p class="omm__t">{t.dielines}</p>
    <div class="omc" data-omc data-omc>
      <div class="omc__track">
        {['cut-red', 'cut-blue', 'cut-blue2'].map((n) => <div class="omc__s"><img src={g(n)} alt={t.dielines} loading="lazy" decoding="async" /></div>)}
        {['cut-red', 'cut-blue', 'cut-blue2'].map((n) => <div class="omc__s omc__s--z"><div class="omc__z" style={`background-image:url(${g(n)})`} role="img" aria-label={t.dielines}></div></div>)}
      </div>
      <button type="button" class="omc__b omc__b--prev" data-omc-prev aria-label={es ? 'Anterior' : 'Previous'}>←</button>
      <button type="button" class="omc__b omc__b--next" data-omc-next aria-label={es ? 'Siguiente' : 'Next'}>→</button>
      <div class="omc__dots" data-omc-dots></div>
    </div>
</dialog>

<script>
  // Carrusel de desplegables: desplazamiento con flechas y puntos
  const init = () => {
    document.querySelectorAll<HTMLElement>('[data-omc]:not([data-on])').forEach((c) => {
      c.setAttribute('data-on', '');
      const tr = c.querySelector<HTMLElement>('.omc__track')!, sl = [...tr.children] as HTMLElement[], dots = c.querySelector<HTMLElement>('[data-omc-dots]')!;
      let i = 0;
      sl.forEach((_, k) => { const d = document.createElement('button'); d.type = 'button'; d.className = 'omc__d'; d.setAttribute('aria-label', String(k + 1)); d.onclick = () => go(k); dots.appendChild(d); });
      const go = (k: number) => { i = (k + sl.length) % sl.length; tr.scrollTo({ left: sl[i].offsetLeft, behavior: 'smooth' }); mark(); };
      const mark = () => [...dots.children].forEach((d, k) => d.classList.toggle('is-on', k === i));
      c.querySelector('[data-omc-prev]')!.addEventListener('click', () => go(i - 1));
      c.querySelector('[data-omc-next]')!.addEventListener('click', () => go(i + 1));
      tr.addEventListener('scroll', () => { const k = Math.round(tr.scrollLeft / tr.clientWidth); if (k !== i) { i = k; mark(); } }, { passive: true });
      mark();
    });
  };
  document.addEventListener('astro:page-load', init); init();
</script>

<script>
  const initV = () => {
    document.querySelectorAll<HTMLElement>('[data-omv]:not([data-on])').forEach((w) => {
      w.setAttribute('data-on', '');
      const cs = [...w.querySelectorAll<HTMLButtonElement>('[data-omv-c]')];
      cs.forEach((c) => c.addEventListener('click', () => {
        if (c.classList.contains('is-active')) return;
        cs.forEach((o) => { const on = o === c; o.classList.toggle('is-active', on); o.setAttribute('aria-pressed', String(on)); });
      }));
    });
  };
  document.addEventListener('astro:page-load', initV); initV();
</script>

<script>
  const initI = () => {
    const els = document.querySelectorAll<HTMLElement>('.om__row, .om__res, .om__apps, .om__deco, .om__prods, [data-omi]');
    const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('is-in'); io.unobserve(e.target); } }), { threshold: 0.25 });
    els.forEach((el) => io.observe(el));
  };
  document.addEventListener('astro:page-load', initI); initI();
</script>

<script>
  const initM = () => {
    const d = document.querySelector<HTMLDialogElement>('[data-om-dialog]'); const o = document.querySelector<HTMLElement>('[data-om-open]');
    if (!d || !o || o.dataset.on) return; o.dataset.on = '1';
    o.addEventListener('click', () => { d.showModal(); d.querySelector<HTMLElement>('.omc__track')?.scrollTo({ left: 0 }); document.documentElement.style.overflow = 'hidden'; });
    const close = () => { d.close(); };
    d.addEventListener('close', () => { document.documentElement.style.overflow = ''; });
    d.querySelector('[data-om-close]')?.addEventListener('click', close);
    d.addEventListener('click', (e) => { if (e.target === d) close(); });
  };
  document.addEventListener('astro:page-load', initM); initM();
</script>

<script>
  document.addEventListener('astro:before-swap', () => document.documentElement.removeAttribute('data-om'));
  document.addEventListener('astro:page-load', () => { if (!document.querySelector('.om')) document.documentElement.removeAttribute('data-om'); });
</script>

<style>
  /* Contenedor común: el contenido vive en un ancho centrado (72 rem), alineado con el encabezado */
  .om > .wrap { max-width: 72rem; }
  .om > figure.wrap { margin-inline: auto; }
  .om { --gold: #e3d0a6; display: grid; gap: clamp(4rem, 9vw, 9rem); padding-block: clamp(3rem, 6vw, 6rem) clamp(4rem, 8vw, 8rem); }
  .om figure { margin: 0; }
  .om img { width: 100%; height: auto; display: block; }
  .om figcaption { font-size: .8rem; padding-top: .75rem; }
  .om__head { display: grid; gap: 1.5rem; max-width: 62rem; }
  .om__lead { margin: 0; font-size: clamp(1.25rem, 2.2vw, 2rem); line-height: 1.35; }
  .om__txt { margin: 0; color: var(--muted); max-width: 40rem; }
  .om__tags { display: flex; flex-wrap: wrap; gap: .5rem; list-style: none; margin: .5rem 0 0; padding: 0; }
  .om__tags li { padding: .35rem 1rem; border: 1px solid color-mix(in srgb, var(--gold) 50%, transparent); border-radius: 999px; font-size: .85rem; color: var(--gold); }
  .om .h2 { margin-bottom: 1rem; }
  .om__row { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr); gap: clamp(2rem, 6vw, 7rem); align-items: center; }
  .om__row--rev { grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); }
  .om__side { display: grid; gap: 1.25rem; align-content: start; }
  .om__photo img { border-radius: 2px; }
  .om__photo--tall { max-width: 24rem; justify-self: center; }
  .om__bleed img { width: 100%; }
  /* Recortes con fondo azul del manual: se difuminan hacia los bordes para fundirse con la página */
  .om > figure.om__concept { padding-inline: 0; width: min(72rem, calc(100% - 2 * var(--gutter))); max-width: none; margin-inline: auto; }
  .om__concept img { border-radius: 2px; }
  .om__weave { aspect-ratio: 658 / 475; overflow: hidden; background: #0f0d18; border-radius: 2px; }
  /* Marco ornamental único (esquina del proyecto, frame-corner.svg): lo comparten todas las piezas */
  .omf { position: relative; --cs: clamp(22px, 3.2vw, 40px); }
  .omf img, .omf svg, .omf .om__weave { background-color: #07070d; display: block; }
  .omc .omc__s img { background-color: #fff; }
