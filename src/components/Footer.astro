---
import { site, waLink } from '../data/site';
import Icon from './Icon.astro';
---
<footer class="footer section" id="contacto">
  <div class="wrap">
    <p class="eyebrow" data-reveal>Contacto</p>
    <h2 class="display" data-split-scroll>Hablemos de tu próximo proyecto.</h2>
    <div class="footer__row" data-reveal>
      <a class="btn btn--solid" href={waLink()} target="_blank" rel="noopener noreferrer">Escribir por WhatsApp <Icon name="arrow-up-right" /></a>
      <a class="btn" href={`mailto:${site.email}`}>{site.email}</a>
      <a class="btn" href={site.cv} download>Descargar CV <Icon name="download" /></a>
    </div>
    <div class="footer__base">
      <span class="muted">© {new Date().getFullYear()} {site.studio} — {site.location}</span>
      <ul>{site.social.map((s) => <li><a class="link" href={s.href} target="_blank" rel="noopener noreferrer">{s.label}</a></li>)}</ul>
    </div>
  </div>
</footer>

<style>
  .footer { border-top: 1px solid var(--line); }
  .footer .display { margin: 1.5rem 0 3rem; max-width: 12ch; font-size: clamp(3rem, 9vw, 10rem); }
  .footer__row { display: flex; flex-wrap: wrap; gap: .75rem; }
  .footer__base { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 1rem; margin-top: clamp(5rem, 10vw, 9rem); font-size: .85rem; }
  .footer__base ul { display: flex; gap: 1.5rem; list-style: none; margin: 0; padding: 0; }
</style>
