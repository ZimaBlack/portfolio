---
import { site, waLink } from '../data/site';
import { copy, paths, type Lang } from '../lib/i18n';
import Icon from './Icon.astro';
import Crt from './Crt.astro';
const { lang } = Astro.props as { lang: Lang };
const c = copy[lang];
---
<footer class="footer section" id="contacto">
  <img class="footer__photo" src={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/portrait.jpg`} alt="" aria-hidden="true" width="1386" height="1135" loading="lazy" decoding="async" />
  <Crt />
  <span class="footer__glitch" aria-hidden="true"></span>
  <div class="wrap footer__content">
    <p class="eyebrow" data-reveal>{c.footer.eyebrow}</p>
    <h2 class="display" data-split-scroll>{c.footer.title}</h2>
    <div class="footer__row" data-reveal>
      <a class="btn btn--solid" href={waLink(lang)} target="_blank" rel="noopener noreferrer">{c.footer.wa} <Icon name="arrow-up-right" /></a>
      <a class="btn" href={`mailto:${site.email}`}>{site.email}</a>
      <a class="btn" href={paths.cv(lang)}>{c.footer.cv} <Icon name="arrow-up-right" /></a>
    </div>
    <div class="footer__base">
      <span class="muted">© {new Date().getFullYear()} {site.studio} — {site.location}</span>
      <ul>{site.social.map((s) => <li><a class="link foot-soc" href={s.href} target="_blank" rel="noopener noreferrer"><Icon name={s.icon} /> {s.label}</a></li>)}</ul>
    </div>
  </div>
</footer>

<style>
  .footer { --crt-z: 0; /* pantalla antigua: sobre la foto, bajo el contenido */ position: relative; overflow: hidden; isolation: isolate; background: var(--bg); /* base sobre la que se funde la foto */ }
  /* Retrato a la derecha, detrás del contenido, al 40% de opacidad; el borde izquierdo se desvanece */
  .footer__photo { position: absolute; z-index: -1; right: 0; bottom: 0; height: 100%; width: auto; max-width: 75%; object-fit: contain; object-position: right bottom; opacity: .55; mix-blend-mode: screen; /* fusión: el negro de la foto desaparece contra el fondo y las luces se suman */ pointer-events: none; user-select: none;
    /* bordes que se desvanecen: izquierdo y superior, para que el recorte del encuadre no se note */
    -webkit-mask-image: linear-gradient(to right, transparent 0, #000 30%), linear-gradient(to bottom, transparent 0, #000 16%); -webkit-mask-composite: source-in;
    mask-image: linear-gradient(to right, transparent 0, #000 30%), linear-gradient(to bottom, transparent 0, #000 16%); mask-composite: intersect; }
  @media (prefers-color-scheme: light) { :global(:root:not([data-theme='dark'])) .footer__photo { display: none; } } /* la foto está pensada para fondo oscuro */
  /* Entrada: la foto aparece con un fundido lento al llegar a la sección */
  :global(.js) .footer__photo { opacity: 0; transform: translateY(26px) scale(1.03); transition: opacity 2.4s var(--ease), transform 2.8s var(--ease); }
  :global(.js) .footer.is-in .footer__photo { opacity: .55; transform: none; }
  @media (prefers-reduced-motion: reduce) { :global(.js) .footer__photo { opacity: .55; transform: none; transition: none; } }

  /* Móvil: el retrato es el protagonista. Ocupa todo el ancho, con el contacto arriba (sobre el pelo)
     y los enlaces abajo (sobre el buzo). Se funde en todos sus bordes. */
  @media (max-width: 760px) {
    .footer { display: flex; flex-direction: column; min-height: min(calc(200vw + 6.5rem), 78rem); padding-block: 5rem 2.25rem; }
    .footer__content { flex: 1; display: flex; flex-direction: column; }
    .footer .footer__base { margin-top: auto; padding-top: 4rem; } /* más específico: gana a la regla base que va después */
    .footer__photo { top: auto; bottom: 6.5rem; left: -13%; right: auto; width: 126%; max-width: none; height: auto; object-fit: fill;
      -webkit-mask-image: linear-gradient(to bottom, transparent 0, #000 24%, #000 80%, transparent 100%); -webkit-mask-composite: source-in;
      mask-image: linear-gradient(to bottom, transparent 0, #000 24%, #000 80%, transparent 100%); }
  }
  /* Glitch (lo dispara el script cada ~3 s, con variaciones): la foto se desfasa en canales RGB y salta; una franja de luz cruza la pantalla */
  .footer__photo.is-glitch { animation: foot-glitch var(--gd, .32s) steps(1) 1; }
  @keyframes foot-glitch {
    0%   { transform: translateX(calc(var(--gx, 12px) * -1)) skewX(calc(var(--gs, 3deg) * -1)); filter: drop-shadow(calc(var(--gx, 12px) * .5) 0 0 rgb(255 0 70 / .75)) drop-shadow(calc(var(--gx, 12px) * -.5) 0 0 rgb(0 230 255 / .75)) brightness(1.5); }
    22%  { transform: translateX(var(--gx, 12px)) skewX(var(--gs, 3deg)); filter: drop-shadow(calc(var(--gx, 12px) * -.4) 0 0 rgb(255 0 70 / .6)) drop-shadow(calc(var(--gx, 12px) * .4) 0 0 rgb(0 230 255 / .6)) contrast(1.4); }
    41%  { transform: translateX(calc(var(--gx, 12px) * .3)) translateY(calc(var(--gy, 4px) * -1)); filter: hue-rotate(40deg) brightness(1.8); }
    63%  { transform: translateX(calc(var(--gx, 12px) * -.6)) translateY(var(--gy, 4px)) skewX(calc(var(--gs, 3deg) * .5)); filter: drop-shadow(calc(var(--gx, 12px) * .6) 0 0 rgb(255 0 70 / .6)) brightness(.7); }
    82%  { transform: translateX(calc(var(--gx, 12px) * .15)); filter: contrast(1.6) brightness(1.3); }
    100% { transform: none; filter: none; }
  }
  .footer__glitch { position: absolute; z-index: 0; left: 0; right: 0; top: var(--gt, 40%); height: var(--gh, 6%); pointer-events: none; opacity: 0; mix-blend-mode: screen;
    background: linear-gradient(to bottom, transparent, rgb(255 255 255 / .22) 30%, rgb(255 255 255 / .1) 70%, transparent); }
  .footer__glitch.is-glitch { animation: foot-bar var(--gd, .32s) steps(3) 1; }
  @keyframes foot-bar { 0% { opacity: 1; transform: translateX(-4%); } 40% { opacity: .5; transform: translateX(3%); } 70% { opacity: .9; transform: translateX(-2%); } 100% { opacity: 0; transform: none; } }
  @media (prefers-color-scheme: light) { :global(:root:not([data-theme='dark'])) .footer__glitch { display: none; } }
  @media (prefers-reduced-motion: reduce) { .footer__glitch { display: none; } .footer__photo.is-glitch { animation: none; } }

  .footer__content { position: relative; z-index: 1; }
  .footer .display { margin: 1.5rem 0 2.5rem; }
  .footer__row { display: flex; flex-wrap: wrap; gap: .75rem; }
  .footer__base { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 1rem; margin-top: clamp(5rem, 10vw, 9rem); font-size: .85rem; }
  .foot-soc { display: inline-flex; align-items: center; gap: .45rem; }
  .footer__base ul { display: flex; gap: 1.5rem; list-style: none; margin: 0; padding: 0; }
</style>

<script>
  // Dispara el fundido de la foto cuando la sección entra en pantalla
  const init = () => {
    const f = document.querySelector<HTMLElement>('#contacto');
    if (!f) return;
    const io = new IntersectionObserver((es) => {
      if (es.some((e) => e.isIntersecting)) { f.classList.add('is-in'); io.disconnect(); }
    }, { threshold: 0.2 });
    io.observe(f);
    glitch(f);
  };

  // Glitch cada ~3 s (entre 1,8 y 4,8 s, siempre distinto) sólo mientras el footer se ve y la pestaña está activa
  let glitchTimer = 0;
  const glitch = (f: HTMLElement) => {
    clearTimeout(glitchTimer);
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    const photo = f.querySelector<HTMLElement>('.footer__photo')!;
    const bar = f.querySelector<HTMLElement>('.footer__glitch')!;
    let seen = false;
    new IntersectionObserver((es) => { seen = es.some((e) => e.isIntersecting); }).observe(f);
    const r = (min: number, max: number) => min + Math.random() * (max - min);
    const fire = () => {
      if (seen && !document.hidden && f.classList.contains('is-in')) {
        const sign = Math.random() < 0.5 ? -1 : 1;
        const st = f.style;
        st.setProperty('--gx', `${(r(5, 22) * sign).toFixed(1)}px`);
        st.setProperty('--gy', `${r(1, 7).toFixed(1)}px`);
        st.setProperty('--gs', `${(r(1, 5) * sign).toFixed(1)}deg`);
        st.setProperty('--gd', `${r(0.2, 0.55).toFixed(2)}s`);
        st.setProperty('--gt', `${r(5, 90).toFixed(0)}%`);
        st.setProperty('--gh', `${r(2, 11).toFixed(0)}%`);
        for (const el of [photo, bar]) { el.classList.remove('is-glitch'); void el.offsetWidth; el.classList.add('is-glitch'); }
      }
      glitchTimer = window.setTimeout(fire, r(1800, 4800));
    };
    glitchTimer = window.setTimeout(fire, r(1500, 3000));
  };
  document.addEventListener('astro:page-load', init);
  document.addEventListener('astro:before-swap', () => clearTimeout(glitchTimer));
</script>
