---
// Manual de marca de Global Citizen adaptado al sitio: texto nativo (bilingüe) + piezas recortadas del manual original en /works/global-citizen/manual/
import { withBase, type Lang } from '../lib/i18n';
import GcLogos from './GcLogos.astro';
import GcConcept from './GcConcept.astro';
import GcGrid from './GcGrid.astro';
import GcSynth from './GcSynth.astro';
import GcResources from './GcResources.astro';
import markRaw from '../../public/works/global-citizen/mark.svg?raw';

const { lang } = Astro.props as { lang: Lang };
const es = lang === 'es';
const img = (n: string) => withBase(`/works/global-citizen/manual/${n}.webp`);
// Trazo del isotipo, para dibujarlo en modo "blueprint" (contorno)
const iso = [...markRaw.matchAll(/\bd="([^"]+)"/g)].map((m) => m[1]).join(' ');

const t = es ? {
  deconH: 'Síntesis: dos corrientes, una marca',
  deconL: 'Estilo suizo moderno y constructivismo gráfico: estructura, claridad y función.',
  deconP: 'El estilo suizo moderno (mediados del siglo XX) es minimalista, limpio y funcional, y marcó el diseño gráfico global. Se vincula con el constructivismo gráfico (inicios del siglo XX), con el que comparte la estructura, la claridad y la legibilidad: ambos rompen con la ornamentación innecesaria y se centran en la función y la información.',
  deconQ: 'Global Citizen se tiñe de estos principios: una marca donde la simplicidad, la coherencia y la legibilidad son fundamentales; donde toda acción tiene un fundamento y una función, y donde las dinámicas con el entorno se construyen desde una perspectiva amplia, duradera y siempre vigente.',
  deconI: 'Principios compartidos',
  deconIs: ['Estructura', 'Claridad', 'Legibilidad', 'Función', 'Sin ornamentación'],
  deconG: [['Estilo suizo', 'mediados del siglo XX'], ['Constructivismo gráfico', 'inicios del siglo XX'], ['Principios compartidos', 'estructura · claridad · legibilidad · función'], ['Global Citizen', 'simplicidad · coherencia · legibilidad']],
  resH: 'Recursos gráficos',
  resP: 'MÓDULOS: para el desarrollo de aplicaciones gráficas utilizamos elementos modulares individuales, composiciones elementales que hacen a las formas de la marca, en los cuales podemos denotar una tendencia de desarrollo y construcción. Representan procesos de ensamble dinámico que sugieren la implementación de las ideas, la interacción de las buenas prácticas y el resultado consecuente, donde siempre el elemento completo y resultante es Global Citizen.',
  resT: 'Pasá el cursor sobre los módulos: giran y se encienden.',
  conceptH: 'El concepto principal',
  conceptL: 'Armonía y constancia: un módulo que se repite, se refleja y se acopla.',
  conceptP: 'La marca aplica estos valores con módulos geométricos individuales de repetición y asimetría, que generan estructuras armónicas. Una buena idea que funciona se optimiza y se replica según su medio: un sistema bien ajustado y medido.',
  gridH: 'Grillas constructivas',
  gridL: 'Ángulos puros y formas definidas por una geometría precisa.',
  gridP: 'El isotipo está casi definido por la sensación de simetría, con un cambio dinámico en peso y forma. Le da movimiento sin quitarle equilibrio: solo cuenta con un ajuste óptico en la dirección del quiebre para mantener un eje equilibrado y generar estructura y cuerpo.',
  palH: 'Paleta institucional',
  palP: 'La gama de verdes evoca la naturaleza y la armonía, en relación con el entorno; los tonos puros en blanco y negro transmiten equilibrio. Una paleta simple y funcional, con una estética atemporal.',
  palX: 'Paleta extendida',
  typH: 'Tipografía',
  typP: 'El logotipo parte de Candle, de trazos de geometría pura y cuerpo pesado. Nunito Sans acompaña como fuente de uso: clara y sencilla, de diseño limpio y sin adornos, esencial para una comunicación efectiva.',
  typS: 'Marca y texto',
  intro: 'Identidad para una marca de bienes raíces e inversión, de inspiración suiza: grilla, geometría y espacio negativo.',
  logos: 'Isotipo, versión vertical y horizontal.',
  insp: 'Estilo Internacional',
  inspA: 'La referencia gráfica de la marca: el modernismo suizo.',
  inspB: 'Tipografía clara, jerarquía simple y mucho espacio.',
  refs: 'Referencias',
  refsBy: 'Josef Müller-Brockmann · Armin Hofmann',
  map: 'Mapa conceptual',
  mapA: 'Del estilo internacional al rubro: ramas conceptuales que ordenan la identidad.',
  mapB: '',
  mapC: 'Un modelo vivo, siempre en revisión.',
  mock: 'Aplicaciones',
  cards: 'Tarjetería',
  avatars: 'Avatares para redes',
  paper: 'Papelería comercial, A4 membrete y tubo de planos',
  fence: 'Gráfica de obra',
  boards: 'Cartelería',
  dark: 'Modo oscuro',
  darkA: 'Opción «blueprint» para piezas premium o internas.',
  darkB: 'Usa la grilla como soporte geométrico.',
  darkC: 'Es opcional.',
  end: 'Principios',
  endA: 'Minimalismo, funcionalidad e innovación.',
  endB: 'Mensajes simples, jerarquía armónica y uso intencional del espacio negativo.',
} : {
  deconH: 'Synthesis: two currents, one brand',
  deconL: 'Modern Swiss style and graphic constructivism: structure, clarity and function.',
  deconP: 'Modern Swiss style (mid-20th century) is minimalist, clean and functional, and shaped graphic design worldwide. It is tied to graphic constructivism (early 20th century), with which it shares structure, clarity and legibility: both break with unnecessary ornament and focus on function and information.',
  deconQ: 'Global Citizen takes on these principles: a brand where simplicity, coherence and legibility are fundamental; where every action has a rationale and a function, and where the dynamics with the environment are built from a broad, lasting and always current perspective.',
  deconI: 'Shared principles',
  deconIs: ['Structure', 'Clarity', 'Legibility', 'Function', 'No ornament'],
  deconG: [['Swiss style', 'mid-20th century'], ['Graphic constructivism', 'early 20th century'], ['Shared principles', 'structure · clarity · legibility · function'], ['Global Citizen', 'simplicity · coherence · legibility']],
  resH: 'Graphic resources',
  resP: 'MODULES: for graphic applications we use individual modular elements, elementary compositions that make up the shapes of the brand, in which we can see a tendency of development and construction. They represent dynamic assembly processes that suggest putting ideas into practice, the interaction of good practices and the resulting outcome, where the complete, resulting element is always Global Citizen.',
  resT: 'Hover over the modules: they turn and light up.',
  conceptH: 'The main concept',
  conceptL: 'Harmony and constancy: a module that repeats, mirrors and couples.',
  conceptP: 'The brand applies these values through individual geometric modules of repetition and asymmetry, creating harmonious structures. A good idea that works gets optimized and replicated across its medium: a well-tuned, measured system.',
  gridH: 'Construction grids',
  gridL: 'Pure angles and shapes defined by precise geometry.',
  gridP: 'The isotype is almost defined by a sense of symmetry, with a dynamic shift in weight and shape. It adds movement without losing balance: a single optical adjustment in the direction of the break keeps a balanced axis and builds structure and body.',
  palH: 'Institutional palette',
  palP: 'The range of greens evokes nature and harmony in relation to the environment; pure white and black convey balance. A simple, functional palette with a timeless look.',
  palX: 'Extended palette',
  typH: 'Typography',
  typP: 'The logotype starts from Candle, with pure-geometry strokes and a heavy body. Nunito Sans supports it as the working font: clear and simple, with a clean design and no ornament, essential for effective communication.',
  typS: 'Brand and text',
  intro: 'Identity for a real estate and investment brand, Swiss-inspired: grid, geometry and negative space.',
  logos: 'Isotype, stacked and horizontal versions.',
  insp: 'International Style',
  inspA: 'The brand’s graphic reference: Swiss modernism.',
  inspB: 'Clear type, simple hierarchy and plenty of space.',
  refs: 'References',
  refsBy: 'Josef Müller-Brockmann · Armin Hofmann',
  map: 'Concept map',
  mapA: 'From the international style to the field: conceptual branches that organize the identity.',
  mapB: '',
  mapC: 'A living model, always under review.',
  mock: 'Applications',
  cards: 'Business cards',
  avatars: 'Social media avatars',
  paper: 'Commercial stationery, A4 letterhead and plan tube',
  fence: 'Construction hoarding',
  boards: 'Signage',
  dark: 'Dark mode',
  darkA: 'A “blueprint” option for premium or internal pieces.',
  darkB: 'It uses the grid as geometric support.',
  darkC: 'It is optional.',
  end: 'Principles',
  endA: 'Minimalism, functionality and innovation.',
  endB: 'Simple messages, harmonious hierarchy and intentional use of negative space.',
};

const pal: [string, string, string][] = [['Ocean Green', '#5DB88A', '#0e1f1a'], ['Minty Fresh', '#74C096', '#0e1f1a'], ['Teal Breeze', '#92CDB6', '#0e1f1a'], ['Whispering White', '#DFEFE5', '#0e1f1a'], ['Pure Snow', '#FAFAFA', '#0e1f1a']];
const palx: [string, string, string][] = [['Tranquil Teal', '#1D4B3C', '#fff'], ['Verdant Glow', '#5EA85A', '#0e1f1a'], ['Deep Onyx', '#1C1C1C', '#fff'], ['Serene Sand', '#E2D4BF', '#0e1f1a']];

// Mapa conceptual: cada fila es una tanda de conceptos (v = verde de marca; b = negrita)
type Chip = [string, boolean?];
const rows: { b: boolean; chips: Chip[] }[] = [
  { b: true, chips: [['BIENES RAICES'], ['INVERSIÓN', true], ['INNOVACION', true], ['ESPACIOS HUMANOS']] },
  { b: true, chips: [['Implementacion'], ['Rentabilidad', true], ['Global Mundial', true], ['Arquitectura'], ['Experiencial']] },
  { b: true, chips: [['Enfoque humano', true], ['Enfoque Ambiental', true], ['Tecnología']] },
  { b: false, chips: [['Viabilidad'], ['Versatilidad'], ['Adaptavilidad'], ['Funcionalidad', true], ['Aplicabilidad', true], ['Sustentabilidad', true]] },
  { b: false, chips: [['Cultura organizativa', true], ['Construtivismo', true], ['Minimalismo']] },
  { b: false, chips: [['Ergonomia', true], ['Materializacion disruptiva'], ['Ecosisitemas', true], ['Ecobrutalismo'], ['Simbiosis']] },
];
---
<section class="gcm" aria-label={es ? 'Identidad' : 'Identity'}>
  <figure class="gcm__bleed" data-reveal>
    <GcLogos label={t.logos} />
    <figcaption class="wrap muted">{t.logos}</figcaption>
  </figure>

  <div class="wrap gcm__block gcm__block--concept" data-reveal>
    <div class="gcm__text">
      <h2 class="h2">{t.conceptH}</h2>
      <p class="gcm__strong">{t.conceptL}</p>
      <p>{t.conceptP}</p>
    </div>
    <GcConcept label={t.conceptH} />
  </div>

  <div class="wrap gcm__block gcm__block--grid" data-reveal>
    <div class="gcm__text">
      <h2 class="h2">{t.gridH}</h2>
      <p class="gcm__strong">{t.gridL}</p>
      <p>{t.gridP}</p>
    </div>
    <GcGrid label={t.gridH} />
  </div>

  <div class="wrap gcm__synth" data-reveal>
    <div class="gcm__synth-t">
      <h2 class="h2">{t.deconH}</h2>
      <p class="gcm__strong">{t.deconL}</p>
      <div class="gcm__cols"><p>{t.deconP}</p><p>{t.deconQ}</p></div>
      <ul class="chips">{t.deconIs.map((c) => <li>{c}</li>)}</ul>
    </div>
    <GcSynth labels={t.deconG} label={t.deconH} />
  </div>

  <div class="wrap gcm__block">
    <div class="gcm__text" data-reveal>
      <h2 class="h2">{t.insp}</h2>
      <p>{t.inspA}</p>
      <p class="gcm__strong">{t.inspB}</p>
    </div>
    <figure class="gcm__mood" data-reveal>
      <img src={img('moodboard')} alt={t.insp} loading="lazy" decoding="async" width="1800" height="2118" />
      <figcaption class="muted">{t.refs}: <strong>{t.refsBy}</strong></figcaption>
    </figure>
  </div>

  <div class="wrap gcm__block gcm__block--map">
    <div class="gcm__text" data-reveal>
      <h2 class="h2">{t.map}</h2>
      <p>{t.mapA}</p>
      <p>{t.mapB}</p>
      <p class="gcm__strong">{t.mapC}</p>
    </div>
    <div class="gcm__chips" data-reveal>
      {rows.map((r) => (
        <ul class:list={['chips', { 'chips--b': r.b }]}>
          {r.chips.map(([label, green]) => <li class:list={{ 'is-green': green }}>{label}</li>)}
        </ul>
      ))}
    </div>
  </div>


  <div class="wrap gcm__pal" data-reveal>
    <div class="gcm__text">
      <h2 class="h2">{t.palH}</h2>
      <p>{t.palP}</p>
    </div>
    <ul class="gcm__sw" data-gc>
      {pal.map(([n, h, f], i) => <li style={`--c:${h};--f:${f};--i:${i}`}><b>{n}</b><span>{h}</span></li>)}
    </ul>
    <h3 class="gcm__sub">{t.palX}</h3>
    <ul class="gcm__sw gcm__sw--x" data-gc>
      {palx.map(([n, h, f], i) => <li style={`--c:${h};--f:${f};--i:${i}`}><b>{n}</b><span>{h}</span></li>)}
    </ul>
  </div>

  <div class="wrap gcm__block gcm__type" data-reveal>
    <div class="gcm__text">
      <h2 class="h2">{t.typH}</h2>
      <p>{t.typP}</p>
    </div>
    <div class="gcm__spec" aria-label={t.typS}>
      <p class="gcm__nb">Nunito Sans Bold</p>
      <p class="gcm__nb gcm__nb--l">ABCDEFGHIJKLM<br />NOPQRSTUVWXYZ</p>
      <p class="gcm__nr">Nunito Sans Regular · abcdefghijklmnopqrstuvwxyz 1234567890</p>
      <p class="gcm__nl">Nunito Sans Light · abcdefghijklmnopqrstuvwxyz 1234567890</p>
    </div>
  </div>

  <div class="wrap gcm__res" data-reveal>
    <GcResources label={t.resH} />
    <div class="gcm__block gcm__block--res">
      <div class="gcm__text"><h2 class="h2">{t.resH}</h2><p class="gcm__hint">{t.resT}</p></div>
      <p class="gcm__restxt">{t.resP}</p>
    </div>
  </div>

  <div class="wrap gcm__title" data-reveal><h2 class="h2">{t.mock}</h2></div>

  <div class="wrap gcm__pair" data-reveal>
    <figure><img src={img('card-green')} alt={t.cards} loading="lazy" decoding="async" /></figure>
    <figure><img src={img('card-tray')} alt={t.cards} loading="lazy" decoding="async" /></figure>
  </div>
  <figure class="gcm__bleed" data-reveal>
    <img src={img('banner-dark')} alt="Global Citizen" loading="lazy" decoding="async" />
  </figure>
  <figure class="wrap gcm__avatars" data-reveal>
    <img src={img('avatars')} alt={t.avatars} loading="lazy" decoding="async" />
    <figcaption class="muted">{t.avatars}</figcaption>
  </figure>
  <figure class="gcm__bleed" data-reveal>
    <img src={img('tube-flatlay')} alt={t.paper} loading="lazy" decoding="async" />
    <figcaption class="wrap muted">{t.paper}</figcaption>
  </figure>
  <figure class="gcm__bleed" data-reveal>
    <img src={img('fence')} alt={t.fence} loading="lazy" decoding="async" />
    <figcaption class="wrap muted">{t.fence}</figcaption>
  </figure>

  <div class="gcm__dark" data-reveal>
    <div class="wrap gcm__dark-in">
      <svg class="gcm__bp" viewBox="-6 -6 246 246" aria-hidden="true">
        <g class="gcm__grid"><path d="M117 -6V240M-6 117H240M-6 240L240 -6"/></g>
        <path d={iso} class="gcm__iso" />
      </svg>
      <div>
        <h2 class="gcm__dark-title">{t.dark}</h2>
        <p>{t.darkA}</p>
        <p>{t.darkB}</p>
        <p>{t.darkC}</p>
      </div>
    </div>
  </div>
  <figure class="gcm__bleed gcm__bleed--flush" data-reveal>
    <img src={img('banner-wide')} alt="Global Citizen" loading="lazy" decoding="async" />
  </figure>
  <figure class="gcm__bleed gcm__bleed--flush" data-reveal>
    <img src={img('billboard')} alt={t.boards} loading="lazy" decoding="async" />
    <figcaption class="wrap muted">{t.boards}</figcaption>
  </figure>

  <div class="wrap gcm__end" data-reveal>
    <h2 class="h2">{t.end}</h2>
    <div><p>{t.endA}</p><p>{t.endB}</p></div>
  </div>
</section>

<style>
  /* Contenedor común: el contenido vive en un ancho centrado (72 rem), alineado con el encabezado */
  .gcm > .wrap { max-width: 72rem; }
  .gcm > figure.wrap { margin-inline: auto; }
  .gcm { display: grid; gap: clamp(5rem, 11vw, 11rem); padding-bottom: clamp(3rem, 6vw, 6rem); --gc: #5db98a; }
  .gcm img { width: 100%; height: auto; display: block; }
  .gcm figure { margin: 0; }
  .gcm figcaption { font-size: .8rem; padding-top: .75rem; }
  .gcm__head { display: grid; gap: 1.25rem; max-width: 62rem; }
  .gcm__intro { margin: 0; font-size: clamp(1.25rem, 2.2vw, 2rem); line-height: 1.35; }
  .gcm__text p:empty { display: none; }
  .gcm__bleed { width: 100%; }
  .gcm__bleed--flush { margin-top: calc(-1 * clamp(3rem, 7vw, 7rem)); }
  .gcm__block { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: clamp(2rem, 5vw, 6rem); align-items: start; }
  .gcm__text { display: grid; gap: 1.25rem; color: var(--muted); max-width: 38rem; }
  .gcm__text p { margin: 0; }
  .gcm__text .h2 { color: var(--fg); margin-bottom: .5rem; }
  .gcm__strong { color: var(--fg); font-weight: 500; }
  .gcm__mood img { border-radius: 2px; }
  .gcm__mood figcaption strong { color: var(--fg); font-weight: 500; }
  .gcm__block--map { align-items: center; }
  .gcm__chips { display: grid; gap: .8rem; }
  .chips { display: flex; flex-wrap: wrap; gap: .5rem; list-style: none; margin: 0; padding: 0; }
  .chips li { padding: .5rem 1rem; border: 1px solid var(--line); border-radius: 999px; font-size: .92rem; font-weight: 400; color: var(--fg); transition: border-color .5s var(--ease), background .5s var(--ease); }
  .chips--b li { font-weight: 600; }
  .chips li.is-green { color: var(--gc); }
  .chips li:hover { border-color: var(--gc); background: rgb(93 185 138 / .08); }
  .gcm__title { margin-bottom: calc(-1 * clamp(1.5rem, 4vw, 4rem)); }
  .gcm__pair { display: grid; grid-template-columns: 1.55fr 1fr; gap: var(--gutter); }
  .gcm__pair img { height: 100%; object-fit: cover; }
  .gcm__avatars { max-width: 70rem; }
  /* Concepto, grillas, paleta y tipografía */
  /* Estas secciones: el texto arriba, en una sola columna, y la pieza gráfica debajo ocupando todo el ancho */
  .gcm__block--concept, .gcm__block--grid, .gcm__block--res, .gcm__type { grid-template-columns: minmax(0, 1fr); gap: clamp(2rem, 5vw, 4rem); align-items: start; }
  .gcm__block--concept .gcm__text, .gcm__block--grid .gcm__text, .gcm__block--res .gcm__text, .gcm__type .gcm__text { max-width: 46rem; }
  .gcm__synth { display: grid; gap: clamp(2rem, 4vw, 3.5rem); }
  .gcm__synth-t { display: grid; gap: 1.1rem; max-width: 62rem; }
  .gcm__synth-t .h2 { margin-bottom: .3rem; } .gcm__synth-t p { margin: 0; }
  .gcm__cols { display: grid; gap: 1.1rem; color: var(--muted); max-width: 46rem; }
  .gcm__res { display: grid; gap: clamp(2rem, 5vw, 4rem); }
    .gcm__restxt { margin: 0; color: var(--muted); max-width: 52rem; line-height: 1.65; }
  .gcm__hint { font-size: .8rem; letter-spacing: .08em; }
  .gcm__pal { display: grid; gap: 1.6rem; }
  .gcm__sub { margin: 1.2rem 0 0; font-size: .75rem; letter-spacing: .16em; text-transform: uppercase; color: var(--muted); font-weight: 500; }
  .gcm__sw { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: .6rem; }
  .gcm__sw--x { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  .gcm__sw li { display: grid; align-content: end; gap: .15rem; min-height: clamp(7rem, 13vw, 11rem); padding: 1rem; border-radius: 4px; background: var(--c); color: var(--f); transform: translateY(18px); opacity: 0; transition: transform .8s calc(var(--i) * .1s) var(--ease, ease), opacity .8s calc(var(--i) * .1s) ease; }
  .gcm__sw.is-in li { transform: none; opacity: 1; }
  .gcm__sw b { font-weight: 700; font-size: .9rem; } .gcm__sw span { font-size: .78rem; opacity: .8; letter-spacing: .06em; }
  .gcm__spec { display: grid; gap: .9rem; font-family: 'Nunito Sans', var(--sans); }
  .gcm__spec p { margin: 0; }
  .gcm__nb { font-weight: 800; font-size: .85rem; color: var(--muted); letter-spacing: .08em; text-transform: uppercase; }
  .gcm__nb--l { font-size: clamp(1.8rem, 4.4vw, 3.4rem); line-height: 1; color: var(--gc); letter-spacing: -.01em; text-transform: none; }
  .gcm__nr { font-weight: 400; font-size: 1.1rem; } .gcm__nl { font-weight: 300; font-size: 1.1rem; }
  @media (max-width: 860px) { .gcm__sw { grid-template-columns: repeat(2, minmax(0, 1fr)); } .gcm__sw--x { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  /* Modo oscuro "blueprint" */
  .gcm__dark { background: #2c2c2c; padding-block: clamp(4rem, 9vw, 9rem); color: #5db98a; }
  .gcm__dark-in { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: clamp(2rem, 5vw, 6rem); align-items: center; }
  .gcm__bp { width: min(100%, 26rem); justify-self: center; overflow: visible; }
  .gcm__grid path { fill: none; stroke: rgb(236 235 230 / .12); stroke-width: .5; }
  .gcm__iso { fill: #3d3b3a; stroke: #5db98a; stroke-width: 1; stroke-linejoin: round; }
  .gcm__dark p { margin: 0 0 1rem; max-width: 40rem; font-weight: 500; line-height: 1.5; }
  .gcm__dark-title { margin: 0 0 1.5rem; font-family: var(--sans); font-weight: 700; font-size: clamp(1.15rem, 2vw, 1.6rem); letter-spacing: .3em; text-transform: uppercase; line-height: 1.4; color: #5db98a; }
  /* Conclusión */
  .gcm__end { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: clamp(2rem, 5vw, 6rem); color: var(--muted); }
  .gcm__end > div { display: grid; gap: 1.25rem; max-width: 46rem; }
  .gcm__end p { margin: 0; }
  @media (max-width: 860px) {
    .gcm__block, .gcm__dark-in, .gcm__end { grid-template-columns: 1fr; }
    .gcm__pair { grid-template-columns: 1fr; }
  }
</style>

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Nunito+Sans:wght@300;400;800&display=swap" />

<script>
  // Las piezas geométricas del manual (logos, módulos, grillas y paleta) se animan al entrar en pantalla
  const run = () => {
    const els = document.querySelectorAll<HTMLElement>('[data-gc]:not([data-gc-on])');
    if (!els.length) return;
    const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('is-in'); io.unobserve(e.target); } }), { threshold: 0.3 });
    els.forEach((el) => { el.setAttribute('data-gc-on', ''); io.observe(el); });
  };
  document.addEventListener('astro:page-load', run);
  run();
  // Trama de módulos: al pasar el cursor, una onda sutil se propaga hacia los vecinos según su distancia
  const ripple = () => {
    document.querySelectorAll<SVGGElement>('.gcr__tapiz:not([data-rip])').forEach((svg) => {
      svg.setAttribute('data-rip', '');
      const tiles = [...svg.querySelectorAll<SVGGElement>('.gcr__tile')];
      svg.addEventListener('pointerover', (e) => {
        const t = (e.target as Element).closest<SVGGElement>('.gcr__tile'); if (!t) return;
        const x = +t.dataset.gx!, y = +t.dataset.gy!;
        tiles.forEach((o) => {
          if (o === t) return;
          const d = Math.hypot(+o.dataset.gx! - x, +o.dataset.gy! - y);
          o.style.setProperty('--rd', String(Math.round(d * 7)));
          o.classList.remove('is-rip'); void (o as unknown as HTMLElement).getBoundingClientRect(); o.classList.add('is-rip');
        });
      });
    });
  };
  document.addEventListener('astro:page-load', ripple);
  ripple();
</script>
