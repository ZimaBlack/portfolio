---
// Manual de marca de Global Citizen adaptado al sitio: texto nativo (bilingüe) + piezas recortadas del manual original en /works/global-citizen/manual/
import { withBase, type Lang } from '../lib/i18n';
import markRaw from '../../public/works/global-citizen/mark.svg?raw';

const { lang } = Astro.props as { lang: Lang };
const es = lang === 'es';
const img = (n: string) => withBase(`/works/global-citizen/manual/${n}.webp`);
// Trazo del isotipo, para dibujarlo en modo "blueprint" (contorno)
const iso = [...markRaw.matchAll(/\bd="([^"]+)"/g)].map((m) => m[1]).join(' ');

const t = es ? {
  intro: 'Identidad para una marca de bienes raíces e inversión, de inspiración suiza: grilla, geometría y espacio negativo.',
  logos: 'Isotipo, versión vertical y horizontal.',
  insp: 'Estilo Internacional',
  inspA: 'La referencia gráfica de la marca: el modernismo suizo.',
  inspB: 'Tipografía clara, jerarquía simple y mucho espacio.',
  refs: 'Referencias',
  refsBy: 'Josef Müller-Brockmann · Armin Hofmann',
  map: 'Mapa conceptual',
  mapA: 'Del estilo internacional al rubro: ramas conceptuales que ordenan la identidad.',
  mapB: '',
  mapC: 'Un modelo vivo, siempre en revisión.',
  mock: 'Aplicaciones',
  cards: 'Tarjetería',
  avatars: 'Avatares para redes',
  paper: 'Papelería comercial, A4 membrete y tubo de planos',
  fence: 'Gráfica de obra',
  boards: 'Cartelería',
  dark: 'Modo oscuro',
  darkA: 'Opción «blueprint» para piezas premium o internas.',
  darkB: 'Usa la grilla como soporte geométrico.',
  darkC: 'Es opcional.',
  end: 'Principios',
  endA: 'Minimalismo, funcionalidad e innovación.',
  endB: 'Mensajes simples, jerarquía armónica y uso intencional del espacio negativo.',
} : {
  intro: 'Identity for a real estate and investment brand, Swiss-inspired: grid, geometry and negative space.',
  logos: 'Isotype, stacked and horizontal versions.',
  insp: 'International Style',
  inspA: 'The brand’s graphic reference: Swiss modernism.',
  inspB: 'Clear type, simple hierarchy and plenty of space.',
  refs: 'References',
  refsBy: 'Josef Müller-Brockmann · Armin Hofmann',
  map: 'Concept map',
  mapA: 'From the international style to the field: conceptual branches that organize the identity.',
  mapB: '',
  mapC: 'A living model, always under review.',
  mock: 'Applications',
  cards: 'Business cards',
  avatars: 'Social media avatars',
  paper: 'Commercial stationery, A4 letterhead and plan tube',
  fence: 'Construction hoarding',
  boards: 'Signage',
  dark: 'Dark mode',
  darkA: 'A “blueprint” option for premium or internal pieces.',
  darkB: 'It uses the grid as geometric support.',
  darkC: 'It is optional.',
  end: 'Principles',
  endA: 'Minimalism, functionality and innovation.',
  endB: 'Simple messages, harmonious hierarchy and intentional use of negative space.',
};

// Mapa conceptual: cada fila es una tanda de conceptos (v = verde de marca; b = negrita)
type Chip = [string, boolean?];
const rows: { b: boolean; chips: Chip[] }[] = [
  { b: true, chips: [['BIENES RAICES'], ['INVERSIÓN', true], ['INNOVACION', true], ['ESPACIOS HUMANOS']] },
  { b: true, chips: [['Implementacion'], ['Rentabilidad', true], ['Global Mundial', true], ['Arquitectura'], ['Experiencial']] },
  { b: true, chips: [['Enfoque humano', true], ['Enfoque Ambiental', true], ['Tecnología']] },
  { b: false, chips: [['Viabilidad'], ['Versatilidad'], ['Adaptavilidad'], ['Funcionalidad', true], ['Aplicabilidad', true], ['Sustentabilidad', true]] },
  { b: false, chips: [['Cultura organizativa', true], ['Construtivismo', true], ['Minimalismo']] },
  { b: false, chips: [['Ergonomia', true], ['Materializacion disruptiva'], ['Ecosisitemas', true], ['Ecobrutalismo'], ['Simbiosis']] },
];
---
<section class="gcm" aria-label={es ? 'Identidad' : 'Identity'}>
  <figure class="gcm__bleed" data-reveal>
    <img src={img('logos')} alt={t.logos} loading="lazy" decoding="async" width="1800" height="1110" />
    <figcaption class="wrap muted">{t.logos}</figcaption>
  </figure>

  <div class="wrap gcm__block">
    <div class="gcm__text" data-reveal>
      <h2 class="h2">{t.insp}</h2>
      <p>{t.inspA}</p>
      <p class="gcm__strong">{t.inspB}</p>
    </div>
    <figure class="gcm__mood" data-reveal>
      <img src={img('moodboard')} alt={t.insp} loading="lazy" decoding="async" width="1800" height="2118" />
      <figcaption class="muted">{t.refs}: <strong>{t.refsBy}</strong></figcaption>
    </figure>
  </div>

  <div class="wrap gcm__block gcm__block--map">
    <div class="gcm__text" data-reveal>
      <h2 class="h2">{t.map}</h2>
      <p>{t.mapA}</p>
      <p>{t.mapB}</p>
      <p class="gcm__strong">{t.mapC}</p>
    </div>
    <div class="gcm__chips" data-reveal>
      {rows.map((r) => (
        <ul class:list={['chips', { 'chips--b': r.b }]}>
          {r.chips.map(([label, green]) => <li class:list={{ 'is-green': green }}>{label}</li>)}
        </ul>
      ))}
    </div>
  </div>

  <div class="wrap gcm__title" data-reveal><h2 class="h2">{t.mock}</h2></div>

  <div class="wrap gcm__pair" data-reveal>
    <figure><img src={img('card-green')} alt={t.cards} loading="lazy" decoding="async" /></figure>
    <figure><img src={img('card-tray')} alt={t.cards} loading="lazy" decoding="async" /></figure>
  </div>
  <figure class="gcm__bleed" data-reveal>
    <img src={img('banner-dark')} alt="Global Citizen" loading="lazy" decoding="async" />
  </figure>
  <figure class="wrap gcm__avatars" data-reveal>
    <img src={img('avatars')} alt={t.avatars} loading="lazy" decoding="async" />
    <figcaption class="muted">{t.avatars}</figcaption>
  </figure>
  <figure class="gcm__bleed" data-reveal>
    <img src={img('tube-flatlay')} alt={t.paper} loading="lazy" decoding="async" />
    <figcaption class="wrap muted">{t.paper}</figcaption>
  </figure>
  <figure class="gcm__bleed" data-reveal>
    <img src={img('fence')} alt={t.fence} loading="lazy" decoding="async" />
    <figcaption class="wrap muted">{t.fence}</figcaption>
  </figure>

  <div class="gcm__dark" data-reveal>
    <div class="wrap gcm__dark-in">
      <svg class="gcm__bp" viewBox="-6 -6 246 246" aria-hidden="true">
        <g class="gcm__grid"><path d="M117 -6V240M-6 117H240M-6 240L240 -6"/></g>
        <path d={iso} class="gcm__iso" />
      </svg>
      <div>
        <h2 class="gcm__dark-title">{t.dark}</h2>
        <p>{t.darkA}</p>
        <p>{t.darkB}</p>
        <p>{t.darkC}</p>
      </div>
    </div>
  </div>
  <figure class="gcm__bleed gcm__bleed--flush" data-reveal>
    <img src={img('banner-wide')} alt="Global Citizen" loading="lazy" decoding="async" />
  </figure>
  <figure class="gcm__bleed gcm__bleed--flush" data-reveal>
    <img src={img('billboard')} alt={t.boards} loading="lazy" decoding="async" />
    <figcaption class="wrap muted">{t.boards}</figcaption>
  </figure>

  <div class="wrap gcm__end" data-reveal>
    <h2 class="h2">{t.end}</h2>
    <div><p>{t.endA}</p><p>{t.endB}</p></div>
  </div>
</section>

<style>
  /* Contenedor común: el contenido vive en un ancho centrado (72 rem), alineado con el encabezado */
  .gcm > .wrap { max-width: 72rem; }
  .gcm > figure.wrap { margin-inline: auto; }
  .gcm { display: grid; gap: clamp(3rem, 7vw, 7rem); padding-bottom: clamp(3rem, 6vw, 6rem); --gc: #5db98a; }
  .gcm img { width: 100%; height: auto; display: block; }
  .gcm figure { margin: 0; }
  .gcm figcaption { font-size: .8rem; padding-top: .75rem; }
  .gcm__head { display: grid; gap: 1.25rem; max-width: 62rem; }
  .gcm__intro { margin: 0; font-size: clamp(1.25rem, 2.2vw, 2rem); line-height: 1.35; }
  .gcm__text p:empty { display: none; }
  .gcm__bleed { width: 100%; }
  .gcm__bleed--flush { margin-top: calc(-1 * clamp(3rem, 7vw, 7rem)); }
  .gcm__block { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: clamp(2rem, 5vw, 6rem); align-items: start; }
  .gcm__text { display: grid; gap: 1.25rem; color: var(--muted); max-width: 38rem; }
  .gcm__text p { margin: 0; }
  .gcm__text .h2 { color: var(--fg); margin-bottom: .5rem; }
  .gcm__strong { color: var(--fg); font-weight: 500; }
  .gcm__mood img { border-radius: 2px; }
  .gcm__mood figcaption strong { color: var(--fg); font-weight: 500; }
  .gcm__block--map { align-items: center; }
  .gcm__chips { display: grid; gap: .8rem; }
  .chips { display: flex; flex-wrap: wrap; gap: .5rem; list-style: none; margin: 0; padding: 0; }
  .chips li { padding: .5rem 1rem; border: 1px solid var(--line); border-radius: 999px; font-size: .92rem; font-weight: 400; color: var(--fg); transition: border-color .5s var(--ease), background .5s var(--ease); }
  .chips--b li { font-weight: 600; }
  .chips li.is-green { color: var(--gc); }
  .chips li:hover { border-color: var(--gc); background: rgb(93 185 138 / .08); }
  .gcm__title { margin-bottom: calc(-1 * clamp(1.5rem, 4vw, 4rem)); }
  .gcm__pair { display: grid; grid-template-columns: 1.55fr 1fr; gap: var(--gutter); }
  .gcm__pair img { height: 100%; object-fit: cover; }
  .gcm__avatars { max-width: 70rem; }
  /* Modo oscuro "blueprint" */
  .gcm__dark { background: #2c2c2c; padding-block: clamp(4rem, 9vw, 9rem); color: #5db98a; }
  .gcm__dark-in { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: clamp(2rem, 5vw, 6rem); align-items: center; }
  .gcm__bp { width: min(100%, 26rem); justify-self: center; overflow: visible; }
  .gcm__grid path { fill: none; stroke: rgb(236 235 230 / .12); stroke-width: .5; }
  .gcm__iso { fill: #3d3b3a; stroke: #5db98a; stroke-width: 1; stroke-linejoin: round; }
  .gcm__dark p { margin: 0 0 1rem; max-width: 40rem; font-weight: 500; line-height: 1.5; }
  .gcm__dark-title { margin: 0 0 1.5rem; font-family: var(--sans); font-weight: 700; font-size: clamp(1.15rem, 2vw, 1.6rem); letter-spacing: .3em; text-transform: uppercase; line-height: 1.4; color: #5db98a; }
  /* Conclusión */
  .gcm__end { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: clamp(2rem, 5vw, 6rem); color: var(--muted); }
  .gcm__end > div { display: grid; gap: 1.25rem; max-width: 46rem; }
  .gcm__end p { margin: 0; }
  @media (max-width: 860px) {
    .gcm__block, .gcm__dark-in, .gcm__end { grid-template-columns: 1fr; }
    .gcm__pair { grid-template-columns: 1fr; }
  }
</style>
