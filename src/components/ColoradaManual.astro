---
// Resumen del manual de Colorada para el portfolio. Sin la tipografía ni los fondos del manual original:
// los logos van en línea (SVG) y toman los colores del widget del hero (--pw-0 / --pw-1); el resto de la página también.
import { readFileSync } from 'node:fs';
import { join } from 'node:path';
import { withBase, type Lang } from '../lib/i18n';
import TintPhoto from './TintPhoto.astro';
import TintMask from './TintMask.astro';

const { lang } = Astro.props as { lang: Lang };
const es = lang === 'es';
const sketch = withBase('/works/colorada/manual/boceto.webp');
const palettePhoto = withBase('/works/colorada/manual/paleta-foto.webp');
const fixedLogo = withBase('/works/colorada/logo.svg');

// Logo en línea: el pelo (#E03B7A) y el mechón (#6CE829) leen --c0 / --c1, que por defecto siguen al widget
const inline = (file: string, label: string) => readFileSync(join(process.cwd(), 'public/works/colorada', file), 'utf8')
  .replace(/fill="#E03B7A"/gi, 'style="fill:var(--c0)"')
  .replace(/fill="#6CE829"/gi, 'style="fill:var(--c1)"')
  .replace(/<svg\b([^>]*)>/i, (_m, a) => `<svg${a.replace(/\s(width|height)="[^"]*"/g, '')} role="img" aria-label="${label}">`);
// SVG de una sección: los rosas y verdes de la marca leen --c0 / --c1; los rellenos de degradado también
const tinted = (file: string, label: string, slice = false, fixed = false) => readFileSync(join(process.cwd(), 'public/works/colorada/manual', file), 'utf8')
  .replace(/fill="#E03B7A"/gi, (m) => (fixed ? m : 'style="fill:var(--c0)"')).replace(/fill="#6CE829"/gi, (m) => (fixed ? m : 'style="fill:var(--c1)"'))
  .replace(/stop-color="#E03B7A"/gi, (m) => (fixed ? m : 'style="stop-color:var(--c0)"'))
  .replace(/<svg\b([^>]*)>/i, (_m, a) => `<svg${a.replace(/\s(width|height)="[^"]*"/g, '')}${slice ? ' preserveAspectRatio="xMidYMax slice"' : ''} role="img" aria-label="${label}">`);
const variable = tinted('paleta-variable.svg', 'Colorada — paleta variable');
// El cierre del proyecto respeta siempre la paleta madre (#E03B7A y #6CE829), sin seguir al widget
const closer = tinted('cierre.svg', 'Colorada', true, true);
// Formas del mármol de la lámina de cierre: se reutilizan en las tres piezas de "Recursos gráficos"
const marble = [...readFileSync(join(process.cwd(), 'public/works/colorada/manual/cierre.svg'), 'utf8').matchAll(/<path d="([^"]+)" fill="(?:black|url\([^)]*\))"/g)].map((m) => m[1]).filter((d) => /C/.test(d) && !/^M[\d. ]+[HV]/.test(d)).slice(0, 22);
const crops = ['380 560 1500 1500', '1180 320 1500 1500', '640 640 1500 1500'];
// Paletas de prueba: colores exactos (el primero va al pelo y los fondos, el segundo al mechón y al isotipo); no activan el modo blanco y negro
const presets: [string, string][] = [['#E03B7A', '#6CE829'], ['#6A3FE0', '#2FE0C4'], ['#D6213C', '#FFB627'], ['#2F52E0', '#E3C4FF'], ['#0E8C8F', '#FF7A59'], ['#23232B', '#F4C7DD']]; // [color 1, color 2]: pares armónicos (análogo/complementario) elegidos por contraste y por cómo se ven sobre piel y pelo
const character = inline('logo.svg', 'Colorada — character');
const wordmark = inline('mark.svg', 'Colorada — logotipo');

const t = es ? {
  lead: 'Identidad variable para una marca personal de cabello fantasía.',
  brandA: 'Un personaje, un conejo y una paleta que cambia según el momento.',
  tags: ['Audaz', 'Joven y rebelde', 'Sensual y simpática', 'De contrastes'],
  sketch: 'Del boceto al personaje',
  sketchCap: 'Boceto original',
  photoCap: 'La marca tiñe la imagen: cambia los colores de la derecha',
  photo2Cap: 'Retrato teñido con los colores de la marca',
  blend: 'Let’s blend!',
  blendA: 'Una sola imagen, muchas versiones. El pelo, el isotipo y los fondos se pintan con los dos colores de la marca: probá una paleta o mové las barras y la fotografía cambia entera, sin perder su textura.',
  varPal: 'Paleta variable',
  varPalA: 'Dos colores madre, #E03B7A y #6CE829, de los que nace todo el sistema: el rosa lleva el peso y el verde acentúa.',
  res: 'Recursos gráficos',
  resA: 'Un mármol líquido de formas orgánicas que se usa en blanco y negro, en color o con el isotipo encima.',
  mother: 'La paleta madre',
  motherA: 'Estos tonos son la base de todas las aplicaciones: fondos, retratos y piezas que conservan el rosa como protagonista.',
  cmp: 'Comparación de métodos',
  cmpA: 'La misma foto con el método de las fotos laterales, para compararlo con el retrato de arriba.',
  cmpCap: 'Color · 67 % · desenfoque 1,6',
  portrait: 'Una imagen, muchas versiones',
  portraitA: 'El pelo, el isotipo y los fondos se pintan con los dos colores de la marca: al mover el widget, la fotografía cambia entera y conserva su textura.',
  tint: 'La marca tiñe la imagen',
  tintA: 'El cabello toma los dos colores de la marca. Las formas se desenfocan y se funden con la foto.',
  sketchTxt: 'Todo parte de un trazo a lápiz: una cabeza que se acurruca, el flequillo como gesto y una mirada de reojo. La marca conserva esa actitud.',
  system: 'Un sistema variable',
  systemA: 'Dos íconos: el personaje (Character) y el conejo (Capsule). En reducciones extremas, la cápsula.',
  systemB: 'El logotipo vive en un contenedor oscuro que prioriza la legibilidad.',
  charCap: 'Isologotipo · Character',
  wordCap: 'Logotipo con refuerzo gráfico',
  color: 'El color como variable',
  colorA: 'La paleta se adapta al evento o al entorno. Probala con los selectores: la página cambia con ellos. La base queda fija.',
  base: 'Paleta base',
  baseCap: 'Rosa y verde, el punto de partida',
  region: 'Variaciones de color de la marca',
} : {
  lead: 'A variable identity for a fantasy hair-care personal brand.',
  brandA: 'A character, a bunny and a palette that changes with the moment.',
  tags: ['Bold', 'Young & rebellious', 'Sensual & sympathetic', 'Of contrasts'],
  sketch: 'From sketch to character',
  sketchCap: 'Original sketch',
  photoCap: 'The brand tints the image: change the colors on the right',
  photo2Cap: 'Portrait tinted with the brand colors',
  blend: 'Let’s blend!',
  blendA: 'One image, many versions. The hair, the isotype and the backdrops are painted with the brand’s two colors: try a palette or move the bars and the whole photograph changes while keeping its texture.',
  varPal: 'Variable palette',
  varPalA: 'Two mother colors, #E03B7A and #6CE829, from which the whole system is born: pink carries the weight and green accents.',
  res: 'Graphic resources',
  resA: 'A liquid marble of organic shapes used in black and white, in color or with the isotype on top.',
  mother: 'The mother palette',
  motherA: 'These tones are the base of every application: backgrounds, portraits and pieces that keep pink as the lead.',
  cmp: 'Method comparison',
  cmpA: 'The same photo with the side photos’ method, to compare against the portrait above.',
  cmpCap: 'Color · 67% · blur 1.6',
  portrait: 'One image, many versions',
  portraitA: 'The hair, the isotype and the backdrops are painted with the brand’s two colors: move the widget and the whole photograph changes while keeping its texture.',
  tint: 'The brand tints the image',
  tintA: 'The hair takes the brand’s two colors. The shapes are blurred and blended into the photo.',
  sketchTxt: 'It all starts with a pencil line: a head curling up, the fringe as a gesture and a sideways glance. The brand keeps that attitude.',
  system: 'A variable system',
  systemA: 'Two icons: the character (Character) and the bunny (Capsule). In extreme reductions, the capsule.',
  systemB: 'The logotype lives in a dark container that prioritizes legibility.',
  charCap: 'Isologotype · Character',
  wordCap: 'Logotype with graphic reinforcement',
  color: 'Color as a variable',
  colorA: 'The palette adapts to the event or environment. Try it with the pickers: the page changes with them. The base stays fixed.',
  base: 'Base palette',
  baseCap: 'Pink and green, the starting point',
  region: 'Brand color variations',
};

---
<section class="cm" aria-label={es ? 'Identidad' : 'Identity'}>
  <div class="wrap cm__head" data-reveal>
    <ul class="cm__tags">{t.tags.map((x) => <li>{x}</li>)}</ul>
  </div>

  <div class="wrap cm__row cm__row--sketch cm__row--plain" data-reveal>
    <figure class="cm__sketch">
      <img src={sketch} alt={t.sketchCap} loading="lazy" decoding="async" />
      <figcaption class="muted">{t.sketchCap}</figcaption>
    </figure>
    <div class="cm__logo cm__logo--big" set:html={character} />
  </div>

  <div class="wrap cm__blend" id="cm-blend" data-reveal>
    <h2 class="h2">{t.blend}</h2>
    <p class="cm__txt">{t.blendA}</p>
    <div class="cm__blendgrid">
      <figure class="cm__photo cm__photo--big"><TintMask photo="/works/colorada/manual/r3.webp" plain={true} video="/works/colorada/manual/retrato-video.mp4" bw="/works/colorada/manual/r3.webp" layers={[
        { n: 'Campera', m: '/works/colorada/manual/r3-cloth.webp', c: '--c0', bl: 0.6, sat: 1, lum: 1, b: [['color', 0.77]] },
        { n: 'Pelo', m: '/works/colorada/manual/r3-hairMain.webp', c: '--c0', bl: 0.6, sat: 1, lum: 1, b: [['color', 0.77]] },
        { n: 'Mechones', m: '/works/colorada/manual/r3-hairAcc.webp', c: '--c1', bl: 0.6, sat: 1.31, lum: 0.4, b: [['color', 0.83]] },
        { n: 'Flequillo', m: '/works/colorada/manual/r3-front.webp', c: '--c1', bl: 0.6, sat: 1.31, lum: 0.4, b: [['color', 0.83]] },
        { n: 'Logos', m: '/works/colorada/manual/r3-logoMain.webp', c: '--c0', bl: 0.6, sat: 1, lum: 1, b: [['color', 0.77]] },
        { n: 'Logos acento', m: '/works/colorada/manual/r3-logoAcc.webp', c: '--c1', bl: 0.6, sat: 1.31, lum: 0.4, b: [['color', 0.83]] },
      ]} layers2={[
        { n: 'Campera', m: '/works/colorada/manual/t3-cloth.webp', c: '--c0', bl: 0.6, sat: 1, lum: 1, b: [['color', 0.77]] },
        { n: 'Pelo', m: '/works/colorada/manual/t3-hairMain.webp', c: '--c0', bl: 0.6, sat: 1, lum: 1, b: [['color', 0.77]] },
        { n: 'Mechones', m: '/works/colorada/manual/t3-hairAcc.webp', c: '--c1', bl: 0.6, sat: 1.31, lum: 0.4, b: [['color', 0.83]] },
        { n: 'Flequillo', m: '/works/colorada/manual/t3-front.webp', c: '--c1', bl: 0.6, sat: 1.31, lum: 0.4, b: [['color', 0.83]] },
        { n: 'Logos', m: '/works/colorada/manual/t3-logoMain.webp', c: '--c0', bl: 0.6, sat: 1, lum: 1, b: [['color', 0.77]] },
        { n: 'Logos acento', m: '/works/colorada/manual/t3-logoAcc.webp', c: '--c1', bl: 0.6, sat: 1.31, lum: 0.4, b: [['color', 0.83]] },
      ]} t2={2.667} alt={t.blend} ratio="1391 / 1830" /></figure>
      <div class="cm__proc">
        <figure class="cm__pola cm__pola--a"><TintPhoto photo="/works/colorada/manual/foto-01.webp" shapes="/works/colorada/manual/foto-01.svg" alt={t.photoCap} ratio="1792 / 2400" blur={1.6} /></figure>
        <figure class="cm__pola cm__pola--b"><TintPhoto photo="/works/colorada/manual/foto-03.webp" shapes="/works/colorada/manual/foto-03.svg" alt={t.photo2Cap} ratio="1298 / 1718" blur={1.6} /></figure>
      </div>
      <ul class="cm__presets" role="group" aria-label={t.blend}>
        {presets.map(([a, b]) => (
          <li><button type="button" data-cm-preset={`${a},${b}`} aria-label={`${a} · ${b}`}><i style={`background:${b}`}></i><i style={`background:${a}`}></i></button></li>
        ))}
      </ul>
      <div class="cm__slot" data-pw-slot aria-hidden="true"></div>
    </div>
  </div>

  <div class="wrap cm__row" data-reveal>
    <div class="cm__side">
      <h2 class="h2">{t.system}</h2>
      <p class="cm__txt">{t.systemA}</p>
      <p class="cm__txt">{t.systemB}</p>
    </div>
    <div class="cm__pair">
      <figure><div class="cm__logo" set:html={character} /><figcaption class="muted">{t.charCap}</figcaption></figure>
      <figure><div class="cm__logo cm__logo--word" set:html={wordmark} /><figcaption class="muted">{t.wordCap}</figcaption></figure>
    </div>
  </div>

  <div class="wrap cm__varpal" data-reveal>
    <div class="cm__varpal-t"><h2 class="h2">{t.varPal}</h2><p class="cm__txt">{t.varPalA}</p></div>
    <div class="cm__vp" set:html={variable} />
  </div>

  <div class="wrap cm__res" data-reveal>
    <h2 class="h2">{t.res}</h2>
    <p class="cm__txt">{t.resA}</p>
    <ul class="cm__tiles">
      {crops.map((vb, i) => (
        <li class={`cm__tile cm__tile--${i}`}>
          <svg viewBox={vb} preserveAspectRatio="xMidYMid slice" aria-hidden="true" focusable="false">{marble.map((d) => <path d={d} />)}</svg>
          {i === 2 && <div class="cm__tilelogo" set:html={character} />}
        </li>
      ))}
    </ul>
  </div>

  <div class="wrap cm__mother" data-reveal>
    <h2 class="h2">{t.mother}</h2>
    <p class="cm__txt">{t.motherA}</p>
    <img src={withBase('/works/colorada/manual/paleta-madre.webp')} alt={t.mother} width="2000" height="1821" loading="lazy" decoding="async" />
  </div>

  <div class="cm__closer" aria-hidden="true"><div class="cm__closerin" set:html={closer} /></div>
</section>

<script>
  // Paletas de prueba: ajustan el widget directamente (no cuentan para el modo blanco y negro)
  const initP = () => document.querySelectorAll<HTMLButtonElement>('[data-cm-preset]:not([data-on])').forEach((b) => {
    b.setAttribute('data-on', '');
    b.addEventListener('click', () => { window.dispatchEvent(new CustomEvent('pw:set', { detail: { colors: b.dataset.cmPreset!.split(',') } })); });
  });
  document.addEventListener('astro:page-load', initP); initP();
</script>

<script>
  // Los rótulos hex de la paleta variable muestran el color vivo del widget
  const initHex = () => document.querySelectorAll<SVGTextElement>('.pv-hex:not([data-on])').forEach((t) => {
    t.setAttribute('data-on', '');
    const i = t.classList.contains('pv-hex--1') ? 1 : 0;
    const hero = document.querySelector<HTMLElement>('[data-pj-hero]');
    const upd = () => { const v = hero?.style.getPropertyValue(`--pw-${i}`).trim(); t.textContent = (v && /^#/.test(v) ? v : ['#E03B7A', '#6CE829'][i]).toUpperCase(); };
    if (hero) new MutationObserver(upd).observe(hero, { attributes: true, attributeFilter: ['style'] });
    upd();
  });
  document.addEventListener('astro:page-load', initHex); initHex();
</script>

<style>
  /* Contenedor común: el contenido vive en un ancho centrado (72 rem), alineado con el encabezado */
  .cm > .wrap { max-width: 72rem; }
  .cm > figure.wrap { margin-inline: auto; }
  .cm { --c0: var(--pw-0, #e03b7a); --c1: var(--pw-1, #6ce829); display: grid; gap: clamp(4rem, 9vw, 9rem); padding-block: clamp(3rem, 6vw, 6rem) clamp(4rem, 8vw, 8rem); }
  .cm figure { margin: 0; }
  .cm :global(.wrap) { padding-right: max(var(--gutter), 5.5rem); } /* deja libre el borde donde va el widget de color */
  .cm__head { display: grid; gap: 1.5rem; max-width: 62rem; }
  .cm__lead { margin: 0; font-size: clamp(1.25rem, 2.2vw, 2rem); line-height: 1.35; }
  .cm__txt { margin: 0; color: var(--muted); max-width: 40rem; }
  .cm__tags { display: flex; flex-wrap: wrap; gap: .5rem; list-style: none; margin: .5rem 0 0; padding: 0; }
  .cm__tags li { padding: .35rem 1rem; border: 1px solid color-mix(in srgb, var(--c0) 70%, transparent); border-radius: 999px; font-size: .85rem; color: color-mix(in srgb, var(--c0) 55%, var(--fg)); transition: border-color .8s linear, color .8s linear; }
  .cm .h2 { margin-bottom: 1rem; }
  .cm__row { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr); gap: clamp(2rem, 6vw, 7rem); align-items: center; }
  .cm__row--sketch { grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); }
  .cm__duo { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: clamp(1rem, 3vw, 2.5rem); align-items: start; }
  .cm__row--plain { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); }
  .cm__row--plain .cm__logo--big { margin: 0; justify-self: center; width: min(100%, 22rem); }
  .cm__row--plain .cm__sketch { max-width: 30rem; justify-self: center; width: 100%; }
  /* Polaroids pop: marcos claros apenas girados, y un SVG de formas con los colores del widget por encima */
  .cm__polas { position: relative; display: grid; grid-template-columns: 1fr 1fr; gap: clamp(.5rem, 2vw, 1.5rem); padding: 1rem .5rem 2rem; }
  .cm__pola { margin: 0; padding: .55rem .55rem 2.6rem; background: #f6f1e7; border-radius: 3px; box-shadow: 0 18px 40px rgb(0 0 0 / .45); transition: transform .6s var(--ease); }
  .cm__pola--a { transform: rotate(-3.5deg) translateY(.6rem); }
  .cm__pola--b { transform: rotate(3deg) translateY(-.6rem); }
  .cm__pola:hover { transform: rotate(0) scale(1.03); z-index: 2; }
  .cm__row--portrait { grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr); }
  .cm__photo--big { max-width: 38rem; justify-self: center; width: 100%; }
  .cm__photo--solo { max-width: 26rem; justify-self: center; width: 100%; }
  .cm__row--rev { grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); }
  .cm__photo figcaption { font-size: .8rem; padding-top: .75rem; }
  .cm__side { display: grid; gap: 1.25rem; align-content: start; }
  .cm__sketch { justify-self: stretch; }
  .cm__sketch img { width: 100%; height: auto; border-radius: 3px; box-shadow: 0 30px 80px rgb(0 0 0 / .5), 0 0 0 1px var(--line); }
  .cm__sketch figcaption, .cm__pair figcaption { font-size: .8rem; padding-top: .75rem; }
  .cm__logo :global(svg) { width: 100%; height: auto; }
  .cm__logo :global(svg path) { transition: fill .8s linear; }
  .cm__logo--big { width: min(100%, 15rem); margin-top: 1rem; }
  .cm__pair { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(1.5rem, 4vw, 4rem); align-items: end; }
  .cm__pair .cm__logo { max-width: 17rem; margin-inline: auto; }
  .cm__pair .cm__logo--word { max-width: 21rem; }
  .cm__pair figcaption { text-align: center; }
  .cm__fixed { width: min(100%, 14rem); height: auto; margin-block: .5rem; }
  .cm__base { display: flex; align-items: center; gap: .6rem; flex-wrap: wrap; }
  .cm__base p { margin: 0 0 0 .5rem; font-size: .82rem; }
  .cm__sw { width: 1.6rem; height: 1.6rem; border-radius: 50%; box-shadow: 0 0 0 1px var(--line); }
  /* Let's blend: la foto, las paletas de prueba y el hueco al que viaja el widget */
  .cm__cmp { display: grid; gap: 1.25rem; } .cm__cmpgrid { max-width: 32rem; }
  /* Fondo muy sutil, como el del hero: luz de color desde el lado del widget y, apenas, desde el lado contrario */
  .cm__blend { position: relative; isolation: isolate; display: grid; gap: 1.25rem; }
  .cm__blend::before { content: ''; position: absolute; z-index: -1; pointer-events: none; top: -4rem; bottom: -4rem; left: 50%; width: 100vw; transform: translateX(-50%);
    background:
      radial-gradient(ellipse 46% 62% at 88% 50%, color-mix(in srgb, var(--c0) 26%, transparent), transparent 70%),
      radial-gradient(ellipse 34% 48% at 8% 60%, color-mix(in srgb, var(--c1) 11%, transparent), transparent 70%);
    transition: background .8s linear; }
  .cm__blend .cm__photo--big { max-width: 34rem; justify-self: start; }
  .cm__blendgrid { display: grid; grid-template-columns: minmax(0, 34rem) minmax(0, 6.5rem) auto minmax(8rem, 1fr); gap: clamp(1.2rem, 3vw, 3rem); align-items: center; margin-top: 1rem; }
  .cm__presets { list-style: none; margin: 0; padding: 0; display: grid; gap: .8rem; }
  .cm__presets button { all: unset; box-sizing: border-box; display: grid; place-items: center; width: 3.2rem; height: 3.2rem; border-radius: 12px; border: 1px solid var(--line); background: color-mix(in srgb, var(--bg) 80%, #fff 6%); cursor: pointer; position: relative; transition: border-color .4s, transform .4s var(--ease); }
  .cm__presets button:hover, .cm__presets button:focus-visible { border-color: var(--fg); transform: translateX(3px); }
  .cm__presets i { grid-area: 1 / 1; width: 1.35rem; height: 1.35rem; border-radius: 5px; }
  .cm__presets i:first-child { transform: translate(-.35rem, -.35rem); } .cm__presets i:last-child { transform: translate(.35rem, .35rem); }
  /* Las fotos del proceso se montan sobre el borde del retrato, hacia el widget */
  .cm__proc { display: grid; gap: 1.2rem; align-self: center; margin-left: -7rem; position: relative; z-index: 2; }
  .cm__proc .cm__pola { padding: .4rem .4rem 1.6rem; }
  .cm__slot { align-self: stretch; display: flex; align-items: center; min-height: 26rem; }
  /* Paleta variable, recursos y paleta madre */
  .cm__res, .cm__mother { display: grid; gap: 1.25rem; }
  /* Paleta variable: la lámina va contra la derecha (junto al widget) y el título y el texto se montan sobre ella, alineados a la izquierda */
  .cm__varpal { position: relative; display: grid; justify-items: end; }
  .cm__varpal-t { position: absolute; left: var(--gutter); top: 0; z-index: 1; display: grid; gap: 1.25rem; max-width: 28rem; }
  .cm__vp { width: min(100%, 36rem); margin-right: -1rem; padding-top: 4rem; }
  .cm__vp :global(svg) { width: 100%; height: auto; }
  .cm__vp :global(path), .cm__closer :global(path), .cm__closer :global(stop) { transition: fill .8s linear, stop-color .8s linear; }
  /* Puntos de la paleta variable: tono sobre tono, más profundos que el círculo que los contiene */
  .cm__vp :global(.pv-dot--0) { fill: color-mix(in srgb, var(--c0) 62%, #000); } .cm__vp :global(.pv-dot--1) { fill: color-mix(in srgb, var(--c1) 62%, #000); }
  .cm__vp :global(.pv-dot) { transition: fill .8s linear; }
