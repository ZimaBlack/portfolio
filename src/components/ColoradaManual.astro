---
// Resumen del manual de Colorada para el portfolio. Sin la tipografía ni los fondos del manual original:
// los logos van en línea (SVG) y toman los colores del widget del hero (--pw-0 / --pw-1); el resto de la página también.
import { readFileSync } from 'node:fs';
import { join } from 'node:path';
import { withBase, type Lang } from '../lib/i18n';
import TintPhoto from './TintPhoto.astro';
import TintMask from './TintMask.astro';

const { lang } = Astro.props as { lang: Lang };
const es = lang === 'es';
const sketch = withBase('/works/colorada/manual/boceto.webp');
const palettePhoto = withBase('/works/colorada/manual/paleta-foto.webp');
const fixedLogo = withBase('/works/colorada/logo.svg');

// Logo en línea: el pelo (#E03B7A) y el mechón (#6CE829) leen --c0 / --c1, que por defecto siguen al widget
const inline = (file: string, label: string) => readFileSync(join(process.cwd(), 'public/works/colorada', file), 'utf8')
  .replace(/fill="#E03B7A"/gi, 'style="fill:var(--c0)"')
  .replace(/fill="#6CE829"/gi, 'style="fill:var(--c1)"')
  .replace(/<svg\b([^>]*)>/i, (_m, a) => `<svg${a.replace(/\s(width|height)="[^"]*"/g, '')} role="img" aria-label="${label}">`);
const character = inline('logo.svg', 'Colorada — character');
const wordmark = inline('mark.svg', 'Colorada — logotipo');

const t = es ? {
  lead: 'Identidad variable para una marca personal de cabello fantasía.',
  brandA: 'Un personaje, un conejo y una paleta que cambia según el momento.',
  tags: ['Audaz', 'Joven y rebelde', 'Sensual y simpática', 'De contrastes'],
  sketch: 'Del boceto al personaje',
  sketchCap: 'Boceto original',
  photoCap: 'La marca tiñe la imagen: cambia los colores de la derecha',
  photo2Cap: 'Retrato teñido con los colores de la marca',
  portrait: 'Una imagen, muchas versiones',
  portraitA: 'El pelo, el isotipo y los fondos se pintan con los dos colores de la marca: al mover el widget, la fotografía cambia entera y conserva su textura.',
  tint: 'La marca tiñe la imagen',
  tintA: 'El cabello toma los dos colores de la marca. Las formas se desenfocan y se funden con la foto.',
  sketchTxt: 'Todo parte de un trazo a lápiz: una cabeza que se acurruca, el flequillo como gesto y una mirada de reojo. La marca conserva esa actitud.',
  system: 'Un sistema variable',
  systemA: 'Dos íconos: el personaje (Character) y el conejo (Capsule). En reducciones extremas, la cápsula.',
  systemB: 'El logotipo vive en un contenedor oscuro que prioriza la legibilidad.',
  charCap: 'Isologotipo · Character',
  wordCap: 'Logotipo con refuerzo gráfico',
  color: 'El color como variable',
  colorA: 'La paleta se adapta al evento o al entorno. Probala con los selectores: la página cambia con ellos. La base queda fija.',
  base: 'Paleta base',
  baseCap: 'Rosa y verde, el punto de partida',
  region: 'Variaciones de color de la marca',
} : {
  lead: 'A variable identity for a fantasy hair-care personal brand.',
  brandA: 'A character, a bunny and a palette that changes with the moment.',
  tags: ['Bold', 'Young & rebellious', 'Sensual & sympathetic', 'Of contrasts'],
  sketch: 'From sketch to character',
  sketchCap: 'Original sketch',
  photoCap: 'The brand tints the image: change the colors on the right',
  photo2Cap: 'Portrait tinted with the brand colors',
  portrait: 'One image, many versions',
  portraitA: 'The hair, the isotype and the backdrops are painted with the brand’s two colors: move the widget and the whole photograph changes while keeping its texture.',
  tint: 'The brand tints the image',
  tintA: 'The hair takes the brand’s two colors. The shapes are blurred and blended into the photo.',
  sketchTxt: 'It all starts with a pencil line: a head curling up, the fringe as a gesture and a sideways glance. The brand keeps that attitude.',
  system: 'A variable system',
  systemA: 'Two icons: the character (Character) and the bunny (Capsule). In extreme reductions, the capsule.',
  systemB: 'The logotype lives in a dark container that prioritizes legibility.',
  charCap: 'Isologotype · Character',
  wordCap: 'Logotype with graphic reinforcement',
  color: 'Color as a variable',
  colorA: 'The palette adapts to the event or environment. Try it with the pickers: the page changes with them. The base stays fixed.',
  base: 'Base palette',
  baseCap: 'Pink and green, the starting point',
  region: 'Brand color variations',
};

---
<section class="cm" aria-label={es ? 'Identidad' : 'Identity'}>
  <div class="wrap cm__head" data-reveal>
    <ul class="cm__tags">{t.tags.map((x) => <li>{x}</li>)}</ul>
  </div>

  <div class="wrap cm__row cm__row--sketch cm__row--plain" data-reveal>
    <figure class="cm__sketch">
      <img src={sketch} alt={t.sketchCap} loading="lazy" decoding="async" />
      <figcaption class="muted">{t.sketchCap}</figcaption>
    </figure>
    <div class="cm__logo cm__logo--big" set:html={character} />
  </div>

  <div class="wrap cm__row cm__row--rev cm__row--polaroid" data-reveal>
    <div class="cm__polas">
      <figure class="cm__pola cm__pola--a">
        <TintPhoto photo="/works/colorada/manual/foto-01.webp" shapes="/works/colorada/manual/foto-01.svg" alt={t.photoCap} ratio="1792 / 2400" blur={1.6} />
      </figure>
      <figure class="cm__pola cm__pola--b">
        <TintPhoto photo="/works/colorada/manual/foto-03.webp" shapes="/works/colorada/manual/foto-03.svg" alt={t.photo2Cap} ratio="1298 / 1718" blur={1.6} />
      </figure>
    </div>
    <div class="cm__side">
      <h2 class="h2">{t.tint}</h2>
      <p class="cm__txt">{t.tintA}</p>
    </div>
  </div>

  <div class="wrap cm__row cm__row--rev" data-reveal>
    <figure class="cm__photo cm__photo--solo"><TintMask photo="/works/colorada/manual/retrato.webp" masks={['/works/colorada/manual/retrato-m0.webp', '/works/colorada/manual/retrato-m1.webp']} alt={t.portrait} ratio="872 / 1330" blur={0.9} opacity={0.72} /></figure>
    <div class="cm__side">
      <h2 class="h2">{t.portrait}</h2>
      <p class="cm__txt">{t.portraitA}</p>
    </div>
  </div>

  <div class="wrap cm__row" data-reveal>
    <div class="cm__side">
      <h2 class="h2">{t.system}</h2>
      <p class="cm__txt">{t.systemA}</p>
      <p class="cm__txt">{t.systemB}</p>
    </div>
    <div class="cm__pair">
      <figure><div class="cm__logo" set:html={character} /><figcaption class="muted">{t.charCap}</figcaption></figure>
      <figure><div class="cm__logo cm__logo--word" set:html={wordmark} /><figcaption class="muted">{t.wordCap}</figcaption></figure>
    </div>
  </div>

  <div class="wrap cm__row cm__row--rev cm__color" data-reveal>
    <figure class="cm__photo cm__photo--solo">
      <img src={palettePhoto} alt={t.baseCap} loading="lazy" decoding="async" />
    </figure>
    <div class="cm__side">
      <h2 class="h2">{t.color}</h2>
      <p class="cm__txt">{t.colorA}</p>
      <img class="cm__fixed" src={fixedLogo} alt="Colorada" loading="lazy" decoding="async" />
      <div class="cm__base">
        <span class="cm__sw" style="background:#E03B7A"></span><span class="cm__sw" style="background:#6CE829"></span>
        <p class="muted"><strong>{t.base}</strong> · #E03B7A · #6CE829 — {t.baseCap}</p>
      </div>
    </div>
  </div>
</section>

<style>
  /* Contenedor común: el contenido vive en un ancho centrado (72 rem), alineado con el encabezado */
  .cm > .wrap { max-width: 72rem; }
  .cm > figure.wrap { margin-inline: auto; }
  .cm { --c0: var(--pw-0, #e03b7a); --c1: var(--pw-1, #6ce829); display: grid; gap: clamp(4rem, 9vw, 9rem); padding-block: clamp(3rem, 6vw, 6rem) clamp(4rem, 8vw, 8rem); }
  .cm figure { margin: 0; }
  .cm :global(.wrap) { padding-right: max(var(--gutter), 5.5rem); } /* deja libre el borde donde va el widget de color */
  .cm__head { display: grid; gap: 1.5rem; max-width: 62rem; }
  .cm__lead { margin: 0; font-size: clamp(1.25rem, 2.2vw, 2rem); line-height: 1.35; }
  .cm__txt { margin: 0; color: var(--muted); max-width: 40rem; }
  .cm__tags { display: flex; flex-wrap: wrap; gap: .5rem; list-style: none; margin: .5rem 0 0; padding: 0; }
  .cm__tags li { padding: .35rem 1rem; border: 1px solid color-mix(in srgb, var(--c0) 70%, transparent); border-radius: 999px; font-size: .85rem; color: color-mix(in srgb, var(--c0) 55%, var(--fg)); transition: border-color .8s linear, color .8s linear; }
  .cm .h2 { margin-bottom: 1rem; }
  .cm__row { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr); gap: clamp(2rem, 6vw, 7rem); align-items: center; }
  .cm__row--sketch { grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); }
  .cm__duo { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: clamp(1rem, 3vw, 2.5rem); align-items: start; }
  .cm__row--plain { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); }
  .cm__row--plain .cm__logo--big { margin: 0; justify-self: center; width: min(100%, 22rem); }
  .cm__row--plain .cm__sketch { max-width: 30rem; justify-self: center; width: 100%; }
  /* Polaroids pop: marcos claros apenas girados, y un SVG de formas con los colores del widget por encima */
  .cm__polas { position: relative; display: grid; grid-template-columns: 1fr 1fr; gap: clamp(.5rem, 2vw, 1.5rem); padding: 1rem .5rem 2rem; }
  .cm__pola { margin: 0; padding: .55rem .55rem 2.6rem; background: #f6f1e7; border-radius: 3px; box-shadow: 0 18px 40px rgb(0 0 0 / .45); transition: transform .6s var(--ease); }
  .cm__pola--a { transform: rotate(-3.5deg) translateY(.6rem); }
  .cm__pola--b { transform: rotate(3deg) translateY(-.6rem); }
  .cm__pola:hover { transform: rotate(0) scale(1.03); z-index: 2; }
  .cm__photo--solo { max-width: 26rem; justify-self: center; width: 100%; }
  .cm__row--rev { grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); }
  .cm__photo figcaption { font-size: .8rem; padding-top: .75rem; }
  .cm__side { display: grid; gap: 1.25rem; align-content: start; }
  .cm__sketch { justify-self: stretch; }
  .cm__sketch img { width: 100%; height: auto; border-radius: 3px; box-shadow: 0 30px 80px rgb(0 0 0 / .5), 0 0 0 1px var(--line); }
  .cm__sketch figcaption, .cm__pair figcaption { font-size: .8rem; padding-top: .75rem; }
  .cm__logo :global(svg) { width: 100%; height: auto; }
  .cm__logo :global(svg path) { transition: fill .8s linear; }
  .cm__logo--big { width: min(100%, 15rem); margin-top: 1rem; }
  .cm__pair { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(1.5rem, 4vw, 4rem); align-items: end; }
  .cm__pair .cm__logo { max-width: 17rem; margin-inline: auto; }
  .cm__pair .cm__logo--word { max-width: 21rem; }
  .cm__pair figcaption { text-align: center; }
  .cm__fixed { width: min(100%, 14rem); height: auto; margin-block: .5rem; }
  .cm__base { display: flex; align-items: center; gap: .6rem; flex-wrap: wrap; }
  .cm__base p { margin: 0 0 0 .5rem; font-size: .82rem; }
  .cm__sw { width: 1.6rem; height: 1.6rem; border-radius: 50%; box-shadow: 0 0 0 1px var(--line); }
  @media (max-width: 860px) {
    .cm__row, .cm__row--sketch, .cm__pair { grid-template-columns: 1fr; }
    }
</style>
