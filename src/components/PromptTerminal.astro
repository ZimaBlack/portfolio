---
import { copy, type Lang } from '../lib/i18n';
import { site } from '../data/site';
import Icon from './Icon.astro';
import AiIcons from './AiIcons.astro';

// Simulación de chat con una IA (estática): saludo → "Enviar" → sugerencia → "pensando…" → respuesta tipeada.
// Al terminar, el campo pasa a ser un formulario real (anti-spam) que le llega a Pablo por WhatsApp.
const { lang } = Astro.props as { lang: Lang };
const p = copy[lang].profile.prompt;
const a = copy[lang].profile.ask;
const endpoint = import.meta.env.PUBLIC_QUESTION_ENDPOINT ?? '';
const siteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY ?? '';
const written = a.placeholder.replace(/…$/, ''); // texto "ya escrito" en el campo
const strings = JSON.stringify({ ...a, thinking: p.thinking });
const Spark = 'M12 0C12 6.63 17.37 12 24 12 17.37 12 12 17.37 12 24 12 17.37 6.63 12 0 12 6.63 12 12 6.63 12 0Z';
---
<figure class="chat" data-chat data-state="idle" data-lang={lang} data-endpoint={endpoint} data-sitekey={siteKey} data-wa={`https://wa.me/${site.whatsapp}`} data-strings={strings} data-reveal>
  <figcaption class="chat__bar">
    <span class="badge">{p.label}</span>
    <span class="chat__route"><b>{p.from}</b> <Icon name="arrow-up-right" class="chat__arrow" /> <b>{p.to}</b></span>
    <span class="chat__ai"><AiIcons /></span>
  </figcaption>

  <div class="chat__stream">
    <div class="msg msg--ai">
      <span class="msg__av" aria-hidden="true"><svg viewBox="0 0 24 24"><path d={Spark} /></svg></span>
      <p class="msg__txt">{p.greeting}</p>
    </div>

    <div class="msg msg--user"><p class="msg__txt" data-user>{written}</p></div>

    <div class="msg msg--ai chat__think" role="status">
      <span class="msg__av msg__av--spin" aria-hidden="true"><svg viewBox="0 0 24 24"><path d={Spark} /></svg></span>
      <p class="msg__txt"><span class="chat__word shimmer">{p.thinking[0]}</span><span class="dots" aria-hidden="true"></span></p>
    </div>

    <div class="msg msg--ai chat__answer">
      <span class="msg__av" aria-hidden="true"><svg viewBox="0 0 24 24"><path d={Spark} /></svg></span>
      <div class="term" data-typed>
        <p class="t-intro"><span class="t-sym">&gt;</span> {p.intro}</p>
        {p.sections.map((x) => (
          <section class="t-sec">
            <h4># {x.h}</h4>
            <p>{x.t}</p>
          </section>
        ))}
        <p class="t-close"><span class="t-sym">$</span> {p.close} <a class="link" href={`mailto:${site.email}`}>{site.email}</a>.</p>
      </div>
    </div>

    <div class="chat__log" aria-live="polite"></div>
  </div>

  <form class="chat__composer" novalidate autocomplete="off">
    <div class="chat__row">
      <input class="chat__q" name="question" type="text" maxlength="500" value={written} aria-label={a.placeholder} readonly />
      <button class="chat__send" type="submit" aria-label={a.send}><Icon name="arrow-up" /></button>
    </div>
    <div class="chat__row chat__row--sub">
      <span class="t-sym" aria-hidden="true">@</span>
      <input class="chat__c" name="contact" type="text" maxlength="120" placeholder={a.contact} aria-label={a.contact} autocomplete="email" />
    </div>
    <!-- Honeypot: invisible para personas; los bots suelen completarlo -->
    <input class="chat__hp" name="website" type="text" tabindex="-1" autocomplete="off" aria-hidden="true" />
    <div class="chat__turnstile"></div>
  </form>

</figure>

<style>
  .chat { --mono: 'JetBrains Mono Variable', ui-monospace, 'SF Mono', Menlo, Consolas, monospace; margin: 0 auto; width: 100%; max-width: 52rem; border: 1px solid var(--line); border-radius: 14px; background: color-mix(in srgb, var(--fg) 3%, var(--bg)); overflow: hidden; }
  .chat__bar { display: flex; flex-wrap: wrap; justify-content: center; align-items: center; gap: .6rem 1.25rem; padding: .9rem 1.25rem; border-bottom: 1px solid var(--line); font-size: .8rem; color: var(--muted); }
  .chat__route { display: inline-flex; flex-wrap: wrap; justify-content: center; align-items: center; gap: .5rem; }
  .chat__route b { font-weight: 500; color: var(--fg); }
  .chat__route :global(.chat__arrow) { transform: rotate(45deg); }

  .chat__stream { display: grid; gap: 1.1rem; padding: clamp(1.25rem, 3vw, 2rem); }
  .msg { display: flex; gap: .85rem; align-items: flex-start; }
  .msg__txt { margin: 0; line-height: 1.5; }
  .msg__av { flex: none; width: 1.9rem; height: 1.9rem; border-radius: 50%; display: grid; place-items: center; background: var(--fg); color: var(--bg); }
  .msg__av svg { width: .95rem; height: .95rem; fill: currentColor; }
  .msg__av--spin svg { animation: spin 1.6s var(--ease) infinite; }
  @keyframes spin { to { transform: rotate(180deg) scale(1.15); } }
  .msg--user { justify-content: flex-end; }
  .msg--user .msg__txt { padding: .6rem 1.1rem; border: 1px solid var(--line); border-radius: 999px; background: color-mix(in srgb, var(--fg) 7%, var(--bg)); }

  /* Estados de la simulación */
  .msg--user, .chat__think, .chat .chat__row--sub { display: none; }
  .chat[data-state='thinking'] .msg--user, .chat[data-state='answering'] .msg--user, .chat[data-state='ask'] .msg--user { display: flex; }
  .chat[data-state='thinking'] .chat__think { display: flex; }
  .chat[data-state='idle'] .chat__answer, .chat[data-state='thinking'] .chat__answer { display: none; }
  .chat[data-state='ask'] .chat__row--sub { display: flex; }

  /* "Pensando…" */
  .shimmer { background: linear-gradient(90deg, var(--muted) 20%, var(--fg) 50%, var(--muted) 80%); background-size: 200% 100%; -webkit-background-clip: text; background-clip: text; color: transparent; animation: shimmer 1.4s linear infinite; }
  @keyframes shimmer { from { background-position: 200% 0; } to { background-position: -200% 0; } }
  .dots::after { content: ''; color: var(--muted); animation: dots 1.2s steps(1) infinite; }
  @keyframes dots { 0% { content: ''; } 25% { content: '.'; } 50% { content: '..'; } 75% { content: '...'; } }

  /* Respuesta con estética de terminal */
  .term { font-family: var(--mono); font-size: clamp(.78rem, 1vw, .88rem); line-height: 1.7; display: grid; gap: 1rem; min-width: 0; flex: 1; text-align: left; }
  .term p, .term h4 { margin: 0; }
  .t-sym { color: var(--muted); user-select: none; }
  .t-sec { display: grid; gap: .15rem; }
  .t-sec h4 { font-size: inherit; font-weight: 500; color: var(--muted); letter-spacing: .02em; }
  .t-sec p { padding-left: 2ch; }
  :global(.term__caret) { display: inline-block; width: .6em; height: 1.1em; margin-left: .15em; vertical-align: -.2em; background: var(--fg); animation: caret 1s steps(1) infinite; }
  @keyframes caret { 50% { opacity: 0; } }

  .chat__log { display: grid; gap: .8rem; font-family: var(--mono); font-size: clamp(.78rem, 1vw, .88rem); line-height: 1.7; }
  .chat__log:empty { display: none; }
  :global(.chat__log .l-q) { color: var(--muted); text-align: right; margin: 0; }
  :global(.chat__log .l-a) { margin: 0; }
  :global(.chat__log .l-e) { color: #e0705f; margin: 0; }

  /* Campo y botón de enviar */
  .chat__composer { display: grid; gap: .4rem; padding: 0 clamp(1.25rem, 3vw, 2rem) 1.1rem; }
  .chat__row { display: flex; align-items: center; gap: .75rem; }
  .chat__row:first-child { padding: .45rem .45rem .45rem 1.25rem; border: 1px solid var(--line); border-radius: 999px; background: var(--bg); transition: border-color .35s; }
  .chat__row:first-child:focus-within { border-color: var(--fg); }
  .chat__row--sub { font-family: var(--mono); font-size: .8rem; padding-inline: 1.25rem; }
  .chat input[type='text'] { flex: 1; min-width: 0; font: inherit; color: var(--fg); background: transparent; border: 0; outline: 0; padding: .45rem 0; }
  .chat input::placeholder { color: var(--muted); }
  .chat__q[readonly] { cursor: pointer; }
  .chat[data-state='idle'] .chat__row:first-child { cursor: pointer; }
  .chat__hp { position: absolute; left: -9999px; width: 1px; height: 1px; opacity: 0; }
  .chat__send { flex: none; display: grid; place-items: center; width: 2.4rem; height: 2.4rem; border-radius: 50%; background: var(--fg); color: var(--bg); transition: transform .4s var(--ease), opacity .3s; }
  .chat__send :global(.ico) { width: 1.1rem; height: 1.1rem; stroke-width: 2; }
  .chat__send:hover, .chat__send:focus-visible { transform: scale(1.1); }
  .chat__send:disabled { opacity: .4; pointer-events: none; }
  .chat[data-state='idle'] .chat__send { animation: pulse 2.2s var(--ease) infinite; }
  @keyframes pulse { 0% { box-shadow: 0 0 0 0 color-mix(in srgb, var(--fg) 45%, transparent); } 70%, 100% { box-shadow: 0 0 0 .8rem transparent; } }
  .chat__turnstile:empty { display: none; }

  .chat__composer { padding-bottom: 1.5rem; }

  @media (prefers-reduced-motion: reduce) { .chat *, .chat *::after { animation: none !important; } }
</style>

<script>
  import { prepareTyping, makeCaret, typeText } from '../scripts/typewriter';

  const reduce = () => matchMedia('(prefers-reduced-motion: reduce)').matches;
  const wait = (ms: number) => new Promise((r) => setTimeout(r, ms));
  const LS = {
    get: (k: string) => { try { return localStorage.getItem(k); } catch { return null; } },
    set: (k: string, v: string) => { try { localStorage.setItem(k, v); } catch { /* sin storage */ } },
  };

  function init() {
    document.querySelectorAll<HTMLElement>('[data-chat]:not([data-ready])').forEach((chat) => {
      chat.dataset.ready = '1';
      const $ = <T extends HTMLElement>(s: string) => chat.querySelector<T>(s)!;
      const S = JSON.parse(chat.dataset.strings!) as Record<string, any>;
      const form = $<HTMLFormElement>('.chat__composer');
      const q = $<HTMLInputElement>('.chat__q');
      const c = $<HTMLInputElement>('.chat__c');
      const hp = $<HTMLInputElement>('.chat__hp');
      const send = $<HTMLButtonElement>('.chat__send');
      const word = $<HTMLElement>('.chat__word');
      const body = $<HTMLElement>('[data-typed]');
      const log = $<HTMLElement>('.chat__log');
      const slot = $<HTMLElement>('.chat__turnstile');
      const endpoint = chat.dataset.endpoint!, siteKey = chat.dataset.sitekey!, wa = chat.dataset.wa!, lang = chat.dataset.lang!;
      const caret = makeCaret();
      const set = (s: string) => (chat.dataset.state = s);
      let state = 'idle';
      const go = (s: string) => { state = s; set(s); };
      go('idle');

      // ── Simulación: idle → thinking → answering → ask ──
      const start = async () => {
        if (state !== 'idle') return;
        go('thinking');
        const words: string[] = S.thinking;
        const quick = reduce();
        word.textContent = words[0];
        await wait(quick ? 250 : 1100);
        word.textContent = words[1] ?? words[0];
        await wait(quick ? 250 : 1700);

        go('answering');
        if (quick) { finish(); return; }
        const run = prepareTyping(body, caret);
        chat.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
        await run(1100);
        caret.remove();
        finish();
      };
      const finish = () => {
        go('ask');
        q.readOnly = false;
        q.placeholder = S.followup;
        q.value = '';
      };

      q.addEventListener('click', () => { if (state === 'idle') start(); });

      // ── Formulario real (después de la simulación) ──
      let openedAt = 0, token = '';
      const loadTurnstile = () => {
        if (!siteKey || document.querySelector('script[data-turnstile]')) return;
        const s = document.createElement('script');
        s.src = 'https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit';
        s.async = true; s.dataset.turnstile = '1';
        s.onload = () => (window as any).turnstile?.render(slot, { sitekey: siteKey, appearance: 'interaction-only', callback: (t: string) => (token = t), 'expired-callback': () => (token = '') });
        document.head.append(s);
      };
      form.addEventListener('focusin', () => { if (state !== 'ask') return; if (!openedAt) openedAt = Date.now(); loadTurnstile(); });

      const say = (cls: string, text: string) => {
        const p = document.createElement('p');
        p.className = cls; log.append(p);
        return typeText(p, text, caret, 1400).then(() => caret.remove());
      };
      const fail = (m: string) => { log.querySelector('.l-e')?.remove(); const p = document.createElement('p'); p.className = 'l-e'; p.textContent = S[m]; log.append(p); };

      form.addEventListener('submit', async (e) => {
        e.preventDefault();

        // Antes de la respuesta, "Enviar" solo hace avanzar la simulación.
        if (state === 'idle') { start(); return; }
        if (state !== 'ask') return;

        log.querySelector('.l-e')?.remove();
        const question = q.value.trim().replace(/\s+/g, ' ');
        const contact = c.value.trim();
        const elapsed = openedAt ? Date.now() - openedAt : 0;

        if (hp.value) return;                                            // bot: honeypot
        if (question.length < 8) return fail('errShort');
        if (/https?:\/\/|www\.|\.(com|net|org|ru|xyz|top)\b/i.test(question)) return fail('errLinks');
        const okMail = /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(contact);
        const okTel = contact.replace(/\D/g, '').length >= 8 && /^[+\d\s()\-.]+$/.test(contact);
        if (!okMail && !okTel) return fail('errContact');
        if (elapsed < 2500) return fail('errWait');                      // demasiado rápido para una persona

        const last = Number(LS.get('ask:last') || 0);
        const day = new Date().toDateString();
        const [d, n] = (LS.get('ask:day') || '|0').split('|');
        const count = d === day ? Number(n) : 0;
        if (Date.now() - last < 60_000) return fail('errWait');
        if (count >= 3) return fail('errLimit');
        if (siteKey && !token) return fail('errVerify');

        send.disabled = true;
        const qLine = document.createElement('p'); qLine.className = 'l-q'; qLine.textContent = question; log.append(qLine);

        let viaWa = false;
        if (endpoint) {
          try {
            const r = await fetch(endpoint, { method: 'POST', headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ question, contact, website: hp.value, t: elapsed, token, lang }) });
            if (!r.ok) throw new Error(String(r.status));
          } catch {
            send.disabled = false; qLine.remove(); return fail('errFail');
          }
        } else {
          // Sin servidor configurado: se abre WhatsApp con la pregunta ya escrita.
          viaWa = true;
          window.open(`${wa}?text=${encodeURIComponent(`${question}\n\n${contact}`)}`, '_blank', 'noopener');
        }

        LS.set('ask:last', String(Date.now()));
        LS.set('ask:day', `${day}|${count + 1}`);
        q.value = ''; c.value = '';
        (window as any).turnstile?.reset?.(); token = '';
        await say('l-a', viaWa ? S.replyWa : S.reply);
        send.disabled = false;
      });
    });
  }
  document.addEventListener('astro:page-load', init);
</script>
