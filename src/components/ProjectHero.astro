---
// Portada animada de un proyecto: pantalla completa, con el logotipo centrado. Tres modos, según el proyecto:
//  · simple: el logotipo (imagen) entra con un fundido; el isotipo (`mark`) queda oculto y centrado, listo para animar;
//  · reactivo (`reactive`): el SVG se inserta en la página y los colores indicados siguen al widget de paleta;
//  · ensamblar (`assemble`): las alas del logotipo llegan de los lados y se juntan; después aparecen el rombo y el nombre, entre un ornamento (ver src/lib/forge.ts).
// Las luces del fondo pueden ser un degradado suave o una trama de semitono (`halftone`).
import { readFileSync } from 'node:fs';
import { join } from 'node:path';
import { withBase } from '../lib/i18n';
import { forge, loadArt, shapeDefs, timingVars, type Gradient } from '../lib/forge';

const { logo, mark, title, tones = ['#1a1a1a', '#2b2b2b'], reactive = [], halftone = false, assemble = false, ornament = '' } = Astro.props as {
  logo: string; mark?: string; title: string; tones?: string[]; reactive?: string[]; halftone?: boolean; assemble?: boolean; ornament?: string;
};
const src = (p: string) => (p.startsWith('/') ? withBase(p) : p);
const isSvg = (p?: string) => !!p && p.toLowerCase().endsWith('.svg');

// ── Modo reactivo: el SVG va dentro de la página y los colores `reactive` leen --pw-0, --pw-1… (con su color original de respaldo)
let reactiveSvg = '';
if (!assemble && reactive.length && isSvg(logo)) {
  let svg = readFileSync(join(process.cwd(), 'public', logo), 'utf8');
  reactive.forEach((hex, i) => { svg = svg.replace(new RegExp(`fill="${hex}"`, 'gi'), `style="fill:var(--pw-${i},${hex})"`); });
  reactiveSvg = svg.replace(/<svg\b([^>]*)>/i, (_m, a) => `<svg${a.replace(/\s(width|height)="[^"]*"/g, '')} class="pjh__logo" role="img" aria-label="${title.replace(/"/g, '&quot;')}">`);
}

// ── Modo ensamblar: iso (alas + rombo), nombre y un ornamento que se repite a los lados
// Relleno de los vectores: el matiz del oro del logotipo, con un degradado diagonal que sugiere metal bruñido (una franja apenas más clara en el medio),
// muy sutil. En las mitades izquierdas se espeja solo.
const GOLD_ORN: Gradient = { dir: [0, 0, 1, 1], stops: [[0, '#6F6B3A'], [0.32, '#A8A152'], [0.5, '#BDB677'], [0.68, '#A8A152'], [1, '#58542F']] };
/** Retraso (s) del brillo según la posición horizontal (en alturas del ornamento, desde el centro): así los brillos de cada SVG forman una sola ola de izquierda a derecha. */
const wave = (x: number) => ((x + 1.55) / 3.1 * 1.3).toFixed(2);
let defs = '', logoSvg = '', nameSvg = '', orn: string[] = [];
if (assemble && isSvg(logo)) {
  const logoArt = loadArt(logo, 'pjl');
  defs += shapeDefs(logoArt);
  logoSvg = forge(logoArt, { id: 'pjm', cls: 'pjh__logo', style: `--sd:${wave(0)}s`, label: title, color: logoArt.color, parts: true, late: [2], shine: 0.95 });

  if (isSvg(mark)) {
    const nameArt = loadArt(mark!, 'pjn');
    defs += shapeDefs(nameArt);
    nameSvg = forge(nameArt, { id: 'pjt', cls: 'pjh__name', style: `--sd:${wave(0)}s`, color: nameArt.color, late: nameArt.paths.map((_, i) => i), shine: 0.95 });
  }

  if (isSvg(ornament)) {
    const ornArt = loadArt(ornament, 'pjo');
    defs += shapeDefs(ornArt);
    // Patrón: el par central (k = 0) enmarca el logotipo; a los lados se repite, cada vez más tenue
    const alpha = [0.42, 0.24, 0.12];
    const half = (k: number, left: boolean) => forge(ornArt, {
      id: `pjo${k + 2}${left ? 'l' : 'r'}`, cls: `pjh__orn pjh__orn--${left ? 'l' : 'r'}`, style: `--k:${k};--od:${(0.3 + 0.2 * Math.abs(k)).toFixed(2)}s;--sd:${wave(k * 0.6672 + (left ? -0.1708 : 0.1708))}s`,
      color: GOLD_ORN, alpha: alpha[Math.abs(k)], flip: left, fade: true, screen: true, shine: Math.min(1, alpha[Math.abs(k)] * 1.8), // el brillo se ajusta a la opacidad de cada vector
    });
    orn = [-2, -1, 0, 1, 2].flatMap((k) => [half(k, true), half(k, false)]);
  }
}
const stageSvg = assemble ? logoSvg : reactiveSvg;
---
<section class="pjh" data-pj-hero data-halftone={halftone ? '' : undefined} data-assemble={assemble ? '' : undefined} data-orn={orn.length ? '' : undefined} style={`--ga:${tones[1]};--gb:${tones[0]};${timingVars()}`} aria-label={title}>
  {defs && <Fragment set:html={defs} />}
  <!-- La escena entera (fondo, ornamento y logotipo) es un solo grupo: al hacer scroll se desvanece junta -->
  <div class="pjh__scene" data-pj-scene>
    <div class="pjh__bg" data-pj-bg aria-hidden="true"></div>
    {halftone && <canvas class="pjh__ht" data-pj-ht aria-hidden="true"></canvas>}
    {orn.map((s) => <Fragment set:html={s} />)}
    <div class="pjh__stage" data-pj-stage>
      {mark && !nameSvg && <img class="pjh__mark" data-pj-mark src={src(mark)} alt="" aria-hidden="true" decoding="async" draggable="false" />}
      {stageSvg
        ? <Fragment set:html={stageSvg} />
        : <img class="pjh__logo" data-pj-logo src={src(logo)} alt={title} decoding="async" draggable="false" />}
      {nameSvg && <Fragment set:html={nameSvg} />}
    </div>
  </div>
</section>

<style>
  .pjh { position: relative; width: 100%; min-height: 100vh; min-height: 100svh; overflow: hidden; isolation: isolate; }
  /* La escena ocupa toda la portada y se desvanece (2 s, con desenfoque) en cuanto se empieza a hacer scroll; al volver arriba, regresa */
  .pjh__scene { position: absolute; inset: 0; display: grid; place-items: center; isolation: isolate; transition: opacity 1.2s var(--ease), filter 1.2s var(--ease); }
  .pjh.is-leaving .pjh__scene { opacity: 0; filter: blur(14px); transition-duration: 2s; }

  /* Fondo: dos luces grandes y asimétricas sobre el negro del sitio. Posiciones (--ax…) y colores (--ga, --gb) los cambia el widget de paleta. */
  .pjh__bg { position: absolute; inset: 0; z-index: -1; transition: --ax 1.1s var(--ease), --ay 1.1s var(--ease), --bx 1.1s var(--ease), --by 1.1s var(--ease), --ga .8s linear, --gb .8s linear;
    background: radial-gradient(ellipse 62% 70% at var(--ax) var(--ay), color-mix(in srgb, var(--ga) 95%, transparent), transparent 72%),
                radial-gradient(ellipse 70% 62% at var(--bx) var(--by), color-mix(in srgb, var(--gb) 90%, transparent), transparent 74%); }
  /* Semitono: el degradado se reemplaza por una trama de puntos dibujada en el canvas (se desvanece bajo el menú, para que se lea) */
  .pjh[data-halftone] .pjh__bg { display: none; }
  .pjh__ht { position: absolute; left: 0; top: 0; z-index: -1; pointer-events: none; animation: ht-in 1.8s ease both;
    -webkit-mask-image: linear-gradient(to bottom, transparent 0, #000 16%); mask-image: linear-gradient(to bottom, transparent 0, #000 16%); }
  @keyframes ht-in { from { opacity: 0; } to { opacity: 1; } }

  .pjh__stage { position: relative; display: grid; place-items: center; width: min(88vw, 56rem); height: min(60vh, 34rem); }
  .pjh__stage > img { grid-area: 1 / 1; max-width: 100%; max-height: 100%; width: auto; height: auto; object-fit: contain; user-select: none; }
  .pjh__stage > .pjh__logo { width: min(100%, 40rem); animation: logo-in 1.6s .2s var(--ease, ease) both; }
  .pjh__mark { opacity: 0; } /* en su lugar, listo para animar */
  @keyframes logo-in { from { opacity: 0; filter: blur(16px); transform: scale(1.04); } to { opacity: 1; filter: none; transform: none; } }
  @media (prefers-reduced-motion: reduce) { .pjh__stage > .pjh__logo, .pjh__ht { animation: none; } .pjh__scene, .pjh.is-leaving .pjh__scene { filter: none; transition: opacity .6s linear; } }
</style>

<!-- El SVG se inserta como HTML, así que sus estilos son globales (siempre bajo .pjh) -->
<style is:global>
  @property --ax { syntax: '<percentage>'; inherits: true; initial-value: 24%; }
  @property --ay { syntax: '<percentage>'; inherits: true; initial-value: 34%; }
  @property --bx { syntax: '<percentage>'; inherits: true; initial-value: 76%; }
  @property --by { syntax: '<percentage>'; inherits: true; initial-value: 72%; }
  @property --ga { syntax: '<color>'; inherits: true; initial-value: #6a1b26; }
  @property --gb { syntax: '<color>'; inherits: true; initial-value: #240d12; }

  /* ── Logotipo SVG (modo reactivo y ensamblar) */
  .pjh__defs { position: absolute; width: 0; height: 0; overflow: hidden; }
  .pjh__stage > svg.pjh__logo { grid-area: 1 / 1; width: auto; height: min(58vh, 32rem); max-width: 100%; animation: logo-in 1.6s .2s var(--ease, ease) both; }
  .pjh__stage > svg.pjh__logo path { transition: fill .7s linear; } /* el cambio de color del widget es suave */

  /* ── Ensamblar: composición. El iso y el nombre se apilan, centrados; el ornamento flanquea (un par por cada k) */
  .pjh { --oh: min(66vh, 38rem); --og: calc(var(--oh) * .066); --pw: calc(var(--oh) * .6672); --mark-h: min(30vh, 14rem); --name-w: min(64vw, 16.5rem); }
  .pjh[data-orn] { --mark-h: min(19vh, 9rem); --name-w: min(44vw, 10.5rem); } /* con ornamento, el logotipo se achica para quedar enmarcado en el arco */
  .pjh[data-assemble] .pjh__stage { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: clamp(.5rem, 1.5vh, .9rem); height: auto; }
  .pjh[data-assemble] .pjh__stage > svg.pjh__logo { overflow: visible; height: var(--mark-h); width: auto; animation: none; }
  .pjh__stage > svg.pjh__name { width: var(--name-w); height: auto; flex: none; overflow: visible; }
  .pjh__orn { position: absolute; top: 50%; translate: 0 -50%; z-index: -1; height: var(--oh); width: auto; aspect-ratio: 116 / 421; overflow: visible; }
  .pjh__orn--l { right: calc(50% - var(--k) * var(--pw) + var(--og) / 2); }
  .pjh__orn--r { left: calc(50% + var(--k) * var(--pw) + var(--og) / 2); }

  /* ── Piezas. Los tiempos salen de las variables --t-* (src/lib/forge.ts). Todo entra con curvas suaves y de a poco, sin golpes. */
  .pj-piece { transform-box: fill-box; transform-origin: center; }
  /* Primero aparecen los vectores, desde el negro; cuando están por ponerse dorados llegan las piezas de Omega, también desde el negro. Las alas vienen desde los costados con un leve giro que se endereza; la derecha un instante después, y se asientan sin chocar */
  .pj-piece[data-part='0'] { animation: pj-from-left 2.1s var(--t-enter) cubic-bezier(.22, .9, .28, 1) both, pj-dark 2.7s var(--t-enter) cubic-bezier(.45, 0, .4, 1) both; }
  .pj-piece[data-part='1'] { animation: pj-from-right 2.3s calc(var(--t-enter) + .14s) cubic-bezier(.22, .9, .28, 1) both, pj-dark 2.8s calc(var(--t-enter) + .14s) cubic-bezier(.45, 0, .4, 1) both; }
  .pjh__logo .pj-late { animation: pj-appear 1.5s var(--t-appear) cubic-bezier(.16, 1, .3, 1) both, pj-dark 2s var(--t-appear) cubic-bezier(.45, 0, .4, 1) both; }  /* el rombo se abre desde el centro, girando un poco */
  .pjh__name .pj-late { animation: pj-rise 1.6s calc(var(--t-appear) + .25s) cubic-bezier(.16, 1, .3, 1) both, pj-dark 2.1s calc(var(--t-appear) + .25s) cubic-bezier(.45, 0, .4, 1) both; } /* el nombre sube y se enfoca */
  /* Los vectores entran hacia afuera desde el centro, de a pares, y después "respiran" muy despacio, cada uno a su ritmo */
  .pjh__orn .pj-piece { animation: pj-orn-in 2.6s var(--od, .6s) cubic-bezier(.16, 1, .3, 1) both, pj-dark 3.4s var(--od, .6s) cubic-bezier(.45, 0, .4, 1) both, pj-breathe calc(7s + var(--k) * 0.6s) calc(var(--od, .6s) + 3s) ease-in-out infinite alternate; }
  .pjh__orn--r .pj-piece { animation-delay: calc(var(--od, .6s) + .12s), calc(var(--od, .6s) + .12s), calc(var(--od, .6s) + 3.12s); }
  /* Los vectores se funden con el fondo (pantalla), sin desenfoque; cuando todo está armado bajan su opacidad */
  .pj-screen { mix-blend-mode: screen; animation: pj-settle 1.8s var(--t-settle) ease-in-out both; }
  /* Brillo de barras planas: una pasada, en una sola ola de izquierda a derecha sobre todo (vectores, logotipo y nombre), que se repite cada 10 s */
  .pj-shine { opacity: 0; animation: pj-shine 10s calc(var(--t-shine) + var(--sd, 0s)) infinite; }
  @keyframes pj-shine { 0% { translate: 0 0; opacity: 0; animation-timing-function: cubic-bezier(.45, .05, .55, .95); } 0.8% { opacity: 1; } 6.8% { translate: var(--gw) 0; opacity: 1; } 8%, 100% { translate: var(--gw) 0; opacity: 0; } }
  @keyframes pj-settle { from { opacity: 1; } to { opacity: .55; } }
  @keyframes pj-from-left { from { transform: translateX(-60vw) rotate(-7deg); opacity: 0; } 35% { opacity: var(--a, 1); } to { transform: none; opacity: var(--a, 1); } }
  @keyframes pj-from-right { from { transform: translateX(60vw) rotate(7deg); opacity: 0; } 35% { opacity: var(--a, 1); } to { transform: none; opacity: var(--a, 1); } }
  @keyframes pj-appear { from { opacity: 0; transform: scale(.55) rotate(-14deg); } to { opacity: var(--a, 1); transform: none; } }
  @keyframes pj-rise { from { opacity: 0; transform: translateY(10px); } to { opacity: var(--a, 1); transform: none; } }
  @keyframes pj-orn-in { from { transform: translateX(150px); opacity: 0; } to { transform: none; opacity: var(--a, 1); } }
  @keyframes pj-dark { from { filter: brightness(0); } to { filter: none; } } /* nacen del negro y van tomando color (sin desenfoque) */
  @keyframes pj-breathe { from { opacity: var(--a, 1); } to { opacity: calc(var(--a, 1) * .78); } }

  /* ── Movimiento reducido: todo se ve ya armado */
  @media (prefers-reduced-motion: reduce) { .pj-piece, .pj-late, .pj-screen, .pj-shine { animation: none !important; } .pj-screen { opacity: .55; } .pj-shine { display: none; } }
</style>

<script>
  import { initHalftone } from '../scripts/halftone';

  // Con el scroll, la escena se desvanece (clase is-leaving); al volver arriba, reaparece. Un solo oyente para toda la sesión.
  let ticking = false;
  const update = () => {
    ticking = false;
    const hero = document.querySelector<HTMLElement>('[data-pj-hero]');
    if (hero) hero.classList.toggle('is-leaving', scrollY > 24);
  };
  addEventListener('scroll', () => { if (!ticking) { ticking = true; requestAnimationFrame(update); } }, { passive: true });

  document.addEventListener('astro:page-load', () => {
    document.querySelectorAll<HTMLElement>('[data-halftone]:not([data-ready])').forEach(initHalftone);
    update();
  });
</script>
