---
// Portada animada de un proyecto: pantalla completa, con el logotipo centrado. Tres modos, según el proyecto:
//  · simple: el logotipo (imagen) entra con un fundido; el isotipo (`mark`) queda oculto y centrado, listo para animar;
//  · reactivo (`reactive`): el SVG se inserta en la página y los colores indicados siguen al widget de paleta;
//  · ensamblar (`assemble`): las alas del logotipo llegan de los lados y se juntan; después aparecen el rombo y el nombre, entre un ornamento (ver src/lib/forge.ts).
// Las luces del fondo pueden ser un degradado suave o una trama de semitono (`halftone`).
import { readFileSync } from 'node:fs';
import { join } from 'node:path';
import { withBase } from '../lib/i18n';
import { forge, loadArt, shapeDefs, timingVars, type Gradient } from '../lib/forge';
import { wavesSvg } from '../lib/waves';

const { logo = '', mark, title, tones = ['#1a1a1a', '#2b2b2b'], reactive = [], halftone = false, liquid = false, assemble = false, ornament = '', pattern = '', photo = '', glass = false } = Astro.props as {
  logo?: string; mark?: string; title: string; tones?: string[]; reactive?: string[]; halftone?: boolean; liquid?: boolean; assemble?: boolean; ornament?: string; pattern?: string; photo?: string; glass?: boolean;
};
const src = (p: string) => (p.startsWith('/') ? withBase(p) : p);
const isSvg = (p?: string) => !!p && p.toLowerCase().endsWith('.svg');

// ── Modo reactivo: el SVG va dentro de la página y los colores `reactive` leen --pw-0, --pw-1… (con su color original de respaldo)
let reactiveSvg = '';
if (!assemble && reactive.length && isSvg(logo)) {
  let svg = readFileSync(join(process.cwd(), 'public', logo), 'utf8');
  reactive.forEach((hex, i) => { svg = svg.replace(new RegExp(`fill="${hex}"`, 'gi'), `style="fill:var(--pw-${i},${hex})"`); });
  reactiveSvg = svg.replace(/<svg\b([^>]*)>/i, (_m, a) => `<svg${a.replace(/\s(width|height)="[^"]*"/g, '')} class="pjh__logo" role="img" aria-label="${title.replace(/"/g, '&quot;')}">`);
}

// ── Modo ensamblar: iso (alas + rombo), nombre y un ornamento que se repite a los lados
// Relleno de los vectores: el matiz del oro del logotipo, con un degradado diagonal que sugiere metal bruñido (una franja apenas más clara en el medio),
// muy sutil. En las mitades izquierdas se espeja solo.
const GOLD_ORN: Gradient = { dir: [0, 0, 1, 1], stops: [[0, '#6F6B3A'], [0.32, '#A8A152'], [0.5, '#BDB677'], [0.68, '#A8A152'], [1, '#58542F']] };
let defs = '', logoSvg = '', nameSvg = '', orn: string[] = [];
if (assemble && isSvg(logo)) {
  const logoArt = loadArt(logo, 'pjl');
  defs += shapeDefs(logoArt);
  logoSvg = forge(logoArt, { id: 'pjm', cls: 'pjh__logo', style: '--sd:.65s', label: title, color: logoArt.color, parts: true, late: [2], shine: 0.5 });

  if (isSvg(mark)) {
    const nameArt = loadArt(mark!, 'pjn');
    defs += shapeDefs(nameArt);
    nameSvg = forge(nameArt, { id: 'pjt', cls: 'pjh__name', style: '--sd:.65s', color: nameArt.color, late: nameArt.paths.map((_, i) => i), shine: 0.5 });
  }

  if (isSvg(ornament)) {
    const ornArt = loadArt(ornament, 'pjo');
    defs += shapeDefs(ornArt);
    // Patrón: el par central (k = 0) enmarca el logotipo; a los lados se repite, cada vez más tenue
    const alpha = [0.28, 0.16, 0.08]; // opacidad final de cada par (los vectores sólo aparecen con un fundido, y ahí se quedan)
    const half = (k: number, left: boolean) => forge(ornArt, {
      id: `pjo${k + 2}${left ? 'l' : 'r'}`, cls: `pjh__orn pjh__orn--${left ? 'l' : 'r'}`, style: `--k:${k};--od:${(0.3 + 0.18 * Math.abs(k)).toFixed(2)}s;--sd:${left ? '.35' : '.95'}s`,
      color: GOLD_ORN, alpha: alpha[Math.abs(k)], flip: left, fade: true, screen: true, shine: k === 0 ? 0.2 : undefined, // sólo los vectores más cercanos al logotipo llevan el brillo, con menos fuerza
    });
    orn = [-2, -1, 0, 1, 2].flatMap((k) => [half(k, true), half(k, false)]);
  }
}
// ── Trama fluida de diseño plano (ondas con los colores del proyecto)
const wavesMarkup = pattern === 'waves' ? wavesSvg([tones[0], tones[1]]) : '';
const stageSvg = assemble ? logoSvg : reactiveSvg;
---
<section class="pjh" data-pj-hero data-halftone={halftone ? '' : undefined} data-liquid-on={liquid ? '' : undefined} data-assemble={assemble ? '' : undefined} data-pattern={pattern ? '' : undefined} data-photo={photo ? '' : undefined} data-glass={glass ? '' : undefined} data-orn={orn.length ? '' : undefined} style={`--ga:${tones[1]};--gb:${tones[0]};${liquid ? '--ax:36%;--ay:42%;--bx:64%;--by:58%;' : ''}${timingVars()}`} aria-label={title}>
  {defs && <Fragment set:html={defs} />}
  <!-- La escena entera (fondo, ornamento y logotipo) es un solo grupo: al hacer scroll se desvanece junta -->
  <div class="pjh__scene" data-pj-scene>
    <div class="pjh__bg" data-pj-bg aria-hidden="true"></div>
    {photo && (
      <div class="pjh__photo" aria-hidden="true">
        <picture>
          <source type="image/webp" srcset={`${src(photo)}-1280.webp 1280w, ${src(photo)}-1920.webp 1920w, ${src(photo)}-2560.webp 2560w`} sizes="100vw" />
          <img src={`${src(photo)}.jpg`} alt="" width="3168" height="1344" fetchpriority="high" decoding="async" />
        </picture>
      </div>
    )}
    {photo && glass && <div class="pjh__blur" aria-hidden="true"></div>}
    {photo && glass && <div class="pjh__tint" aria-hidden="true"></div>}
    {photo && <div class="pjh__vig" aria-hidden="true"></div>}
    {wavesMarkup && <Fragment set:html={wavesMarkup} />}
    {liquid && <canvas class="pjh__liquid" data-pj-liquid aria-hidden="true"></canvas>}
    {halftone && <canvas class="pjh__ht" data-pj-ht aria-hidden="true"></canvas>}
    {orn.map((s) => <Fragment set:html={s} />)}
    <div class="pjh__stage" data-pj-stage>
      {glass && logo && mark ? (
        <div class="pjh__glass" role="img" aria-label={title}>
          <!-- Cristal: el propio iso es de vidrio (máscara + desenfoque del fondo); se abre desde un círculo, gira de canto y deja ver el logotipo completo -->
          <div class="pjh__glow"></div>
          <div class="pjh__flip">
            <img class="pjh__iso" src={src(mark)} alt="" decoding="async" draggable="false" />
          </div>
          <img class="pjh__logo pjh__logo--full" src={src(logo)} alt="" decoding="async" draggable="false" />
        </div>
      ) : (
        <>
          {mark && !nameSvg && <img class="pjh__mark" data-pj-mark src={src(mark)} alt="" aria-hidden="true" decoding="async" draggable="false" />}
          {stageSvg
            ? <Fragment set:html={stageSvg} />
            : logo
              ? <img class="pjh__logo" data-pj-logo src={src(logo)} alt={title} decoding="async" draggable="false" />
              : <h2 class="pjh__title display" data-pj-logo>{title}</h2>}
          {nameSvg && <Fragment set:html={nameSvg} />}
        </>
      )}
    </div>
  </div>
</section>

<style>
  .pjh { position: relative; width: 100%; min-height: 100vh; min-height: 100svh; overflow: hidden; isolation: isolate; }
  /* La escena ocupa toda la portada y se desvanece (2 s, con desenfoque) en cuanto se empieza a hacer scroll; al volver arriba, regresa */
  .pjh__scene { position: absolute; inset: 0; display: grid; place-items: center; isolation: isolate; transition: opacity 1.2s var(--ease), filter 1.2s var(--ease); }
  .pjh.is-leaving .pjh__scene { opacity: 0; filter: blur(14px); transition-duration: 2s; }

  /* Fondo: dos luces grandes y asimétricas sobre el negro del sitio. Posiciones (--ax…) y colores (--ga, --gb) los cambia el widget de paleta. */
  .pjh__bg { position: absolute; inset: 0; z-index: -1; transition: --ax 1.1s var(--ease), --ay 1.1s var(--ease), --bx 1.1s var(--ease), --by 1.1s var(--ease), --ga .8s linear, --gb .8s linear;
    background: radial-gradient(ellipse 62% 70% at var(--ax) var(--ay), color-mix(in srgb, var(--ga) 95%, transparent), transparent 72%),
                radial-gradient(ellipse 70% 62% at var(--bx) var(--by), color-mix(in srgb, var(--gb) 90%, transparent), transparent 74%); }
  /* Líquido: el canvas WebGL va sobre el fondo de luces suaves (que queda de respaldo si no hay WebGL2) */
  .pjh__liquid { position: absolute; inset: 0; z-index: -1; width: 100%; height: 100%; pointer-events: none; animation: ht-in 2.2s ease both; }
  .pjh[data-liquid='1'] .pjh__bg { opacity: 0; }
  /* Semitono: el degradado se reemplaza por una trama de puntos dibujada en el canvas (se desvanece bajo el menú, para que se lea) */
  .pjh[data-halftone] .pjh__bg { display: none; }
  .pjh__ht { position: absolute; left: 0; top: 0; z-index: -1; pointer-events: none; animation: ht-in 1.8s ease both;
    -webkit-mask-image: linear-gradient(to bottom, transparent 0, #000 16%); mask-image: linear-gradient(to bottom, transparent 0, #000 16%); }
  @keyframes ht-in { from { opacity: 0; } to { opacity: 1; } }


  /* ── Foto de fondo (si hay): cubre la portada y se coloca para que la figura clara quede hacia la derecha (a ~66 % del ancho) */
  .pjh[data-photo] .pjh__bg { display: none; }
  .pjh__photo { position: absolute; inset: 0; z-index: -1; overflow: hidden; container-type: size; animation: photo-in 2.1s cubic-bezier(.3, .6, .3, 1) both; }
  .pjh__photo img { position: absolute; top: 0; left: 0; width: 100%; height: 100%; max-width: none; object-fit: cover; object-position: 30% 50%; user-select: none; }
  @supports (width: 1cqw) {
    /* La imagen es más ancha que la pantalla: se desplaza para que la figura (que está al 51 % de su ancho) caiga al 66 % de la pantalla, sin dejar huecos */
    .pjh__photo img { width: max(100cqw, calc(100cqh * 2.357)); object-fit: fill;
      left: clamp(calc(100cqw - max(100cqw, calc(100cqh * 2.357))), calc(66cqw - .51 * max(100cqw, calc(100cqh * 2.357))), 0px); }
  }
  @keyframes photo-in { from { opacity: 0; filter: blur(26px); transform: scale(1.05); } to { opacity: 1; filter: blur(0); transform: none; } }
  /* Viñeta leve por delante de la foto y del velo verde */
  .pjh__vig { position: absolute; inset: 0; z-index: -1; pointer-events: none; background: radial-gradient(ellipse 85% 80% at 52% 48%, transparent 50%, rgb(0 0 0 / .5) 100%); }
  /* Velo verde: opaca apenas la foto; entra despacio cuando ya está el logotipo completo */
  .pjh__tint { position: absolute; inset: 0; z-index: -1; pointer-events: none; opacity: 0;
    background: linear-gradient(115deg, rgb(4 30 22 / .74), rgb(10 44 26 / .7), rgb(5 36 34 / .74), rgb(16 46 22 / .68), rgb(4 30 22 / .74));
    background-size: 320% 320%;
    animation: tint-in 2.6s 4.4s ease-in-out both, tint-drift 22s 4.4s ease-in-out infinite alternate; }
  @keyframes tint-in { from { opacity: 0; } to { opacity: 1; } }
  @keyframes tint-drift { from { background-position: 0% 30%; } to { background-position: 100% 70%; } }

  /* ── Iso de cristal (Global Citizen): se abre como un círculo, gira de canto y aparece el logotipo completo */
  .pjh__glass { position: relative; display: grid; place-items: center; width: min(94vw, 44rem); height: min(54vh, 28rem); perspective: 1500px; }
  .pjh__flip { grid-area: 1 / 1; display: grid; place-items: center; transform-style: preserve-3d; animation: glass-turn 1.6s 3.7s cubic-bezier(.55, .05, .3, 1) both; }
  .pjh__iso { width: min(48vh, 25rem); height: auto; animation: glass-open 2.7s .4s cubic-bezier(.22, .9, .28, 1) both; }
  /* Brillo: un resplandor verde-blanco que sube justo antes del giro */
  .pjh__glow { grid-area: 1 / 1; width: min(90vh, 52rem); aspect-ratio: 1; border-radius: 50%; pointer-events: none; mix-blend-mode: screen; opacity: 0;
    background: radial-gradient(closest-side, rgb(210 255 230 / .85), rgb(93 185 138 / .45) 38%, transparent 72%); animation: glow 1.9s 2.2s ease-in-out both; }
  @keyframes glow { 0% { opacity: 0; transform: scale(.55); } 55% { opacity: 1; transform: scale(1); } 100% { opacity: 0; transform: scale(1.15); } }
  /* Desenfoque del fondo: acompaña la aparición del iso y se retira cuando llega el logotipo completo */
  .pjh__blur { position: absolute; inset: 0; z-index: -1; pointer-events: none; opacity: 0;
    -webkit-backdrop-filter: blur(16px); backdrop-filter: blur(16px); animation: bg-blur 5s .2s ease-in-out both; }
  @keyframes bg-blur { 0% { opacity: 0; } 30% { opacity: 1; } 68% { opacity: 1; } 100% { opacity: 0; } }
  .pjh__logo--full { grid-area: 1 / 1; width: min(92vw, 40rem); height: auto; animation: logo-turn 2s 4.3s cubic-bezier(.22, .9, .28, 1) both; }
  @keyframes glass-open { from { clip-path: circle(0% at 50% 50%); opacity: 0; transform: rotate(-140deg) scale(.86); } 20% { opacity: 1; } to { clip-path: circle(72% at 50% 50%); opacity: 1; transform: none; } }
  @keyframes glass-turn { from { transform: rotateY(0deg); opacity: 1; } 70% { opacity: .6; } to { transform: rotateY(90deg); opacity: 0; } }
  @keyframes logo-turn { from { opacity: 0; transform: rotateY(-90deg) scale(.94); } 40% { opacity: .5; } to { opacity: 1; transform: none; } }
  @media (prefers-reduced-motion: reduce) {
    .pjh__iso, .pjh__flip, .pjh__logo--full, .pjh__photo, .pjh__tint, .pjh__blur, .pjh__glow { animation: none; } .pjh__glow { display: none; }
    .pjh__flip { display: none; } .pjh__tint { opacity: 1; }
  }

  .pjh__stage { position: relative; display: grid; place-items: center; width: min(88vw, 56rem); height: min(60vh, 34rem); }
  .pjh__stage > img { grid-area: 1 / 1; max-width: 100%; max-height: 100%; width: auto; height: auto; object-fit: contain; user-select: none; }
  .pjh__stage > .pjh__logo { width: min(100%, 40rem); animation: logo-in 1.6s .2s var(--ease, ease) both; }
  .pjh__mark { opacity: 0; } /* en su lugar, listo para animar */
  @keyframes logo-in { from { opacity: 0; filter: blur(16px); transform: scale(1.04); } to { opacity: 1; filter: none; transform: none; } }
  @media (prefers-reduced-motion: reduce) { .pjh__stage > .pjh__logo, .pjh__ht { animation: none; } .pjh__scene, .pjh.is-leaving .pjh__scene { filter: none; transition: opacity .6s linear; } }
</style>

<!-- El SVG se inserta como HTML, así que sus estilos son globales (siempre bajo .pjh) -->
<style is:global>
  @property --ax { syntax: '<percentage>'; inherits: true; initial-value: 24%; }
  @property --ay { syntax: '<percentage>'; inherits: true; initial-value: 34%; }
  @property --bx { syntax: '<percentage>'; inherits: true; initial-value: 76%; }
  @property --by { syntax: '<percentage>'; inherits: true; initial-value: 72%; }
  @property --ga { syntax: '<color>'; inherits: true; initial-value: #6a1b26; }
  @property --gb { syntax: '<color>'; inherits: true; initial-value: #240d12; }

  /* ── Trama fluida: capas de ondas lisas que se desplazan un ancho de pantalla en bucle, a distinta velocidad y en sentidos opuestos */
  .pjh__waves { position: absolute; inset: 0; z-index: -1; width: 100%; height: 100%; overflow: hidden; pointer-events: none; opacity: .9; }
  .pjh__wave { animation: pj-flow var(--dur, 60s) linear infinite; animation-direction: normal; }
  .pjh__wave[style*='--dir:-1'] { animation-direction: reverse; }
  @keyframes pj-flow { from { transform: translateX(0); } to { transform: translateX(-1440px); } }
  /* Con trama fluida, el semitono acompaña (más tenue y sólo hacia arriba), para que las ondas planas se lean */
  .pjh[data-pattern] .pjh__ht { opacity: .55; -webkit-mask-image: linear-gradient(to bottom, #000 0, #000 35%, transparent 80%); mask-image: linear-gradient(to bottom, #000 0, #000 35%, transparent 80%); animation: none; }
  @media (prefers-reduced-motion: reduce) { .pjh__wave { animation: none; } }
  .pjh__title { margin: 0; text-align: center; font-size: clamp(2rem, 6vw, 5rem); }

  /* ── Logotipo SVG (modo reactivo y ensamblar) */
  .pjh__defs { position: absolute; width: 0; height: 0; overflow: hidden; }
  .pjh__stage > svg.pjh__logo { grid-area: 1 / 1; width: auto; height: min(58vh, 32rem); max-width: 100%; animation: logo-in 1.6s .2s var(--ease, ease) both; }
  .pjh__stage > svg.pjh__logo path { transition: fill .7s linear; } /* el cambio de color del widget es suave */

  /* ── Ensamblar: composición. El iso y el nombre se apilan, centrados; el ornamento flanquea (un par por cada k) */
  .pjh { --oh: min(66vh, 38rem); --og: calc(var(--oh) * .066); --pw: calc(var(--oh) * .6672); --mark-h: min(30vh, 14rem); --name-w: min(64vw, 16.5rem); }
  .pjh[data-orn] { --mark-h: min(19vh, 9rem); --name-w: min(44vw, 10.5rem); } /* con ornamento, el logotipo se achica para quedar enmarcado en el arco */
  .pjh[data-assemble] .pjh__stage { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: clamp(.5rem, 1.5vh, .9rem); height: auto; }
  .pjh[data-assemble] .pjh__stage > svg.pjh__logo { overflow: visible; height: var(--mark-h); width: auto; animation: none; }
  .pjh__stage > svg.pjh__name { width: var(--name-w); height: auto; flex: none; overflow: visible; }
  .pjh__orn { position: absolute; top: 50%; translate: 0 -50%; z-index: -1; height: var(--oh); width: auto; aspect-ratio: 116 / 421; overflow: visible; }
  .pjh__orn--l { right: calc(50% - var(--k) * var(--pw) + var(--og) / 2); }
  .pjh__orn--r { left: calc(50% + var(--k) * var(--pw) + var(--og) / 2); }

  /* ── Piezas. Los tiempos salen de las variables --t-* (src/lib/forge.ts). Todo entra con curvas suaves y de a poco, sin golpes. */
  .pj-piece { transform-box: fill-box; transform-origin: center; }
  /* Primero aparecen los vectores, desde el negro; cuando están por ponerse dorados llegan las piezas de Omega, también desde el negro. Las alas vienen desde los costados con un leve giro que se endereza; la derecha un instante después, y se asientan sin chocar */
  .pj-piece[data-part='0'] { animation: pj-from-left 2.1s var(--t-enter) cubic-bezier(.22, .9, .28, 1) both; }
  .pj-piece[data-part='1'] { animation: pj-from-right 2.3s calc(var(--t-enter) + .14s) cubic-bezier(.22, .9, .28, 1) both; }
  .pjh__logo .pj-late { animation: pj-appear 1.5s var(--t-appear) cubic-bezier(.16, 1, .3, 1) both; }  /* el rombo se abre desde el centro, girando un poco */
  .pjh__name .pj-late { animation: pj-rise 1.6s calc(var(--t-appear) + .25s) cubic-bezier(.16, 1, .3, 1) both; } /* el nombre sube y se enfoca */
  /* Los vectores sólo aparecen con un fundido (del centro hacia afuera, de a pares) y ahí se quedan: sin movimiento, brillo ni pulsos */
  .pjh__orn .pj-piece { animation: pj-fade 2.4s var(--od, .3s) ease-out both; }
  /* Los vectores se funden con el fondo (pantalla), sin desenfoque; cuando todo está armado bajan su opacidad */
  .pj-screen { mix-blend-mode: screen; } /* los vectores se funden con el fondo (pantalla) */
  /* El logotipo y el nombre hacen lo mismo que los vectores, pero cambiando su tono a uno más claro mientras pasa el brillo; (mismo ciclo y retraso que el brillo sobre el logotipo) */
  .pj-tone { animation: pj-tone 10s calc(var(--t-shine) + var(--sd, 0s)) infinite; }
  @keyframes pj-tone { 0% { filter: none; animation-timing-function: ease-out; } 4% { filter: brightness(1.1) saturate(.92); animation-timing-function: ease-in; } 10%, 100% { filter: none; } }
  /* Brillo suave (una banda diagonal de luz, como el de LogoFolio): una pasada que se repite cada 10 s sobre el logotipo y el nombre, y con menos fuerza sobre los vectores más cercanos */
  .pj-shine { opacity: 0; animation: pj-shine 10s calc(var(--t-shine) + var(--sd, 0s)) infinite; }
  @keyframes pj-shine { 0% { translate: 0 0; opacity: 0; animation-timing-function: cubic-bezier(.4, 0, .3, 1); } 1.2% { opacity: 1; } 10% { translate: var(--gw) 0; opacity: 1; } 11.5%, 100% { translate: var(--gw) 0; opacity: 0; } }
  @keyframes pj-from-left { from { transform: translateX(-60vw) rotate(-7deg); opacity: 0; } 35% { opacity: var(--a, 1); } to { transform: none; opacity: var(--a, 1); } }
  @keyframes pj-from-right { from { transform: translateX(60vw) rotate(7deg); opacity: 0; } 35% { opacity: var(--a, 1); } to { transform: none; opacity: var(--a, 1); } }
  @keyframes pj-appear { from { opacity: 0; transform: scale(.55) rotate(-14deg); } to { opacity: var(--a, 1); transform: none; } }
  @keyframes pj-rise { from { opacity: 0; transform: translateY(10px); } to { opacity: var(--a, 1); transform: none; } }
  @keyframes pj-fade { from { opacity: 0; } to { opacity: var(--a, 1); } }

  /* ── Movimiento reducido: todo se ve ya armado */
  @media (prefers-reduced-motion: reduce) { .pj-piece, .pj-late, .pj-shine, .pj-tone { animation: none !important; } .pj-shine { display: none; } }
</style>

<script>
  import { initHalftone } from '../scripts/halftone';
  import { initLiquid } from '../scripts/liquid';

  // Con el scroll, la escena se desvanece (clase is-leaving); al volver arriba, reaparece. Un solo oyente para toda la sesión.
  let ticking = false;
  const update = () => {
    ticking = false;
    const hero = document.querySelector<HTMLElement>('[data-pj-hero]');
    if (hero) hero.classList.toggle('is-leaving', scrollY > 24);
  };
  addEventListener('scroll', () => { if (!ticking) { ticking = true; requestAnimationFrame(update); } }, { passive: true });

  document.addEventListener('astro:page-load', () => {
    document.querySelectorAll<HTMLElement>('[data-halftone]:not([data-ready])').forEach(initHalftone);
    document.querySelectorAll<HTMLElement>('[data-liquid-on]:not([data-liquid])').forEach(initLiquid);
    update();
  });
</script>
