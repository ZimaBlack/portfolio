---
// Portada de LogoFolio (tarjeta 2:3), armada con los SVG de los logotipos: título espaciado y quince marcas en una retícula de 3 × 5,
// todas en un mismo gris sobre el fondo oscuro. Sin movimiento propio: la tarjeta aporta su zoom al pasar el cursor.
import { withBase } from '../lib/i18n';
const f = (n: string) => withBase(`/works/logofolio/cover/${n}.svg`);
const cols = [24, 50, 76];
const rows = [21.6, 37, 52.8, 68, 83.2];
const marks = ['1b', '2a', '3a', '5b', '4b', '15b', '6b', '14b', '7b', '8b', '9b', '10b', '11b', '12b', '13b'];
---
<div class="lfc" role="img" aria-label="LogoFolio">
  <svg width="0" height="0" style="position:absolute" aria-hidden="true" focusable="false"><filter id="lfc-g" color-interpolation-filters="sRGB"><feColorMatrix type="matrix" values=".33 .59 .11 0 0  .33 .59 .11 0 0  .33 .59 .11 0 0  0 0 0 1 0" /><feComponentTransfer><feFuncR type="linear" slope=".13" intercept=".17" /><feFuncG type="linear" slope=".13" intercept=".17" /><feFuncB type="linear" slope=".13" intercept=".17" /></feComponentTransfer></filter></svg>
  <span class="lfc__t" aria-hidden="true">LOGOFOLIO</span>
  {marks.map((m, i) => <img class="lfc__m" src={f(m)} alt="" loading="lazy" decoding="async" style={`left:${cols[i % 3]}%;top:${rows[Math.floor(i / 3)]}%`} />)}
</div>

<style>
  .lfc { position: relative; width: 100%; height: 100%; container-type: size; background: #1a1a1a; overflow: hidden; }
  .lfc__t { position: absolute; left: 0; right: 0; top: 7.6%; text-align: center; font-weight: 300; font-size: 4.3cqw; letter-spacing: .9em; padding-left: .9em; color: #4d4d4d; }
  .lfc__m { position: absolute; width: 16cqw; height: 16cqw; transform: translate(-50%, -50%); object-fit: contain; filter: url(#lfc-g); }
</style>
