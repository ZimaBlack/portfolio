    <g transform="matrix(3.279186,0,0,3.279186,-447.341403,-450.976893)"><path class="l" style="--i:3" d="M211.218,250.482L217.768,250.482C220.202,250.482 222.343,250.141 224.193,249.457C226.043,248.774 227.51,247.782 228.593,246.482C229.677,245.182 230.218,243.616 230.218,241.782C230.218,239.782 229.677,238.124 228.593,236.807C227.51,235.491 226.043,234.507 224.193,233.857C222.343,233.207 220.202,232.882 217.768,232.882L204.918,232.882L204.918,267.882L218.618,267.882C221.385,267.882 223.785,267.541 225.818,266.857C227.852,266.174 229.427,265.116 230.543,263.682C231.66,262.249 232.218,260.366 232.218,258.032C232.218,256.266 231.827,254.757 231.043,253.507C230.26,252.257 229.218,251.224 227.918,250.407C226.618,249.591 225.168,248.999 223.568,248.632C221.968,248.266 220.318,248.082 218.618,248.082L211.218,248.082L211.218,252.682L217.668,252.682C218.502,252.682 219.26,252.757 219.943,252.907C220.627,253.057 221.235,253.299 221.768,253.632C222.302,253.966 222.718,254.399 223.018,254.932C223.318,255.466 223.468,256.099 223.468,256.832C223.468,257.966 223.21,258.857 222.693,259.507C222.177,260.157 221.485,260.624 220.618,260.907C219.752,261.191 218.768,261.332 217.668,261.332L213.368,261.332L213.368,239.432L216.868,239.432C218.302,239.432 219.427,239.732 220.243,240.332C221.06,240.932 221.468,241.832 221.468,243.032C221.468,243.832 221.285,244.507 220.918,245.057C220.552,245.607 220.027,246.032 219.343,246.332C218.66,246.632 217.835,246.782 216.868,246.782L211.218,246.782L211.218,250.482Z"/></g>
