    <g transform="matrix(3.279186,0,0,3.279186,-387.653711,-450.976893)"><path class="l" style="--i:5" d="M264.518,232.882L264.518,267.882L273.268,267.882L273.268,232.882L264.518,232.882ZM285.168,232.882L270.818,249.532L285.568,267.882L295.818,267.882L280.868,249.282L295.068,232.882L285.168,232.882Z"/></g>
    <g transform="matrix(0.606555,0,0,1,220.952616,21.037369)"><rect class="bar" x="334.629" y="380.843" width="74.922" height="25.822"/></g>
  </g>
</svg>

<style>
  .logo { display: block; height: 2rem; width: auto; aspect-ratio: 465 / 338; overflow: visible; }
  .logo .l { fill: currentColor; fill-rule: nonzero; transform-box: fill-box; transform-origin: 50% 100%; }
  /* La barra era gris oscuro (#363636) sobre fondo negro: aquí se deriva del color de texto */
  .logo .bar { fill: currentColor; opacity: .22; transform-box: fill-box; transform-origin: 0 50%; transition: opacity .5s var(--ease); }

  /* Hover: las letras saltan en cascada y la barra se extiende */
  @media (hover: hover) {
    :global(a:hover) > .logo .l, :global(a:focus-visible) > .logo .l { animation: logo-hop .7s var(--ease) both; animation-delay: calc(var(--i) * 45ms); }
    :global(a:hover) > .logo .bar, :global(a:focus-visible) > .logo .bar { animation: logo-bar .8s var(--ease) both; }
  }
  @keyframes logo-hop { 0% { transform: translateY(0); } 35% { transform: translateY(-16%) scaleY(1.06); } 100% { transform: translateY(0); } }
  @keyframes logo-bar { 0% { transform: scaleX(1); opacity: .22; } 40% { transform: scaleX(2.4); opacity: 1; } 100% { transform: scaleX(1); opacity: .22; } }

  /* Aparición (la dispara motion.ts): estado inicial oculto sólo con JS */
  :global(.js) .logo:not(.is-ready) .l, :global(.js) .logo:not(.is-ready) .bar { opacity: 0; }
</style>
