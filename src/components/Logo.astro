// Cada letra es un <path> sin transform propio, así se puede animar por CSS/GSAP.
const { class: cls, label = 'ZMA BLK' } = Astro.props;
---
<svg class:list={['logo', cls]} viewBox="180 222 465 338" role="img" aria-label={label} data-logo>
  <g transform="matrix(1.195951,0,0,1.195951,-80.778466,40.428012)">
    <g transform="matrix(3.279186,0,0,3.279186,-436.684048,-361.096768)"><path class="l" style="--i:0" d="M204.068,168.182L217.968,168.182L201.668,195.632L229.718,195.632L229.718,188.382L214.968,188.382L231.518,160.632L204.068,160.632L204.068,168.182Z"/></g>
