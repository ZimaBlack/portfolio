---
// Íconos de las IA que usa a diario. Claude: destello radial; Gemini: estrella de cuatro puntas.
---
<ul class="ai">
  <li title="Claude" aria-label="Claude">
    <svg viewBox="0 0 24 24" aria-hidden="true"><g stroke="#D97757" stroke-width="2.3" stroke-linecap="round"><line x1="14.90" y1="12.78" x2="21.66" y2="14.59"/><line x1="14.12" y1="14.12" x2="16.60" y2="16.60"/><line x1="12.78" y1="14.90" x2="14.33" y2="20.69"/><line x1="11.22" y1="14.90" x2="10.19" y2="18.76"/><line x1="9.88" y1="14.12" x2="4.58" y2="19.42"/><line x1="9.10" y1="12.78" x2="6.20" y2="13.55"/><line x1="9.10" y1="11.22" x2="2.82" y2="9.54"/><line x1="9.88" y1="9.88" x2="6.70" y2="6.70"/><line x1="11.22" y1="9.10" x2="9.41" y2="2.34"/><line x1="12.78" y1="9.10" x2="13.68" y2="5.72"/><line x1="14.12" y1="9.88" x2="18.36" y2="5.64"/><line x1="14.90" y1="11.22" x2="18.76" y2="10.19"/></g></svg>
  </li>
  <li title="Gemini" aria-label="Gemini">
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <defs>
        <linearGradient id="gem-g" x1="3" y1="21" x2="21" y2="3" gradientUnits="userSpaceOnUse">
          <stop offset="0" stop-color="#4285F4" /><stop offset=".55" stop-color="#9B72CB" /><stop offset="1" stop-color="#D96570" />
        </linearGradient>
      </defs>
      <path fill="url(#gem-g)" d="M12 0C12 6.63 17.37 12 24 12 17.37 12 12 17.37 12 24 12 17.37 6.63 12 0 12 6.63 12 12 6.63 12 0Z" />
    </svg>
  </li>
</ul>

<style>
  .ai { display: inline-flex; align-items: center; gap: .8rem; list-style: none; margin: 0; padding: 0; }
  .ai li { display: inline-flex; align-items: center; gap: .45rem; color: var(--fg); font-size: .8rem; }
  .ai svg { width: 1.45rem; height: 1.45rem; flex: none; }
</style>
