---
// Reproductor responsivo 16:9 con carga diferida (facade por click).
const { provider, id, title = 'Video', play = 'Play' } = Astro.props;
const src = provider === 'vimeo'
  ? `https://player.vimeo.com/video/${id}?autoplay=1&title=0&byline=0&portrait=0&dnt=1`
  : `https://www.youtube-nocookie.com/embed/${id}?autoplay=1&rel=0`;
---
<div class="video" data-video data-src={src} data-title={title}>
  <button type="button" class="video__play" aria-label={`${play}: ${title}`}>
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5l12 7-12 7z" /></svg>
    <span>{play}</span>
  </button>
</div>

<style>
  .video { position: relative; aspect-ratio: 16 / 9; width: 100%; background: radial-gradient(100% 100% at 30% 0%, #1d2a38, #0a0f14); overflow: hidden; }
  .video :global(iframe) { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
  .video__play { position: absolute; inset: 0; width: 100%; display: grid; place-content: center; justify-items: center; gap: .9rem; color: #fff; font-size: .8rem; letter-spacing: .12em; text-transform: uppercase; }
  .video__play svg { width: 5.5rem; height: 5.5rem; padding: 1.7rem 1.5rem 1.7rem 1.9rem; border: 1px solid rgb(255 255 255 / .5); border-radius: 50%; fill: currentColor; transition: transform .6s var(--ease), background .4s, color .4s; }
  .video__play:hover svg { transform: scale(1.1); background: #fff; color: #000; }
</style>

<script>
  const bind = () => document.querySelectorAll<HTMLElement>('[data-video]:not([data-bound])').forEach((el) => {
    el.dataset.bound = '1';
    el.querySelector('button')?.addEventListener('click', () => {
      const f = document.createElement('iframe');
      f.src = el.dataset.src!;
      f.title = el.dataset.title!;
      f.allow = 'autoplay; fullscreen; picture-in-picture';
      f.allowFullscreen = true;
      el.replaceChildren(f);
    });
  });
  document.addEventListener('astro:page-load', bind);
</script>
