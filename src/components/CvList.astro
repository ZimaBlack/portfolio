---
import type { Item } from '../data/cv';
import { loc, type Lang } from '../lib/i18n';

// Muestra los primeros `limit` ítems; el resto queda plegado (funciona sin JavaScript).
const { items, lang, limit = 5, more, less } = Astro.props as { items: Item[]; lang: Lang; limit?: number; more: string; less: string };
const head = items.slice(0, limit);
const rest = items.slice(limit);
---
<div class="cvlist">
<ul class="tl">
  {head.map((i) => <li class:list={{ strong: i.strong }}><span class="tl__p">{loc(i.p, lang)}</span><span class="tl__t">{loc(i.t, lang)}{i.o && <em>{loc(i.o, lang)}</em>}</span></li>)}
</ul>
{rest.length > 0 && (
  <details class="more">
    <summary>
      <span class="more__open">{more} <b>+{rest.length}</b></span>
      <span class="more__close">{less}</span>
    </summary>
    <ul class="tl">
      {rest.map((i) => <li class:list={{ strong: i.strong }}><span class="tl__p">{loc(i.p, lang)}</span><span class="tl__t">{loc(i.t, lang)}{i.o && <em>{loc(i.o, lang)}</em>}</span></li>)}
    </ul>
  </details>
)}
</div>

<style>
  .tl { list-style: none; margin: 0; padding: 0; display: grid; gap: .9rem; }
  .tl li { display: grid; grid-template-columns: 8.5rem 1fr; gap: 1rem; font-size: .95rem; line-height: 1.4; color: var(--muted); }
  .tl li.strong { color: var(--fg); }
  .tl li.strong .tl__t { font-weight: 500; }
  .tl__t { display: grid; gap: .1rem; }
  .tl__t em { font-style: normal; font-weight: 400; color: var(--muted); }
  @media (max-width: 560px) { .tl li { grid-template-columns: 1fr; gap: .1rem; } }

  .more { margin-top: 1.1rem; }
  .more[open] > .tl { margin-top: 1.1rem; animation: unfold .6s var(--ease); }
  @keyframes unfold { from { opacity: 0; transform: translateY(-8px); } }
  summary { list-style: none; cursor: pointer; display: inline-flex; align-items: center; gap: .5rem; font-size: .85rem; padding: .5rem 1rem; border: 1px solid var(--line); border-radius: 999px; transition: background .35s var(--ease), color .35s var(--ease), border-color .35s; }
  summary::-webkit-details-marker { display: none; }
  summary:hover, summary:focus-visible { background: var(--fg); color: var(--bg); border-color: var(--fg); }
  summary b { font-weight: 500; opacity: .6; }
  .more__close { display: none; }
  .more[open] .more__open { display: none; }
  .more[open] .more__close { display: inline; }
</style>
