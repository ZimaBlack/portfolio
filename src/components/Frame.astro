---
// Imagen o marco placeholder con degradé del proyecto.
import { withBase } from '../lib/i18n';
const { src: rawSrc, alt = '', tones = ['#1a1a1a', '#2b2b2b'], ratio = '16 / 9', label, parallax = 0, fill = false, note } = Astro.props;

// Medidas recomendadas para preparar la imagen (se muestran en el placeholder):
//  · con parallax: ancho de pantalla (2560 px) y un 18% más de alto que el marco;
//  · sin parallax: 1600 px de ancho y la proporción exacta del marco (no se recorta).
const [rw, rh] = String(ratio).split('/').map((n) => parseFloat(n));
const r = rw / (rh || 1);
const w = parallax > 0 ? 2560 : 1600;
const h = parallax > 0 ? Math.round((w * 1.18) / r / 10) * 10 : Math.round(w / r);
const ratioTxt = `${rw}:${rh}`;
// Las rutas absolutas (/works/…) se prefijan con la base del sitio, para que funcionen también en GitHub Pages bajo /repo
const src = rawSrc && rawSrc.startsWith('/') ? withBase(rawSrc) : rawSrc;
---
<div class:list={['frame', { 'frame--fill': fill, 'frame--par': parallax > 0 }]} style={`--a:${tones[0]};--b:${tones[1]};--r:${ratio}`}>
  {src
    ? <img src={src} alt={alt} loading="lazy" decoding="async" data-parallax={parallax || undefined} />
    : <div class="frame__ph" data-parallax={parallax || undefined}>
        <div class="frame__spec">
          {label && <span class="frame__label">{label}</span>}
          <strong class="frame__dims">{w} × {h} px</strong>
          <span class="frame__ratio">{ratioTxt}{parallax > 0 ? ' · parallax' : ''}</span>
          {note && parallax > 0 && <em class="frame__note">{note}</em>}
        </div>
      </div>}
</div>

<style>
  .frame { position: relative; overflow: hidden; aspect-ratio: var(--r); background: var(--a); }
  .frame--fill { aspect-ratio: auto; position: absolute; inset: 0; }
  /* Por defecto la imagen se ve completa (tarjetas, pares, insets). */
  .frame img, .frame__ph { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  /* Sólo las imágenes con parallax son un 18% más altas que el marco (9% de sobra arriba y abajo) para tener recorrido.
     Se posiciona con `top` (porcentaje de la ALTURA); `margin-top` usaría el ancho y dejaría una franja en marcos apaisados. */
  .frame--par img, .frame--par .frame__ph { inset: auto; left: 0; top: -9%; height: 118%; }
  .frame__ph { background: radial-gradient(120% 90% at 20% 10%, var(--b), var(--a)); display: grid; place-items: center; }
  .frame__spec { display: grid; gap: .4rem; justify-items: center; text-align: center; padding: 1rem; max-width: 34rem; color: rgb(255 255 255 / .4); }
  .frame__label { font-size: .7rem; letter-spacing: .14em; text-transform: uppercase; }
  .frame__dims { font-size: clamp(1rem, 2.2vw, 1.6rem); font-weight: 500; letter-spacing: .02em; color: rgb(255 255 255 / .82); }
  .frame__ratio { font-size: .72rem; letter-spacing: .12em; text-transform: uppercase; }
  .frame__note { font-style: normal; font-size: .72rem; line-height: 1.4; max-width: 26rem; margin-top: .3rem; }
</style>
