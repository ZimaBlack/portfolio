---
// Video de fondo del hero (los últimos 10 s del original, en blanco y negro).
// Ciclo: arranca 1,3 s después de que termina de desplegarse el hero → el video (se desvanece al aparecer y al terminar)
// → 10 s de negro → vuelve el video, y así sucesivamente. Sin audio ni controles.
const src = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/video/hero-loop.mp4`;
---
<div class="hero__media" aria-hidden="true">
  <div class="hero__frame">
  <video class="hero__video" muted playsinline preload="none" tabindex="-1" disablepictureinpicture data-src={src} data-after="1300" data-gap="10000" data-rate="1"></video>
  </div>
  <div class="hero__shade"></div>
</div>
<!-- Viñeta: degradado radial negro por fuera; el video queda por debajo y se pierde hacia los bordes -->
<div class="hero__vignette" aria-hidden="true"></div>

<style>
  .hero__media { position: absolute; inset: 0; z-index: 0; overflow: hidden; pointer-events: none; opacity: 0; transition: opacity var(--fade, 2.6s) ease; }
  .hero__media.is-on { opacity: .3; } /* opacidad máxima del video */
  /* El video no se estira a toda la pantalla: ocupa sólo la ventana central que deja ver la viñeta, a su resolución
     nativa (máx. 1280 px, nunca ampliado) y sin pixelarse. Los bordes de la ventana quedan bajo el negro de la viñeta.
     Se recorta el degradado negro que trae el original en su borde inferior (relación 2,07:1 en lugar de 16:9). */
  .hero__frame { position: absolute; left: var(--vx, 50%); top: var(--vy, 44%); transform: translate(-50%, -50%) scale(var(--vs, 1)) rotate(var(--vr, 0deg)); width: min(1280px, max(82vw, 110svh)); aspect-ratio: 2.07; overflow: hidden;
    /* Máscara elíptica: el video se disuelve hacia el borde de su ventana, en la misma forma que la viñeta */
    -webkit-mask-image: radial-gradient(ellipse closest-side at 50% 50%, #000 38%, rgb(0 0 0 / .55) 68%, transparent 100%); mask-image: radial-gradient(ellipse closest-side at 50% 50%, #000 38%, rgb(0 0 0 / .55) 68%, transparent 100%); }
  .hero__video { display: block; width: 100%; height: auto; filter: grayscale(1) brightness(.9) blur(16px); transition: filter var(--fade, 2.6s) ease; } /* sin color */
  /* Al aparecer se enfoca y al terminar se desenfoca de nuevo, junto con el fundido */
  .is-on .hero__video { filter: grayscale(1) brightness(.9) blur(0); }
  /* Velo mínimo y uniforme (sin degradado): sólo para asentar el texto sobre las vetas claras */
  .hero__shade { position: absolute; inset: 0; background: rgb(11 11 10 / .14); }
  /* Viñeta siempre presente (no se desvanece con el video): negro sólido en los bordes que se abre hacia el centro */
  .hero__vignette { position: absolute; inset: 0; z-index: 0; pointer-events: none;
    background: radial-gradient(ellipse 70% 66% at var(--vx, 50%) var(--vy, 44%), transparent 0%, rgb(11 11 10 / .22) 18%, rgb(11 11 10 / .62) 44%, rgb(11 11 10 / .93) 68%, var(--bg) 86%); }
  /* El video está pensado para fondo oscuro */
  @media (prefers-color-scheme: light) { :global(:root:not([data-theme='dark'])) .hero__media, :global(:root:not([data-theme='dark'])) .hero__vignette { display: none; } }
  @media (prefers-reduced-motion: reduce) { .hero__media, .hero__vignette { display: none; } }
</style>

<script>
  let timers: number[] = [];
  const clear = () => { timers.forEach(clearTimeout); timers = []; };

  const init = () => {
    const media = document.querySelector<HTMLElement>('.hero__media:not([data-ready])');
    const video = media?.querySelector<HTMLVideoElement>('video');
    if (!media || !video) return;
    media.dataset.ready = '1';
    clear();
    const conn = (navigator as any).connection;
    if (matchMedia('(prefers-reduced-motion: reduce)').matches || conn?.saveData) return;

    const AFTER = Number(video.dataset.after); // ms después de que termina de desplegarse el hero
    const GAP = Number(video.dataset.gap);
    const RATE = Number(video.dataset.rate) || 1; // velocidad de reproducción (1 = normal)
    let fade = 2.6; // segundos (reales) de fundido de entrada y de salida; se acorta si el clip es muy breve
    const later = (fn: () => void, ms: number) => void timers.push(window.setTimeout(fn, ms));
    const whenVisible = () => new Promise<void>((res) => {
      if (!document.hidden) return res();
      const on = () => { if (!document.hidden) { document.removeEventListener('visibilitychange', on); res(); } };
      document.addEventListener('visibilitychange', on);
    });

    // Cada reproducción aparece en un lugar distinto del hero (con otra escala y un leve giro) y deriva despacio mientras dura.
    // Se coloca mientras el video está invisible, así que "aparece" en otro punto, de forma inquietante.
    const hero = media.closest<HTMLElement>('.hero') ?? media;
    const frame = media.querySelector<HTMLElement>('.hero__frame')!;
    let last = { x: 50, y: 44 };
    let drift: Animation | undefined;
    const place = () => {
      let x = 50, y = 44;
      for (let k = 0; k < 10; k++) {
        x = 26 + Math.random() * 48; y = 28 + Math.random() * 38;
        if (Math.hypot(x - last.x, (y - last.y) * 1.4) > 24) break; // nunca cerca del lugar anterior
      }
      last = { x, y };
      const st = hero.style;
      st.setProperty('--vx', `${x.toFixed(1)}%`);
      st.setProperty('--vy', `${y.toFixed(1)}%`);
      st.setProperty('--vs', (0.72 + Math.random() * 0.28).toFixed(2)); // sólo reduce: no se amplía por encima de su resolución
      st.setProperty('--vr', `${((Math.random() - 0.5) * 9).toFixed(1)}deg`);
      drift?.cancel();
      const ang = Math.random() * Math.PI * 2;
      const dist = Math.min(innerWidth, innerHeight) * (0.05 + Math.random() * 0.07);
      const ms = ((video.duration || 10) / RATE + fade * 2) * 1000;
      // Además de desplazarse, gira un poco durante la reproducción (±1,5° a ±3,5°, en un sentido al azar)
      const turn = (1.5 + Math.random() * 2) * (Math.random() < 0.5 ? -1 : 1);
      drift = frame.animate(
        [{ translate: '0 0', rotate: '0deg' }, { translate: `${Math.cos(ang) * dist}px ${Math.sin(ang) * dist}px`, rotate: `${turn.toFixed(2)}deg` }],
        { duration: ms, easing: 'ease-in-out', fill: 'forwards' },
      );
    };

    const prepare = () => { if (!video.src) { video.src = video.dataset.src!; video.load(); } };
    const play = async () => {
      prepare();
      await whenVisible();
      if (video.readyState < 3) await new Promise<void>((res) => video.addEventListener('canplay', () => res(), { once: true }));
      video.currentTime = 0;
      video.playbackRate = RATE;
      fade = Math.min(2.6, (video.duration / RATE) * 0.35); // el fundido no puede ser más largo que el propio clip
      media.style.setProperty('--fade', `${fade}s`);
      place();
      try { await video.play(); } catch { return later(play, GAP); } // si el navegador no deja reproducir, reintenta más tarde
      media.classList.add('is-on');
    };

    video.addEventListener('timeupdate', () => {
      if (video.duration && (video.duration - video.currentTime) / RATE < fade) media.classList.remove('is-on');
    });
    video.addEventListener('ended', () => { media.classList.remove('is-on'); later(play, GAP); });

    prepare(); // empieza a descargar enseguida (1,7 MB) para estar listo
    // Arranca AFTER ms después de que el hero termina de desplegarse (evento `hero:ready`, con respaldo por si no llega)
    let started = false;
    const go = () => { if (started) return; started = true; later(play, AFTER); };
    document.addEventListener('hero:ready', go, { once: true });
    later(go, 6000);
  };

  document.addEventListener('astro:page-load', init);
  document.addEventListener('astro:before-swap', clear);
</script>
