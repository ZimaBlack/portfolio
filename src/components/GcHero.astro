---
// Portada modular de Global Citizen (manual de marca): a los lados, columnas de medios anillos que se arman por secciones y giran;
// al centro, cuatro medios anillos giran sobre el centro del isotipo hasta encajar y las letras entran girando una a una.
// Todo es geometría vectorial en SVG y siempre se arma con giros (animación radial compartida: --gc-radial en global.css).
import { readFileSync } from 'node:fs';
import { join } from 'node:path';
import { halfDouble, halfMid, halfOut, fullMid } from '../lib/gcmods';

const { part = 'stage', title = 'Global Citizen' } = Astro.props as { part?: 'field' | 'stage'; title?: string };
const pub = (f: string) => readFileSync(join(process.cwd(), 'public/works/global-citizen', f), 'utf8');
const ds = (raw: string) => [...raw.matchAll(/\bd="([^"]+)"/g)].map((m) => m[1]);
const [midRing, outRing] = ds(pub('mark.svg'));
const logoPaths = ds(pub('logo.svg')).slice(0, 13); // GLOBAL (0-5) y CITIZEN (6-12)

// ── Columna modular (la de "Deconstruimos"): eje A (mitades derechas) y eje B (mitades izquierdas), cinco secciones
const W = 1600, H = 900, R = 77.5;
const DX = 179; // distancia entre ejes
const ys = [95, 277, 453, 629, 803].map((y) => y - 453 + H / 2);
type Mod = { x: number; y: number; d?: string; iso?: boolean; row: number };
const strip: Mod[] = [
  { x: 0, y: ys[0], d: halfMid(R, 'r'), row: 0 }, { x: DX, y: ys[0], d: halfDouble(R, 'l'), row: 0 },
  { x: 0, y: ys[1], d: halfDouble(R, 'r'), row: 1 }, { x: DX, y: ys[1], iso: true, row: 1 },
  { x: 0, y: ys[2], d: halfOut(R, 'r') + fullMid(R), row: 2 }, { x: DX, y: ys[2], iso: true, row: 2 },
  { x: 0, y: ys[3], d: halfDouble(R, 'r'), row: 3 }, { x: DX, y: ys[3], d: halfDouble(R, 'l'), row: 3 },
  { x: 0, y: ys[4], d: halfMid(R, 'r'), row: 4 },
];
// Dos columnas, una a cada lado y reflejadas: la de la derecha se arma primero, la de la izquierda la sigue
const strips = [{ ax: 70, flip: false, lag: 0 }, { ax: W - 70, flip: true, lag: 0.45 }];
const isoK = (2 * R / 234).toFixed(4);
const clipL = 'gch-l', clipR = 'gch-r';
---
{part === 'field' ? (
  <svg class="gch__field" viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="xMidYMid slice" aria-hidden="true" focusable="false">
    {strips.map((st) => (
      <g transform={`translate(${st.ax} 0) ${st.flip ? 'scale(-1 1)' : ''}`}>
        {strip.map((m, i) => (
          <g transform={`translate(${m.x} ${m.y})`}>
            <g class="gch__a" style={`--dl:${(0.2 + st.lag + m.row * 0.4 + (m.x ? 0.15 : 0)).toFixed(2)}s;--fr:${m.x ? 120 : -120}deg`}>
              <g class={i % 3 === 0 ? 'gch__t' : ''} style={`--td:${(4 + i * 1.3 + st.lag * 3).toFixed(1)}s`}>
                <g class="gch__c" style={`--hd:${(3.4 + i * 0.7 + st.lag * 2).toFixed(2)}s`}>
                  {m.iso
                    ? <g transform={`scale(${isoK}) translate(-117 -117)`}><path d={midRing} /><path d={outRing} /></g>
                    : <path d={m.d} />}
                </g>
              </g>
            </g>
          </g>
        ))}
      </g>
    ))}
  </svg>
) : (
  <svg class="gch" viewBox="0 0 665 189" role="img" aria-label={title} xmlns="http://www.w3.org/2000/svg">
    <g class="gch__letters">
      {logoPaths.map((d, i) => <path class="gch__l" style={`--i:${i}`} d={d} fill="#fff" />)}
    </g>
    <svg x="0" y="3.5" width="181" height="181" viewBox="0 0 234 234" overflow="visible">
      <defs>
        <clipPath id={clipL}><rect x="-60" y="-60" width="177.2" height="360" /></clipPath>
        <clipPath id={clipR}><rect x="116.6" y="-60" width="180" height="360" /></clipPath>
      </defs>
      <g class="gch__p gch__p--mid-l"><path d={midRing} clip-path={`url(#${clipL})`} /></g>
      <g class="gch__p gch__p--mid-r"><path d={midRing} clip-path={`url(#${clipR})`} /></g>
      <g class="gch__p gch__p--out-l"><path d={outRing} clip-path={`url(#${clipL})`} /></g>
      <g class="gch__p gch__p--out-r"><path d={outRing} clip-path={`url(#${clipR})`} /></g>
    </svg>
  </svg>
)}

<style is:global>
  .gch__field { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; z-index: 0; }
  .gch__a { opacity: 0; animation: gc-radial 1.5s var(--dl) var(--gc-ease) forwards; }
  .gch__t { animation: gch-turn 14s var(--td) ease-in-out infinite; }
  .gch__c { fill: #dfefe5; fill-opacity: .1; animation: gch-hop 18s var(--hd) ease-in-out infinite; }
  .gch__c path { fill: inherit; fill-opacity: inherit; }
  @keyframes gch-turn { 0%, 10% { transform: rotate(0); } 22%, 60% { transform: rotate(180deg); } 72%, 100% { transform: rotate(360deg); } }
  @keyframes gch-hop { 0%, 9%, 100% { fill: #dfefe5; fill-opacity: .1; } 3%, 6% { fill: #5db98a; fill-opacity: .7; } }

  .gch { position: relative; z-index: 1; display: block; width: min(86vw, 50rem); height: auto; overflow: visible; }
  .gch__p { transform-origin: 116.9px 116.9px; opacity: 0; fill: #dfefe5; animation: gc-radial 1.5s var(--pd) var(--gc-ease) forwards, gch-tint .9s 3.1s ease forwards; }
  .gch__p--mid-l { --pd: .5s; --fr: -200deg; } .gch__p--mid-r { --pd: .9s; --fr: 200deg; }
  .gch__p--out-l { --pd: 1.3s; --fr: -270deg; } .gch__p--out-r { --pd: 1.7s; --fr: 270deg; }
  @keyframes gch-tint { to { fill: #5db98a; } }
  .gch__l { opacity: 0; transform-box: fill-box; transform-origin: center; --fr: -100deg; animation: gc-radial .9s calc(2.9s + var(--i) * .07s) var(--gc-ease) forwards; }
  @media (prefers-reduced-motion: reduce) {
    .gch__a { animation: none; opacity: 1; } .gch__t, .gch__c { animation: none; }
    .gch__p { animation: none; opacity: 1; fill: #5db98a; } .gch__l { animation: none; opacity: 1; }
  }
</style>
