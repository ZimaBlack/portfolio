---
// Portada de Global Citizen (manual de marca): sobre blanco, la trama modular a pantalla completa. Medios anillos dobles ("C") en filas,
// con el anillo completo en la cuarta posición; el isotipo ocupa ese lugar en la fila central. Se arma sobre el centro del anillo y la trama
// aparece en ondas concéntricas desde él. Todo es geometría vectorial en SVG.
import { readFileSync } from 'node:fs';
import { join } from 'node:path';
import { halfDouble, fullDouble } from '../lib/gcmods';

const { part = 'stage', title = 'Global Citizen' } = Astro.props as { part?: 'field' | 'stage'; title?: string };
const pub = (f: string) => readFileSync(join(process.cwd(), 'public/works/global-citizen', f), 'utf8');
const ds = (raw: string) => [...raw.matchAll(/\bd="([^"]+)"/g)].map((m) => m[1]);
const [midRing, outRing] = ds(pub('mark.svg'));

const R = 100;                 // radio del módulo: un módulo mide R de ancho y 2R de alto
const PITCH = 2 * R + 20;      // paso entre filas
const ROWS = 5, W = 7 * R, H = (ROWS - 1) * PITCH + 2 * R;
const SLOTS = ['L', 'L', 'L', 'F', 'F', 'L', 'L'] as const;
const gx = 4 * R, gy = Math.floor(ROWS / 2) * PITCH + R; // el isotipo ocupa el anillo completo de la fila central
type Cell = { x: number; y: number; d: string; delay: number };
const cells: Cell[] = [];
for (let r = 0; r < ROWS; r++) {
  const y = r * PITCH + R;
  for (let s = 0; s < SLOTS.length; s++) {
    if (SLOTS[s] === 'F' && s === 4) continue;
    const full = SLOTS[s] === 'F';
    const x = full ? (s + 1) * R : (s + 1) * R;
    if (full && r === Math.floor(ROWS / 2)) continue; // lo ocupa el isotipo
    const d = Math.hypot(x - gx, y - gy);
    cells.push({ x, y, d: full ? fullDouble(R) : halfDouble(R, 'l'), delay: 1.2 + d / 520 });
  }
}
const k = (2 * R / 234).toFixed(4);
---
{part === 'field' ? (
  <svg class="gch__pat" viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="xMidYMid slice" aria-hidden="true" focusable="false">
    <defs>
      <clipPath id="gch-l"><rect x="-60" y="-60" width="176.914" height="360" /></clipPath>
      <clipPath id="gch-r"><rect x="116.914" y="-60" width="180" height="360" /></clipPath>
    </defs>
    {cells.map((c) => (
      <g transform={`translate(${c.x} ${c.y})`}>
        <path class="gch__c" style={`--dl:${c.delay.toFixed(2)}s`} d={c.d} />
      </g>
    ))}
    <g transform={`translate(${gx} ${gy})`}>
      <g transform={`scale(${k}) translate(-117 -117)`}>
        <g class="gch__p gch__p--mid-l"><path d={midRing} clip-path="url(#gch-l)" /></g>
        <g class="gch__p gch__p--mid-r"><path d={midRing} clip-path="url(#gch-r)" /></g>
        <g class="gch__p gch__p--out-l"><path d={outRing} clip-path="url(#gch-l)" /></g>
        <g class="gch__p gch__p--out-r"><path d={outRing} clip-path="url(#gch-r)" /></g>
      </g>
    </g>
  </svg>
) : (
  <span class="gch__sr">{title}</span>
)}

<style is:global>
  /* Portada sobre blanco, sin foto */
  .pjh[data-modular] { background: #fafafa; }
  .pjh[data-modular] :is(.pjh__bg, .pjh__photo, .pjh__blur, .pjh__tint, .pjh__vig) { display: none; }
  .gch__pat { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; z-index: 0; }
  .gch__sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  /* Los módulos aparecen en ondas concéntricas desde el isotipo, con un giro mínimo sobre el centro de su anillo */
  .gch__c { fill: #dfece4; opacity: 0; animation: gc-radial 1.8s var(--dl) var(--gc-ease) forwards; --fr: -60deg; }
  /* El isotipo se arma sobre su centro: cuatro medios anillos que giran y encajan */
  .gch__p { transform-origin: 116.9px 116.9px; opacity: 0; fill: #dfece4; animation: gc-radial 1.8s var(--pd) var(--gc-ease) forwards, gch-tint 1.2s 2.6s ease forwards; }
  .gch__p--mid-l { --pd: .2s; --fr: -200deg; } .gch__p--mid-r { --pd: .45s; --fr: 200deg; }
  .gch__p--out-l { --pd: .7s; --fr: -270deg; } .gch__p--out-r { --pd: .95s; --fr: 270deg; }
  @keyframes gch-tint { to { fill: #74b992; } }
  @media (prefers-reduced-motion: reduce) { .gch__c { animation: none; opacity: 1; } .gch__p { animation: none; opacity: 1; fill: #74b992; } }
</style>
