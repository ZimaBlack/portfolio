---
// Síntesis (manual de marca): estilo suizo + constructivismo gráfico = principios compartidos = Global Citizen.
// Cada corriente es un módulo (medio anillo doble); al enfrentarlos cierran el anillo completo y éste se resuelve en el isotipo.
import { halfDouble, fullDouble } from '../lib/gcmods';
const { labels, label = 'Síntesis' } = Astro.props as { labels: [string, string][]; label?: string };
const R = 77.5;
const MID = `M116.914 79.1455V47.0698C85.0753 47.0698 58.2192 68.3743 49.7735 97.5089C47.971 103.677 47.0215 110.225 47.0215 116.963C47.0215 136.274 54.8523 153.736 67.5213 166.358C80.1406 179.027 97.6035 186.856 116.914 186.856C155.539 186.856 186.809 155.539 186.809 116.963H154.733C154.733 137.841 137.794 154.78 116.914 154.78C106.478 154.78 97.0348 150.557 90.2011 143.677C83.3694 136.844 79.1442 127.401 79.1442 116.963C79.1442 109.845 81.0928 103.203 84.5067 97.5089C91.1037 86.5003 103.154 79.1455 116.914 79.1455Z`;
const OUT = `M232.265 97.5086C228.186 73.025 216.463 51.1029 199.621 34.2583L176.891 56.9871L166.359 67.5203L136.37 97.5086H199.43C200.949 103.725 201.708 110.273 201.708 116.963C201.708 163.795 163.748 201.755 116.914 201.755C93.5215 201.755 72.3599 192.265 56.9885 176.939V176.891C41.6615 161.517 32.1723 140.355 32.1723 116.963C32.1723 110.273 32.9314 103.725 34.4496 97.5086C43.2266 60.0234 76.8205 32.1702 116.914 32.1702V-0.00012207C58.9788 -0.00012207 10.8672 42.1824 1.61471 97.5086C0.568631 103.819 0 110.32 0 116.963C0 149.275 13.0968 178.505 34.2591 199.619C55.3738 220.782 84.6037 233.878 116.914 233.878C181.496 233.878 233.88 181.542 233.88 116.963C233.88 110.32 233.309 103.819 232.265 97.5086Z`;
---
<ol class="gcs" data-gc aria-label={label}>
  <li class="gcs__c" style="--n:0">
    <svg viewBox="-90 -90 180 180" aria-hidden="true" focusable="false"><g class="gcs__m gcs__m--a" style="--fr:-200deg"><path d={halfDouble(R, 'r')} transform="translate(-39 0)" /></g></svg>
    <b>{labels[0][0]}</b><span>{labels[0][1]}</span>
  </li>
  <li class="gcs__op" aria-hidden="true" style="--n:1">+</li>
  <li class="gcs__c" style="--n:2">
    <svg viewBox="-90 -90 180 180" aria-hidden="true" focusable="false"><g class="gcs__m gcs__m--a" style="--fr:200deg"><path d={halfDouble(R, 'l')} transform="translate(39 0)" /></g></svg>
    <b>{labels[1][0]}</b><span>{labels[1][1]}</span>
  </li>
  <li class="gcs__op" aria-hidden="true" style="--n:3">=</li>
  <li class="gcs__c" style="--n:4">
    <svg viewBox="-90 -90 180 180" aria-hidden="true" focusable="false">
      <g class="gcs__m gcs__m--a" style="--fr:-270deg"><path d={halfDouble(R, 'r')} /></g>
      <g class="gcs__m gcs__m--a" style="--fr:270deg"><path d={halfDouble(R, 'l')} /></g>
    </svg>
    <b>{labels[2][0]}</b><span>{labels[2][1]}</span>
  </li>
  <li class="gcs__op gcs__op--go" aria-hidden="true" style="--n:5">→</li>
  <li class="gcs__c gcs__c--gc" style="--n:6">
    <svg viewBox="-90 -90 180 180" aria-hidden="true" focusable="false"><g class="gcs__m gcs__m--g" style="--fr:-360deg"><g transform={`scale(${(2 * R / 234).toFixed(4)}) translate(-117 -117)`}><path d={MID} /><path d={OUT} /></g></g></svg>
    <b>{labels[3][0]}</b><span>{labels[3][1]}</span>
  </li>
</ol>

<style is:global>
  .gcs { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: 1fr auto 1fr auto 1fr auto 1fr; align-items: start; gap: clamp(.3rem, 1.4vw, 1.2rem); }
  .gcs__c { display: grid; gap: .35rem; justify-items: center; text-align: center; }
  .gcs__c svg { width: min(100%, 9rem); height: auto; overflow: visible; }
  .gcs__c b { font-weight: 600; font-size: .95rem; margin-top: .4rem; } .gcs__c span { color: var(--muted); font-size: .8rem; line-height: 1.45; max-width: 15ch; }
  .gcs__op { align-self: center; font-size: clamp(1.2rem, 2.4vw, 2rem); color: var(--muted); margin-top: -3rem; opacity: 0; }
  .gcs.is-in .gcs__op { animation: gcs-fade .8s calc(var(--n) * .45s) ease forwards; }
  @keyframes gcs-fade { to { opacity: 1; } }
  .gcs__m { opacity: 0; fill: #dfefe5; fill-opacity: .6; }
  .gcs.is-in .gcs__c:nth-child(1) .gcs__m { animation: gc-radial 1.4s 0s var(--gc-ease) forwards; }
  .gcs.is-in .gcs__c:nth-child(3) .gcs__m { animation: gc-radial 1.4s .5s var(--gc-ease) forwards; }
  .gcs.is-in .gcs__c:nth-child(5) .gcs__m { animation: gc-radial 1.4s 1.5s var(--gc-ease) forwards; }
  .gcs.is-in .gcs__c:nth-child(7) .gcs__m { animation: gc-radial 1.6s 2.6s var(--gc-ease) forwards, gcs-green 1s 3.8s ease forwards; }
  @keyframes gcs-green { to { fill: #5db98a; fill-opacity: 1; } }
  .gcs__c b, .gcs__c span { opacity: 0; }
  .gcs.is-in .gcs__c b, .gcs.is-in .gcs__c span { animation: gcs-fade .9s calc(var(--n) * .45s + .6s) ease forwards; }
  .gcs__c--gc b { color: #5db98a; }
  @media (max-width: 760px) { .gcs { grid-template-columns: 1fr 1fr; row-gap: 1.2rem; } .gcs__op { display: none; } }
  @media (prefers-reduced-motion: reduce) { .gcs__m, .gcs__op, .gcs__c b, .gcs__c span { opacity: 1; animation: none !important; } .gcs__c--gc .gcs__m { fill: #5db98a; fill-opacity: 1; } }
</style>
