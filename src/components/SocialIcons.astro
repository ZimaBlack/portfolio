---
<ul class="soc-row">
  {site.social.map((s) => (
    <li>
      <a href={s.href} target="_blank" rel="noopener noreferrer" aria-label={s.label} title={s.label} style={`--c:${glyph[s.icon].color}`}>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d={glyph[s.icon].path} /></svg>
      </a>
    </li>
  ))}
</ul>

<style>
  .soc-row { display: flex; align-items: center; gap: 1.1rem; list-style: none; margin: 0; padding: 0; }
  a { display: block; color: #8a8982; transition: color .35s var(--ease), transform .5s var(--ease); }
  a:hover, a:focus-visible { color: var(--c); transform: translateY(-3px); }
  svg { display: block; width: 1.9rem; height: 1.9rem; fill: currentColor; }
</style>
