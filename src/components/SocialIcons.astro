---
// Íconos sólidos: grises en reposo, color de marca al hover/foco.
import { site } from '../data/site';

const glyph: Record<string, { path: string; color: string; svg?: string }> = {
  linkedin: { color: '#0A66C2', path: 'M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 1 1 0-4.125 2.062 2.062 0 0 1 0 4.125zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z' },
  // Dibujado a mano: "B" con contraformas (evenodd), barra superior y "e" trazada.
  behance: { color: '#1769FF', path: '', svg: '<g transform="translate(1 .75)"><path fill-rule="evenodd" d="M0 4.5h6.7c2.4 0 4 1.2 4 3.3 0 1.4-.7 2.4-1.9 3 1.6.5 2.7 1.7 2.7 3.5 0 2.4-1.9 3.7-4.7 3.7H0zM3 7h3.1c1 0 1.6.5 1.6 1.3 0 .9-.6 1.4-1.6 1.4H3zM3 12.4h3.7c1.3 0 2 .6 2 1.6 0 1.1-.8 1.7-2 1.7H3z"/><path d="M14.4 5.4h6.6v1.6h-6.6z"/><path d="M14.9 13.6h6.2a3.1 3.1 0 1 0-.9 2.2" fill="none" stroke="currentColor" stroke-width="1.9"/></g>' },
  substack: { color: '#FF6719', path: 'M22.539 8.242H1.46V5.406h21.08v2.836zM1.46 10.812V24L12 18.11 22.54 24V10.812H1.46zM22.54 0H1.46v2.836h21.08V0z' },
};
---
<ul class="soc-row">
  {site.social.map((s) => (
    <li>
      <a href={s.href} target="_blank" rel="noopener noreferrer" aria-label={s.label} title={s.label} style={`--c:${glyph[s.icon].color}`}>
        <svg viewBox="0 0 24 24" aria-hidden="true" set:html={glyph[s.icon].svg ?? `<path d="${glyph[s.icon].path}"/>`} />
      </a>
    </li>
  ))}
</ul>

<style>
  .soc-row { display: flex; align-items: center; gap: 1.1rem; list-style: none; margin: 0; padding: 0; }
  a { display: block; color: #8a8982; transition: color .35s var(--ease), transform .5s var(--ease); }
  a:hover, a:focus-visible { color: var(--c); transform: translateY(-3px); }
  svg { display: block; width: 1.9rem; height: 1.9rem; fill: currentColor; }
</style>
