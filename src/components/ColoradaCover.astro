---
// Portada de Colorada (tarjeta 2:3), con la paleta madre: rosa #E03B7A, el mármol líquido de la marca en blanco y el logo al centro.
import { readFileSync } from 'node:fs';
import { join } from 'node:path';
const pub = (f: string) => readFileSync(join(process.cwd(), 'public/works/colorada', f), 'utf8');
const marble = [...pub('manual/cierre.svg').matchAll(/<path d="([^"]+)" fill="(?:black|url\([^)]*\))"/g)].map((m) => m[1]).filter((d) => /C/.test(d) && !/^M[\d. ]+[HV]/.test(d)).slice(0, 22).filter((_, i) => i % 3 !== 1);
const logo = pub('logo.svg').replace(/<svg\b([^>]*)>/i, (_m, a) => `<svg${a.replace(/\s(width|height)="[^"]*"/g, '')} class="cvl" role="img" aria-label="Colorada">`);
---
<div class="cvr">
  <svg class="cvr__m" viewBox="620 300 1000 1500" preserveAspectRatio="xMidYMid slice" aria-hidden="true" focusable="false">{marble.map((d) => <path d={d} />)}</svg>
  <div class="cvr__logo" set:html={logo} />
</div>

<style>
  .cvr { position: relative; width: 100%; height: 100%; background: #e03b7a; overflow: hidden; container-type: size; }
  .cvr__m { position: absolute; inset: 0; width: 100%; height: 100%; }
  .cvr__m path { fill: #fff; }
  .cvr__logo { position: absolute; left: 50%; top: 50%; width: 64cqw; transform: translate(-50%, -50%); filter: drop-shadow(0 .9cqw 1.8cqw rgb(120 20 60 / .45)); }
  .cvr__logo :global(svg) { display: block; width: 100%; height: auto; }
</style>
