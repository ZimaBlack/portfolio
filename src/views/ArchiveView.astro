---
import Base from '../layouts/Base.astro';
import ShotFig from '../components/cases/ShotFig.astro';
import Pend from '../components/cases/Pend.astro';
import { archive, brands, type PieceType } from '../data/archive';
import { loc, paths, withBase, type Lang } from '../lib/i18n';
import { u } from '../lib/casesUi';
const { lang } = Astro.props as { lang: Lang };
const ui = u(lang);
const alt = lang === 'es' ? 'en' : 'es';
const types = (Object.keys(ui.types) as PieceType[]).filter((k) => archive.some((p) => p.type === k));
const usedBrands = brands.filter((b) => archive.some((p) => p.brand === b));
---
<Base lang={lang} section="cases" title={ui.archiveTitle} description={ui.archiveLead} altHref={paths.archive(alt)} esHref={paths.archive('es')} enHref={paths.archive('en')}>
  <section class="wrap top">
    <a class="back muted" href={paths.cases(lang)}>{ui.back}</a>
    <p class="eyebrow" data-hero>{archive.length} {lang === 'es' ? 'piezas' : 'pieces'}</p>
    <h1 class="display" data-hero-title>{ui.archiveTitle}</h1>
    <p class="lead">{ui.archiveLead}</p>

    <div class="filters" data-filters>
      <div class="fgroup" role="group" aria-label={ui.type}>
        <span class="flabel">{ui.type}</span>
        <button type="button" class="fbtn" data-k="type" data-v="all" aria-pressed="true">{ui.allF}</button>
        {types.map((k) => <button type="button" class="fbtn" data-k="type" data-v={k} aria-pressed="false">{ui.types[k]}</button>)}
      </div>
      <div class="fgroup" role="group" aria-label={ui.brand}>
        <span class="flabel">{ui.brand}</span>
        <button type="button" class="fbtn" data-k="brand" data-v="all" aria-pressed="true">{ui.allF}</button>
        {usedBrands.map((b) => <button type="button" class="fbtn" data-k="brand" data-v={b} aria-pressed="false">{b}</button>)}
      </div>
      <p class="count" aria-live="polite" data-count></p>
    </div>
  </section>

  <section class="wrap list">
    <ul class="grid" data-grid>
      {archive.map((p) => (
        <li class="piece" data-type={p.type} data-brand={p.brand}>
          <ShotFig shot={p.shot} lang={lang} bare={true} />
          <div class="piece__m">
            <span class="piece__tag">{ui.types[p.type]} · {p.brand}{p.live && <b class="live">{ui.live}</b>}</span>
            <p>{loc(p.context, lang)}</p>
            <span class="piece__links">
              {p.case && <a href={paths.caseOf(lang, p.case)}>{lang === 'es' ? 'Ver el caso' : 'See the case'}</a>}
              {p.href && <a href={withBase(p.href)} target="_blank" rel="noopener">{ui.openDemo} ↗</a>}
            </span>
          </div>
        </li>
      ))}
    </ul>
    <p class="empty" hidden data-empty>{ui.noResults}</p>
  </section>
</Base>

<script>
  function initArchive() {
    const root = document.querySelector<HTMLElement>('[data-filters]');
    if (!root) return;
    const items = [...document.querySelectorAll<HTMLElement>('.piece')];
    const empty = document.querySelector<HTMLElement>('[data-empty]');
    const count = root.querySelector<HTMLElement>('[data-count]');
    const state: Record<string, string> = { type: 'all', brand: 'all' };
    const apply = () => {
      let n = 0;
      items.forEach((el) => {
        const ok = (state.type === 'all' || el.dataset.type === state.type) && (state.brand === 'all' || el.dataset.brand === state.brand);
        el.hidden = !ok;
        if (ok) n++;
      });
      if (empty) empty.hidden = n > 0;
      if (count) count.textContent = `${n} / ${items.length}`;
    };
    root.querySelectorAll<HTMLButtonElement>('.fbtn').forEach((b) =>
      b.addEventListener('click', () => {
        const k = b.dataset.k!;
        state[k] = b.dataset.v!;
        root.querySelectorAll<HTMLButtonElement>(`.fbtn[data-k="${k}"]`).forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
        apply();
      }),
    );
    apply();
  }
  document.addEventListener('astro:page-load', initArchive);
</script>

<style>
  .top { padding-top: clamp(9rem, 16vw, 14rem); display: grid; gap: 1.2rem; }
  .back { font-size: .85rem; justify-self: start; }
  .lead { color: var(--muted); max-width: 56ch; margin: 0; line-height: 1.55; }
  .filters { display: grid; gap: .9rem; margin-top: 1.6rem; padding-top: 1.4rem; border-top: 1px solid var(--line); }
  .fgroup { display: flex; flex-wrap: wrap; gap: .5rem; align-items: center; }
  .flabel { width: 4.5rem; font-size: .7rem; letter-spacing: .14em; text-transform: uppercase; color: var(--muted); }
  .fbtn { font: inherit; font-size: .82rem; color: var(--fg); background: transparent; border: 1px solid var(--line); border-radius: 999px; padding: .45rem 1rem; cursor: pointer; transition: background .3s, color .3s, border-color .3s; }
  .fbtn:hover { border-color: var(--fg); }
  .fbtn[aria-pressed='true'] { background: var(--fg); color: var(--bg); border-color: var(--fg); }
  .fbtn:focus-visible { outline: 2px solid var(--fg); outline-offset: 2px; }
  .count { margin: 0; font-size: .8rem; color: var(--muted); }
  .list { padding-block: clamp(3rem, 6vw, 6rem) clamp(6rem, 12vw, 12rem); }
  .grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: clamp(2rem, 4vw, 3.5rem) var(--gutter); }
  .piece[hidden] { display: none; }
  .piece { display: grid; gap: .9rem; align-content: start; }
  .piece__m { display: grid; gap: .4rem; font-size: .88rem; }
  .piece__m p { margin: 0; line-height: 1.45; }
  .piece__tag { font-size: .68rem; letter-spacing: .14em; text-transform: uppercase; color: var(--muted); }
  .live { margin-left: .6rem; color: #7ccde1; letter-spacing: .12em; }
  .piece__links { display: flex; flex-wrap: wrap; gap: .4rem 1.2rem; font-size: .8rem; }
  .piece__links a { color: var(--muted); border-bottom: 1px solid var(--line); }
  .piece__links a:hover { color: var(--fg); }
  .empty { color: var(--muted); }
  @media (max-width: 980px) { .grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 600px) { .grid { grid-template-columns: 1fr; } }
</style>
