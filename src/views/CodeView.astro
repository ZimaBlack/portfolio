---
import { Code } from 'astro:components';
import Base from '../layouts/Base.astro';
import mixinsRaw from '../../demo-src/design-system/_mixins.scss?raw';
import { paths, withBase, type Lang } from '../lib/i18n';
import { u } from '../lib/casesUi';
const { lang } = Astro.props as { lang: Lang };
const ui = u(lang);
const alt = lang === 'es' ? 'en' : 'es';
const lines = mixinsRaw.split('\n');
const a = lines.findIndex((x) => x.includes('@mixin respond'));
const b = lines.findIndex((x, i) => i > a && x.startsWith('}'));
const respond = lines.slice(a - 3, b + 1).join('\n');
const preview = { ds: '16 / 11', landing: '16 / 11', email: '3 / 4' } as Record<string, string>;
---
<Base lang={lang} section="cases" title={ui.codeTitle} description={ui.codeLead} altHref={paths.code(alt)} esHref={paths.code('es')} enHref={paths.code('en')}>
  <section class="wrap top">
    <a class="back muted" href={paths.cases(lang)}>{ui.back}</a>
    <p class="eyebrow" data-hero>{lang === 'es' ? '3 demos vivas' : '3 live demos'}</p>
    <h1 class="display" data-hero-title>{ui.codeTitle}</h1>
    <p class="lead">{ui.codeLead}</p>
  </section>

  <section class="wrap demos">
    {ui.codeDemos.map((d) => (
      <article class="demo" data-reveal>
        <div class="demo__t">
          <h2>{d.title}</h2>
          <p>{d.text}</p>
          <p class="demo__l">
            <a class="btn" href={withBase(d.href)} target="_blank" rel="noopener">{d.cta} ↗</a>
            {'href2' in d && <a class="btn" href={withBase(d.href2 as string)} target="_blank" rel="noopener">{d.cta2} ↗</a>}
          </p>
        </div>
        <div class="demo__f">
          <iframe src={withBase(d.href)} title={d.title} loading="lazy" style={`aspect-ratio:${preview[d.key]}`}></iframe>
        </div>
      </article>
    ))}
  </section>

  <section class="wrap snip">
    <div class="snip__t">
      <h2>{ui.checkTitle}</h2>
      <ul>{ui.checks.map((c) => <li>{c}</li>)}</ul>
      <p class="muted"><code>{ui.run}</code></p>
    </div>
    <figure class="code">
      <figcaption><code>_mixins.scss</code><span>respond()</span></figcaption>
      <Code code={respond} lang="scss" theme="github-dark" />
    </figure>
  </section>
</Base>

<style>
  .top { padding-top: clamp(9rem, 16vw, 14rem); display: grid; gap: 1.2rem; }
  .back { font-size: .85rem; justify-self: start; }
  .lead { color: var(--muted); max-width: 56ch; margin: 0; line-height: 1.55; }
  .demos { display: grid; gap: clamp(4rem, 8vw, 8rem); padding-block: clamp(4rem, 8vw, 8rem); }
  .demo { display: grid; gap: 2rem 3rem; grid-template-columns: 1fr 1.6fr; align-items: start; border-top: 1px solid var(--line); padding-top: 2rem; }
  .demo:nth-child(even) { grid-template-columns: 1.6fr 1fr; }
  .demo:nth-child(even) .demo__t { order: 2; }
  .demo__t { display: grid; gap: 1rem; align-content: start; }
  .demo__t h2 { margin: 0; font-size: 1.5rem; font-weight: 500; letter-spacing: -.02em; }
  .demo__t p { margin: 0; color: var(--muted); line-height: 1.6; max-width: 46ch; }
  .demo__l { display: flex; flex-wrap: wrap; gap: .6rem; }
  .demo__f { border: 1px solid var(--line); border-radius: 8px; overflow: hidden; background: #fff; }
  .demo__f iframe { display: block; width: 100%; border: 0; }
  @media (max-width: 860px) { .demo, .demo:nth-child(even) { grid-template-columns: 1fr; } .demo:nth-child(even) .demo__t { order: 0; } }
  .snip { display: grid; gap: 2rem 3rem; grid-template-columns: 1fr 1.4fr; padding-bottom: clamp(6rem, 12vw, 12rem); align-items: start; }
  .snip__t h2 { margin: 0 0 1rem; font-size: 1.2rem; font-weight: 500; }
  .snip__t ul { margin: 0 0 1.4rem; padding-left: 1.1rem; display: grid; gap: .5rem; color: var(--muted); line-height: 1.5; }
  .snip :global(code) { font-family: ui-monospace, 'SF Mono', Menlo, monospace; font-size: .85em; }
  .code { margin: 0; border: 1px solid var(--line); border-radius: 8px; overflow: hidden; }
  .code figcaption { display: flex; gap: 1rem; padding: .7rem 1rem; background: rgb(127 127 127 / .12); font-size: .8rem; color: var(--muted); }
  .code :global(pre) { margin: 0 !important; padding: 1.1rem 1.2rem !important; font-size: .78rem; line-height: 1.6; overflow-x: auto; }
  @media (max-width: 860px) { .snip { grid-template-columns: 1fr; } }
</style>
