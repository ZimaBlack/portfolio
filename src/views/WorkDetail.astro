---
import { getCollection, type CollectionEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import Frame from '../components/Frame.astro';
import VideoEmbed from '../components/VideoEmbed.astro';
import Icon from '../components/Icon.astro';
import Carousel, { type Slide } from '../components/Carousel.astro';
import Marquee from '../components/Marquee.astro';
import ProjectHero from '../components/ProjectHero.astro';
import PaletteWidget from '../components/PaletteWidget.astro';
import BrandManual from '../components/BrandManual.astro';
import CdxxManual from '../components/CdxxManual.astro';
import ColoradaManual from '../components/ColoradaManual.astro';
import PiruloManual from '../components/PiruloManual.astro';
import OmegaManual from '../components/OmegaManual.astro';
import { ambientOf, isLight, toneOfHex, type Tone } from '../lib/palette';
import { site } from '../data/site';
import { copy, loc, paths, type Lang } from '../lib/i18n';

const { lang, work } = Astro.props as { lang: Lang; work: CollectionEntry<'works'> };
const c = copy[lang];
const d = work.data;
const all = (await getCollection('works', (w) => !w.data.draft)).sort((a, b) => a.data.order - b.data.order);
const isCode = d.kind === 'code';

// Carrusel: las imágenes (SVG o PNG) se detectan en src/assets/works/<slug>/carrusel/ con nombres 01a.png, 01b.png, 02a.png…
const found = import.meta.glob('/src/assets/works/*/carrusel/*.{svg,png,webp,jpg,jpeg,avif}', { eager: true, query: '?url', import: 'default' }) as Record<string, string>;
const raws = import.meta.glob('/src/assets/works/*/carrusel/*.svg', { eager: true, query: '?raw', import: 'default' }) as Record<string, string>;
const files: Record<number, { a?: string; b?: string }> = {};
const svgText: Record<number, string[]> = {};
const light: Record<number, { a?: boolean; b?: boolean }> = {}; // logos blancos: llevan un destello gris
for (const [path, url] of Object.entries(found)) {
  const m = path.match(/\/works\/([^/]+)\/carrusel\/(\d+)([ab])\.[a-z]+$/i);
  if (!m || m[1] !== work.id) continue;
  (files[Number(m[2])] ??= {})[m[3].toLowerCase() as 'a' | 'b'] = url;
  if (raws[path]) {
    (svgText[Number(m[2])] ??= []).push(raws[path]);
    (light[Number(m[2])] ??= {})[m[3].toLowerCase() as 'a' | 'b'] = isLight(raws[path]);
  }
}
// Respaldo para logos blancos/grises/negros: una luz neutra, apenas fría, en vez de un color
const NEUTRAL: [Tone, Tone] = [{ h: 215, s: 0.1, l: 0.62 }, { h: 30, s: 0.08, l: 0.55 }];
// Láminas en el orden de la lista `slides` (cada una apunta a su archivo con `file`; por defecto, el orden).
// Sin lista, se usan los archivos tal cual (01, 02, …). Una lámina con `intro: true` es la lámina 00 (sin archivos).
const entries: any[] = d.slides.length
  ? d.slides
  : Object.keys(files).map(Number).sort((x, y) => x - y).map((n) => ({ file: n }));
let counter = 0;
const slides: Slide[] = entries.map((e) => {
  const intro = !!e.intro;
  const n = intro ? 0 : ++counter;
  const f: number = e.file ?? n;
  const sub = loc(e.subtitle, lang);
  return {
    n,
    intro,
    a: intro ? undefined : files[f]?.a,
    b: intro ? undefined : files[f]?.b,
    subtitle: sub,
    alt: loc(e.alt, lang) || sub || d.title,
    href: e.project && all.some((w) => w.id === e.project) ? paths.work(lang, e.project) : undefined,
    lightA: intro ? undefined : light[f]?.a,
    lightB: intro ? undefined : light[f]?.b,
    swap: e.swap,
    sizeA: e.size?.a,
    sizeB: e.size?.b,
    dyA: e.dy?.a,
    dyB: e.dy?.b,
    ambient: e.ambient?.colors?.length === 2 ? { c1: toneOfHex(e.ambient.colors[0]), c2: toneOfHex(e.ambient.colors[1]), source: 'custom', boost: e.ambient.boost } : ambientOf(intro ? [] : (svgText[f] ?? []), NEUTRAL),
  };
});
// La marquesina de la cabecera usa los logos "b" en el orden de las láminas
const marqueeItems = slides.map((s, i) => ({ src: s.b as string, label: s.subtitle, slide: i, light: !!s.lightB })).filter((m, i) => !slides[i].intro && m.src);
const alt = lang === 'es' ? 'en' : 'es';
---
<Base lang={lang} section="works" title={d.title} description={loc(d.summary, lang)}
  altHref={paths.work(alt, work.id)} esHref={paths.work('es', work.id)} enHref={paths.work('en', work.id)}>
  <article data-pw-scope={d.widget === 'palette' ? '' : undefined} class:list={{ 'is-pal': d.widget === 'palette' }}>
    {d.widget === 'palette' && <div class="pal-glow" aria-hidden="true"></div>}
    {(d.logo || d.heroPattern || d.heroImage || d.heroLights !== 'soft') && <ProjectHero logo={d.logo ?? ''} mark={d.mark} title={d.title} tones={d.tones} reactive={d.widget === 'palette' ? d.reactiveColors : []} halftone={d.heroLights === 'halftone'} liquid={d.heroLights === 'liquid'} assemble={d.heroAnimation === 'assemble'} ornament={d.ornament} pattern={d.heroPattern} photo={d.heroImage} glass={d.heroAnimation === 'glass'} />}
    <header class="wrap intro">
      <p class="eyebrow" data-hero><a class="link" href={paths.works(lang)}>{c.works.back}</a> · {loc(d.discipline, lang)}</p>
      {d.headerMarquee && marqueeItems.length > 0 && <div class="mq-bleed" data-hero><Marquee items={marqueeItems} /></div>}
      <h1 class="display" data-hero-title>{d.title}</h1>
      {d.badge && <p data-hero><span class="badge">{d.badge}</span></p>}
      <dl class="meta" data-hero>
        {d.year && <div><dt>{c.detail.year}</dt><dd>{d.year}</dd></div>}
        <div><dt>{c.detail.role}</dt><dd>{loc(d.role, lang)}</dd></div>
        {d.client && <div><dt>{c.detail.client}</dt><dd>{d.client}</dd></div>}
        {isCode && d.stack.length > 0 && <div class="meta__stack"><dt>{c.detail.stack}</dt><dd><ul>{d.stack.map((s) => <li>{s}</li>)}</ul></dd></div>}
      </dl>
      <p class="lead" data-hero>{loc(d.summary, lang)}</p>
      {isCode && (d.repo || d.live) && (
        <div class="cta" data-hero>
          {d.repo && <a class="btn btn--solid" href={d.repo} target="_blank" rel="noopener noreferrer"><Icon name="github" /> {c.detail.repo}</a>}
          {d.live && <a class="btn" href={d.live} target="_blank" rel="noopener noreferrer">{c.detail.live} <Icon name="arrow-up-right" /></a>}
        </div>
      )}
      {d.links.length > 0 && (
        <div class="cta" data-hero>
          {d.links.map((l) => <a class="btn" href={l.url} target="_blank" rel="noopener noreferrer">{/instagram\.com/.test(l.url) && <Icon name="instagram" />} {l.label} <Icon name="arrow-up-right" /></a>)}
        </div>
      )}
    </header>

    {!(d.headerMarquee && marqueeItems.length > 0) && (d.hero || !d.manual) && (
      <div class="hero-img" data-reveal><Frame src={d.hero} alt={d.title} tones={d.tones} ratio="21 / 9" label={c.detail.hero} parallax={7} note={c.detail.safe} /></div>
    )}

    {loc(d.text, lang).trim() && <div class="wrap prose" data-reveal><p>{loc(d.text, lang)}</p></div>}

    {slides.length > 0 && (
      <section class="wrap car-sec">
        <Carousel slides={slides} title={d.title} cta={{ title: c.detail.loopTitle, button: c.detail.loopCta, subtitle: c.detail.loopSubtitle, href: `https://wa.me/${site.whatsapp}?text=${encodeURIComponent(c.detail.loopWa)}` }} labels={{ prev: c.detail.prev, next: c.detail.next_, region: c.detail.slides, png: c.detail.pngHint, details: c.detail.details, more: c.detail.fullDev }} />
      </section>
    )}

    {d.manual === 'global-citizen' && <BrandManual lang={lang} />}
    {d.manual === 'cdxx' && <CdxxManual lang={lang} />}
    {d.manual === 'colorada' && <ColoradaManual lang={lang} />}
    {d.manual === 'pirulo' && <PiruloManual lang={lang} />}
    {d.manual === 'omega-shields' && <OmegaManual lang={lang} />}

    {d.video?.id && <section class="wrap vid" data-reveal><VideoEmbed provider={d.video.provider} id={d.video.id} title={d.title} play={c.detail.play} /></section>}

    {!isCode && d.gallery.length > 0 && (
      <section class="gallery" aria-label={c.detail.gallery}>
        {d.gallery.map((b) => (
          <figure class:list={['blk', `blk--${b.kind}`]} data-reveal>
            {b.kind === 'pair' ? (
              <div class="pair">
                <Frame src={b.src} alt={b.alt} tones={d.tones} ratio="4 / 5" label={loc(b.caption, lang)} />
                <Frame src={b.src2} alt={b.alt} tones={[d.tones[1], d.tones[0]]} ratio="4 / 5" label={loc(b.caption, lang)} />
              </div>
            ) : (
              <Frame src={b.src} alt={b.alt} tones={d.tones} ratio={b.ratio} label={loc(b.caption, lang)} parallax={b.kind === 'full' ? 6 : 0} note={c.detail.safe} />
            )}
            {b.caption && <figcaption class="muted">{loc(b.caption, lang)}</figcaption>}
          </figure>
        ))}
      </section>
    )}

  </article>
  {d.widget === 'palette' && d.paletteColors.length > 0 && <PaletteWidget colors={d.paletteColors} lang={lang} />}
</Base>

<style>
  /* Proyecto con widget de color: toda la página toma los colores elegidos (--pw-0/--pw-1 y las luces --ga/--gb) */
  @property --pw-0 { syntax: '<color>'; inherits: true; initial-value: #ae0407; }
  @property --pw-1 { syntax: '<color>'; inherits: true; initial-value: #840002; }
  .is-pal { transition: --pw-0 .8s linear, --pw-1 .8s linear; }
  .pal-glow { position: fixed; inset: 0; z-index: -1; pointer-events: none; opacity: .5;
    background: radial-gradient(ellipse 60% 55% at 12% 88%, color-mix(in srgb, var(--ga) 32%, transparent), transparent 70%), radial-gradient(ellipse 55% 50% at 92% 14%, color-mix(in srgb, var(--gb) 30%, transparent), transparent 70%); }
  .is-pal .meta dt { color: color-mix(in srgb, var(--pw-0) 60%, var(--muted)); transition: color .8s linear; }
  .is-pal .meta { border-top-color: color-mix(in srgb, var(--pw-0) 40%, var(--line)); transition: border-color .8s linear; }
  .is-pal :global(.eyebrow a):hover { color: var(--pw-0); }
  .intro { padding-top: clamp(9rem, 16vw, 14rem); display: grid; gap: 2rem; }
  .meta { display: grid; grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr)); gap: 1.5rem; margin: 1rem 0 0; padding-top: 1.5rem; border-top: 1px solid var(--line); font-size: .9rem; }
  .meta dt { color: var(--muted); font-size: .72rem; letter-spacing: .14em; text-transform: uppercase; margin-bottom: .35rem; }
  .meta dd { margin: 0; }
  .meta ul { display: flex; flex-wrap: wrap; gap: .4rem; list-style: none; margin: 0; padding: 0; }
  .meta li { border: 1px solid var(--line); border-radius: 999px; padding: .15rem .7rem; font-size: .8rem; }
  .meta__stack { grid-column: span 2; }
  .cta { display: flex; flex-wrap: wrap; gap: .75rem; }
  .mq-bleed { width: 100vw; margin-left: calc(50% - 50vw); }
  .hero-img { margin-top: clamp(3rem, 6vw, 6rem); }
  .prose { max-width: 60rem; padding-block: clamp(4rem, 8vw, 8rem); font-size: clamp(1.1rem, 1.5vw, 1.35rem); color: var(--muted); }
  .car-sec { padding-bottom: clamp(3rem, 6vw, 6rem); }
  .vid { padding-bottom: clamp(3rem, 6vw, 6rem); }
  .gallery { display: grid; gap: clamp(2rem, 5vw, 5rem); }
  .blk { margin: 0; }
  .blk--inset { width: 100%; max-width: 70rem; margin-inline: auto; padding-inline: var(--gutter); }
  .blk--pair .pair { display: grid; grid-template-columns: 1fr 1fr; gap: var(--gutter); padding-inline: var(--gutter); }
  .blk figcaption { font-size: .8rem; padding: .75rem var(--gutter) 0; }
  @media (max-width: 640px) { .meta__stack { grid-column: auto; } .blk--pair .pair { grid-template-columns: 1fr; } }
</style>
