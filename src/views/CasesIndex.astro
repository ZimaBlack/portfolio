---
import Base from '../layouts/Base.astro';
import CaseCard from '../components/cases/CaseCard.astro';
import { cases } from '../data/cases';
import { paths, type Lang } from '../lib/i18n';
import { u } from '../lib/casesUi';
const { lang } = Astro.props as { lang: Lang };
const ui = u(lang);
const alt = lang === 'es' ? 'en' : 'es';
---
<Base lang={lang} section="cases" title={ui.indexTitle} description={ui.indexMeta} altHref={paths.cases(alt)} esHref={paths.cases('es')} enHref={paths.cases('en')}>
  <section class="wrap top">
    <p class="eyebrow" data-hero>{ui.eyebrow}</p>
    <h1 class="display" data-hero-title>{ui.indexTitle}</h1>
    <p class="lead">{ui.manifesto}</p>
    <ol class="thread" aria-label={ui.indexTitle}>{ui.thread.map((t) => <li>{t}</li>)}</ol>
  </section>
  <section class="wrap list">
    <div class="grid">
      {cases.map((c) => <CaseCard c={c} lang={lang} ratio="4 / 3" />)}
    </div>
    <p class="more">
      <a class="btn" href={paths.archive(lang)}>{ui.archive}</a>
      <a class="btn" href={paths.code(lang)}>{ui.code}</a>
    </p>
  </section>
</Base>
<style>
  .top { padding-top: clamp(9rem, 16vw, 14rem); display: grid; gap: 1.4rem; }
  .lead { font-size: clamp(1.1rem, 2.2vw, 1.8rem); line-height: 1.35; letter-spacing: -.015em; max-width: 34ch; margin: 1rem 0 0; }
  .thread { display: flex; flex-wrap: wrap; gap: .4rem 1.6rem; list-style: none; margin: .4rem 0 0; padding: 0; font-size: .72rem; letter-spacing: .16em; text-transform: uppercase; color: var(--muted); }
  .thread li + li::before { content: '→'; margin-right: 1.6rem; opacity: .6; }
  .list { padding-block: clamp(4rem, 8vw, 8rem) clamp(6rem, 12vw, 12rem); }
  .grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: clamp(3rem, 6vw, 6rem) var(--gutter); }
  .grid > :global(*:nth-child(even)) { margin-top: 6vw; }
  @media (max-width: 760px) { .grid { grid-template-columns: 1fr; } .grid > :global(*) { margin-top: 0 !important; } }
  .more { display: flex; flex-wrap: wrap; gap: 1rem; margin-top: clamp(4rem, 8vw, 8rem); }
</style>
