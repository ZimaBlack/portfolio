---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import WorkCard from '../components/WorkCard.astro';
import Icon from '../components/Icon.astro';
import { site } from '../data/site';
import { cv } from '../data/cv';
import CvSection from '../components/CvSection.astro';
import { copy, paths, type Lang } from '../lib/i18n';

const { lang } = Astro.props as { lang: Lang };
const c = copy[lang];
const featured = (await getCollection('works')).filter((w) => w.data.featured).sort((a, b) => a.data.order - b.data.order);
const alt = lang === 'es' ? 'en' : 'es';
---
<Base lang={lang} section="home" altHref={paths.home(alt)} esHref={paths.home('es')} enHref={paths.home('en')}>
  <section class="hero">
    <div class="wrap hero__in">
      <h1 class="hero__line hero__name" data-hero>{cv.name}</h1>
      <p class="hero__line hero__role" data-hero>{c.role}</p>
      <p class="hero__line hero__loc" data-hero>{site.location}</p>
      <a class="hero__scroll" href="#trabajos" data-hero aria-label={c.featured.title}>
        <span>{c.hero.cta}</span><Icon name="arrow-up-right" class="rot" />
      </a>
    </div>
  </section>

  <section class="section wrap" id="trabajos">
    <header class="head">
      <p class="eyebrow" data-reveal>{c.featured.eyebrow}</p>
      <h2 class="h2" data-split-scroll>{c.featured.title}</h2>
    </header>
    <div class="grid">
      {featured.map((w, i) => (
        <div class:list={['grid__item', `grid__item--${i % 4}`]}>
          <WorkCard work={w} lang={lang} index={i} ratio={i % 4 === 1 ? '3 / 4' : '4 / 5'} />
        </div>
      ))}
    </div>
    <p class="more" data-reveal><a class="btn" href={paths.works(lang)}>{c.featured.all} <Icon name="arrow-up-right" /></a></p>
  </section>

  <section class="section wrap profile" id="perfil">
    <div class="profile__lead">
      <p class="eyebrow" data-reveal>{c.profile.eyebrow}</p>
      <h2 class="h2" data-split-scroll>{c.profile.title}</h2>
    </div>
    <ul class="disc">
      {c.profile.items.map((d) => (
        <li data-reveal>
          <hr data-line />
          <span class="muted">{d.n}</span>
          <h3 class="h3">{d.title}</h3>
          <p class="muted">{d.text}</p>
        </li>
      ))}
    </ul>
  </section>

  <CvSection lang={lang} />
</Base>

<style>
  .hero { min-height: 100svh; display: flex; align-items: flex-end; padding-block: 7rem 3rem; }
  .hero__in { display: grid; align-content: end; }
  /* Misma medida para los tres textos; la jerarquía sale del peso y del blanco/gris */
  .hero__in { gap: .35rem; }
  .hero__line { margin: 0; font-size: .72rem; letter-spacing: .14em; text-transform: uppercase; line-height: 1.6; }
  .hero__name { font-weight: 700; color: var(--fg); }
  .hero__role { font-weight: 400; color: color-mix(in srgb, var(--fg) 72%, var(--bg)); }
  .hero__loc { font-weight: 400; color: var(--muted); }
  .hero__scroll { margin-top: 1.5rem; }
  .hero__scroll { display: inline-flex; align-items: center; gap: .5rem; font-size: .85rem; }
  .hero__scroll :global(.rot) { transform: rotate(90deg); animation: nudge 2.2s var(--ease) infinite; }
  @keyframes nudge { 50% { transform: rotate(90deg) translate(3px, -3px); } }


  .head { margin-bottom: clamp(3rem, 7vw, 7rem); display: grid; gap: 1rem; }
  .grid { display: grid; grid-template-columns: repeat(12, 1fr); gap: clamp(3rem, 7vw, 7rem) var(--gutter); }
  .grid__item--0 { grid-column: 1 / span 7; }
  .grid__item--1 { grid-column: 9 / span 4; margin-top: 14vw; }
  .grid__item--2 { grid-column: 3 / span 5; }
  .grid__item--3 { grid-column: 9 / span 4; margin-top: 8vw; }
  .more { margin-top: clamp(4rem, 8vw, 8rem); }
  @media (max-width: 760px) { .grid__item { grid-column: 1 / -1 !important; margin-top: 0 !important; } }

  .profile { display: grid; grid-template-columns: 1fr 1.2fr; gap: 4rem var(--gutter); }
  .profile__lead { display: grid; gap: 1rem; align-content: start; position: sticky; top: 7rem; align-self: start; }
  .disc { list-style: none; margin: 0; padding: 0; display: grid; gap: 3rem; }
  .disc li { display: grid; gap: .75rem; }
  .disc p { margin: 0; max-width: 46ch; }
  hr { border: 0; height: 1px; background: var(--line); margin: 0 0 1.25rem; width: 100%; }
  @media (max-width: 860px) { .profile { grid-template-columns: 1fr; } .profile__lead { position: static; } }

</style>
