---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import WorkCard from '../components/WorkCard.astro';
import Icon from '../components/Icon.astro';
import { site } from '../data/site';

const featured = (await getCollection('works')).filter((w) => w.data.featured).sort((a, b) => a.data.order - b.data.order);
---
<Base>
  <section class="hero">
    <div class="wrap hero__in">
      <p class="eyebrow" data-hero>{site.role} — {site.location}</p>
      <h1 class="display hero__title" data-hero-title>Diseño que <span class="serif-i">se siente</span> antes de leerse.</h1>
      <div class="hero__foot">
        <p class="lead" data-hero>Soy Pablo Ponce García. Desde 2009 construyo marcas, interfaces y piezas audiovisuales con foco en la claridad y el detalle.</p>
        <a class="hero__scroll" href="#trabajos" data-hero aria-label="Ir a trabajos destacados">
          <span>Trabajos</span><Icon name="arrow-up-right" class="rot" />
        </a>
      </div>
    </div>
  </section>

  <section class="section marquee-sec" aria-hidden="true">
    <div class="marquee" data-marquee>
      <span>Dirección de arte</span><i>—</i><span class="serif-i">Brand</span><i>—</i><span>UX / UI</span><i>—</i><span class="serif-i">Front-end</span><i>—</i><span>Motion</span><i>—</i><span class="serif-i">Concept art</span>
    </div>
  </section>

  <section class="section wrap" id="trabajos">
    <header class="head">
      <p class="eyebrow" data-reveal>Selección 2021 — 2025</p>
      <h2 class="h2" data-split-scroll>Trabajos destacados</h2>
    </header>
    <div class="grid">
      {featured.map((w, i) => (
        <div class:list={['grid__item', `grid__item--${i % 3}`]}>
          <WorkCard work={w} index={i} ratio={i % 3 === 1 ? '3 / 4' : '4 / 5'} />
        </div>
      ))}
    </div>
    <p class="more" data-reveal><a class="btn" href="/trabajos">Ver todos los trabajos <Icon name="arrow-up-right" /></a></p>
  </section>

  <section class="section wrap profile" id="perfil">
    <div class="profile__lead">
      <p class="eyebrow" data-reveal>Perfil</p>
      <h2 class="h2" data-split-scroll>Estrategia y oficio, en la misma mesa.</h2>
    </div>
    <ul class="disc">
      {site.disciplines.map((d) => (
        <li data-reveal>
          <hr data-line />
          <span class="muted">{d.n}</span>
          <h3 class="h3">{d.title}</h3>
          <p class="muted">{d.text}</p>
        </li>
      ))}
    </ul>
  </section>

  <section class="section wrap">
    <p class="eyebrow" data-reveal>Trayectoria</p>
    <ul class="tl">
      {site.timeline.map((t) => (
        <li data-reveal>
          <hr data-line />
          <span class="muted">{t.years}</span>
          <span class="tl__what">{t.what}</span>
          <span class="muted tl__where">{t.where}</span>
        </li>
      ))}
    </ul>
  </section>
</Base>

<style>
  .hero { min-height: 100svh; display: flex; align-items: flex-end; padding-block: 7rem 3rem; }
  .hero__in { display: grid; gap: clamp(1.5rem, 4vw, 3rem); }
  .hero__title { max-width: 14ch; }
  .hero__foot { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-end; gap: 2rem; }
  .hero__scroll { display: inline-flex; align-items: center; gap: .5rem; font-size: .85rem; }
  .hero__scroll :global(.rot) { transform: rotate(90deg); animation: nudge 2.2s var(--ease) infinite; }
  @keyframes nudge { 50% { transform: rotate(90deg) translate(3px, -3px); } }

  .marquee-sec { padding-block: 2rem; overflow: hidden; border-block: 1px solid var(--line); }
  .marquee { display: flex; gap: 2.5rem; white-space: nowrap; font-family: var(--serif); font-size: clamp(3rem, 8vw, 8rem); line-height: 1; width: max-content; padding-left: var(--gutter); }
  .marquee i { color: var(--muted); font-style: normal; }

  .head { margin-bottom: clamp(3rem, 7vw, 7rem); display: grid; gap: 1rem; }
  .grid { display: grid; grid-template-columns: repeat(12, 1fr); gap: clamp(3rem, 7vw, 7rem) var(--gutter); }
  .grid__item--0 { grid-column: 1 / span 7; }
  .grid__item--1 { grid-column: 9 / span 4; margin-top: 14vw; }
  .grid__item--2 { grid-column: 3 / span 6; }
  .more { margin-top: clamp(4rem, 8vw, 8rem); }
  @media (max-width: 760px) { .grid__item { grid-column: 1 / -1 !important; margin-top: 0 !important; } }

  .profile { display: grid; grid-template-columns: 1fr 1.2fr; gap: 4rem var(--gutter); }
  .profile__lead { display: grid; gap: 1rem; align-content: start; position: sticky; top: 7rem; align-self: start; }
  .disc { list-style: none; margin: 0; padding: 0; display: grid; gap: 3rem; }
  .disc li { display: grid; gap: .75rem; }
  .disc p { margin: 0; max-width: 46ch; }
  hr { border: 0; height: 1px; background: var(--line); margin: 0 0 1.25rem; width: 100%; }
  @media (max-width: 860px) { .profile { grid-template-columns: 1fr; } .profile__lead { position: static; } }

  .tl { list-style: none; margin: 2rem 0 0; padding: 0; }
  .tl li { display: grid; grid-template-columns: 12rem 1fr auto; gap: 1rem; padding-bottom: 1.25rem; font-size: 1rem; }
  .tl li hr { grid-column: 1 / -1; margin: 0 0 1.25rem; }
  @media (max-width: 760px) { .tl li { grid-template-columns: 1fr; gap: .15rem; } }
</style>
