---
// Laboratorio: pruebas de efectos fuera del sitio principal (no figura en el menú).
import Base from '../../layouts/Base.astro';
---
<Base title="Laboratorio" description="Pruebas de efectos." section="lab" noindex>
  <section class="lab">
    <canvas class="lab__canvas" data-trace aria-hidden="true"></canvas>
    <p class="lab__hint eyebrow">Difusión de pistas · deja el cursor quieto</p>
  </section>
</Base>

<style>
  .lab { position: relative; min-height: 100svh; background: #000; overflow: hidden; }
  .lab__canvas { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }
  .lab__hint { position: absolute; left: var(--gutter); bottom: var(--gutter); pointer-events: none; opacity: .7; }
</style>

<script>
  import { initTraceDiffusion } from '../../scripts/trace-diffusion';
  document.addEventListener('astro:page-load', () => {
    document.querySelectorAll<HTMLCanvasElement>('[data-trace]:not([data-ready])').forEach((c) => { c.dataset.ready = '1'; initTraceDiffusion(c); });
  });
</script>
